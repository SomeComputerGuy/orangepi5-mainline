# Keep the Orange Pi 5 rebuilds of FFmpeg, mpv, GStreamer and the VA-API driver
# (version suffix +opi5.N, from scripts/build-media-debs.sh): Ubuntu's builds lack
# the V4L2 stateless decoding this image relies on. When Ubuntu updates one of
# them, rebuild ours from the new version and install it.
# (Version pins need named packages, hence src:...; a leading * in a version glob
# doesn't match, hence the regex.)
Package: src:ffmpeg src:mpv src:gst-plugins-bad1.0 src:libva-v4l2-request
Pin: version /\+opi5/
Pin-Priority: 1001
