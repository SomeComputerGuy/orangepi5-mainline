# Site settings for the scripts. Copy to local.env (ignored by git) and edit.
# Read by scripts/env.sh. Every value here is an example.

# Board login for pi-*.sh (the image's default user is "ubuntu")
#OPI5_PI=ubuntu@orangepi5
#OPI5_SSH_KEY=$TOP/.ssh/opi5_ed25519
#OPI5_KNOWN_HOSTS=$TOP/.ssh/known_hosts

# Build-PC network ports and the board subnet (nat-on.sh, bridge-on.sh)
#OPI5_UPLINK=enp129s0
#OPI5_PORT=enp130s0
#OPI5_NAT_ADDR=172.31.55.1/24

# make-board-permanent.sh: fixed DHCP lease for the board
#OPI5_PI_MAC=aa:bb:cc:dd:ee:ff
#OPI5_PI_IP=172.31.55.129

# Identity for formatting/sending patches (default: git config user.name/email)
#OPI5_NAME="Your Name"
#OPI5_EMAIL=you@example.com

# Where the source trees live (default: src/)
#OPI5_SRC=$TOP/src

# Kernel build identity baked into /proc/version and the deb Maintainer field
#KBUILD_BUILD_USER=opi5
#KBUILD_BUILD_HOST=opi5-build
