# This repository holds only what is needed to build the image. Everything else
# (topics, tests, docs, notes, tooling) stays local and untracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSES/
!/install-deps.sh
!/local.env.example
!/cidata/
!/overlay/
!/overlay-desktop/
!/scripts/
!/patches/

/scripts/*
!/scripts/build-chroot.sh
!/scripts/build-image.sh
!/scripts/build-kernel.sh
!/scripts/build-media-debs.sh
!/scripts/build-uboot.sh
!/scripts/build-va-driver.sh
!/scripts/customize-desktop.sh
!/scripts/customize-rootfs.sh
!/scripts/desktop-exclude.pref
!/scripts/env.sh
!/scripts/fetch-sources.sh
!/scripts/flash-sd.sh
!/scripts/flash-uboot-sd.sh
!/scripts/make-media-repo.sh
!/scripts/opi5.config
!/scripts/opi5-extra.config
!/scripts/opi5-install-ssd

/patches/*
!/patches/linux/
!/patches/linux-extra/
!/patches/u-boot/
!/patches/tf-a/
!/patches/ffmpeg/
!/patches/mpv/
!/patches/gstreamer/
!/patches/gst-plugins-good/
!/patches/alsa-ucm-conf/
/patches/*/README*
/patches/*/*.md

# local, private or generated
/local.env
/cidata/user-data
*.ko
*.dtb
*.dtbo
*.img
*.img.xz
*.deb
*.pem
x509.genkey
__pycache__/
