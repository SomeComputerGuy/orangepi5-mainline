 sys/v4l2codecs/gstv4l2decoder.c       | 92 ++++++++++++++++++++++++++-
 sys/v4l2codecs/gstv4l2decoder.h       |  7 ++
 8 files changed, 166 insertions(+), 53 deletions(-)

diff --git a/sys/v4l2codecs/gstv4l2codecav1dec.c b/sys/v4l2codecs/gstv4l2codecav1dec.c
index f14b3dc..e19d3e6 100644
--- a/sys/v4l2codecs/gstv4l2codecav1dec.c
+++ b/sys/v4l2codecs/gstv4l2codecav1dec.c
@@ -67,10 +67,8 @@ enum
   PROP_LAST = PROP_0
 };
 
-static GstStaticPadTemplate sink_template =
-GST_STATIC_PAD_TEMPLATE (GST_VIDEO_DECODER_SINK_NAME,
-    GST_PAD_SINK, GST_PAD_ALWAYS,
-    GST_STATIC_CAPS ("video/x-av1, alignment=frame"));
+static GstStaticCaps static_sink_caps =
+GST_STATIC_CAPS ("video/x-av1, alignment=frame");
 
 #define SRC_CAPS \
     GST_VIDEO_DMA_DRM_CAPS_MAKE " ; " \
@@ -1571,7 +1569,9 @@ gst_v4l2_codec_av1_dec_class_init (GstV4l2CodecAV1DecClass * klass,
 
   parent_class = g_type_class_peek_parent (klass);
 
-  gst_element_class_add_static_pad_template (element_class, &sink_template);
+  gst_element_class_add_pad_template (element_class,
+      gst_pad_template_new (GST_VIDEO_DECODER_SINK_NAME, GST_PAD_SINK,
+          GST_PAD_ALWAYS, cdata->sink_caps));
   gst_element_class_add_pad_template (element_class,
       gst_pad_template_new ("src", GST_PAD_SRC, GST_PAD_ALWAYS,
           cdata->src_caps));
@@ -1632,7 +1632,7 @@ gst_v4l2_codec_av1_dec_register (GstPlugin * plugin, GstV4l2Decoder * decoder,
     .instance_size = sizeof (GstV4l2CodecAV1Dec),
     .instance_init = (GInstanceInitFunc) gst_v4l2_codec_av1_dec_init,
   };
-  GstCaps *tmpl_src_caps = NULL, *src_caps = NULL;
+  GstCaps *tmpl_src_caps = NULL, *sink_caps = NULL, *src_caps = NULL;
   guint version;
 
   GST_DEBUG_CATEGORY_INIT (v4l2_av1dec_debug, "v4l2codecs-av1dec", 0,
@@ -1672,13 +1672,17 @@ gst_v4l2_codec_av1_dec_register (GstPlugin * plugin, GstV4l2Decoder * decoder,
   }
 
 register_element:
+  sink_caps = gst_v4l2_decoder_probe_sink_caps (decoder,
+      V4L2_PIX_FMT_AV1_FRAME, &static_sink_caps);
+
   type_info.class_data = gst_v4l2_decoder_class_data_new (device,
-      tmpl_src_caps);
+      sink_caps, tmpl_src_caps);
   gst_v4l2_decoder_register (plugin, GST_TYPE_AV1_DECODER, &type_info,
       "v4l2sl%sav1dec", device, rank, NULL);
 
 done:
   gst_clear_caps (&tmpl_src_caps);
+  gst_clear_caps (&sink_caps);
   if (src_caps)
     gst_caps_unref (src_caps);
 }
