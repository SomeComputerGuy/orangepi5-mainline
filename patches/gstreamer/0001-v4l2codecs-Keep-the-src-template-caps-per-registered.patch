+/*
+ * gst_v4l2_decoder_class_data_new:
+ * @device: a #GstV4l2CodecDevice
+ * @src_caps: (transfer none): the src pad template caps
+ *
+ * Creates the class data of a decoder element type. The class of a
+ * registered element type is only initialized when the type is first used,
+ * which is after all the codecs of all devices have been probed when the
+ * plugin is loaded from the registry cache, so everything the class_init
+ * function needs must be kept per element type. The class data lives as long
+ * as the type, i.e. until the process exits.
+ *
+ * Returns: (transfer full): the class data
+ */
+GstV4l2DecoderClassData *
+gst_v4l2_decoder_class_data_new (GstV4l2CodecDevice * device,
+    GstCaps * src_caps)
+{
+  GstV4l2DecoderClassData *cdata = g_new0 (GstV4l2DecoderClassData, 1);
+
+  cdata->device = (GstV4l2CodecDevice *)
+      gst_mini_object_ref (GST_MINI_OBJECT (device));
+  cdata->src_caps = gst_caps_ref (src_caps);
+
+  GST_MINI_OBJECT_FLAG_SET (cdata->device, GST_MINI_OBJECT_FLAG_MAY_BE_LEAKED);
+  GST_MINI_OBJECT_FLAG_SET (cdata->src_caps,
+      GST_MINI_OBJECT_FLAG_MAY_BE_LEAKED);
+
+  return cdata;
+}
