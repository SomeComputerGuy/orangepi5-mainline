From 5163262992b60abf5199de9bf4a9000132b622b0 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 04:14:19 +0000
Subject: [PATCH 1/7] v4l2codecs: Keep the src template caps per registered
 decoder

Each codec's register function probes the CAPTURE formats for that
codec and stores them in device->src_caps, and the class_init function
builds the src pad template from device->src_caps. But a
GstV4l2CodecDevice is shared by all the codecs of a device, and
class_init does not run at registration: when the plugin is loaded
from the registry cache, gst_element_register() only attaches the type
to the cached factory, and the class is initialized when the element is
first created. By then, every element of a multi-codec device (e.g.
rkvdec on RK3588: H.264, HEVC and VP9) reads the caps that the last
probed codec stored, and the caps of the earlier codecs are leaked.

Pass per-registration class data instead, holding the device and the
template caps of that element type, and drop the caps from
GstV4l2CodecDevice.

Assisted-by: Claude:claude-opus-5-5
---
 sys/v4l2codecs/gstv4l2codecav1dec.c   | 15 +++++++------
 sys/v4l2codecs/gstv4l2codecdevice.h   |  1 -
 sys/v4l2codecs/gstv4l2codech264dec.c  | 15 +++++++------
 sys/v4l2codecs/gstv4l2codech265dec.c  | 15 +++++++------
 sys/v4l2codecs/gstv4l2codecmpeg2dec.c | 15 +++++++------
 sys/v4l2codecs/gstv4l2codecvp8dec.c   | 17 +++++++++------
 sys/v4l2codecs/gstv4l2codecvp9dec.c   | 17 +++++++++------
 sys/v4l2codecs/gstv4l2decoder.c       | 31 +++++++++++++++++++++++++++
 sys/v4l2codecs/gstv4l2decoder.h       | 18 ++++++++++++++++
 9 files changed, 105 insertions(+), 39 deletions(-)

diff --git a/sys/v4l2codecs/gstv4l2codecav1dec.c b/sys/v4l2codecs/gstv4l2codecav1dec.c
index c5ad26f..f14b3dc 100644
--- a/sys/v4l2codecs/gstv4l2codecav1dec.c
+++ b/sys/v4l2codecs/gstv4l2codecav1dec.c
@@ -1551,8 +1551,9 @@ gst_v4l2_codec_av1_dec_dispose (GObject * object)
 
 static void
 gst_v4l2_codec_av1_dec_class_init (GstV4l2CodecAV1DecClass * klass,
-    GstV4l2CodecDevice * device)
+    GstV4l2DecoderClassData * cdata)
 {
+  GstV4l2CodecDevice *device = cdata->device;
   GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
   GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
   GstVideoDecoderClass *decoder_class = GST_VIDEO_DECODER_CLASS (klass);
@@ -1573,7 +1574,7 @@ gst_v4l2_codec_av1_dec_class_init (GstV4l2CodecAV1DecClass * klass,
   gst_element_class_add_static_pad_template (element_class, &sink_template);
   gst_element_class_add_pad_template (element_class,
       gst_pad_template_new ("src", GST_PAD_SRC, GST_PAD_ALWAYS,
-          device->src_caps));
+          cdata->src_caps));
 
   element_class->change_state =
       GST_DEBUG_FUNCPTR (gst_v4l2_codec_av1_dec_change_state);
@@ -1628,18 +1629,17 @@ gst_v4l2_codec_av1_dec_register (GstPlugin * plugin, GstV4l2Decoder * decoder,
   GTypeInfo type_info = {
     .class_size = sizeof (GstV4l2CodecAV1DecClass),
     .class_init = (GClassInitFunc) gst_v4l2_codec_av1_dec_class_init,
-    .class_data = gst_mini_object_ref (GST_MINI_OBJECT (device)),
     .instance_size = sizeof (GstV4l2CodecAV1Dec),
     .instance_init = (GInstanceInitFunc) gst_v4l2_codec_av1_dec_init,
   };
-  GstCaps *src_caps = NULL;
+  GstCaps *tmpl_src_caps = NULL, *src_caps = NULL;
   guint version;
 
   GST_DEBUG_CATEGORY_INIT (v4l2_av1dec_debug, "v4l2codecs-av1dec", 0,
       "V4L2 stateless AV1 decoder");
 
   if (gst_v4l2_decoder_in_doc_mode (decoder)) {
-    device->src_caps = gst_static_caps_get (&static_src_caps);
+    tmpl_src_caps = gst_static_caps_get (&static_src_caps);
     goto register_element;
   }
 
@@ -1657,7 +1657,7 @@ gst_v4l2_codec_av1_dec_register (GstPlugin * plugin, GstV4l2Decoder * decoder,
   }
 
   /* Get all supported pixel formats for AV1 */
-  device->src_caps =
+  tmpl_src_caps =
       gst_v4l2_decoder_enum_all_src_formats (decoder, &static_src_caps);
 
   version = gst_v4l2_decoder_get_version (decoder);
@@ -1672,10 +1672,13 @@ gst_v4l2_codec_av1_dec_register (GstPlugin * plugin, GstV4l2Decoder * decoder,
   }
 
 register_element:
+  type_info.class_data = gst_v4l2_decoder_class_data_new (device,
+      tmpl_src_caps);
   gst_v4l2_decoder_register (plugin, GST_TYPE_AV1_DECODER, &type_info,
       "v4l2sl%sav1dec", device, rank, NULL);
 
 done:
+  gst_clear_caps (&tmpl_src_caps);
   if (src_caps)
     gst_caps_unref (src_caps);
 }
