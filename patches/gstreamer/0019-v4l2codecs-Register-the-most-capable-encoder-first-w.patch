diff --git a/sys/v4l2codecs/gstv4l2encoder.c b/sys/v4l2codecs/gstv4l2encoder.c
index b538927..edede6c 100644
--- a/sys/v4l2codecs/gstv4l2encoder.c
+++ b/sys/v4l2codecs/gstv4l2encoder.c
@@ -88,6 +88,8 @@ struct _GstV4l2Encoder
   gint video_fd;
   GQueue request_pool;
   guint version;
+  gchar driver[16];
+  gchar bus_info[32];
 
   enum v4l2_buf_type sink_buf_type;
   enum v4l2_buf_type src_buf_type;
@@ -280,6 +282,10 @@ gst_v4l2_encoder_open (GstV4l2Encoder * self)
   }
 
   self->version = querycap.version;
+  g_strlcpy (self->driver, (const gchar *) querycap.driver,
+      sizeof (self->driver));
+  g_strlcpy (self->bus_info, (const gchar *) querycap.bus_info,
+      sizeof (self->bus_info));
 
   if (querycap.capabilities & V4L2_CAP_DEVICE_CAPS)
     capabilities = querycap.device_caps;
@@ -1140,6 +1146,56 @@ gst_v4l2_encoder_get_property (GObject * object, guint prop_id,
   }
 }
 
+/* Keep the ASCII letters and digits of @str, in lower case. */
+static void
+append_alnum (GString * tag, const gchar * str)
+{
+  for (; *str; str++) {
+    if (g_ascii_isalnum (*str))
+      g_string_append_c (tag, g_ascii_tolower (*str));
+  }
+}
+
+/**
+ * gst_v4l2_encoder_get_device_tag:
+ * @self: an opened #GstV4l2Encoder
+ * @with_bus: append the bus address
+ *
+ * Returns: (transfer full): a short tag for element names that does not
+ * depend on the device probe order: the driver name ("hantrovpu" for
+ * "hantro-vpu"), followed by the address part of the bus info when
+ * @with_bus ("hantrovpufdb50000" for "platform:fdb50000.video-codec").
+ * %NULL if the tag would be empty.
+ */
+gchar *
+gst_v4l2_encoder_get_device_tag (GstV4l2Encoder * self, gboolean with_bus)
+{
+  GString *tag = g_string_new (NULL);
+
+  append_alnum (tag, self->driver);
+
+  if (with_bus && tag->len) {
+    const gchar *bus = strchr (self->bus_info, ':');
+    gchar *addr = g_strdup (bus ? bus + 1 : self->bus_info);
+    gchar *dot = strchr (addr, '.');
+
+    if (dot)
+      *dot = '\0';
+    if (*addr)
+      append_alnum (tag, addr);
+    else
+      g_string_truncate (tag, 0);
+    g_free (addr);
+  }
+
+  if (!tag->len) {
+    g_string_free (tag, TRUE);
+    return NULL;
+  }
+
+  return g_string_free (tag, FALSE);
+}
+
 /**
  * gst_v4l2_encoder_register:
  * @plugin: a #GstPlugin
@@ -1149,24 +1205,31 @@ gst_v4l2_encoder_get_property (GObject * object, guint prop_id,
  * @instance_init: The #GInstanceInitFunc for #enc_type
  * @element_name_tmpl: A string to use for the first codec found and as a
  *   template for the next ones.
+ * @encoder: the opened #GstV4l2Encoder of @device
  * @device: (transfer full) A #GstV4l2CodecDevice
  * @rank: The rank to use for the element
  * @element_name: (nullable) (out) Sets the pointer to the new element name
  *
  * Registers an encoder element as a subtype of @enc_type for @plugin. The
- * first device gets a constant name like v4l2slh264enc, the next ones one
- * that contains the video device name.
+ * first device gets a constant name like v4l2slh264enc. The callers register
+ * the devices of a codec most capable first (see plugin.c), so that is the
+ * best encoder of the system. The next ones are named after the driver, like
+ * v4l2slhantrovpuh264enc, with the bus address added if two devices share a
+ * driver, so the names do not depend on the probe order. The video device
+ * name (v4l2slvideo4h264enc), as for the decoders, is the last resort.
  */
 void
 gst_v4l2_encoder_register (GstPlugin * plugin, GType enc_type,
     GClassInitFunc class_init, gconstpointer class_data,
     GInstanceInitFunc instance_init, const gchar * element_name_tmpl,
-    GstV4l2CodecDevice * device, guint rank, gchar ** element_name)
+    GstV4l2Encoder * encoder, GstV4l2CodecDevice * device, guint rank,
+    gchar ** element_name)
 {
   GTypeQuery type_query;
   GTypeInfo type_info = { 0, };
   GType subtype;
   gchar *type_name;
+  gint i;
 
   g_type_query (enc_type, &type_query);
   type_info.class_size = type_query.class_size;
@@ -1179,11 +1242,31 @@ gst_v4l2_encoder_register (GstPlugin * plugin, GType enc_type,
     GST_MINI_OBJECT_FLAG_SET (device, GST_MINI_OBJECT_FLAG_MAY_BE_LEAKED);
 
   type_name = g_strdup_printf (element_name_tmpl, "");
+
+  for (i = 0; i < 3 && g_type_from_name (type_name) != 0; i++) {
+    gchar *tag;
+
+    if (i < 2)
+      tag = gst_v4l2_encoder_get_device_tag (encoder, i == 1);
+    else
+      tag = g_path_get_basename (device->video_device_path);
+
+    if (!tag)
+      continue;
+
+    g_free (type_name);
+    type_name = g_strdup_printf (element_name_tmpl, tag);
+    g_free (tag);
+  }
+
   if (g_type_from_name (type_name) != 0) {
-    gchar *basename = g_path_get_basename (device->video_device_path);
+    GST_WARNING ("Element name '%s' is already in use", type_name);
     g_free (type_name);
-    type_name = g_strdup_printf (element_name_tmpl, basename);
-    g_free (basename);
+    if (class_data == device)
+      gst_mini_object_unref (GST_MINI_OBJECT (device));
+    if (element_name)
+      *element_name = NULL;
+    return;
   }
 
   subtype = g_type_register_static (enc_type, type_name, &type_info, 0);
diff --git a/sys/v4l2codecs/gstv4l2encoder.h b/sys/v4l2codecs/gstv4l2encoder.h
index 7a955ca..2b68380 100644
