diff --git a/sys/v4l2codecs/gstv4l2codech265enc.c b/sys/v4l2codecs/gstv4l2codech265enc.c
index cd48538..6c8e2c8 100644
--- a/sys/v4l2codecs/gstv4l2codech265enc.c
+++ b/sys/v4l2codecs/gstv4l2codech265enc.c
@@ -384,21 +384,28 @@ gst_v4l2_codec_h265_enc_subclass_init (GstV4l2CodecBaseEncClass * klass,
   gst_v4l2_codec_base_enc_install_device_properties (gobject_class, device);
 }
 
-void
