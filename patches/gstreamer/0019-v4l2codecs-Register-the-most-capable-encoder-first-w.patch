@@ -24,7 +24,7 @@
 
 G_BEGIN_DECLS
 
-void gst_v4l2_codec_h265_enc_register (GstPlugin * plugin,
+gboolean gst_v4l2_codec_h265_enc_register (GstPlugin * plugin,
