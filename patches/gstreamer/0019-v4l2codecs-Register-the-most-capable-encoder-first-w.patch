+++ b/sys/v4l2codecs/gstv4l2encoder.h
@@ -115,12 +115,16 @@ void              gst_v4l2_encoder_set_property (GObject * object, guint prop_id
 void              gst_v4l2_encoder_get_property (GObject * object, guint prop_id,
                                                  GValue * value, GParamSpec * pspec);
 
+gchar *           gst_v4l2_encoder_get_device_tag (GstV4l2Encoder * self,
+                                                   gboolean with_bus);
+
 void              gst_v4l2_encoder_register (GstPlugin * plugin,
                                              GType enc_type,
                                              GClassInitFunc class_init,
                                              gconstpointer class_data,
                                              GInstanceInitFunc instance_init,
                                              const gchar * element_name_tmpl,
+                                             GstV4l2Encoder * encoder,
                                              GstV4l2CodecDevice * device,
                                              guint rank,
                                              gchar ** element_name);
diff --git a/sys/v4l2codecs/plugin.c b/sys/v4l2codecs/plugin.c
index 27b8451..79a86c7 100644
--- a/sys/v4l2codecs/plugin.c
+++ b/sys/v4l2codecs/plugin.c
@@ -122,8 +122,49 @@ register_video_decoder (GstPlugin * plugin, GstV4l2CodecDevice * device)
   g_object_unref (decoder);
 }
 
+/* An encoder device and one coded format it supports */
+typedef struct
+{
+  GstV4l2CodecDevice *device;
+  GstV4l2Encoder *encoder;
+  guint32 pix_fmt;
+  guint64 max_area;
+} EncoderCandidate;
+
 static void
-register_video_encoder (GstPlugin * plugin, GstV4l2CodecDevice * device)
+encoder_candidate_free (EncoderCandidate * c)
+{
+  g_object_unref (c->encoder);
+  gst_mini_object_unref (GST_MINI_OBJECT (c->device));
+  g_free (c);
+}
+
+/* Biggest picture first, then a probe order independent tie break. */
+static gint
+encoder_candidate_compare (gconstpointer pa, gconstpointer pb)
+{
+  const EncoderCandidate *a = *(const EncoderCandidate **) pa;
+  const EncoderCandidate *b = *(const EncoderCandidate **) pb;
+  gchar *ta, *tb;
+  gint ret;
+
+  if (a->max_area != b->max_area)
+    return a->max_area > b->max_area ? -1 : 1;
+
+  ta = gst_v4l2_encoder_get_device_tag (a->encoder, TRUE);
+  tb = gst_v4l2_encoder_get_device_tag (b->encoder, TRUE);
+  ret = g_strcmp0 (ta, tb);
+  g_free (ta);
+  g_free (tb);
+
+  if (ret == 0)
+    ret = g_strcmp0 (a->device->name, b->device->name);
+
+  return ret;
+}
+
+static void
+add_video_encoder (GPtrArray * candidates, GstV4l2CodecDevice * device)
 {
   GstV4l2Encoder *encoder = gst_v4l2_encoder_new (device);
   guint32 fmt;
@@ -135,33 +176,78 @@ register_video_encoder (GstPlugin * plugin, GstV4l2CodecDevice * device)
   }
 
   for (i = 0; gst_v4l2_encoder_enum_src_formats (encoder, i, &fmt); i++) {
+    struct v4l2_frmsize_stepwise range = { 0, };
+    EncoderCandidate *c;
+
     switch (fmt) {
       case V4L2_PIX_FMT_H264_SLICE:
-        GST_INFO_OBJECT (encoder, "Registering %s as H264 Encoder",
-            device->name);
-        gst_v4l2_codec_h264_enc_register (plugin, encoder, device,
-            GST_RANK_PRIMARY + 1);
-        break;
       case V4L2_PIX_FMT_HEVC_SLICE:
-        GST_INFO_OBJECT (encoder, "Registering %s as H265 Encoder",
-            device->name);
-        gst_v4l2_codec_h265_enc_register (plugin, encoder, device,
-            GST_RANK_PRIMARY + 1);
         break;
       default:
         GST_FIXME_OBJECT (encoder, "%" GST_FOURCC_FORMAT " is not supported.",
             GST_FOURCC_ARGS (fmt));
-        break;
+        continue;
     }
+
+    c = g_new0 (EncoderCandidate, 1);
+    c->device = GST_V4L2_CODEC_DEVICE (gst_mini_object_ref (GST_MINI_OBJECT
+            (device)));
+    c->encoder = g_object_ref (encoder);
+    c->pix_fmt = fmt;
+    if (gst_v4l2_encoder_get_frame_size_range (encoder, fmt, &range))
+      c->max_area = (guint64) range.max_width * range.max_height;
+    g_ptr_array_add (candidates, c);
   }
 
   g_object_unref (encoder);
 }
 
+/*
+ * Several devices of one system can encode the same codec, like the Hantro
+ * H1 (1080p) and the VEPU580 (4K) H.264 encoders of the RK3588. The probe
+ * order of the devices is not stable, so they are registered most capable
+ * (biggest picture) first: that one gets the plain name (v4l2slh264enc) and
+ * the highest rank, so autoplugging picks it. The others get a name from
+ * their driver (see gst_v4l2_encoder_register()) and one rank less, as the
+ * VA plugin does for its secondary devices.
+ */
+static void
+register_video_encoders (GstPlugin * plugin, GPtrArray * candidates)
+{
+  guint n_h264 = 0, n_h265 = 0;
+  guint i;
+
+  g_ptr_array_sort (candidates, encoder_candidate_compare);
+
+  for (i = 0; i < candidates->len; i++) {
+    EncoderCandidate *c = g_ptr_array_index (candidates, i);
+
+    switch (c->pix_fmt) {
+      case V4L2_PIX_FMT_H264_SLICE:
+        GST_INFO_OBJECT (c->encoder, "Registering %s as H264 Encoder",
+            c->device->name);
+        if (gst_v4l2_codec_h264_enc_register (plugin, c->encoder, c->device,
+                n_h264 ? GST_RANK_PRIMARY : GST_RANK_PRIMARY + 1))
+          n_h264++;
+        break;
+      case V4L2_PIX_FMT_HEVC_SLICE:
+        GST_INFO_OBJECT (c->encoder, "Registering %s as H265 Encoder",
+            c->device->name);
+        if (gst_v4l2_codec_h265_enc_register (plugin, c->encoder, c->device,
+                n_h265 ? GST_RANK_PRIMARY : GST_RANK_PRIMARY + 1))
+          n_h265++;
+        break;
+      default:
+        g_assert_not_reached ();
+    }
+  }
+}
+
 static gboolean
 plugin_init (GstPlugin * plugin)
 {
   GList *devices, *d;
+  GPtrArray *encoders;
   const gchar *paths[] = { "/dev", NULL };
   const gchar *names[] = { "media", NULL };
 
@@ -173,6 +259,9 @@ plugin_init (GstPlugin * plugin)
   gst_plugin_add_dependency (plugin,
       NULL, paths, names, GST_PLUGIN_DEPENDENCY_FLAG_FILE_NAME_IS_PREFIX);
 
+  encoders =
+      g_ptr_array_new_with_free_func ((GDestroyNotify) encoder_candidate_free);
+
   devices = gst_v4l2_codec_find_devices ();
   for (d = devices; d; d = g_list_next (d)) {
     GstV4l2CodecDevice *device = d->data;
@@ -181,9 +270,12 @@ plugin_init (GstPlugin * plugin)
       register_video_decoder (plugin, device);
 
     if (device->function == MEDIA_ENT_F_PROC_VIDEO_ENCODER)
-      register_video_encoder (plugin, device);
+      add_video_encoder (encoders, device);
   }
 
+  register_video_encoders (plugin, encoders);
+  g_ptr_array_unref (encoders);
+
   gst_v4l2_codec_device_list_free (devices);
   return TRUE;
 }
