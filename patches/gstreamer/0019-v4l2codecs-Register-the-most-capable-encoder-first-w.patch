 sys/v4l2codecs/gstv4l2encoder.h      |   4 +
 sys/v4l2codecs/plugin.c              | 116 ++++++++++++++++++++++++---
 7 files changed, 219 insertions(+), 26 deletions(-)

diff --git a/sys/v4l2codecs/gstv4l2codech264enc.c b/sys/v4l2codecs/gstv4l2codech264enc.c
index 746c2e4..a2274b1 100644
--- a/sys/v4l2codecs/gstv4l2codech264enc.c
+++ b/sys/v4l2codecs/gstv4l2codech264enc.c
@@ -510,10 +510,12 @@ gst_v4l2_codec_h264_enc_subclass_init (GstV4l2CodecBaseEncClass * klass,
   gst_v4l2_codec_base_enc_install_device_properties (gobject_class, device);
 }
 
-void
+gboolean
 gst_v4l2_codec_h264_enc_register (GstPlugin * plugin, GstV4l2Encoder * encoder,
     GstV4l2CodecDevice * device, guint rank)
 {
+  gchar *name = NULL;
+  gboolean registered;
   guint version;
 
   GST_DEBUG_CATEGORY_INIT (v4l2_h264enc_debug, "v4l2codecs-h264enc", 0,
@@ -527,12 +529,17 @@ gst_v4l2_codec_h264_enc_register (GstPlugin * plugin, GstV4l2Encoder * encoder,
 
   if (!gst_v4l2_codec_h264_enc_api_check (encoder)) {
     GST_WARNING ("Not registering the H.264 encoder, it failed the API check");
-    return;
+    return FALSE;
   }
 
   gst_v4l2_encoder_register (plugin, GST_TYPE_V4L2_CODEC_H264_ENC,
       (GClassInitFunc) gst_v4l2_codec_h264_enc_subclass_init,
       gst_mini_object_ref (GST_MINI_OBJECT (device)),
       (GInstanceInitFunc) gst_v4l2_codec_h264_enc_subinit,
-      "v4l2sl%sh264enc", device, rank, NULL);
+      "v4l2sl%sh264enc", encoder, device, rank, &name);
+
+  registered = name != NULL;
+  g_free (name);
+
+  return registered;
 }
