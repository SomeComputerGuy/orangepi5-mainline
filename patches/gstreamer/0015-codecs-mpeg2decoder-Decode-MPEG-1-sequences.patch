From ea97aeec8fb2ab1c406d2c7de11f76c5370a556d Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 06:54:00 +0000
Subject: [PATCH 15/17] codecs: mpeg2decoder: Decode MPEG-1 sequences

An ISO/IEC 11172-2 (MPEG-1) bitstream is an MPEG-2 bitstream without
the extensions (ISO/IEC 13818-2 6.1.1.6: no sequence_extension() follows
the first sequence_header()). The base class required a sequence
extension and refused every picture of such a stream with "no sequence
before parsing picture header".

Treat a sequence without sequence extension as MPEG-1: mark it
progressive, call new_sequence() without a sequence extension (which is
already allowed to be NULL), and give the slices of each picture a
picture coding extension with the values ISO/IEC 13818-2 defines for
MPEG-1: frame pictures with frame_pred_frame_dct and progressive_frame
set, the forward and backward f_code in both components of f_code[0]
and f_code[1], everything else 0. The full pel vector flags stay in the
picture header, where the parser already puts them.

Subclasses only see MPEG-1 streams if their sink caps accept
mpegversion=1, so nothing changes for the existing ones.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 gst-libs/gst/codecs/gstmpeg2decoder.c | 34 +++++++++++++++++++++++++++
 gst-libs/gst/codecs/gstmpeg2decoder.h |  8 +++++--
 2 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/gst-libs/gst/codecs/gstmpeg2decoder.c b/gst-libs/gst/codecs/gstmpeg2decoder.c
index e9d2b76..63bf959 100644
--- a/gst-libs/gst/codecs/gstmpeg2decoder.c
+++ b/gst-libs/gst/codecs/gstmpeg2decoder.c
@@ -239,6 +239,8 @@ struct _GstMpeg2DecoderPrivate
   gint display_height;
   GstMpegVideoProfile profile;
   gboolean progressive;
+  /* ISO/IEC 11172-2 (MPEG-1) sequence: no sequence_extension() */
+  gboolean mpeg1;
 
   GstMpegVideoSequenceHdr seq_hdr;
   GstMpegVideoSequenceExt seq_ext;
@@ -532,6 +534,7 @@ gst_mpeg2_decoder_handle_sequence (GstMpeg2Decoder * decoder,
   priv->seq_display_ext = SEQ_DISPLAY_EXT_INIT;
   priv->seq_scalable_ext = SEQ_SCALABLE_EXT_INIT;
   priv->pic_ext = PIC_HDR_EXT_INIT;
+  priv->mpeg1 = FALSE;
 
   priv->seq_hdr = seq_hdr;
   priv->seq_changed = TRUE;
@@ -577,6 +580,7 @@ gst_mpeg2_decoder_handle_sequence_ext (GstMpeg2Decoder * decoder,
 
   priv->seq_ext = seq_ext;
   priv->seq_changed = TRUE;
+  priv->mpeg1 = FALSE;
 
   if (seq_ext.fps_n_ext && seq_ext.fps_d_ext) {
     guint fps_n = priv->tsg.fps_n;
@@ -765,6 +769,19 @@ gst_mpeg2_decoder_handle_picture (GstMpeg2Decoder * decoder,
 
   g_assert (klass->new_sequence);
 
+  /* 6.1.1.6: an ISO/IEC 11172-2 (MPEG-1) bitstream has no
+     sequence_extension() between the sequence_header() and the first
+     picture_header(). Decode it with the values ISO/IEC 13818-2 defines
+     for the absent extensions: a progressive 4:2:0 sequence of frame
+     pictures. Subclasses get no sequence extension in new_sequence(). */
+  if (_is_valid_state (decoder, GST_MPEG2_DECODER_STATE_GOT_SEQ_HDR) &&
+      !_is_valid_state (decoder, GST_MPEG2_DECODER_STATE_GOT_SEQ_EXT)) {
+    GST_DEBUG_OBJECT (decoder, "no sequence-extension, MPEG-1 sequence");
+    priv->mpeg1 = TRUE;
+    priv->progressive = TRUE;
+    priv->state |= GST_MPEG2_DECODER_STATE_GOT_SEQ_EXT;
+  }
+
   if (!_is_valid_state (decoder, GST_MPEG2_DECODER_STATE_VALID_SEQ_HEADERS)) {
     GST_ERROR_OBJECT (decoder, "no sequence before parsing picture header");
     return GST_FLOW_ERROR;
@@ -827,6 +844,23 @@ gst_mpeg2_decoder_handle_picture (GstMpeg2Decoder * decoder,
 
   priv->state |= GST_MPEG2_DECODER_STATE_GOT_PIC_HDR;
 
+  if (priv->mpeg1) {
+    /* MPEG-1 has no picture_coding_extension(): use the ISO/IEC 13818-2
+       values for MPEG-1 (frame picture, frame_pred_frame_dct, both
+       components of each f_code from forward_f_code/backward_f_code, all
+       other fields 0). The full pel flags stay in the picture header. */
+    GstMpegVideoPictureExt pic_ext = { {{0,},}, };
+
+    pic_ext.f_code[0][0] = pic_ext.f_code[0][1] = pic_hdr.f_code[0][0];
+    pic_ext.f_code[1][0] = pic_ext.f_code[1][1] = pic_hdr.f_code[1][0];
+    pic_ext.picture_structure = GST_MPEG_VIDEO_PICTURE_STRUCTURE_FRAME;
+    pic_ext.frame_pred_frame_dct = 1;
+    pic_ext.progressive_frame = 1;
+
+    priv->pic_ext = pic_ext;
+    priv->state |= GST_MPEG2_DECODER_STATE_GOT_PIC_EXT;
+  }
+
   return GST_FLOW_OK;
 }
 
diff --git a/gst-libs/gst/codecs/gstmpeg2decoder.h b/gst-libs/gst/codecs/gstmpeg2decoder.h
index 3fb35fc..dd8c944 100644
--- a/gst-libs/gst/codecs/gstmpeg2decoder.h
+++ b/gst-libs/gst/codecs/gstmpeg2decoder.h
@@ -72,11 +72,15 @@ struct _GstMpeg2DecoderClass
    * GstMpeg2DecoderClass::new_sequence:
    * @decoder: a #GstMpeg2Decoder
    * @seq: a #GstMpegVideoSequenceHdr
-   * @seq_ext: a #GstMpegVideoSequenceExt
+   * @seq_ext: a #GstMpegVideoSequenceExt, or %NULL for an ISO/IEC 11172-2
+   *   (MPEG-1) sequence, which has no sequence extension
    * @max_dpb_size: the size of dpb including preferred output delay
    *   by subclass reported via get_preferred_output_delay method.
    *
-   * Notifies subclass of SPS update
+   * Notifies subclass of SPS update. For MPEG-1 sequences the slices of each
+   * picture carry a picture coding extension filled with the values that
+   * ISO/IEC 13818-2 defines for MPEG-1; the MPEG-1 full pel vector flags are
+   * in the picture header.
    *
    * Since: 1.20
    */
-- 
