+static const struct
+{
+  gint n, d;
+} frame_rates[16] = {
+  {0, 1}, {24000, 1001}, {24, 1}, {25, 1}, {30000, 1001}, {30, 1}, {50, 1},
+  {60000, 1001}, {60, 1}, {100, 1}, {120, 1}, {200, 1}, {240, 1}, {300, 1},
+};
