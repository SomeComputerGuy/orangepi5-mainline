+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/*
+ * Bit reader for the headers of AVS1, AVS+ and AVS2 streams.
+ *
+ * Where an encoder would emulate a start code prefix in a header, the byte
+ * after two zero bytes reads 0x02 and its two least significant bits are
+ * stuffing (pseudo start code method, GB/T 20090.2 and GB/T 33475.2 annex).
+ * The reader skips those two bits. Reads past the end return zero bits and
+ * set @overrun.
+ */
+typedef struct
+{
+  const guint8 *data;
+  guint size;
+  guint byte;                   /* current byte */
+  guint bit;                    /* bits of it consumed, from the MSB */
+  guint nbits;                  /* bits of it that are data (8 or 6) */
+  guint zeros;                  /* zero bytes before the current byte */
+  gboolean overrun;
+} GstAvsBitReader;
+
+static inline void
+_gst_avs_bit_reader_load (GstAvsBitReader * br)
+{
+  br->bit = 0;
+  br->nbits = 8;
+  if (br->byte < br->size && br->zeros >= 2 && br->data[br->byte] == 0x02)
+    br->nbits = 6;
+}
+
+static inline void
+gst_avs_bit_reader_init (GstAvsBitReader * br, const guint8 * data,
+    guint size)
+{
+  br->data = data;
+  br->size = size;
+  br->byte = 0;
+  br->zeros = 0;
+  br->overrun = FALSE;
+  _gst_avs_bit_reader_load (br);
+}
+
+static inline guint
+gst_avs_bit_reader_get_bit (GstAvsBitReader * br)
+{
+  guint v;
+
+  if (br->byte >= br->size) {
+    br->overrun = TRUE;
+    return 0;
+  }
+
+  v = (br->data[br->byte] >> (7 - br->bit)) & 1;
+  if (++br->bit == br->nbits) {
+    if (br->nbits == 6)
+      br->zeros = 0;
+    else
+      br->zeros = br->data[br->byte] ? 0 : br->zeros + 1;
+    br->byte++;
+    _gst_avs_bit_reader_load (br);
+  }
+
+  return v;
+}
+
+static inline guint32
+gst_avs_bit_reader_get (GstAvsBitReader * br, guint n)
+{
+  guint32 v = 0;
+
+  while (n--)
+    v = (v << 1) | gst_avs_bit_reader_get_bit (br);
+
+  return v;
+}
+
+static inline guint32
+gst_avs_bit_reader_peek (const GstAvsBitReader * br, guint n)
+{
+  GstAvsBitReader copy = *br;
+
+  return gst_avs_bit_reader_get (&copy, n);
+}
+
+static inline guint32
+gst_avs_bit_reader_get_ue (GstAvsBitReader * br)
+{
+  guint lz = 0;
+
+  while (!gst_avs_bit_reader_get_bit (br)) {
+    if (br->overrun || ++lz > 31) {
+      br->overrun = TRUE;
+      return 0;
+    }
+  }
+
+  return ((1u << lz) - 1) + gst_avs_bit_reader_get (br, lz);
+}
+
+static inline gint32
+gst_avs_bit_reader_get_se (GstAvsBitReader * br)
+{
+  guint32 v = gst_avs_bit_reader_get_ue (br);
+
+  return (v & 1) ? (gint32) ((v + 1) / 2) : -(gint32) (v / 2);
+}
+
+static inline guint
+gst_avs_bit_reader_bits_left (const GstAvsBitReader * br)
+{
+  if (br->byte >= br->size)
+    return 0;
+  /* ignores stuffing further on, which only matters at the very end */
+  return (br->size - br->byte) * 8 - br->bit;
+}
+
+G_END_DECLS
