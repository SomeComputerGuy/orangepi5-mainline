+#pragma once
+
+#ifndef GST_USE_UNSTABLE_API
+#warning "The AVS parsing library is unstable API and may change in future."
+#warning "You can define GST_USE_UNSTABLE_API to avoid this warning."
+#endif
+
+#include <gst/gst.h>
+#include <gst/codecparsers/codecparsers-prelude.h>
+
+G_BEGIN_DECLS
+
+/**
+ * GstAvsStartCode:
+ * @GST_AVS_START_CODE_SLICE_MAX: the highest slice start code, slices use
+ *   0x00 to 0xaf (slice_vertical_position)
+ * @GST_AVS_START_CODE_SEQUENCE: video_sequence_start_code
+ * @GST_AVS_START_CODE_SEQUENCE_END: video_sequence_end_code
+ * @GST_AVS_START_CODE_USER_DATA: user_data_start_code
+ * @GST_AVS_START_CODE_I_PICTURE: i_picture_start_code
+ * @GST_AVS_START_CODE_EXTENSION: extension_start_code
+ * @GST_AVS_START_CODE_PB_PICTURE: pb_picture_start_code
+ * @GST_AVS_START_CODE_VIDEO_EDIT: video_edit_code
+ *
+ * The start code values of GB/T 20090.2 (AVS1) and GY/T 257.1 (AVS+).
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS_START_CODE_SLICE_MAX = 0xaf,
+  GST_AVS_START_CODE_SEQUENCE = 0xb0,
+  GST_AVS_START_CODE_SEQUENCE_END = 0xb1,
+  GST_AVS_START_CODE_USER_DATA = 0xb2,
+  GST_AVS_START_CODE_I_PICTURE = 0xb3,
+  GST_AVS_START_CODE_EXTENSION = 0xb5,
+  GST_AVS_START_CODE_PB_PICTURE = 0xb6,
+  GST_AVS_START_CODE_VIDEO_EDIT = 0xb7,
+} GstAvsStartCode;
+
+/**
+ * GstAvsProfile:
+ * @GST_AVS_PROFILE_JIZHUN: the JiZhun (base) profile of AVS1
+ * @GST_AVS_PROFILE_GUANGDIAN: the Guangdian (broadcast) profile, AVS+
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS_PROFILE_JIZHUN = 0x20,
+  GST_AVS_PROFILE_GUANGDIAN = 0x48,
+} GstAvsProfile;
+
+/**
+ * GstAvsPictureType:
+ * @GST_AVS_PICTURE_TYPE_I: intra picture
+ * @GST_AVS_PICTURE_TYPE_P: predicted picture
+ * @GST_AVS_PICTURE_TYPE_B: bi-predicted picture
+ *
+ * The picture_coding_type values; I pictures have their own start code.
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS_PICTURE_TYPE_I = 0,
+  GST_AVS_PICTURE_TYPE_P = 1,
+  GST_AVS_PICTURE_TYPE_B = 2,
+} GstAvsPictureType;
+
+/**
+ * GstAvsParserResult:
+ * @GST_AVS_PARSER_OK: the parsing succeeded
+ * @GST_AVS_PARSER_ERROR: the data is not valid
+ * @GST_AVS_PARSER_NO_PACKET: no start code was found
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS_PARSER_OK,
+  GST_AVS_PARSER_ERROR,
+  GST_AVS_PARSER_NO_PACKET,
+} GstAvsParserResult;
+
+typedef struct _GstAvsPacket GstAvsPacket;
+typedef struct _GstAvsSequenceHeader GstAvsSequenceHeader;
+typedef struct _GstAvsPictureHeader GstAvsPictureHeader;
+
+/**
+ * GstAvsPacket:
+ * @data: the data the packet was found in
+ * @type: the start code value, see #GstAvsStartCode
+ * @offset: offset in @data of the first byte after the start code
+ * @size: size of the packet after its start code, up to the next start
+ *   code or the end of the data
+ *
+ * A unit of an AVS1 or AVS+ elementary stream: a start code and the data
+ * up to the next start code.
+ *
+ * Since: 1.30
+ */
+struct _GstAvsPacket
+{
+  const guint8 *data;
+  guint8 type;
+  guint offset;
+  gint size;
+};
+
+/**
+ * GstAvsSequenceHeader:
+ * @profile_id: profile_id, see #GstAvsProfile
+ * @level_id: level_id
+ * @progressive_sequence: progressive_sequence
+ * @horizontal_size: horizontal_size, the width in luma samples
+ * @vertical_size: vertical_size, the height in luma samples
+ * @chroma_format: chroma_format, 1 for 4:2:0
+ * @sample_precision: sample_precision, 1 for 8-bit samples
+ * @aspect_ratio: aspect_ratio
+ * @frame_rate_code: frame_rate_code
+ * @bit_rate: the bit rate in units of 400 bit/s, from bit_rate_lower and
+ *   bit_rate_upper
+ * @low_delay: low_delay
+ * @bbv_buffer_size: bbv_buffer_size
+ * @fps_n: frame rate numerator of @frame_rate_code, 0 if unknown
+ * @fps_d: frame rate denominator of @frame_rate_code
+ *
+ * The video_sequence_header() of GB/T 20090.2 section 7.1.2.2.
+ *
+ * Since: 1.30
+ */
+struct _GstAvsSequenceHeader
+{
+  guint8 profile_id;
+  guint8 level_id;
+  guint8 progressive_sequence;
+  guint16 horizontal_size;
+  guint16 vertical_size;
+  guint8 chroma_format;
+  guint8 sample_precision;
+  guint8 aspect_ratio;
+  guint8 frame_rate_code;
+  guint32 bit_rate;
+  guint8 low_delay;
+  guint32 bbv_buffer_size;
+
+  gint fps_n;
+  gint fps_d;
+};
+
+/**
+ * GstAvsPictureHeader:
+ * @picture_type: see #GstAvsPictureType
+ * @time_code_flag: time_code_flag of I pictures
+ * @time_code: time_code of I pictures
+ * @picture_distance: picture_distance
+ * @progressive_frame: progressive_frame
+ * @picture_structure: picture_structure, 1 for a frame coded picture
+ * @advanced_pred_mode_disable: advanced_pred_mode_disable
+ * @top_field_first: top_field_first
+ * @repeat_first_field: repeat_first_field
+ * @fixed_picture_qp: fixed_picture_qp
+ * @picture_qp: picture_qp
+ * @skip_mode_flag: skip_mode_flag
+ * @picture_reference_flag: picture_reference_flag of P and B pictures, 1
+ *   when not coded (frame coded B pictures)
+ * @no_forward_reference_flag: no_forward_reference_flag (AVS+ only)
+ * @pb_field_enhanced_flag: pb_field_enhanced_flag (AVS+ only)
+ * @loop_filter_disable: loop_filter_disable
+ * @loop_filter_parameter_flag: loop_filter_parameter_flag
+ * @alpha_c_offset: alpha_c_offset
+ * @beta_offset: beta_offset
+ * @weighting_quant_flag: weighting_quant_flag (AVS+ only)
+ * @chroma_quant_param_disable: chroma_quant_param_disable
+ * @chroma_quant_param_delta_cb: chroma_quant_param_delta_cb
+ * @chroma_quant_param_delta_cr: chroma_quant_param_delta_cr
+ * @weighting_quant_param_index: weighting_quant_param_index
+ * @weighting_quant_model: weighting_quant_model
+ * @weighting_quant_param_delta1: weighting_quant_param_delta1
+ * @weighting_quant_param_delta2: weighting_quant_param_delta2
+ * @aec_enable: aec_enable (AVS+ only)
+ * @header_size: size in bytes of the picture header packet, its start code
+ *   excluded
+ *
+ * The i_picture_header() and pb_picture_header() of GB/T 20090.2 sections
+ * 7.1.3.1 and 7.1.3.2, with the AVS+ (GY/T 257.1) additions.
+ *
+ * Since: 1.30
+ */
+struct _GstAvsPictureHeader
+{
+  GstAvsPictureType picture_type;
+  guint8 time_code_flag;
+  guint32 time_code;
+  guint8 picture_distance;
+  guint8 progressive_frame;
+  guint8 picture_structure;
+  guint8 advanced_pred_mode_disable;
+  guint8 top_field_first;
+  guint8 repeat_first_field;
+  guint8 fixed_picture_qp;
+  guint8 picture_qp;
+  guint8 skip_mode_flag;
+  guint8 picture_reference_flag;
+  guint8 no_forward_reference_flag;
+  guint8 pb_field_enhanced_flag;
+  guint8 loop_filter_disable;
+  guint8 loop_filter_parameter_flag;
+  gint8 alpha_c_offset;
+  gint8 beta_offset;
+  guint8 weighting_quant_flag;
+  guint8 chroma_quant_param_disable;
+  gint8 chroma_quant_param_delta_cb;
+  gint8 chroma_quant_param_delta_cr;
+  guint8 weighting_quant_param_index;
+  guint8 weighting_quant_model;
+  gint16 weighting_quant_param_delta1[6];
+  gint16 weighting_quant_param_delta2[6];
+  guint8 aec_enable;
+
+  guint header_size;
+};
+
+GST_CODEC_PARSERS_API
+GstAvsParserResult gst_avs_parse (GstAvsPacket * packet,
+                                  const guint8 * data,
+                                  gsize size,
+                                  guint offset);
+
