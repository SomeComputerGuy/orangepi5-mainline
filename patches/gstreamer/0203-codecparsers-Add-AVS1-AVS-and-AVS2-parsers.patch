+ * Boston, MA 02110-1301, USA.
+ */
+
+
+#pragma once
+
+#ifndef GST_USE_UNSTABLE_API
+#warning "The AVS2 parsing library is unstable API and may change in future."
+#warning "You can define GST_USE_UNSTABLE_API to avoid this warning."
+#endif
+
+#include <gst/gst.h>
+#include <gst/codecparsers/codecparsers-prelude.h>
+
+G_BEGIN_DECLS
+
+#define GST_AVS2_MAX_RCS              32
+#define GST_AVS2_MAX_REFS             7
+#define GST_AVS2_ALF_MAX_FILTERS      16
+#define GST_AVS2_ALF_NUM_COEFFS       9
+
+/**
+ * GstAvs2StartCode:
+ * @GST_AVS2_START_CODE_SLICE_MAX: the highest slice start code, slices use
+ *   0x00 to 0x8f
+ * @GST_AVS2_START_CODE_SEQUENCE: video_sequence_start_code
+ * @GST_AVS2_START_CODE_SEQUENCE_END: video_sequence_end_code
+ * @GST_AVS2_START_CODE_USER_DATA: user_data_start_code
+ * @GST_AVS2_START_CODE_INTRA_PICTURE: intra_picture_start_code
+ * @GST_AVS2_START_CODE_EXTENSION: extension_start_code
+ * @GST_AVS2_START_CODE_INTER_PICTURE: inter_picture_start_code
+ * @GST_AVS2_START_CODE_VIDEO_EDIT: video_edit_code
+ *
+ * The start code values of GB/T 33475.2 (AVS2).
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS2_START_CODE_SLICE_MAX = 0x8f,
+  GST_AVS2_START_CODE_SEQUENCE = 0xb0,
+  GST_AVS2_START_CODE_SEQUENCE_END = 0xb1,
+  GST_AVS2_START_CODE_USER_DATA = 0xb2,
+  GST_AVS2_START_CODE_INTRA_PICTURE = 0xb3,
+  GST_AVS2_START_CODE_EXTENSION = 0xb5,
+  GST_AVS2_START_CODE_INTER_PICTURE = 0xb6,
+  GST_AVS2_START_CODE_VIDEO_EDIT = 0xb7,
+} GstAvs2StartCode;
+
+/**
+ * GstAvs2Profile:
+ * @GST_AVS2_PROFILE_MAIN_PICTURE: the main picture profile
+ * @GST_AVS2_PROFILE_MAIN: the main profile
+ * @GST_AVS2_PROFILE_MAIN10: the main 10 profile
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS2_PROFILE_MAIN_PICTURE = 0x12,
+  GST_AVS2_PROFILE_MAIN = 0x20,
+  GST_AVS2_PROFILE_MAIN10 = 0x22,
+} GstAvs2Profile;
+
+/**
+ * GstAvs2PictureType:
+ * @GST_AVS2_PICTURE_TYPE_I: intra picture, G or GB for a background picture
+ * @GST_AVS2_PICTURE_TYPE_P: forward predicted picture, S with background_pred
+ * @GST_AVS2_PICTURE_TYPE_B: bi-predicted picture
+ * @GST_AVS2_PICTURE_TYPE_F: forward multi-hypothesis predicted picture
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS2_PICTURE_TYPE_I = 0,
+  GST_AVS2_PICTURE_TYPE_P = 1,
+  GST_AVS2_PICTURE_TYPE_B = 2,
+  GST_AVS2_PICTURE_TYPE_F = 3,
+} GstAvs2PictureType;
+
+/**
+ * GstAvs2ParserResult:
+ * @GST_AVS2_PARSER_OK: the parsing succeeded
+ * @GST_AVS2_PARSER_ERROR: the data is not valid
+ * @GST_AVS2_PARSER_NO_PACKET: no start code was found
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_AVS2_PARSER_OK,
+  GST_AVS2_PARSER_ERROR,
+  GST_AVS2_PARSER_NO_PACKET,
+} GstAvs2ParserResult;
+
+typedef struct _GstAvs2Packet GstAvs2Packet;
+typedef struct _GstAvs2Rcs GstAvs2Rcs;
+typedef struct _GstAvs2SequenceHeader GstAvs2SequenceHeader;
+typedef struct _GstAvs2AlfParams GstAvs2AlfParams;
+typedef struct _GstAvs2PictureHeader GstAvs2PictureHeader;
+
+/**
+ * GstAvs2Packet:
+ * @data: the data the packet was found in
+ * @type: the start code value, see #GstAvs2StartCode
+ * @offset: offset in @data of the first byte after the start code
+ * @size: size of the packet after its start code, up to the next start
+ *   code or the end of the data
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2Packet
+{
+  const guint8 *data;
+  guint8 type;
+  guint offset;
+  gint size;
+};
+
+/**
+ * GstAvs2Rcs:
+ * @refered_by_others: refered_by_others_flag
+ * @num_of_reference_picture: num_of_reference_picture
+ * @delta_doi_of_reference_picture: delta_doi_of_reference_picture[]
+ * @num_of_removed_picture: num_of_removed_picture
+ * @delta_doi_of_removed_picture: delta_doi_of_removed_picture[]
+ *
+ * A reference_configuration_set(), GB/T 33475.2 section 7.1.2.3.
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2Rcs
+{
+  guint8 refered_by_others;
+  guint8 num_of_reference_picture;
+  guint8 delta_doi_of_reference_picture[GST_AVS2_MAX_REFS];
+  guint8 num_of_removed_picture;
+  guint8 delta_doi_of_removed_picture[GST_AVS2_MAX_REFS];
+};
+
+/**
+ * GstAvs2SequenceHeader:
+ *
+ * The sequence_header() of GB/T 33475.2 section 7.1.2.2. @wqm holds
+ * WeightQuantMatrix4x4 (@wqm[0], 16 entries) and WeightQuantMatrix8x8
+ * (@wqm[1]) of the sequence in raster order, the defaults when not loaded.
+ * @background_picture_enable is the inverse of background_picture_disable.
+ * @encoding_precision is 1 for profiles without it. @fps_n and @fps_d are
+ * the frame rate of @frame_rate_code, @fps_n is 0 if unknown.
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2SequenceHeader
+{
+  guint8 profile_id;
+  guint8 level_id;
+  guint8 progressive_sequence;
+  guint8 field_coded_sequence;
+  guint16 horizontal_size;
+  guint16 vertical_size;
+  guint8 chroma_format;
+  guint8 sample_precision;
+  guint8 encoding_precision;
+  guint8 aspect_ratio;
+  guint8 frame_rate_code;
+  guint32 bit_rate;
+  guint8 low_delay;
+  guint8 temporal_id_enable;
+  guint32 bbv_buffer_size;
+  guint8 lcu_size;
+  guint8 weight_quant_enable;
+  guint8 wqm[2][64];
+  guint8 background_picture_enable;
+  guint8 mhp_skip_enable;
+  guint8 dhp_enable;
+  guint8 wsm_enable;
+  guint8 amp_enable;
+  guint8 nsqt_enable;
+  guint8 nsip_enable;
+  guint8 secondary_transform_enable;
+  guint8 sao_enable;
+  guint8 alf_enable;
+  guint8 pmvr_enable;
+  guint8 num_of_rcs;
+  GstAvs2Rcs rcs[GST_AVS2_MAX_RCS];
+  guint8 picture_reorder_delay;
+  guint8 cross_slice_loopfilter_enable;
+  guint8 bcbr_enable;
+
+  gint fps_n;
+  gint fps_d;
+};
+
+/**
+ * GstAvs2AlfParams:
+ * @enable: picture_alf_enable_flag[] of Y, Cb and Cr
+ * @num_luma_filters: alf_filter_num_minus1 + 1
+ * @luma_coeff: alf_coeff_luma[][]
+ * @chroma_coeff: alf_coeff_chroma[][] of Cb and Cr
+ * @region_filter: the luma filter of each of the 16 regions, derived from
+ *   alf_region_distance[]
+ *
+ * The alf_parameter_set() of GB/T 33475.2 section 7.1.8.
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2AlfParams
+{
+  guint8 enable[3];
+  guint8 num_luma_filters;
+  gint16 luma_coeff[GST_AVS2_ALF_MAX_FILTERS][GST_AVS2_ALF_NUM_COEFFS];
+  gint16 chroma_coeff[2][GST_AVS2_ALF_NUM_COEFFS];
+  guint8 region_filter[16];
+};
+
+/**
+ * GstAvs2PictureHeader:
+ *
+ * The intra_picture_header() or inter_picture_header() of GB/T 33475.2
+ * sections 7.1.3.1 and 7.1.3.2. @picture_type is %GST_AVS2_PICTURE_TYPE_I
+ * for an intra picture header. @rcs is the reference configuration set of
+ * the picture, copied from the sequence header when the picture refers to
+ * one. @output_delay_present is set when picture_output_delay is coded.
+ * @wqm holds the weighting quantization matrices that apply to the picture,
+ * resolved from the sequence and picture headers, all 64 when weighting
+ * quantization is off for the picture. @header_size is the size in bytes of
+ * the picture header packet, its start code excluded.
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2PictureHeader
+{
+  GstAvs2PictureType picture_type;
+  guint8 background_picture;
+  guint8 background_picture_output;
+  guint8 background_pred;
+  guint8 background_reference;
+  guint8 decode_order_index;
+  guint8 temporal_id;
+  guint8 output_delay_present;
+  guint8 picture_output_delay;
+  GstAvs2Rcs rcs;
+  guint8 progressive_frame;
+  guint8 picture_structure;
+  guint8 top_field_first;
+  guint8 repeat_first_field;
+  guint8 is_top_field;
+  guint8 fixed_picture_qp;
+  guint8 picture_qp;
+  guint8 random_access_decodable;
+  guint8 loop_filter_disable;
+  gint8 alpha_c_offset;
+  gint8 beta_offset;
+  gint8 chroma_quant_param_delta_cb;
+  gint8 chroma_quant_param_delta_cr;
+  guint8 weight_quant_enable;
+  guint8 wqm[2][64];
+  GstAvs2AlfParams alf;
+
+  guint header_size;
+};
+
+GST_CODEC_PARSERS_API
+GstAvs2ParserResult gst_avs2_parse (GstAvs2Packet * packet,
+                                    const guint8 * data,
+                                    gsize size,
+                                    guint offset);
+
+GST_CODEC_PARSERS_API
+GstAvs2ParserResult gst_avs2_parse_sequence_header (const GstAvs2Packet * packet,
+                                                    GstAvs2SequenceHeader * seq);
+
+GST_CODEC_PARSERS_API
+GstAvs2ParserResult gst_avs2_parse_picture_header (const GstAvs2Packet * packet,
+                                                   const GstAvs2SequenceHeader * seq,
+                                                   GstAvs2PictureHeader * pic);
+
+G_END_DECLS
