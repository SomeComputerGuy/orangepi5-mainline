+
+/**
+ * SECTION:gstavsparser
+ * @title: GstAvsParser
+ * @short_description: Convenience library for parsing AVS1 and AVS+ video
+ * bitstreams.
+ *
+ * Parses the start code units, the sequence header and the picture headers
+ * of AVS1 (GB/T 20090.2, JiZhun profile) and AVS+ (GY/T 257.1, Guangdian
+ * profile) elementary streams.
+ *
+ * Since: 1.30
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "gstavsparser.h"
+#include "gstavsbitreader-private.h"
+
+#include <gst/base/gstbytereader.h>
+
+#ifndef GST_DISABLE_GST_DEBUG
+#define GST_CAT_DEFAULT gst_avs_debug_category_get ()
+static GstDebugCategory *
+gst_avs_debug_category_get (void)
+{
+  static gsize cat_gonce = 0;
+
+  if (g_once_init_enter (&cat_gonce)) {
+    GstDebugCategory *cat = NULL;
+
+    GST_DEBUG_CATEGORY_INIT (cat, "codecparsers_avs", 0, "avs parser library");
+
+    g_once_init_leave (&cat_gonce, (gsize) cat);
+  }
+
+  return (GstDebugCategory *) cat_gonce;
+}
+#endif /* GST_DISABLE_GST_DEBUG */
+
+/* the headers are short, the start of a unit is enough to parse them */
+#define MAX_HEADER_SIZE 256
+
+static const struct
+{
+  gint n, d;
+} frame_rates[16] = {
+  {0, 1}, {24000, 1001}, {24, 1}, {25, 1}, {30000, 1001}, {30, 1}, {50, 1},
+  {60000, 1001}, {60, 1},
+};
+
+/**
+ * gst_avs_parse:
+ * @packet: (out): the #GstAvsPacket to fill
+ * @data: the data to parse
+ * @size: the size of @data
+ * @offset: the offset in @data from which to look for a start code
+ *
+ * Finds the next start code in @data from @offset and fills @packet with
+ * its type, the offset of the data after it and, if a further start code
+ * follows, its size.
+ *
+ * Returns: %GST_AVS_PARSER_OK if a start code was found.
+ *
+ * Since: 1.30
+ */
+GstAvsParserResult
+gst_avs_parse (GstAvsPacket * packet, const guint8 * data, gsize size,
+    guint offset)
+{
+  GstByteReader br;
+  gint off;
+
+  g_return_val_if_fail (packet != NULL, GST_AVS_PARSER_ERROR);
+
+  if (size <= offset + 3)
+    return GST_AVS_PARSER_NO_PACKET;
+
+  gst_byte_reader_init (&br, data, size);
+  off = gst_byte_reader_masked_scan_uint32 (&br, 0xffffff00, 0x00000100,
+      offset, size - offset);
+  if (off < 0)
+    return GST_AVS_PARSER_NO_PACKET;
+
+  packet->data = data;
+  packet->type = data[off + 3];
+  packet->offset = off + 4;
+  packet->size = size - packet->offset;
+
+  if (size > packet->offset + 3) {
+    off = gst_byte_reader_masked_scan_uint32 (&br, 0xffffff00, 0x00000100,
+        packet->offset, size - packet->offset);
+    if (off >= 0)
+      packet->size = off - packet->offset;
+  }
+
+  return GST_AVS_PARSER_OK;
+}
+
+static guint
+packet_size (const GstAvsPacket * packet)
+{
+  return MIN (packet->size, MAX_HEADER_SIZE);
+}
+
+/**
+ * gst_avs_parse_sequence_header:
+ * @packet: a #GstAvsPacket of type %GST_AVS_START_CODE_SEQUENCE
+ * @seq: (out): the #GstAvsSequenceHeader to fill
+ *
+ * Returns: %GST_AVS_PARSER_OK if the sequence header was parsed.
+ *
+ * Since: 1.30
+ */
+GstAvsParserResult
+gst_avs_parse_sequence_header (const GstAvsPacket * packet,
+    GstAvsSequenceHeader * seq)
+{
+  GstAvsBitReader br;
+  guint32 lower, upper;
+
+  g_return_val_if_fail (packet != NULL, GST_AVS_PARSER_ERROR);
+  g_return_val_if_fail (seq != NULL, GST_AVS_PARSER_ERROR);
+
+  if (packet->type != GST_AVS_START_CODE_SEQUENCE)
+    return GST_AVS_PARSER_ERROR;
+
+  gst_avs_bit_reader_init (&br, packet->data + packet->offset,
+      packet_size (packet));
+
+  memset (seq, 0, sizeof (*seq));
+  seq->profile_id = gst_avs_bit_reader_get (&br, 8);
+  seq->level_id = gst_avs_bit_reader_get (&br, 8);
+  seq->progressive_sequence = gst_avs_bit_reader_get (&br, 1);
+  seq->horizontal_size = gst_avs_bit_reader_get (&br, 14);
+  seq->vertical_size = gst_avs_bit_reader_get (&br, 14);
+  seq->chroma_format = gst_avs_bit_reader_get (&br, 2);
+  seq->sample_precision = gst_avs_bit_reader_get (&br, 3);
+  seq->aspect_ratio = gst_avs_bit_reader_get (&br, 4);
+  seq->frame_rate_code = gst_avs_bit_reader_get (&br, 4);
+  lower = gst_avs_bit_reader_get (&br, 18);
+  gst_avs_bit_reader_get (&br, 1);      /* marker_bit */
+  upper = gst_avs_bit_reader_get (&br, 12);
+  seq->bit_rate = (upper << 18) | lower;
+  seq->low_delay = gst_avs_bit_reader_get (&br, 1);
+  gst_avs_bit_reader_get (&br, 1);      /* marker_bit */
+  seq->bbv_buffer_size = gst_avs_bit_reader_get (&br, 18);
+
+  if (br.overrun) {
+    GST_WARNING ("sequence header too short");
+    return GST_AVS_PARSER_ERROR;
+  }
+
+  if (!seq->horizontal_size || !seq->vertical_size) {
+    GST_WARNING ("invalid size %ux%u", seq->horizontal_size,
+        seq->vertical_size);
+    return GST_AVS_PARSER_ERROR;
+  }
+
+  seq->fps_n = frame_rates[seq->frame_rate_code].n;
+  seq->fps_d = frame_rates[seq->frame_rate_code].d;
+
+  GST_LOG ("profile 0x%02x level 0x%02x %ux%u progressive %u low_delay %u",
+      seq->profile_id, seq->level_id, seq->horizontal_size,
+      seq->vertical_size, seq->progressive_sequence, seq->low_delay);
+
+  return GST_AVS_PARSER_OK;
+}
+
+static gboolean
+is_guangdian (const GstAvsSequenceHeader * seq)
+{
+  return seq->profile_id == GST_AVS_PROFILE_GUANGDIAN;
+}
+
+/**
+ * gst_avs_parse_picture_header:
+ * @packet: a #GstAvsPacket of type %GST_AVS_START_CODE_I_PICTURE or
+ *   %GST_AVS_START_CODE_PB_PICTURE
+ * @seq: the active #GstAvsSequenceHeader
+ * @final_revision: (inout): whether the stream follows the final revision
+ *   of the standard, which has a marker bit after the time_code of I
+ *   pictures; start with %FALSE for a new stream
+ * @pic: (out): the #GstAvsPictureHeader to fill
+ *
+ * Streams of a pre-final revision of GB/T 20090.2 have no marker bit after
+ * time_code. Those streams are progressive, have no low_delay and code
+ * top_field_first and repeat_first_field as 0, which tells them apart; once
+ * a final revision I picture header is seen, @final_revision stays set.
+ *
+ * Returns: %GST_AVS_PARSER_OK if the picture header was parsed.
+ *
+ * Since: 1.30
+ */
+GstAvsParserResult
+gst_avs_parse_picture_header (const GstAvsPacket * packet,
+    const GstAvsSequenceHeader * seq, gboolean * final_revision,
+    GstAvsPictureHeader * pic)
+{
+  GstAvsBitReader br;
+  gboolean pb, guangdian;
+  guint i;
+
+  g_return_val_if_fail (packet != NULL, GST_AVS_PARSER_ERROR);
+  g_return_val_if_fail (seq != NULL, GST_AVS_PARSER_ERROR);
+  g_return_val_if_fail (final_revision != NULL, GST_AVS_PARSER_ERROR);
+  g_return_val_if_fail (pic != NULL, GST_AVS_PARSER_ERROR);
+
+  if (packet->type == GST_AVS_START_CODE_PB_PICTURE)
+    pb = TRUE;
+  else if (packet->type == GST_AVS_START_CODE_I_PICTURE)
+    pb = FALSE;
+  else
+    return GST_AVS_PARSER_ERROR;
+
+  guangdian = is_guangdian (seq);
+  gst_avs_bit_reader_init (&br, packet->data + packet->offset,
+      packet_size (packet));
+  memset (pic, 0, sizeof (*pic));
+
+  gst_avs_bit_reader_get (&br, 16);     /* bbv_delay */
+  if (guangdian)
+    gst_avs_bit_reader_get (&br, 8);    /* marker_bit, bbv_delay_extension */
+
+  if (pb) {
+    pic->picture_type = gst_avs_bit_reader_get (&br, 2);
+    if (pic->picture_type != GST_AVS_PICTURE_TYPE_P &&
+        pic->picture_type != GST_AVS_PICTURE_TYPE_B) {
+      GST_WARNING ("invalid picture_coding_type %u", pic->picture_type);
+      return GST_AVS_PARSER_ERROR;
+    }
+  } else {
+    pic->picture_type = GST_AVS_PICTURE_TYPE_I;
+    pic->time_code_flag = gst_avs_bit_reader_get (&br, 1);
+    if (pic->time_code_flag)
+      pic->time_code = gst_avs_bit_reader_get (&br, 24);
+    if (guangdian || seq->low_delay || !(gst_avs_bit_reader_peek (&br, 9) & 1)
+        || (gst_avs_bit_reader_peek (&br, 11) & 3))
+      *final_revision = TRUE;
+    if (*final_revision)
+      gst_avs_bit_reader_get (&br, 1);  /* marker_bit */
+  }
+
+  pic->picture_distance = gst_avs_bit_reader_get (&br, 8);
+  if (seq->low_delay)
+    gst_avs_bit_reader_get_ue (&br);    /* bbv_check_times */
+  pic->progressive_frame = gst_avs_bit_reader_get (&br, 1);
+  pic->picture_structure = 1;
+  if (!pic->progressive_frame) {
+    pic->picture_structure = gst_avs_bit_reader_get (&br, 1);
+    if (pb && !pic->picture_structure)
+      pic->advanced_pred_mode_disable = gst_avs_bit_reader_get (&br, 1);
+  }
+  pic->top_field_first = gst_avs_bit_reader_get (&br, 1);
+  pic->repeat_first_field = gst_avs_bit_reader_get (&br, 1);
+  pic->fixed_picture_qp = gst_avs_bit_reader_get (&br, 1);
+  pic->picture_qp = gst_avs_bit_reader_get (&br, 6);
+
+  if (!pb) {
+    if (!pic->picture_structure)
+      pic->skip_mode_flag = gst_avs_bit_reader_get (&br, 1);
+    gst_avs_bit_reader_get (&br, 4);    /* reserved_bits */
+  } else {
+    pic->picture_reference_flag = 1;
+    if (!(pic->picture_type == GST_AVS_PICTURE_TYPE_B &&
+            pic->picture_structure))
+      pic->picture_reference_flag = gst_avs_bit_reader_get (&br, 1);
+    pic->no_forward_reference_flag = gst_avs_bit_reader_get (&br, 1);
+    pic->pb_field_enhanced_flag = gst_avs_bit_reader_get (&br, 1);
+    if (!guangdian) {
+      /* reserved bits in the JiZhun profile */
+      pic->no_forward_reference_flag = 0;
+      pic->pb_field_enhanced_flag = 0;
+    }
+    gst_avs_bit_reader_get (&br, 2);    /* reserved_bits */
+    pic->skip_mode_flag = gst_avs_bit_reader_get (&br, 1);
+  }
+
+  pic->loop_filter_disable = gst_avs_bit_reader_get (&br, 1);
+  if (!pic->loop_filter_disable) {
+    pic->loop_filter_parameter_flag = gst_avs_bit_reader_get (&br, 1);
+    if (pic->loop_filter_parameter_flag) {
+      pic->alpha_c_offset = gst_avs_bit_reader_get_se (&br);
+      pic->beta_offset = gst_avs_bit_reader_get_se (&br);
+    }
+  }
+
+  if (guangdian) {
+    pic->weighting_quant_flag = gst_avs_bit_reader_get (&br, 1);
+    if (pic->weighting_quant_flag) {
+      pic->chroma_quant_param_disable = gst_avs_bit_reader_get (&br, 1);
+      if (!pic->chroma_quant_param_disable) {
+        pic->chroma_quant_param_delta_cb = gst_avs_bit_reader_get_se (&br);
+        pic->chroma_quant_param_delta_cr = gst_avs_bit_reader_get_se (&br);
+      }
+      pic->weighting_quant_param_index = gst_avs_bit_reader_get (&br, 2);
+      pic->weighting_quant_model = gst_avs_bit_reader_get (&br, 2);
+      if (pic->weighting_quant_param_index == 1) {
+        for (i = 0; i < 6; i++)
+          pic->weighting_quant_param_delta1[i] =
+              gst_avs_bit_reader_get_se (&br);
+      } else if (pic->weighting_quant_param_index == 2) {
+        for (i = 0; i < 6; i++)
+          pic->weighting_quant_param_delta2[i] =
+              gst_avs_bit_reader_get_se (&br);
+      }
+    }
+    pic->aec_enable = gst_avs_bit_reader_get (&br, 1);
+  }
+
+  if (br.overrun) {
+    GST_WARNING ("picture header too short");
+    return GST_AVS_PARSER_ERROR;
+  }
+
+  pic->header_size = packet->size;
+
+  GST_LOG ("%c picture distance %u structure %u qp %u",
+      "IPB"[pic->picture_type], pic->picture_distance,
+      pic->picture_structure, pic->picture_qp);
+
+  return GST_AVS_PARSER_OK;
+}
