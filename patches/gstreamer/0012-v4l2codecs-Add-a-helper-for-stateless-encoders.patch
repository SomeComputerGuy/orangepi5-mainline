From 9fa582d07b526ca44cb67cc0d43f92dfdf900579 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 06:29:59 +0000
Subject: [PATCH] v4l2codecs: Add a helper for stateless encoders

GstV4l2Encoder is the encoder counterpart of GstV4l2Decoder: it opens the
media and video devices, sets the coded (CAPTURE) and picture (OUTPUT)
formats, allocates the bitstream buffers, queues one media request per
picture and waits for it to complete. Pictures are queued as dma-bufs: the
encoder's own buffers are exported once and the OUTPUT queue then switched
to DMABUF memory, so that upstream dma-bufs with the driver's layout are
imported without a copy, and everything else is copied into the encoder's
buffers.

The raw formats of the encoders are kept in a table of their own, so the
decoders are not affected. NV12, NV21 and I420 use the single-buffer
layout when the driver supports it, and the one buffer per plane layout
otherwise (the Hantro H1).

When the driver aligns the size of the picture buffers (the Hantro H1 to
macroblocks), the visible picture is set as the crop rectangle of the
OUTPUT queue, as for stateful encoders; sizes that the driver cannot crop
to are refused at negotiation.

The allocator gains the encoder mode: GstV4l2CodecBuffer refers to either a
decoder or an encoder. The buffer pool takes the number of planes of the
video meta from the video info for formats that are not DMA_DRM, since the
V4L2 format table only knows the decoders' formats (NV21, YUY2 and UYVY are
not in it).

Based on the encoder helper of the work on stateless encoders by Benjamin
Gaignard, Michael Grzeschik and Paul Kocialkowski (gstreamer MR !5676 and
the v4l2codecs/h264enc branch of Paul Kocialkowski).

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 sys/v4l2codecs/gstv4l2codecallocator.c |  105 +-
 sys/v4l2codecs/gstv4l2codecallocator.h |    5 +
 sys/v4l2codecs/gstv4l2codecpool.c      |    5 +-
 sys/v4l2codecs/gstv4l2encoder.c        | 1383 ++++++++++++++++++++++++
 sys/v4l2codecs/gstv4l2encoder.h        |  151 +++
 sys/v4l2codecs/meson.build             |    2 +
 6 files changed, 1642 insertions(+), 9 deletions(-)
 create mode 100644 sys/v4l2codecs/gstv4l2encoder.c
 create mode 100644 sys/v4l2codecs/gstv4l2encoder.h

diff --git a/sys/v4l2codecs/gstv4l2codecallocator.c b/sys/v4l2codecs/gstv4l2codecallocator.c
index 624c852..95baa7c 100644
--- a/sys/v4l2codecs/gstv4l2codecallocator.c
+++ b/sys/v4l2codecs/gstv4l2codecallocator.c
@@ -49,6 +49,7 @@ struct _GstV4l2CodecAllocator
   gboolean flushing;
 
   GstV4l2Decoder *decoder;
+  GstV4l2Encoder *encoder;
   GstPadDirection direction;
 };
 
@@ -74,7 +75,7 @@ gst_v4l2_codec_buffer_quark (void)
 
 static GstV4l2CodecBuffer *
 gst_v4l2_codec_buffer_new (GstAllocator * allocator, GstV4l2Decoder * decoder,
-    GstPadDirection direction, gint index)
+    GstV4l2Encoder * encoder, GstPadDirection direction, gint index)
 {
   GstV4l2CodecBuffer *buf;
   guint i, num_mems;
@@ -82,9 +83,15 @@ gst_v4l2_codec_buffer_new (GstAllocator * allocator, GstV4l2Decoder * decoder,
   gsize sizes[GST_VIDEO_MAX_PLANES];
   gsize offsets[GST_VIDEO_MAX_PLANES];
 
-  if (!gst_v4l2_decoder_export_buffer (decoder, direction, index, fds, sizes,
-          offsets, &num_mems))
-    return NULL;
+  if (decoder) {
+    if (!gst_v4l2_decoder_export_buffer (decoder, direction, index, fds,
+            sizes, offsets, &num_mems))
+      return NULL;
+  } else {
+    if (!gst_v4l2_encoder_export_buffer (encoder, direction, index, fds,
+            sizes, offsets, &num_mems))
+      return NULL;
+  }
 
   buf = g_new0 (GstV4l2CodecBuffer, 1);
   buf->index = index;
@@ -191,8 +198,8 @@ gst_v4l2_codec_allocator_prepare (GstV4l2CodecAllocator * self)
     }
 
     buf =
-        gst_v4l2_codec_buffer_new (GST_ALLOCATOR (self), decoder, direction,
-        index);
+        gst_v4l2_codec_buffer_new (GST_ALLOCATOR (self), decoder, NULL,
+        direction, index);
     g_queue_push_tail (&self->pool, buf);
   }
 
@@ -213,6 +220,58 @@ failed:
   return FALSE;
 }
 
+/*
+ * Encoder buffers. The bitstream (src) buffers are MMAP buffers, queued by
+ * index. The picture (sink) queue uses DMABUF memory so that upstream
+ * dma-bufs can be imported. Its buffer pool is made of MMAP buffers that are
+ * exported as dma-bufs and then released from the queue: the exported
+ * dma-bufs keep the memory alive and are imported like any other dma-buf.
+ */
+static gboolean
+gst_v4l2_codec_encoder_allocator_prepare (GstV4l2CodecAllocator * self)
+{
+  GstV4l2Encoder *encoder = self->encoder;
+  GstPadDirection direction = self->direction;
+  GstV4l2CodecBuffer *buf;
+  gint ret;
+  guint i;
+
+  ret = gst_v4l2_encoder_request_buffers (encoder, direction, self->pool_size,
+      V4L2_MEMORY_MMAP);
+  if (ret < self->pool_size) {
+    if (ret >= 0)
+      GST_ERROR_OBJECT (self,
+          "%i buffers were needed, but only %i could be allocated",
+          self->pool_size, ret);
+    goto failed;
+  }
+
+  for (i = 0; i < self->pool_size; i++) {
+    buf = gst_v4l2_codec_buffer_new (GST_ALLOCATOR (self), NULL, encoder,
+        direction, i);
+    if (!buf)
+      goto failed;
+    g_queue_push_tail (&self->pool, buf);
+  }
+
+  if (direction == GST_PAD_SINK) {
+    if (gst_v4l2_encoder_request_buffers (encoder, direction, 0,
+            V4L2_MEMORY_MMAP) < 0)
+      goto failed;
+    if (gst_v4l2_encoder_request_buffers (encoder, direction,
+            VIDEO_MAX_FRAME, V4L2_MEMORY_DMABUF) <= 0)
+      goto failed;
+  }
+
+  return TRUE;
+
+failed:
+  while ((buf = g_queue_pop_tail (&self->pool)))
+    gst_v4l2_codec_buffer_free (buf);
+  gst_v4l2_encoder_request_buffers (encoder, direction, 0, V4L2_MEMORY_MMAP);
+  return FALSE;
+}
+
 static void
 gst_v4l2_codec_allocator_init (GstV4l2CodecAllocator * self)
 {
@@ -228,7 +287,7 @@ gst_v4l2_codec_allocator_dispose (GObject * object)
   GstV4l2CodecBuffer *buf;
 
   while ((buf = g_queue_pop_head (&self->pool))) {
-    if (gst_v4l2_decoder_has_remove_bufs (decoder)) {
+    if (decoder && gst_v4l2_decoder_has_remove_bufs (decoder)) {
       gst_v4l2_decoder_remove_buffers (decoder, direction, buf->index, 1);
     }
     gst_v4l2_codec_buffer_free (buf);
@@ -239,6 +298,11 @@ gst_v4l2_codec_allocator_dispose (GObject * object)
     gst_clear_object (&self->decoder);
   }
 
+  if (self->encoder) {
+    gst_v4l2_codec_allocator_detach (self);
+    gst_clear_object (&self->encoder);
+  }
+
   G_OBJECT_CLASS (gst_v4l2_codec_allocator_parent_class)->dispose (object);
 }
 
@@ -282,6 +346,25 @@ gst_v4l2_codec_allocator_new (GstV4l2Decoder * decoder,
   return self;
 }
 
+GstV4l2CodecAllocator *
+gst_v4l2_codec_encoder_allocator_new (GstV4l2Encoder * encoder,
+    GstPadDirection direction, guint num_buffers)
+{
+  GstV4l2CodecAllocator *self =
+      g_object_new (GST_TYPE_V4L2_CODEC_ALLOCATOR, NULL);
+
+  self->encoder = g_object_ref (encoder);
+  self->direction = direction;
+  self->pool_size = num_buffers;
+
+  if (!gst_v4l2_codec_encoder_allocator_prepare (self)) {
+    g_object_unref (self);
+    return NULL;
+  }
+
+  return self;
+}
+
 GstMemory *
 gst_v4l2_codec_allocator_alloc (GstV4l2CodecAllocator * self)
 {
@@ -369,7 +452,13 @@ gst_v4l2_codec_allocator_detach (GstV4l2CodecAllocator * self)
   GstV4l2Decoder *decoder = self->decoder;
 
   GST_OBJECT_LOCK (self);
-  if (!self->detached) {
+  if (!self->detached && self->encoder) {
+    self->detached = TRUE;
+    /* Exported buffers stay valid as dma-bufs until they are freed. */
+    gst_v4l2_encoder_request_buffers (self->encoder, self->direction, 0,
+        self->direction == GST_PAD_SINK ? V4L2_MEMORY_DMABUF :
+        V4L2_MEMORY_MMAP);
+  } else if (!self->detached) {
     self->detached = TRUE;
     if (!gst_v4l2_decoder_has_remove_bufs (decoder)) {
       gst_v4l2_decoder_request_buffers (self->decoder, self->direction, 0);
diff --git a/sys/v4l2codecs/gstv4l2codecallocator.h b/sys/v4l2codecs/gstv4l2codecallocator.h
index 8f4dcdd..603f8eb 100644
--- a/sys/v4l2codecs/gstv4l2codecallocator.h
+++ b/sys/v4l2codecs/gstv4l2codecallocator.h
@@ -25,6 +25,7 @@
 
 #include "gstv4l2codecdevice.h"
 #include "gstv4l2decoder.h"
+#include "gstv4l2encoder.h"
 
 #define GST_TYPE_V4L2_CODEC_ALLOCATOR gst_v4l2_codec_allocator_get_type ()
 G_DECLARE_FINAL_TYPE (GstV4l2CodecAllocator, gst_v4l2_codec_allocator,
@@ -35,6 +36,10 @@ GstV4l2CodecAllocator  *gst_v4l2_codec_allocator_new (GstV4l2Decoder * decoder,
                                                       GstPadDirection direction,
                                                       guint num_buffers);
 
+GstV4l2CodecAllocator  *gst_v4l2_codec_encoder_allocator_new (GstV4l2Encoder * encoder,
+                                                              GstPadDirection direction,
+                                                              guint num_buffers);
+
 GstMemory              *gst_v4l2_codec_allocator_alloc (GstV4l2CodecAllocator * allocator);
 
 
diff --git a/sys/v4l2codecs/gstv4l2codecpool.c b/sys/v4l2codecs/gstv4l2codecpool.c
index 9a539b1..2f45e7a 100644
--- a/sys/v4l2codecs/gstv4l2codecpool.c
+++ b/sys/v4l2codecs/gstv4l2codecpool.c
@@ -89,7 +89,10 @@ gst_v4l2_codec_pool_acquire_buffer (GstBufferPool * pool, GstBuffer ** buffer,
   vmeta->format = GST_VIDEO_INFO_FORMAT (&self->vinfo_drm->vinfo);
   vmeta->width = GST_VIDEO_INFO_WIDTH (&self->vinfo_drm->vinfo);
   vmeta->height = GST_VIDEO_INFO_HEIGHT (&self->vinfo_drm->vinfo);
-  vmeta->n_planes = gst_v4l2_format_get_n_planes (self->vinfo_drm);
+  if (GST_VIDEO_INFO_FORMAT (&self->vinfo_drm->vinfo) == GST_VIDEO_FORMAT_DMA_DRM)
+    vmeta->n_planes = gst_v4l2_format_get_n_planes (self->vinfo_drm);
+  else
+    vmeta->n_planes = GST_VIDEO_INFO_N_PLANES (&self->vinfo_drm->vinfo);
   memcpy (vmeta->offset, self->vinfo_drm->vinfo.offset, sizeof (vmeta->offset));
   memcpy (vmeta->stride, self->vinfo_drm->vinfo.stride, sizeof (vmeta->stride));
 
diff --git a/sys/v4l2codecs/gstv4l2encoder.c b/sys/v4l2codecs/gstv4l2encoder.c
new file mode 100644
index 0000000..b538927
--- /dev/null
+++ b/sys/v4l2codecs/gstv4l2encoder.c
@@ -0,0 +1,1383 @@
+/* GStreamer
+ * Copyright (C) 2022 Benjamin Gaignard <benjamin.gaignard@collabora.com>
+ * Copyright (C) 2026 Arun Iyengar <aiyengar1990@gmail.com>
+ *
