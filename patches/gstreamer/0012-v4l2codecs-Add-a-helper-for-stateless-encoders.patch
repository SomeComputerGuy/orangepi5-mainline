+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Library General Public License for more details.
+ *
+ * You should have received a copy of the GNU Library General Public
+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+/*
+ * Helper object driving a V4L2 stateless (request API) encoder, the
+ * counterpart of GstV4l2Decoder. Based on the GstV4l2Encoder of the
+ * GStreamer v4l2codecs stateless encoder work (Benjamin Gaignard, Michael
+ * Tretter, Paul Kocialkowski et al., gstreamer MR !5676 and
+ * github.com/paulkocialkowski/gstreamer branch v4l2codecs/h264enc).
+ *
+ * Requests complete in the order they were queued: a stateless encoder
+ * context runs one job at a time, and every picture but an IDR depends on
+ * the previous one. The element queues a few requests ahead and waits for
+ * the oldest one.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include "gstv4l2codecallocator.h"
+#include "gstv4l2codecpool.h"
+#include "gstv4l2encoder.h"
+#include "linux/media.h"
+#include "linux/videodev2.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <gst/allocators/allocators.h>
+
+GST_DEBUG_CATEGORY (v4l2_encoder_debug);
+#define GST_CAT_DEFAULT v4l2_encoder_debug
+
+enum
+{
+  PROP_0,
+  PROP_MEDIA_DEVICE,
+  PROP_VIDEO_DEVICE,
+};
+
+struct _GstV4l2EncodeRequest
+{
+  GstV4l2Encoder *encoder;
+  gint fd;
+  guint64 frame_id;
+  GstBuffer *bitstream;
+  GstBuffer *pic_buf;
+  gint sink_index;
+  gboolean pending;
+};
+
+struct BufState
+{
+  gboolean queued;
+  gint dmabuf_fd;
+};
+
+struct _GstV4l2Encoder
+{
+  GstObject parent;
+
+  gboolean opened;
+  gint media_fd;
+  gint video_fd;
+  GQueue request_pool;
+  guint version;
+
+  enum v4l2_buf_type sink_buf_type;
+  enum v4l2_buf_type src_buf_type;
+  struct v4l2_format sink_fmt;
+  GstVideoInfo sink_info;
+  gboolean mplane;
+
+  /* Which dma-buf was imported at which OUTPUT queue index */
+  struct BufState buffer_state[VIDEO_MAX_FRAME];
+
+  /* properties */
+  gchar *media_device;
+  gchar *video_device;
+};
+
+G_DEFINE_TYPE_WITH_CODE (GstV4l2Encoder, gst_v4l2_encoder, GST_TYPE_OBJECT,
+    GST_DEBUG_CATEGORY_INIT (v4l2_encoder_debug, "v4l2codecs-encoder", 0,
+        "V4L2 stateless encoder helper"));
+
+/* Raw formats of the encoders, the single-buffer layout first, so that the
+ * pictures of upstream elements can be imported as they are. The layouts
+ * with one buffer per plane are used by drivers that only support those. */
+static const struct
+{
+  GstVideoFormat format;
+  guint32 pix_fmt;
+} raw_formats[] = {
+  {GST_VIDEO_FORMAT_NV12, V4L2_PIX_FMT_NV12},
+  {GST_VIDEO_FORMAT_NV12, V4L2_PIX_FMT_NV12M},
+  {GST_VIDEO_FORMAT_NV21, V4L2_PIX_FMT_NV21},
+  {GST_VIDEO_FORMAT_NV21, V4L2_PIX_FMT_NV21M},
+  {GST_VIDEO_FORMAT_I420, V4L2_PIX_FMT_YUV420},
+  {GST_VIDEO_FORMAT_I420, V4L2_PIX_FMT_YUV420M},
+  {GST_VIDEO_FORMAT_YUY2, V4L2_PIX_FMT_YUYV},
+  {GST_VIDEO_FORMAT_UYVY, V4L2_PIX_FMT_UYVY},
+};
+
+static gboolean
+sink_format_supported (GstV4l2Encoder * self, guint32 pix_fmt)
+{
+  gint i;
+
+  for (i = 0;; i++) {
+    struct v4l2_fmtdesc fmtdesc = {.index = i,.type = self->sink_buf_type, };
+
+    if (ioctl (self->video_fd, VIDIOC_ENUM_FMT, &fmtdesc) < 0)
+      return FALSE;
+    if (fmtdesc.pixelformat == pix_fmt)
+      return TRUE;
+  }
+}
+
+/* The first V4L2 format of @format that the driver supports */
+static guint32
+raw_format_to_v4l2 (GstV4l2Encoder * self, GstVideoFormat format)
+{
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (raw_formats); i++)
+    if (raw_formats[i].format == format &&
+        sink_format_supported (self, raw_formats[i].pix_fmt))
+      return raw_formats[i].pix_fmt;
+  return 0;
+}
+
+static GstVideoFormat
+raw_format_from_v4l2 (guint32 pix_fmt)
+{
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (raw_formats); i++)
+    if (raw_formats[i].pix_fmt == pix_fmt)
+      return raw_formats[i].format;
+  return GST_VIDEO_FORMAT_UNKNOWN;
+}
+
+static void
+buffer_state_init (GstV4l2Encoder * self)
+{
+  gint i;
+
+  for (i = 0; i < VIDEO_MAX_FRAME; i++) {
+    self->buffer_state[i].queued = FALSE;
+    self->buffer_state[i].dmabuf_fd = -1;
+  }
+}
+
+static gint
+buffer_state_find (GstV4l2Encoder * self, gint dmabuf_fd)
+{
+  gint free_index = -1, unused_index = -1;
+  gint i;
+
+  for (i = 0; i < VIDEO_MAX_FRAME; i++) {
+    if (self->buffer_state[i].queued)
+      continue;
+    if (self->buffer_state[i].dmabuf_fd == dmabuf_fd)
+      return i;
+    if (unused_index < 0 && self->buffer_state[i].dmabuf_fd == -1)
+      unused_index = i;
+    if (free_index < 0)
+      free_index = i;
+  }
+
+  /* Prefer a slot that never held a buffer, to keep the driver's dma-buf
+   * mappings of the other slots. */
+  return unused_index >= 0 ? unused_index : free_index;
+}
+
+static void
+gst_v4l2_encoder_finalize (GObject * obj)
+{
+  GstV4l2Encoder *self = GST_V4L2_ENCODER (obj);
+
+  gst_v4l2_encoder_close (self);
+
+  g_free (self->media_device);
+  g_free (self->video_device);
+
+  G_OBJECT_CLASS (gst_v4l2_encoder_parent_class)->finalize (obj);
+}
+
+static void
+gst_v4l2_encoder_init (GstV4l2Encoder * self)
+{
+  g_queue_init (&self->request_pool);
+  self->media_fd = -1;
+  self->video_fd = -1;
+  buffer_state_init (self);
+}
+
+static void
+gst_v4l2_encoder_class_init (GstV4l2EncoderClass * klass)
+{
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+
+  gobject_class->finalize = gst_v4l2_encoder_finalize;
+  gobject_class->get_property = gst_v4l2_encoder_get_property;
+  gobject_class->set_property = gst_v4l2_encoder_set_property;
+
+  gst_v4l2_encoder_install_properties (gobject_class, 0, NULL);
+}
+
+GstV4l2Encoder *
+gst_v4l2_encoder_new (GstV4l2CodecDevice * device)
+{
+  GstV4l2Encoder *encoder;
+
+  g_return_val_if_fail (device->function == MEDIA_ENT_F_PROC_VIDEO_ENCODER,
+      NULL);
+
+  encoder = g_object_new (GST_TYPE_V4L2_ENCODER,
+      "media-device", device->media_device_path,
+      "video-device", device->video_device_path, NULL);
+
+  return gst_object_ref_sink (encoder);
+}
+
+guint
+gst_v4l2_encoder_get_version (GstV4l2Encoder * self)
+{
+  return self->version;
+}
+
+gboolean
+gst_v4l2_encoder_open (GstV4l2Encoder * self)
+{
+  struct v4l2_capability querycap;
+  guint32 capabilities;
+
+  self->media_fd = open (self->media_device, O_RDWR | O_CLOEXEC);
+  if (self->media_fd < 0) {
+    GST_ERROR_OBJECT (self, "Failed to open '%s': %s",
+        self->media_device, g_strerror (errno));
+    return FALSE;
+  }
+
+  self->video_fd = open (self->video_device, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  if (self->video_fd < 0) {
+    GST_ERROR_OBJECT (self, "Failed to open '%s': %s",
+        self->video_device, g_strerror (errno));
+    gst_v4l2_encoder_close (self);
+    return FALSE;
+  }
+
+  if (ioctl (self->video_fd, VIDIOC_QUERYCAP, &querycap) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_QUERYCAP failed: %s", g_strerror (errno));
+    gst_v4l2_encoder_close (self);
+    return FALSE;
+  }
+
+  self->version = querycap.version;
+
+  if (querycap.capabilities & V4L2_CAP_DEVICE_CAPS)
+    capabilities = querycap.device_caps;
+  else
+    capabilities = querycap.capabilities;
+
+  if (capabilities & V4L2_CAP_VIDEO_M2M_MPLANE) {
+    self->sink_buf_type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    self->src_buf_type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    self->mplane = TRUE;
+  } else if (capabilities & V4L2_CAP_VIDEO_M2M) {
+    self->sink_buf_type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+    self->src_buf_type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+    self->mplane = FALSE;
+  } else {
+    GST_ERROR_OBJECT (self, "Unsupported memory-to-memory device.");
+    gst_v4l2_encoder_close (self);
+    return FALSE;
+  }
+
+  self->opened = TRUE;
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_close (GstV4l2Encoder * self)
+{
+  GstV4l2EncodeRequest *request;
+
+  while ((request = g_queue_pop_head (&self->request_pool))) {
+    close (request->fd);
+    g_free (request);
+  }
+
+  if (self->media_fd >= 0)
+    close (self->media_fd);
+  if (self->video_fd >= 0)
+    close (self->video_fd);
+
+  self->media_fd = -1;
+  self->video_fd = -1;
+  self->opened = FALSE;
+
+  buffer_state_init (self);
+
+  return TRUE;
+}
+
+static guint32
+direction_to_buffer_type (GstV4l2Encoder * self, GstPadDirection direction)
+{
+  return direction == GST_PAD_SRC ? self->src_buf_type : self->sink_buf_type;
+}
+
+gboolean
+gst_v4l2_encoder_streamon (GstV4l2Encoder * self, GstPadDirection direction)
+{
+  guint32 type = direction_to_buffer_type (self, direction);
+
+  if (ioctl (self->video_fd, VIDIOC_STREAMON, &type) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_STREAMON failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_streamoff (GstV4l2Encoder * self, GstPadDirection direction)
+{
+  guint32 type = direction_to_buffer_type (self, direction);
+  gint i;
+
+  if (direction == GST_PAD_SINK)
+    for (i = 0; i < VIDEO_MAX_FRAME; i++)
+      self->buffer_state[i].queued = FALSE;
+
+  if (ioctl (self->video_fd, VIDIOC_STREAMOFF, &type) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_STREAMOFF failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_enum_src_formats (GstV4l2Encoder * self, gint i,
+    guint32 * out_fmt)
+{
+  struct v4l2_fmtdesc fmtdesc = {.index = i,.type = self->src_buf_type, };
+
+  if (ioctl (self->video_fd, VIDIOC_ENUM_FMT, &fmtdesc) < 0) {
+    if (errno != EINVAL)
+      GST_ERROR_OBJECT (self, "VIDIOC_ENUM_FMT failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  GST_DEBUG_OBJECT (self, "Found coded format %" GST_FOURCC_FORMAT " (%s)",
+      GST_FOURCC_ARGS (fmtdesc.pixelformat), fmtdesc.description);
+  *out_fmt = fmtdesc.pixelformat;
+
+  return TRUE;
+}
+
+GstCaps *
+gst_v4l2_encoder_list_sink_formats (GstV4l2Encoder * self)
+{
+  GValue list = G_VALUE_INIT;
+  GValue value = G_VALUE_INIT;
+  GstCaps *caps;
+  gint i;
+
+  if (!self->opened)
+    return NULL;
+
+  g_value_init (&list, GST_TYPE_LIST);
+  g_value_init (&value, G_TYPE_STRING);
+
+  for (i = 0;; i++) {
+    struct v4l2_fmtdesc fmtdesc = {.index = i,.type = self->sink_buf_type, };
+    GstVideoFormat format;
+
+    if (ioctl (self->video_fd, VIDIOC_ENUM_FMT, &fmtdesc) < 0)
+      break;
+
+    format = raw_format_from_v4l2 (fmtdesc.pixelformat);
+    if (format == GST_VIDEO_FORMAT_UNKNOWN)
+      continue;
+    if (raw_format_to_v4l2 (self, format) != fmtdesc.pixelformat)
+      continue;                 /* listed once, by its preferred layout */
+
+    g_value_set_static_string (&value, gst_video_format_to_string (format));
+    gst_value_list_append_value (&list, &value);
+  }
+  g_value_unset (&value);
+
+  caps = gst_caps_new_empty_simple ("video/x-raw");
+  gst_caps_set_value (caps, "format", &list);
+  g_value_unset (&list);
+
+  return caps;
+}
+
+gboolean
+gst_v4l2_encoder_get_frame_size_range (GstV4l2Encoder * self,
+    guint32 pix_fmt, struct v4l2_frmsize_stepwise * range)
+{
+  struct v4l2_frmsizeenum fsize = {.index = 0,.pixel_format = pix_fmt, };
+
+  if (ioctl (self->video_fd, VIDIOC_ENUM_FRAMESIZES, &fsize) < 0)
+    return FALSE;
+
+  if (fsize.type == V4L2_FRMSIZE_TYPE_DISCRETE) {
+    range->min_width = range->max_width = fsize.discrete.width;
+    range->min_height = range->max_height = fsize.discrete.height;
+    range->step_width = range->step_height = 1;
+  } else {
+    *range = fsize.stepwise;
+  }
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_set_src_fmt (GstV4l2Encoder * self, guint32 pix_fmt,
+    gint width, gint height)
+{
+  struct v4l2_format fmt = {.type = self->src_buf_type, };
+
+  GST_DEBUG_OBJECT (self, "Setting coded format %" GST_FOURCC_FORMAT
+      " %dx%d", GST_FOURCC_ARGS (pix_fmt), width, height);
+
+  /* Leave the bitstream buffer size to the driver, it knows the worst case
+   * size of a picture. */
+  if (self->mplane) {
+    fmt.fmt.pix_mp.pixelformat = pix_fmt;
+    fmt.fmt.pix_mp.width = width;
+    fmt.fmt.pix_mp.height = height;
+    fmt.fmt.pix_mp.num_planes = 1;
+  } else {
+    fmt.fmt.pix.pixelformat = pix_fmt;
+    fmt.fmt.pix.width = width;
+    fmt.fmt.pix.height = height;
+  }
+
+  if (ioctl (self->video_fd, VIDIOC_S_FMT, &fmt) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_S_FMT failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  if ((self->mplane ? fmt.fmt.pix_mp.pixelformat : fmt.fmt.pix.pixelformat)
+      != pix_fmt) {
+    GST_WARNING_OBJECT (self, "Failed to set coded format to %"
+        GST_FOURCC_FORMAT, GST_FOURCC_ARGS (pix_fmt));
+    errno = EINVAL;
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static void
+colorimetry_to_v4l2 (const GstVideoColorimetry * cinfo,
+    struct v4l2_pix_format_mplane *pix)
+{
+  pix->colorspace = V4L2_COLORSPACE_DEFAULT;
+  pix->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+  pix->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+  pix->quantization = V4L2_QUANTIZATION_DEFAULT;
+
+  switch (cinfo->primaries) {
+    case GST_VIDEO_COLOR_PRIMARIES_BT709:
+      pix->colorspace = V4L2_COLORSPACE_REC709;
+      break;
+    case GST_VIDEO_COLOR_PRIMARIES_BT470BG:
+      pix->colorspace = V4L2_COLORSPACE_470_SYSTEM_BG;
+      break;
+    case GST_VIDEO_COLOR_PRIMARIES_SMPTE170M:
+      pix->colorspace = V4L2_COLORSPACE_SMPTE170M;
+      break;
+    case GST_VIDEO_COLOR_PRIMARIES_SMPTE240M:
+      pix->colorspace = V4L2_COLORSPACE_SMPTE240M;
+      break;
+    case GST_VIDEO_COLOR_PRIMARIES_BT2020:
+      pix->colorspace = V4L2_COLORSPACE_BT2020;
+      break;
+    default:
+      break;
+  }
+
+  switch (cinfo->matrix) {
+    case GST_VIDEO_COLOR_MATRIX_BT709:
+      pix->ycbcr_enc = V4L2_YCBCR_ENC_709;
+      break;
+    case GST_VIDEO_COLOR_MATRIX_BT601:
+      pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+      break;
+    case GST_VIDEO_COLOR_MATRIX_SMPTE240M:
+      pix->ycbcr_enc = V4L2_YCBCR_ENC_SMPTE240M;
+      break;
+    case GST_VIDEO_COLOR_MATRIX_BT2020:
+      pix->ycbcr_enc = V4L2_YCBCR_ENC_BT2020;
+      break;
+    default:
+      break;
+  }
+
+  switch (cinfo->transfer) {
+    case GST_VIDEO_TRANSFER_BT709:
+    case GST_VIDEO_TRANSFER_BT601:
+    case GST_VIDEO_TRANSFER_BT2020_10:
+    case GST_VIDEO_TRANSFER_BT2020_12:
+      pix->xfer_func = V4L2_XFER_FUNC_709;
+      break;
+    case GST_VIDEO_TRANSFER_SRGB:
+      pix->xfer_func = V4L2_XFER_FUNC_SRGB;
+      break;
+    case GST_VIDEO_TRANSFER_SMPTE240M:
+      pix->xfer_func = V4L2_XFER_FUNC_SMPTE240M;
+      break;
+    case GST_VIDEO_TRANSFER_SMPTE2084:
+      pix->xfer_func = V4L2_XFER_FUNC_SMPTE2084;
+      break;
+    case GST_VIDEO_TRANSFER_GAMMA10:
+      pix->xfer_func = V4L2_XFER_FUNC_NONE;
+      break;
+    default:
+      break;
+  }
+
+  switch (cinfo->range) {
+    case GST_VIDEO_COLOR_RANGE_0_255:
+      pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+      break;
+    case GST_VIDEO_COLOR_RANGE_16_235:
+      pix->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+      break;
+    default:
+      break;
+  }
+}
+
+/* GstVideoInfo of the driver's picture layout: planes follow each other in
+ * the single buffer, strides from bytesperline. With one buffer per plane,
+ * the offsets are those of the planes in a GstBuffer holding one memory per
+ * buffer, as in the decoders. */
+static gboolean
+sink_fmt_to_video_info (struct v4l2_format *fmt, GstVideoInfo * in_info,
+    GstVideoInfo * info)
+{
+  struct v4l2_pix_format_mplane *pix = &fmt->fmt.pix_mp;
+  GstVideoFormat format = raw_format_from_v4l2 (pix->pixelformat);
+  guint i, bpl = pix->plane_fmt[0].bytesperline;
+  gsize offset = 0;
+
+  if (format == GST_VIDEO_FORMAT_UNKNOWN || pix->num_planes < 1)
+    return FALSE;
+
+  /* The picture is the visible part of the driver's (maybe larger,
+   * aligned) picture buffer. */
+  *info = *in_info;
+  if (!gst_video_info_set_format (info, format, GST_VIDEO_INFO_WIDTH (in_info),
+          GST_VIDEO_INFO_HEIGHT (in_info)))
+    return FALSE;
+  /* Keep the colorimetry, framerate and aspect ratio of the input. */
+  info->colorimetry = in_info->colorimetry;
+  info->fps_n = in_info->fps_n;
+  info->fps_d = in_info->fps_d;
+  info->par_n = in_info->par_n;
+  info->par_d = in_info->par_d;
+
+  if (pix->num_planes > 1) {
+    if (pix->num_planes != GST_VIDEO_INFO_N_PLANES (info))
+      return FALSE;
+    for (i = 0; i < pix->num_planes; i++) {
+      info->stride[i] = pix->plane_fmt[i].bytesperline;
+      info->offset[i] = offset;
+      offset += pix->plane_fmt[i].sizeimage;
+    }
+    info->size = offset;
+    return TRUE;
+  }
+
+  for (i = 0; i < GST_VIDEO_INFO_N_PLANES (info); i++) {
+    guint stride = bpl;
+    guint h = pix->height;
+
+    /* Semi-planar chroma has the luma stride, planar chroma half of it. */
+    if (i > 0) {
+      h = GST_VIDEO_SUB_SCALE (GST_VIDEO_FORMAT_INFO_H_SUB (info->finfo, i),
+          pix->height);
+      if (GST_VIDEO_INFO_N_PLANES (info) != 2)
+        stride = bpl / 2;
+    }
+
+    info->stride[i] = stride;
+    info->offset[i] = offset;
+    offset += (gsize) stride *h;
+  }
+  info->size = pix->plane_fmt[0].sizeimage;
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_select_sink_format (GstV4l2Encoder * self,
+    GstVideoInfo * in_info, GstVideoInfoDmaDrm * vinfo_drm)
+{
+  struct v4l2_format fmt = {.type = self->sink_buf_type, };
+  guint32 pix_fmt = raw_format_to_v4l2 (self, GST_VIDEO_INFO_FORMAT (in_info));
+
+  if (!pix_fmt || !self->mplane) {
+    GST_ERROR_OBJECT (self, "Unsupported raw format %s",
+        gst_video_format_to_string (GST_VIDEO_INFO_FORMAT (in_info)));
+    return FALSE;
+  }
+
+  fmt.fmt.pix_mp.pixelformat = pix_fmt;
+  fmt.fmt.pix_mp.width = GST_VIDEO_INFO_WIDTH (in_info);
+  fmt.fmt.pix_mp.height = GST_VIDEO_INFO_HEIGHT (in_info);
+  fmt.fmt.pix_mp.num_planes = 0;        /* chosen by the driver */
+  fmt.fmt.pix_mp.field = V4L2_FIELD_NONE;
+  colorimetry_to_v4l2 (&in_info->colorimetry, &fmt.fmt.pix_mp);
+
+  if (ioctl (self->video_fd, VIDIOC_S_FMT, &fmt) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_S_FMT failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  /* The driver may align the picture buffer size; the coded size comes from
+   * the CAPTURE format. */
+  if (fmt.fmt.pix_mp.pixelformat != pix_fmt ||
+      fmt.fmt.pix_mp.width < GST_VIDEO_INFO_WIDTH (in_info) ||
+      fmt.fmt.pix_mp.height < GST_VIDEO_INFO_HEIGHT (in_info)) {
+    GST_ERROR_OBJECT (self, "Driver changed the format to %" GST_FOURCC_FORMAT
+        " %ux%u", GST_FOURCC_ARGS (fmt.fmt.pix_mp.pixelformat),
+        fmt.fmt.pix_mp.width, fmt.fmt.pix_mp.height);
+    return FALSE;
+  }
+
+  /* A picture buffer larger than the picture: the visible part is the crop
+   * rectangle of the OUTPUT queue, as for stateful encoders. Drivers whose
+   * picture buffer has the size of the picture have no crop rectangle. */
+  if (fmt.fmt.pix_mp.width != GST_VIDEO_INFO_WIDTH (in_info) ||
+      fmt.fmt.pix_mp.height != GST_VIDEO_INFO_HEIGHT (in_info)) {
+    struct v4l2_selection sel = {
+      .type = V4L2_BUF_TYPE_VIDEO_OUTPUT,
+      .target = V4L2_SEL_TGT_CROP,
+      .r.width = GST_VIDEO_INFO_WIDTH (in_info),
+      .r.height = GST_VIDEO_INFO_HEIGHT (in_info),
+    };
+
+    if (ioctl (self->video_fd, VIDIOC_S_SELECTION, &sel) < 0 ||
+        sel.r.left != 0 || sel.r.top != 0 ||
+        sel.r.width != GST_VIDEO_INFO_WIDTH (in_info) ||
+        sel.r.height != GST_VIDEO_INFO_HEIGHT (in_info)) {
+      GST_ERROR_OBJECT (self, "Driver cannot encode %dx%d pictures (picture "
+          "buffer %ux%u, crop %ux%u)", GST_VIDEO_INFO_WIDTH (in_info),
+          GST_VIDEO_INFO_HEIGHT (in_info), fmt.fmt.pix_mp.width,
+          fmt.fmt.pix_mp.height, sel.r.width, sel.r.height);
+      return FALSE;
+    }
+  }
+
+  gst_video_info_dma_drm_init (vinfo_drm);
+  if (!sink_fmt_to_video_info (&fmt, in_info, &vinfo_drm->vinfo)) {
+    GST_ERROR_OBJECT (self, "Unsupported V4L2 picture layout");
+    return FALSE;
+  }
+
+  self->sink_fmt = fmt;
+  self->sink_info = vinfo_drm->vinfo;
+
+  GST_INFO_OBJECT (self, "Picture format %s %ux%u stride %u size %u",
+      gst_video_format_to_string (GST_VIDEO_INFO_FORMAT (in_info)),
+      fmt.fmt.pix_mp.width, fmt.fmt.pix_mp.height,
+      fmt.fmt.pix_mp.plane_fmt[0].bytesperline,
+      fmt.fmt.pix_mp.plane_fmt[0].sizeimage);
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_set_fps (GstV4l2Encoder * self, const GstVideoInfo * info)
+{
+  struct v4l2_streamparm parm = {.type = self->sink_buf_type, };
+  struct v4l2_fract *timeperframe = &parm.parm.output.timeperframe;
+
+  timeperframe->numerator = GST_VIDEO_INFO_FPS_D (info);
+  timeperframe->denominator = GST_VIDEO_INFO_FPS_N (info);
+
+  if (!timeperframe->numerator || !timeperframe->denominator) {
+    timeperframe->numerator = 1;
+    timeperframe->denominator = 30;
+  }
+
+  if (ioctl (self->video_fd, VIDIOC_S_PARM, &parm) < 0) {
+    GST_WARNING_OBJECT (self, "VIDIOC_S_PARM failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+gint
+gst_v4l2_encoder_request_buffers (GstV4l2Encoder * self,
+    GstPadDirection direction, guint num_buffers, guint mem_type)
+{
+  struct v4l2_requestbuffers reqbufs = {
+    .count = num_buffers,
+    .memory = mem_type,
+    .type = direction_to_buffer_type (self, direction),
+  };
+
+  GST_DEBUG_OBJECT (self, "Requesting %u buffers of memory type %u on the %s "
+      "queue", reqbufs.count, reqbufs.memory,
+      direction == GST_PAD_SRC ? "CAPTURE" : "OUTPUT");
+
+  if (ioctl (self->video_fd, VIDIOC_REQBUFS, &reqbufs) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_REQBUFS failed: %s", g_strerror (errno));
+    return -1;
+  }
+
+  if (direction == GST_PAD_SINK && mem_type == V4L2_MEMORY_DMABUF)
+    buffer_state_init (self);
+
+  return reqbufs.count;
+}
+
+gboolean
+gst_v4l2_encoder_export_buffer (GstV4l2Encoder * self,
+    GstPadDirection direction, gint index, gint * fds, gsize * sizes,
+    gsize * offsets, guint * num_fds)
+{
+  struct v4l2_plane planes[GST_VIDEO_MAX_PLANES] = { {0} };
+  struct v4l2_buffer v4l2_buf = {
+    .index = index,
+    .type = direction_to_buffer_type (self, direction),
+  };
+  guint i, n;
+
+  if (self->mplane) {
+    v4l2_buf.length = GST_VIDEO_MAX_PLANES;
+    v4l2_buf.m.planes = planes;
+  }
+
+  if (ioctl (self->video_fd, VIDIOC_QUERYBUF, &v4l2_buf) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_QUERYBUF failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  n = self->mplane ? v4l2_buf.length : 1;
+  for (i = 0; i < n; i++) {
+    struct v4l2_exportbuffer expbuf = {
+      .type = v4l2_buf.type,
+      .index = index,
+      .plane = i,
+      .flags = O_CLOEXEC | O_RDWR,
+    };
+
+    if (ioctl (self->video_fd, VIDIOC_EXPBUF, &expbuf) < 0) {
+      GST_ERROR_OBJECT (self, "VIDIOC_EXPBUF failed: %s", g_strerror (errno));
+      while (i--)
+        close (fds[i]);
+      return FALSE;
+    }
+
+    fds[i] = expbuf.fd;
+    if (self->mplane) {
+      sizes[i] = planes[i].length;
+      offsets[i] = planes[i].data_offset;
+    } else {
+      sizes[i] = v4l2_buf.length;
+      offsets[i] = 0;
+    }
+  }
+  *num_fds = n;
+
+  return TRUE;
+}
+
+/* The driver ignores data_offset, so each plane buffer of the driver must
+ * start at the beginning of a dma-buf: a single dma-buf with the driver's
+ * layout, or one dma-buf per plane when the driver uses one buffer per plane.
+ * Returns the number of memories, or 0. */
+static guint
+gst_v4l2_encoder_get_import_memories (GstV4l2Encoder * self,
+    GstBuffer * buffer, GstMemory ** mems)
+{
+  GstVideoMeta *vmeta = gst_buffer_get_video_meta (buffer);
+  const GstVideoInfo *info = &self->sink_info;
+  const struct v4l2_pix_format_mplane *pix = &self->sink_fmt.fmt.pix_mp;
+  guint i, n_planes = GST_VIDEO_INFO_N_PLANES (info);
+  guint n_mems = pix->num_planes;
+
+  if (!self->mplane || n_mems < 1 || gst_buffer_n_memory (buffer) != n_mems)
+    return 0;
+
+  for (i = 0; i < n_mems; i++) {
+    gsize offset, maxsize, size;
+
+    mems[i] = gst_buffer_peek_memory (buffer, i);
+    if (!gst_is_dmabuf_memory (mems[i]))
+      return 0;
+    size = gst_memory_get_sizes (mems[i], &offset, &maxsize);
+    if (offset != 0 || size < pix->plane_fmt[i].sizeimage)
+      return 0;
+  }
+
+  if (vmeta) {
+    if (vmeta->n_planes != n_planes)
+      return 0;
+    for (i = 0; i < n_planes; i++) {
+      if (vmeta->stride[i] != info->stride[i]) {
+        GST_LOG_OBJECT (self, "plane %u stride %d, %d expected", i,
+            vmeta->stride[i], info->stride[i]);
+        return 0;
+      }
+
+      if (n_mems == 1) {
+        if (vmeta->offset[i] != info->offset[i]) {
+          GST_LOG_OBJECT (self, "plane %u offset %" G_GSIZE_FORMAT ", %"
+              G_GSIZE_FORMAT " expected", i, vmeta->offset[i],
+              info->offset[i]);
+          return 0;
+        }
+      } else {
+        guint idx, len;
+        gsize skip;
+
+        /* Plane i must be at the start of memory i */
+        if (!gst_buffer_find_memory (buffer, vmeta->offset[i], 1, &idx, &len,
+                &skip) || idx != i || skip != 0)
+          return 0;
+      }
+    }
+  } else {
+    GstVideoInfo def;
+
+    /* Without a meta the layout is the default one of the format, in a
+     * single memory. */
+    if (n_mems != 1)
+      return 0;
+    gst_video_info_set_format (&def, GST_VIDEO_INFO_FORMAT (info),
+        GST_VIDEO_INFO_WIDTH (info), GST_VIDEO_INFO_HEIGHT (info));
+    for (i = 0; i < n_planes; i++)
+      if (def.stride[i] != info->stride[i] || def.offset[i] != info->offset[i])
+        return 0;
+  }
+
+  return n_mems;
+}
+
+gboolean
+gst_v4l2_encoder_can_import (GstV4l2Encoder * self, GstBuffer * buffer)
+{
+  GstMemory *mems[GST_VIDEO_MAX_PLANES];
+
+  return gst_v4l2_encoder_get_import_memories (self, buffer, mems) > 0;
+}
+
+static gboolean
+gst_v4l2_encoder_queue_sink_buffer (GstV4l2Encoder * self,
+    GstV4l2EncodeRequest * request)
+{
+  struct v4l2_plane planes[GST_VIDEO_MAX_PLANES] = { {0} };
+  struct v4l2_buffer buf = {
+    .type = self->sink_buf_type,
+    .memory = V4L2_MEMORY_DMABUF,
+    .request_fd = request->fd,
+    .flags = V4L2_BUF_FLAG_REQUEST_FD,
+    .m.planes = planes,
+  };
+  guint64 ts = GST_V4L2_ENCODER_FRAME_TS (request->frame_id);
+  GstMemory *mems[GST_VIDEO_MAX_PLANES];
+  guint i, n;
+  gint fd, index;
+
+  n = gst_v4l2_encoder_get_import_memories (self, request->pic_buf, mems);
+  if (!n) {
+    GST_ERROR_OBJECT (self, "Picture buffer cannot be imported");
+    return FALSE;
+  }
+
+  /* The slot is chosen by the dma-buf of the first plane */
+  fd = gst_dmabuf_memory_get_fd (mems[0]);
+  index = buffer_state_find (self, fd);
+  if (index < 0) {
+    GST_ERROR_OBJECT (self, "No free picture slot");
+    return FALSE;
+  }
+
+  for (i = 0; i < n; i++) {
+    planes[i].m.fd = gst_dmabuf_memory_get_fd (mems[i]);
+    planes[i].bytesused = self->sink_fmt.fmt.pix_mp.plane_fmt[i].sizeimage;
+    planes[i].length = gst_memory_get_sizes (mems[i], NULL, NULL);
+  }
+  buf.length = n;
+  buf.index = index;
+  buf.timestamp.tv_sec = ts / GST_SECOND;
+  buf.timestamp.tv_usec = (ts % GST_SECOND) / 1000;
+
+  if (ioctl (self->video_fd, VIDIOC_QBUF, &buf) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_QBUF (OUTPUT) failed: %s",
+        g_strerror (errno));
+    return FALSE;
+  }
+
+  GST_TRACE_OBJECT (self, "Queued picture %" G_GUINT64_FORMAT " at index %d",
+      request->frame_id, index);
+
+  self->buffer_state[index].queued = TRUE;
+  self->buffer_state[index].dmabuf_fd = fd;
+  request->sink_index = index;
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_encoder_queue_src_buffer (GstV4l2Encoder * self,
+    GstV4l2EncodeRequest * request)
+{
+  struct v4l2_plane plane = { 0 };
+  struct v4l2_buffer buf = {
+    .type = self->src_buf_type,
+    .memory = V4L2_MEMORY_MMAP,
+    .index = gst_v4l2_codec_buffer_get_index (request->bitstream),
+  };
+
+  if (self->mplane) {
+    buf.length = 1;
+    buf.m.planes = &plane;
+  }
+
+  if (ioctl (self->video_fd, VIDIOC_QBUF, &buf) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_QBUF (CAPTURE) failed: %s",
+        g_strerror (errno));
+    return FALSE;
+  }
+
+  GST_TRACE_OBJECT (self, "Queued bitstream buffer %u", buf.index);
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_encoder_dequeue (GstV4l2Encoder * self, enum v4l2_buf_type type,
+    guint memory, struct v4l2_buffer *buf, struct v4l2_plane *planes,
+    GstClockTime timeout)
+{
+  memset (buf, 0, sizeof (*buf));
+  buf->type = type;
+  buf->memory = memory;
+  if (self->mplane) {
+    memset (planes, 0, sizeof (*planes) * GST_VIDEO_MAX_PLANES);
+    buf->length = GST_VIDEO_MAX_PLANES;
+    buf->m.planes = planes;
+  }
+
+  for (;;) {
+    struct pollfd pfd = {.fd = self->video_fd, };
+    gint ret;
+
+    if (ioctl (self->video_fd, VIDIOC_DQBUF, buf) == 0)
+      return TRUE;
+    if (errno != EAGAIN) {
+      GST_ERROR_OBJECT (self, "VIDIOC_DQBUF failed: %s", g_strerror (errno));
+      return FALSE;
+    }
+
+    pfd.events = V4L2_TYPE_IS_OUTPUT (type) ? POLLOUT : POLLIN;
+    ret = poll (&pfd, 1, timeout / GST_MSECOND);
+    if (ret == 0) {
+      GST_ERROR_OBJECT (self, "Timeout dequeuing a buffer");
+      return FALSE;
+    }
+    if (ret < 0 && errno != EINTR) {
+      GST_ERROR_OBJECT (self, "poll failed: %s", g_strerror (errno));
+      return FALSE;
+    }
+  }
+}
+
+gboolean
+gst_v4l2_encoder_set_controls (GstV4l2Encoder * self,
+    GstV4l2EncodeRequest * request, struct v4l2_ext_control *control,
+    guint count)
+{
+  struct v4l2_ext_controls controls = {
+    .controls = control,
+    .count = count,
+    .request_fd = request ? request->fd : 0,
+    .which = request ? V4L2_CTRL_WHICH_REQUEST_VAL : V4L2_CTRL_WHICH_CUR_VAL,
+  };
+
+  if (ioctl (self->video_fd, VIDIOC_S_EXT_CTRLS, &controls) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_S_EXT_CTRLS failed: %s (control %#x)",
+        g_strerror (errno), controls.error_idx < count ?
+        control[controls.error_idx].id : 0);
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_get_controls (GstV4l2Encoder * self,
+    GstV4l2EncodeRequest * request, struct v4l2_ext_control *control,
+    guint count)
+{
+  struct v4l2_ext_controls controls = {
+    .controls = control,
+    .count = count,
+    .request_fd = request ? request->fd : 0,
+    .which = request ? V4L2_CTRL_WHICH_REQUEST_VAL : V4L2_CTRL_WHICH_CUR_VAL,
+  };
+
+  if (ioctl (self->video_fd, VIDIOC_G_EXT_CTRLS, &controls) < 0) {
+    GST_DEBUG_OBJECT (self, "VIDIOC_G_EXT_CTRLS failed: %s",
+        g_strerror (errno));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+gboolean
+gst_v4l2_encoder_set_control (GstV4l2Encoder * self,
+    GstV4l2EncodeRequest * request, guint32 id, gint32 value)
+{
+  struct v4l2_ext_control control = {.id = id,.value = value, };
+
+  return gst_v4l2_encoder_set_controls (self, request, &control, 1);
+}
+
+gboolean
+gst_v4l2_encoder_query_control (GstV4l2Encoder * self, guint32 id,
+    struct v4l2_query_ext_ctrl * ctrl)
+{
+  memset (ctrl, 0, sizeof (*ctrl));
+  ctrl->id = id;
+
+  /* A missing control is not an error. */
+  return ioctl (self->video_fd, VIDIOC_QUERY_EXT_CTRL, ctrl) == 0;
+}
+
+gboolean
+gst_v4l2_encoder_query_menu (GstV4l2Encoder * self, guint32 id, guint32 index)
+{
+  struct v4l2_querymenu menu = {.id = id,.index = index, };
+
+  return ioctl (self->video_fd, VIDIOC_QUERYMENU, &menu) == 0;
+}
+
+void
+gst_v4l2_encoder_install_properties (GObjectClass * gobject_class,
+    gint prop_offset, GstV4l2CodecDevice * device)
+{
+  const gchar *media_device_path = NULL;
+  const gchar *video_device_path = NULL;
+
+  if (device) {
+    media_device_path = device->media_device_path;
+    video_device_path = device->video_device_path;
+  }
+
+  g_object_class_install_property (gobject_class, prop_offset +
+      PROP_MEDIA_DEVICE, g_param_spec_string ("media-device",
+          "Media Device Path", "Path to the media device node",
+          media_device_path, G_PARAM_CONSTRUCT_ONLY | G_PARAM_READWRITE |
+          G_PARAM_STATIC_STRINGS));
+
+  g_object_class_install_property (gobject_class, prop_offset +
+      PROP_VIDEO_DEVICE, g_param_spec_string ("video-device",
+          "Video Device Path", "Path to the video device node",
+          video_device_path, G_PARAM_CONSTRUCT_ONLY | G_PARAM_READWRITE |
+          G_PARAM_STATIC_STRINGS));
+}
+
+void
+gst_v4l2_encoder_set_property (GObject * object, guint prop_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstV4l2Encoder *self = GST_V4L2_ENCODER (object);
+
+  switch (prop_id) {
+    case PROP_MEDIA_DEVICE:
+      g_free (self->media_device);
+      self->media_device = g_value_dup_string (value);
+      break;
+    case PROP_VIDEO_DEVICE:
+      g_free (self->video_device);
+      self->video_device = g_value_dup_string (value);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+
+void
+gst_v4l2_encoder_get_property (GObject * object, guint prop_id,
+    GValue * value, GParamSpec * pspec)
+{
+  GstV4l2Encoder *self = GST_V4L2_ENCODER (object);
+
+  switch (prop_id) {
+    case PROP_MEDIA_DEVICE:
+      g_value_set_string (value, self->media_device);
+      break;
+    case PROP_VIDEO_DEVICE:
+      g_value_set_string (value, self->video_device);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+
+/**
+ * gst_v4l2_encoder_register:
+ * @plugin: a #GstPlugin
+ * @enc_type: A #GType for the codec
+ * @class_init: The #GClassInitFunc for #enc_type
+ * @class_data: (transfer full) A #gpointer to pass as class_data
+ * @instance_init: The #GInstanceInitFunc for #enc_type
+ * @element_name_tmpl: A string to use for the first codec found and as a
+ *   template for the next ones.
+ * @device: (transfer full) A #GstV4l2CodecDevice
+ * @rank: The rank to use for the element
+ * @element_name: (nullable) (out) Sets the pointer to the new element name
+ *
+ * Registers an encoder element as a subtype of @enc_type for @plugin. The
+ * first device gets a constant name like v4l2slh264enc, the next ones one
+ * that contains the video device name.
+ */
+void
+gst_v4l2_encoder_register (GstPlugin * plugin, GType enc_type,
+    GClassInitFunc class_init, gconstpointer class_data,
+    GInstanceInitFunc instance_init, const gchar * element_name_tmpl,
+    GstV4l2CodecDevice * device, guint rank, gchar ** element_name)
+{
+  GTypeQuery type_query;
+  GTypeInfo type_info = { 0, };
+  GType subtype;
+  gchar *type_name;
+
+  g_type_query (enc_type, &type_query);
+  type_info.class_size = type_query.class_size;
+  type_info.instance_size = type_query.instance_size;
+  type_info.class_init = class_init;
+  type_info.class_data = class_data;
+  type_info.instance_init = instance_init;
+
+  if (class_data == device)
+    GST_MINI_OBJECT_FLAG_SET (device, GST_MINI_OBJECT_FLAG_MAY_BE_LEAKED);
+
+  type_name = g_strdup_printf (element_name_tmpl, "");
+  if (g_type_from_name (type_name) != 0) {
+    gchar *basename = g_path_get_basename (device->video_device_path);
+    g_free (type_name);
+    type_name = g_strdup_printf (element_name_tmpl, basename);
+    g_free (basename);
+  }
+
+  subtype = g_type_register_static (enc_type, type_name, &type_info, 0);
+
+  if (!gst_element_register (plugin, type_name, rank, subtype)) {
+    GST_WARNING ("Failed to register plugin '%s'", type_name);
+    g_free (type_name);
+    type_name = NULL;
+  }
+
+  if (element_name)
+    *element_name = type_name;
+  else
+    g_free (type_name);
+}
+
+/**
+ * gst_v4l2_encoder_alloc_request:
+ * @self: a #GstV4l2Encoder
+ * @frame_id: identifies the picture; its V4L2 timestamp is
+ *   GST_V4L2_ENCODER_FRAME_TS (@frame_id), which the uAPIs use to refer to
+ *   reference pictures
+ * @pic_buf: the #GstBuffer holding the raw picture (an importable dma-buf)
+ * @bitstream: the #GstBuffer from the bitstream pool
+ *
+ * Returns: (transfer full): a new #GstV4l2EncodeRequest
+ */
+GstV4l2EncodeRequest *
+gst_v4l2_encoder_alloc_request (GstV4l2Encoder * self, guint64 frame_id,
+    GstBuffer * pic_buf, GstBuffer * bitstream)
+{
+  GstV4l2EncodeRequest *request = g_queue_pop_head (&self->request_pool);
+
+  if (!request) {
+    request = g_new0 (GstV4l2EncodeRequest, 1);
+
+    if (ioctl (self->media_fd, MEDIA_IOC_REQUEST_ALLOC, &request->fd) < 0) {
+      GST_ERROR_OBJECT (self, "MEDIA_IOC_REQUEST_ALLOC failed: %s",
+          g_strerror (errno));
+      g_free (request);
+      return NULL;
+    }
+  }
+
+  request->encoder = gst_object_ref (self);
+  request->frame_id = frame_id;
+  request->pic_buf = gst_buffer_ref (pic_buf);
+  request->bitstream = gst_buffer_ref (bitstream);
+  request->sink_index = -1;
+  request->pending = FALSE;
+
+  return request;
+}
+
+gboolean
+gst_v4l2_encode_request_queue (GstV4l2EncodeRequest * request)
+{
+  GstV4l2Encoder *self = request->encoder;
+
+  if (!gst_v4l2_encoder_queue_sink_buffer (self, request))
+    return FALSE;
+
+  if (!gst_v4l2_encoder_queue_src_buffer (self, request))
+    return FALSE;
+
+  if (ioctl (request->fd, MEDIA_REQUEST_IOC_QUEUE, NULL) < 0) {
+    GST_ERROR_OBJECT (self, "MEDIA_REQUEST_IOC_QUEUE failed: %s",
+        g_strerror (errno));
+    return FALSE;
+  }
+
+  request->pending = TRUE;
+
+  return TRUE;
+}
+
+/**
+ * gst_v4l2_encode_request_wait:
+ *
+ * Waits for @request, which must be the oldest pending request, and
+ * dequeues its buffers. The request's controls can be read back with
+ * gst_v4l2_encoder_get_controls() until gst_v4l2_encode_request_recycle().
+ *
+ * Returns: %FALSE on a timeout, a dequeue error or an encoding error.
+ */
+gboolean
+gst_v4l2_encode_request_wait (GstV4l2EncodeRequest * request,
+    GstClockTime timeout, guint32 * bytesused, guint32 * flags)
+{
+  GstV4l2Encoder *self = request->encoder;
+  struct v4l2_plane planes[GST_VIDEO_MAX_PLANES];
+  struct v4l2_buffer buf;
+  struct pollfd pfd = {.fd = request->fd,.events = POLLPRI, };
+  guint64 ts = GST_V4L2_ENCODER_FRAME_TS (request->frame_id);
+  guint64 got;
+  gboolean ret = TRUE;
+  gint pret;
+
+  *bytesused = 0;
+  *flags = 0;
+
+  if (!request->pending)
+    return FALSE;
+
+  do {
+    pret = poll (&pfd, 1, timeout / GST_MSECOND);
+  } while (pret < 0 && errno == EINTR);
+
+  if (pret == 0) {
+    GST_ERROR_OBJECT (self, "Request for picture %" G_GUINT64_FORMAT
+        " timed out", request->frame_id);
+    return FALSE;
+  }
+  if (pret < 0) {
+    GST_ERROR_OBJECT (self, "poll failed: %s", g_strerror (errno));
+    return FALSE;
+  }
+
+  request->pending = FALSE;
+
+  if (!gst_v4l2_encoder_dequeue (self, self->sink_buf_type,
+          V4L2_MEMORY_DMABUF, &buf, planes, timeout))
+    return FALSE;
+  if (buf.index < VIDEO_MAX_FRAME)
+    self->buffer_state[buf.index].queued = FALSE;
+  if ((gint) buf.index != request->sink_index)
+    GST_WARNING_OBJECT (self, "Dequeued picture index %u, expected %d",
+        buf.index, request->sink_index);
+
+  if (!gst_v4l2_encoder_dequeue (self, self->src_buf_type, V4L2_MEMORY_MMAP,
+          &buf, planes, timeout))
+    return FALSE;
+
+  got = (guint64) buf.timestamp.tv_sec * GST_SECOND +
+      (guint64) buf.timestamp.tv_usec * 1000;
+  if (got != ts) {
+    GST_ERROR_OBJECT (self, "Bitstream of picture %" G_GUINT64_FORMAT
+        " expected, got timestamp %" G_GUINT64_FORMAT, request->frame_id, got);
+    ret = FALSE;
+  }
+
+  if (buf.flags & V4L2_BUF_FLAG_ERROR) {
+    GST_ERROR_OBJECT (self, "Driver reported an error encoding picture %"
+        G_GUINT64_FORMAT, request->frame_id);
+    ret = FALSE;
+  }
+
+  *bytesused = self->mplane ? planes[0].bytesused : buf.bytesused;
+  *flags = buf.flags;
+
+  GST_TRACE_OBJECT (self, "Picture %" G_GUINT64_FORMAT " done: %u bytes",
+      request->frame_id, *bytesused);
+
+  return ret;
+}
+
+GstBuffer *
+gst_v4l2_encode_request_get_bitstream (GstV4l2EncodeRequest * request)
+{
+  return request->bitstream;
+}
+
+static void
+request_clear (GstV4l2EncodeRequest * request)
+{
+  gst_clear_buffer (&request->bitstream);
+  gst_clear_buffer (&request->pic_buf);
+  gst_clear_object (&request->encoder);
+}
+
+/* Returns the request to the pool once it is complete. A request that is
+ * still pending (cancelled by STREAMOFF) is closed instead. */
+void
+gst_v4l2_encode_request_recycle (GstV4l2EncodeRequest * request)
+{
+  GstV4l2Encoder *self = gst_object_ref (request->encoder);
+
+  if (request->pending
+      || ioctl (request->fd, MEDIA_REQUEST_IOC_REINIT, NULL) < 0) {
+    request_clear (request);
+    close (request->fd);
+    g_free (request);
+  } else {
+    request_clear (request);
+    g_queue_push_tail (&self->request_pool, request);
+  }
+
+  gst_object_unref (self);
+}
+
+void
+gst_v4l2_encode_request_free (GstV4l2EncodeRequest * request)
+{
+  request_clear (request);
+  close (request->fd);
+  g_free (request);
+}
