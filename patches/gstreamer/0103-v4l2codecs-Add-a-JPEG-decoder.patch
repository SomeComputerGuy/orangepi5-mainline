+/**
+ * SECTION:element-v4l2sljpegdec
+ * @title: v4l2sljpegdec
+ * @short_description: V4L2 request-based JPEG image decoder
+ *
+ * Decodes baseline JPEG images and Motion JPEG through a V4L2 memory-to-memory
+ * decoder that sits on a media device (the Allwinner cedrus VPU) and takes
+ * one complete JFIF image per OUTPUT buffer. The driver parses the headers
+ * itself, so no codec controls are passed; the media request only binds the
+ * image to its picture buffer.
+ *
+ * The sink caps only accept what the hardware path decodes, as jpegparse
+ * describes it: baseline or extended sequential Huffman coding, YCbCr with
+ * 4:2:0, 4:2:2, 4:4:4 or 4:1:1 sampling and 1x1 chroma sampling factors,
+ * progressive scan (not field-interleaved MJPEG). Greyscale, RGB, CMYK,
+ * progressive and lossless JPEG and other sampling factor layouts are
+ * refused at caps negotiation, so decodebin and playbin pick a software
+ * decoder (jpegdec) for them. What the caps do not show (12-bit samples, a
+ * non-interleaved scan) is checked on every image and reported as an error;
+ * images the driver refuses (e.g. different Cb and Cr tables) are dropped
+ * with a decode error.
+ *
+ * ## Example launch line
+ * ```
+ * gst-launch-1.0 filesrc location=picture.jpg ! jpegparse ! v4l2sljpegdec ! imagefreeze ! autovideosink
+ * ```
+ *
+ * Since: 1.30
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#define GST_USE_UNSTABLE_API
+#include <gst/codecparsers/gstjpegparser.h>
+
+#include "gstv4l2codecallocator.h"
+#include "gstv4l2codecjpegdec.h"
+#include "gstv4l2codecpool.h"
+#include "gstv4l2format.h"
+
+GST_DEBUG_CATEGORY_STATIC (v4l2_jpegdec_debug);
+#define GST_CAT_DEFAULT v4l2_jpegdec_debug
+
+#define GST_V4L2_CODEC_JPEG_DEC(obj) ((GstV4l2CodecJpegDec *) obj)
+
+enum
+{
+  PROP_0,
+  PROP_LAST = PROP_0
+};
+
+/* What jpegparse puts in its caps, restricted to what the hardware path
+ * decodes (see the class documentation). sampling-factors lists the HxV
+ * factors of Y, Cb and Cr: the chroma ones must be 1x1. */
+static GstStaticCaps static_sink_caps = GST_STATIC_CAPS ("image/jpeg, "
+    "parsed = (boolean) true, "
+    "sof-marker = (int) { 0, 1 }, "
+    "colorspace = (string) sYUV, "
+    "sampling-factors = (string) { \"2x2:1x1:1x1\", \"2x1:1x1:1x1\", "
+    "\"1x1:1x1:1x1\", \"4x1:1x1:1x1\" }, "
+    "interlace-mode = (string) progressive");
+
+#define SRC_CAPS \
+    GST_VIDEO_DMA_DRM_CAPS_MAKE " ; " \
+    GST_VIDEO_CAPS_MAKE (GST_V4L2_DEFAULT_VIDEO_FORMATS)
+
+#define SRC_CAPS_NO_DRM \
+    GST_VIDEO_CAPS_MAKE (GST_V4L2_DEFAULT_VIDEO_FORMATS)
+
+static GstStaticCaps static_src_caps = GST_STATIC_CAPS (SRC_CAPS);
+static GstStaticCaps static_src_caps_no_drm = GST_STATIC_CAPS (SRC_CAPS_NO_DRM);
+
+/* 4:1:1 is decoded through a bounce buffer and resampled by the driver, which
+ * only writes linear capture formats then. */
+static GstStaticCaps static_src_caps_linear =
+GST_STATIC_CAPS (GST_VIDEO_CAPS_MAKE ("{ NV12, I420 }"));
+
+typedef struct _GstV4l2CodecJpegDec GstV4l2CodecJpegDec;
+typedef struct _GstV4l2CodecJpegDecClass GstV4l2CodecJpegDecClass;
+
+struct _GstV4l2CodecJpegDecClass
+{
+  GstVideoDecoderClass parent_class;
+  GstV4l2CodecDevice *device;
+};
+
+struct _GstV4l2CodecJpegDec
+{
+  GstVideoDecoder parent;
+  GstV4l2Decoder *decoder;
+  GstVideoCodecState *input_state;
+  GstVideoCodecState *output_state;
+  GstVideoInfoDmaDrm vinfo_drm;
+  gint width;
+  gint height;
+  gboolean linear_only;
+  gsize bitstream_size;
+
+  GstV4l2CodecAllocator *sink_allocator;
+  GstV4l2CodecAllocator *src_allocator;
+  GstV4l2CodecPool *src_pool;
+  gboolean streaming;
+  gboolean copy_frames;
+};
+
+typedef enum
+{
+  JPEG_OK,
+  JPEG_UNSUPPORTED,
+  JPEG_CORRUPT,
+} GstV4l2CodecJpegCheck;
+
+typedef struct
+{
+  guint width;
+  guint height;
+  gboolean linear_only;
+} GstV4l2CodecJpegInfo;
+
+static GstElementClass *parent_class = NULL;
+
+/* Check the parts of the image the hardware path cares about; *reason says
+ * what is wrong unless JPEG_OK is returned. */
+static GstV4l2CodecJpegCheck
+gst_v4l2_codec_jpeg_dec_parse (const guint8 * data, gsize size,
+    GstV4l2CodecJpegInfo * info, const gchar ** reason)
+{
+  GstJpegFrameHdr frame = { 0, };
+  GstJpegScanHdr scan = { 0, };
+  GstJpegSegment seg;
+  gboolean have_frame = FALSE;
+  guint offset = 0;
+  guint h0, v0, i;
+
+  *reason = "no start of frame or start of scan";
+
+  while (gst_jpeg_parse (&seg, data, size, offset)) {
+    if (seg.size < 0) {
+      *reason = "truncated segment";
+      return JPEG_CORRUPT;
+    }
+
+    if (seg.marker >= GST_JPEG_MARKER_SOF_MIN &&
+        seg.marker <= GST_JPEG_MARKER_SOF_MAX &&
+        seg.marker != GST_JPEG_MARKER_DHT &&
+        seg.marker != 0xc8 /* JPG */ && seg.marker != GST_JPEG_MARKER_DAC) {
+      if (have_frame) {
+        *reason = "more than one frame header";
+        return JPEG_CORRUPT;
+      }
+      if (seg.marker != GST_JPEG_MARKER_SOF0 &&
+          seg.marker != GST_JPEG_MARKER_SOF1) {
+        *reason = "not baseline or extended sequential Huffman coding";
+        return JPEG_UNSUPPORTED;
+      }
+      if (!gst_jpeg_segment_parse_frame_header (&seg, &frame)) {
+        *reason = "invalid frame header";
+        return JPEG_CORRUPT;
+      }
+      have_frame = TRUE;
+    } else if (seg.marker == GST_JPEG_MARKER_SOS) {
+      if (!have_frame)
+        return JPEG_CORRUPT;
+      if (!gst_jpeg_segment_parse_scan_header (&seg, &scan)) {
+        *reason = "invalid scan header";
+        return JPEG_CORRUPT;
+      }
+      break;
+    } else if (seg.marker == GST_JPEG_MARKER_EOI) {
+      return JPEG_CORRUPT;
+    }
+
+    offset = seg.offset + seg.size;
+  }
+
+  if (!have_frame || scan.num_components == 0)
+    return JPEG_CORRUPT;
+
+  if (frame.sample_precision != 8) {
+    *reason = "sample precision is not 8 bits";
+    return JPEG_UNSUPPORTED;
+  }
+  if (frame.width == 0 || frame.height == 0) {
+    *reason = "image size not in the frame header (DNL)";
+    return JPEG_UNSUPPORTED;
+  }
+  if (frame.num_components != 3) {
+    *reason = "not 3 components";
+    return JPEG_UNSUPPORTED;
+  }
+  if (scan.num_components != frame.num_components) {
+    *reason = "non-interleaved scan";
+    return JPEG_UNSUPPORTED;
+  }
+  for (i = 0; i < 3; i++) {
+    if (scan.components[i].component_selector != frame.components[i].identifier) {
+      *reason = "scan component order differs from the frame";
+      return JPEG_UNSUPPORTED;
+    }
+  }
+  for (i = 1; i < 3; i++) {
+    if (frame.components[i].horizontal_factor != 1 ||
+        frame.components[i].vertical_factor != 1) {
+      *reason = "chroma sampling factors are not 1x1";
+      return JPEG_UNSUPPORTED;
+    }
+  }
+
+  h0 = frame.components[0].horizontal_factor;
+  v0 = frame.components[0].vertical_factor;
+  switch (h0 << 4 | v0) {
+    case 0x11:                 /* 4:4:4 */
+    case 0x21:                 /* 4:2:2 */
+    case 0x22:                 /* 4:2:0 */
+      info->linear_only = FALSE;
+      break;
+    case 0x41:                 /* 4:1:1 */
+      info->linear_only = TRUE;
+      break;
+    default:
+      *reason = "luma sampling factors";
+      return JPEG_UNSUPPORTED;
+  }
+
+  info->width = frame.width;
+  info->height = frame.height;
+  *reason = NULL;
+  return JPEG_OK;
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_open (GstVideoDecoder * decoder)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+
+  if (!gst_v4l2_decoder_open (self->decoder)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, OPEN_READ_WRITE,
+        ("Failed to open JPEG decoder"),
+        ("gst_v4l2_decoder_open() failed: %s", g_strerror (errno)));
+    return FALSE;
+  }
+
+  /* One image in flight: the decode is waited for in handle_frame(). */
+  gst_v4l2_decoder_set_render_delay (self->decoder, 0);
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_close (GstVideoDecoder * decoder)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+  gst_v4l2_decoder_close (self->decoder);
+  return TRUE;
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_streamoff (GstV4l2CodecJpegDec * self)
+{
+  if (self->streaming) {
+    gst_v4l2_decoder_streamoff (self->decoder, GST_PAD_SINK);
+    gst_v4l2_decoder_streamoff (self->decoder, GST_PAD_SRC);
+    self->streaming = FALSE;
+  }
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_reset_allocation (GstV4l2CodecJpegDec * self)
+{
+  if (self->sink_allocator) {
+    gst_v4l2_codec_allocator_detach (self->sink_allocator);
+    g_clear_object (&self->sink_allocator);
+  }
+
+  if (self->src_allocator) {
+    gst_v4l2_codec_allocator_detach (self->src_allocator);
+    g_clear_object (&self->src_allocator);
+    g_clear_object (&self->src_pool);
+  }
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_start (GstVideoDecoder * decoder)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+
+  self->width = 0;
+  self->height = 0;
+  self->linear_only = FALSE;
+  self->bitstream_size = 0;
+  gst_video_info_dma_drm_init (&self->vinfo_drm);
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_stop (GstVideoDecoder * decoder)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+
+  gst_v4l2_codec_jpeg_dec_streamoff (self);
+  gst_v4l2_codec_jpeg_dec_reset_allocation (self);
+
+  g_clear_pointer (&self->output_state, gst_video_codec_state_unref);
+  g_clear_pointer (&self->input_state, gst_video_codec_state_unref);
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_set_format (GstVideoDecoder * decoder,
+    GstVideoCodecState * state)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+
+  GST_DEBUG_OBJECT (self, "Input caps %" GST_PTR_FORMAT, state->caps);
+
+  g_clear_pointer (&self->input_state, gst_video_codec_state_unref);
+  self->input_state = gst_video_codec_state_ref (state);
+
+  /* The size and the sampling are taken from each image. */
+  return TRUE;
+}
+
+/* JPEG is full range BT.601; say so like jpegdec does. */
+static void
+gst_v4l2_codec_jpeg_dec_set_colorimetry (GstVideoCodecState * state,
+    GstVideoInfoDmaDrm * vinfo_drm)
+{
+  state->info.colorimetry.range = GST_VIDEO_COLOR_RANGE_0_255;
+  state->info.colorimetry.matrix = GST_VIDEO_COLOR_MATRIX_BT601;
+  state->info.colorimetry.transfer = GST_VIDEO_TRANSFER_UNKNOWN;
+  state->info.colorimetry.primaries = GST_VIDEO_COLOR_PRIMARIES_UNKNOWN;
+  state->info.chroma_site = GST_VIDEO_CHROMA_SITE_NONE;
+
+  gst_clear_caps (&state->caps);
+  if (vinfo_drm->drm_fourcc /* != DRM_FORMAT_INVALID */ ) {
+    GstVideoInfoDmaDrm tmp_vinfo_drm;
+
+    gst_video_info_dma_drm_init (&tmp_vinfo_drm);
+    tmp_vinfo_drm.vinfo = state->info;
+    tmp_vinfo_drm.drm_fourcc = vinfo_drm->drm_fourcc;
+    tmp_vinfo_drm.drm_modifier = vinfo_drm->drm_modifier;
+    state->caps = gst_video_info_dma_drm_to_caps (&tmp_vinfo_drm);
+  } else {
+    state->caps = gst_video_info_to_caps (&state->info);
+  }
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_negotiate (GstVideoDecoder * decoder)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+  GstCaps *peer_caps, *filter, *caps;
+  GstStaticCaps *static_filter;
+  guint bitdepth;
+
+  /* Ignore downstream renegotiation request. */
+  if (self->streaming)
+    goto done;
+
+  if (self->width == 0 || self->height == 0) {
+    /* Nothing decoded yet: wait for the first image. */
+    GST_DEBUG_OBJECT (self, "No image yet, delaying negotiation");
+    return TRUE;
+  }
+
+  GST_DEBUG_OBJECT (self, "Negotiate %dx%d", self->width, self->height);
+
+  gst_v4l2_codec_jpeg_dec_reset_allocation (self);
+
+  /* The coded size of a JPEG has no fixed bound: size the OUTPUT buffers
+   * from the image at hand (handle_frame() renegotiates if a later one is
+   * bigger). */
+  bitdepth = MAX (8, (guint) ((self->bitstream_size * 8 +
+              (gsize) self->width * self->height - 1) /
+          ((gsize) self->width * self->height)));
+
+  if (!gst_v4l2_decoder_set_sink_fmt (self->decoder, V4L2_PIX_FMT_JPEG,
+          self->width, self->height, bitdepth)) {
+    GST_ELEMENT_ERROR (self, CORE, NEGOTIATION,
+        ("Failed to configure JPEG decoder"),
+        ("gst_v4l2_decoder_set_sink_fmt() failed: %s", g_strerror (errno)));
+    gst_v4l2_decoder_close (self->decoder);
+    return FALSE;
+  }
+
+  /* If the peer has ANY caps only advertise system memory caps */
+  peer_caps = gst_pad_peer_query_caps (decoder->srcpad, NULL);
+  if (self->linear_only)
+    static_filter = &static_src_caps_linear;
+  else if (gst_caps_is_any (peer_caps))
+    static_filter = &static_src_caps_no_drm;
+  else
+    static_filter = &static_src_caps;
+  gst_caps_unref (peer_caps);
+
+  filter = gst_v4l2_decoder_enum_src_formats (self->decoder, static_filter);
+  if (!filter || gst_caps_is_empty (filter)) {
+    gst_clear_caps (&filter);
+    GST_ELEMENT_ERROR (self, CORE, NEGOTIATION,
+        ("No supported decoder output formats"), (NULL));
+    return FALSE;
+  }
+  GST_DEBUG_OBJECT (self, "Supported output formats: %" GST_PTR_FORMAT, filter);
+
+  caps = gst_pad_peer_query_caps (decoder->srcpad, filter);
+  gst_caps_unref (filter);
+  GST_DEBUG_OBJECT (self, "Peer supported formats: %" GST_PTR_FORMAT, caps);
+
+  if (!gst_v4l2_decoder_select_src_format (self->decoder, caps,
+          &self->vinfo_drm)) {
+    GST_ELEMENT_ERROR (self, CORE, NEGOTIATION,
+        ("Unsupported pixel format"),
+        ("No support for %ux%u format %s", self->width, self->height,
+            gst_video_format_to_string (GST_VIDEO_INFO_FORMAT (&self->
+                    vinfo_drm.vinfo))));
+    gst_caps_unref (caps);
+    return FALSE;
+  }
+  gst_caps_unref (caps);
+
+done:
+  g_clear_pointer (&self->output_state, gst_video_codec_state_unref);
+
+  self->output_state =
+      gst_v4l2_decoder_set_output_state (GST_VIDEO_DECODER (self),
+      &self->vinfo_drm, self->width, self->height, self->input_state);
+  gst_v4l2_codec_jpeg_dec_set_colorimetry (self->output_state,
+      &self->vinfo_drm);
+
+  if (GST_VIDEO_DECODER_CLASS (parent_class)->negotiate (decoder)) {
+    if (self->streaming)
+      return TRUE;
+
+    if (!gst_v4l2_decoder_streamon (self->decoder, GST_PAD_SINK)) {
+      GST_ELEMENT_ERROR (self, RESOURCE, FAILED,
+          ("Could not enable the decoder driver."),
+          ("VIDIOC_STREAMON(SINK) failed: %s", g_strerror (errno)));
+      return FALSE;
+    }
+
+    if (!gst_v4l2_decoder_streamon (self->decoder, GST_PAD_SRC)) {
+      GST_ELEMENT_ERROR (self, RESOURCE, FAILED,
+          ("Could not enable the decoder driver."),
+          ("VIDIOC_STREAMON(SRC) failed: %s", g_strerror (errno)));
+      return FALSE;
+    }
+
+    self->streaming = TRUE;
+
+    return TRUE;
+  }
+
+  return FALSE;
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_decide_allocation (GstVideoDecoder * decoder,
+    GstQuery * query)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+  GstCaps *caps = NULL;
+  guint min = 0;
+  gboolean has_videometa;
+
+  if (self->streaming)
+    goto no_internal_changes;
+
+  g_clear_object (&self->src_pool);
+  g_clear_object (&self->src_allocator);
+  g_clear_object (&self->sink_allocator);
+
+  has_videometa = gst_query_find_allocation_meta (query,
+      GST_VIDEO_META_API_TYPE, NULL);
+
+  gst_query_parse_allocation (query, &caps, NULL);
+  if (!caps) {
+    GST_ERROR_OBJECT (self, "No valid caps");
+    return FALSE;
+  }
+
+  if (gst_video_is_dma_drm_caps (caps) && !has_videometa) {
+    GST_ERROR_OBJECT (self,
+        "DMABuf caps negotiated without the mandatory support of VideoMeta");
+    return FALSE;
+  }
+
+  /* Check if we can zero-copy buffers */
+  self->copy_frames = FALSE;
+  if (!has_videometa) {
+    GstVideoInfo ref_vinfo;
+    gint i;
+
+    gst_video_info_set_format (&ref_vinfo,
+        GST_VIDEO_INFO_FORMAT (&self->vinfo_drm.vinfo), self->width,
+        self->height);
+
+    for (i = 0; i < GST_VIDEO_INFO_N_PLANES (&self->vinfo_drm.vinfo); i++) {
+      if (self->vinfo_drm.vinfo.stride[i] != ref_vinfo.stride[i] ||
+          self->vinfo_drm.vinfo.offset[i] != ref_vinfo.offset[i]) {
+        GST_WARNING_OBJECT (self,
+            "GstVideoMeta support required, copying frames.");
+        self->copy_frames = TRUE;
+        break;
+      }
+    }
+  }
+
+  if (gst_query_get_n_allocation_pools (query) > 0)
+    gst_query_parse_nth_allocation_pool (query, 0, NULL, NULL, &min, NULL);
+
+  min = MAX (2, min);
+
+  /* One image is decoded at a time; the second OUTPUT buffer lets the next
+   * image be copied in while the previous one is released. */
+  self->sink_allocator = gst_v4l2_codec_allocator_new (self->decoder,
+      GST_PAD_SINK, 2);
+  if (!self->sink_allocator) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Not enough memory to allocate sink buffers."), (NULL));
+    return FALSE;
+  }
+
+  self->src_allocator = gst_v4l2_codec_allocator_new (self->decoder,
+      GST_PAD_SRC, min + 2);
+  if (!self->src_allocator) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Not enough memory to allocate source buffers."), (NULL));
+    g_clear_object (&self->sink_allocator);
+    return FALSE;
+  }
+
+  self->src_pool =
+      gst_v4l2_codec_pool_new (self->src_allocator, &self->vinfo_drm);
+
+no_internal_changes:
+  /* Our buffer pool is internal, we will let the base class create a video
+   * pool, and use it if we are running out of buffers or if downstream does
+   * not support GstVideoMeta */
+  return GST_VIDEO_DECODER_CLASS (parent_class)->decide_allocation
+      (decoder, query);
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_copy_output_buffer (GstV4l2CodecJpegDec * self,
+    GstVideoCodecFrame * codec_frame)
+{
+  GstVideoFrame src_frame;
+  GstVideoFrame dest_frame;
+  GstVideoInfo dest_vinfo;
+  GstBuffer *buffer;
+
+  gst_video_info_set_format (&dest_vinfo,
+      GST_VIDEO_INFO_FORMAT (&self->vinfo_drm.vinfo), self->width,
+      self->height);
+
+  buffer = gst_video_decoder_allocate_output_buffer (GST_VIDEO_DECODER (self));
+  if (!buffer)
+    goto fail;
+
+  if (!gst_video_frame_map (&src_frame, &self->vinfo_drm.vinfo,
+          codec_frame->output_buffer, GST_MAP_READ)) {
+    gst_buffer_unref (buffer);
+    goto fail;
+  }
+
+  if (!gst_video_frame_map (&dest_frame, &dest_vinfo, buffer, GST_MAP_WRITE)) {
+    gst_video_frame_unmap (&src_frame);
+    gst_buffer_unref (buffer);
+    goto fail;
+  }
+
+  /* gst_video_frame_copy can crop this, but does not know, so let make it
+   * think it's all right */
+  GST_VIDEO_INFO_WIDTH (&src_frame.info) = self->width;
+  GST_VIDEO_INFO_HEIGHT (&src_frame.info) = self->height;
+
+  if (!gst_video_frame_copy (&dest_frame, &src_frame)) {
+    gst_video_frame_unmap (&src_frame);
+    gst_video_frame_unmap (&dest_frame);
+    gst_buffer_unref (buffer);
+    goto fail;
+  }
+
+  gst_video_frame_unmap (&src_frame);
+  gst_video_frame_unmap (&dest_frame);
+  gst_buffer_replace (&codec_frame->output_buffer, buffer);
+  gst_buffer_unref (buffer);
+
+  return TRUE;
+
+fail:
+  GST_ERROR_OBJECT (self, "Failed copy output buffer.");
+  return FALSE;
+}
+
+static GstFlowReturn
+gst_v4l2_codec_jpeg_dec_handle_frame (GstVideoDecoder * decoder,
+    GstVideoCodecFrame * frame)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+  GstV4l2CodecJpegInfo info = { 0, };
+  GstV4l2Request *request = NULL;
+  GstMemory *bitstream = NULL;
+  GstMapInfo in_map = GST_MAP_INFO_INIT, bs_map = GST_MAP_INFO_INIT;
+  GstFlowReturn flow_ret = GST_FLOW_OK;
+  GstBuffer *buffer;
+  GstV4l2CodecJpegCheck check;
+  const gchar *reason;
+  gsize size;
+  gint ret;
+
+  if (!gst_buffer_map (frame->input_buffer, &in_map, GST_MAP_READ)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, READ,
+        ("Could not map the input image"), (NULL));
+    gst_video_decoder_release_frame (decoder, frame);
+    return GST_FLOW_ERROR;
+  }
+  size = in_map.size;
+
+  check = gst_v4l2_codec_jpeg_dec_parse (in_map.data, size, &info, &reason);
+  if (check != JPEG_OK) {
+    gst_buffer_unmap (frame->input_buffer, &in_map);
+    if (check == JPEG_UNSUPPORTED) {
+      /* A valid image the hardware cannot decode: the caps did not show it,
+       * so the stream is not for this element. */
+      GST_ELEMENT_ERROR (self, STREAM, WRONG_TYPE,
+          ("JPEG image not supported by the hardware decoder"),
+          ("%s", reason));
+      gst_video_decoder_release_frame (decoder, frame);
+      return GST_FLOW_NOT_SUPPORTED;
+    }
+    /* Broken image (MJPEG streams have them): drop it. */
+    flow_ret = GST_FLOW_OK;
+    GST_VIDEO_DECODER_ERROR (self, 1, STREAM, DECODE,
+        ("Corrupt JPEG image"), ("%s", reason), flow_ret);
+    gst_video_decoder_drop_frame (decoder, frame);
+    return flow_ret;
+  }
+
+  if (!self->streaming || info.width != (guint) self->width ||
+      info.height != (guint) self->height ||
+      info.linear_only != self->linear_only ||
+      size > self->bitstream_size) {
+    gboolean resized = info.width != (guint) self->width ||
+        info.height != (guint) self->height;
+
+    gst_v4l2_codec_jpeg_dec_streamoff (self);
+    self->width = info.width;
+    self->height = info.height;
+    self->linear_only = info.linear_only;
+    if (resized || size > self->bitstream_size)
+      self->bitstream_size = MAX (size * 2, self->bitstream_size);
+
+    GST_INFO_OBJECT (self, "Image %ux%u%s, %" G_GSIZE_FORMAT " bytes",
+        info.width, info.height, info.linear_only ? " (4:1:1)" : "", size);
+
+    if (!gst_video_decoder_negotiate (decoder)) {
+      gst_buffer_unmap (frame->input_buffer, &in_map);
+      GST_ERROR_OBJECT (self, "Failed to negotiate with downstream");
+      gst_video_decoder_release_frame (decoder, frame);
+      return GST_FLOW_NOT_NEGOTIATED;
+    }
+  }
+
+  bitstream = gst_v4l2_codec_allocator_alloc (self->sink_allocator);
+  if (!bitstream) {
+    gst_buffer_unmap (frame->input_buffer, &in_map);
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Not enough memory to decode JPEG image."), (NULL));
+    gst_video_decoder_release_frame (decoder, frame);
+    return GST_FLOW_ERROR;
+  }
+
+  if (!gst_memory_map (bitstream, &bs_map, GST_MAP_WRITE)) {
+    gst_buffer_unmap (frame->input_buffer, &in_map);
+    gst_memory_unref (bitstream);
+    GST_ELEMENT_ERROR (self, RESOURCE, WRITE,
+        ("Could not access bitstream memory for writing"), (NULL));
+    gst_video_decoder_release_frame (decoder, frame);
+    return GST_FLOW_ERROR;
+  }
+
+  if (bs_map.maxsize < size) {
+    /* The driver gave smaller buffers than asked for. */
+    gst_memory_unmap (bitstream, &bs_map);
+    gst_buffer_unmap (frame->input_buffer, &in_map);
+    gst_memory_unref (bitstream);
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Not enough space to send the JPEG image."),
+        ("%" G_GSIZE_FORMAT " bytes, buffer %" G_GSIZE_FORMAT, size,
+            bs_map.maxsize));
+    gst_video_decoder_release_frame (decoder, frame);
+    return GST_FLOW_ERROR;
+  }
+
+  memcpy (bs_map.data, in_map.data, size);
+  gst_memory_unmap (bitstream, &bs_map);
+  gst_buffer_unmap (frame->input_buffer, &in_map);
+  gst_memory_resize (bitstream, 0, size);
+
+  flow_ret = gst_buffer_pool_acquire_buffer (GST_BUFFER_POOL (self->src_pool),
+      &buffer, NULL);
+  if (flow_ret != GST_FLOW_OK) {
+    gst_memory_unref (bitstream);
+    if (flow_ret == GST_FLOW_FLUSHING)
+      GST_DEBUG_OBJECT (self, "Frame decoding aborted, we are flushing.");
+    else
+      GST_ELEMENT_ERROR (self, RESOURCE, WRITE,
+          ("No more picture buffer available."), (NULL));
+    gst_video_decoder_release_frame (decoder, frame);
+    return flow_ret;
+  }
+  frame->output_buffer = buffer;
+
+  request = gst_v4l2_decoder_alloc_request (self->decoder,
+      frame->system_frame_number, bitstream, buffer);
+  gst_memory_unref (bitstream);
+  if (!request) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Failed to allocate a media request object."), (NULL));
+    goto error;
+  }
+
+  if (!gst_v4l2_request_queue (request, 0)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, WRITE,
+        ("Driver did not accept the decode request."), (NULL));
+    goto error;
+  }
+
+  ret = gst_v4l2_request_set_done (request);
+  if (ret == 0) {
+    GST_ELEMENT_ERROR (self, STREAM, DECODE,
+        ("Decoding frame took too long"), (NULL));
+    goto error;
+  } else if (ret < 0) {
+    GST_ELEMENT_ERROR (self, STREAM, DECODE,
+        ("Decoding request failed: %s", g_strerror (errno)), (NULL));
+    goto error;
+  }
+
+  if (gst_v4l2_request_failed (request)) {
+    GST_ELEMENT_ERROR (self, STREAM, DECODE,
+        ("Failed to decode frame %u", frame->system_frame_number), (NULL));
+    goto error;
+  }
+
+  if (gst_v4l2_request_has_buf_error (request)) {
+    /* The driver refused or could not finish this image (see the kernel
+     * log); a corrupt MJPEG frame should not end the stream. */
+    gst_v4l2_request_unref (request);
+    flow_ret = GST_FLOW_OK;
+    GST_VIDEO_DECODER_ERROR (self, 1, STREAM, DECODE,
+        ("Failed to decode frame %u", frame->system_frame_number),
+        ("the driver returned the picture with the error flag"), flow_ret);
+    gst_video_decoder_drop_frame (decoder, frame);
+    return flow_ret;
+  }
+
+  gst_v4l2_request_unref (request);
+
+  if (self->copy_frames &&
+      !gst_v4l2_codec_jpeg_dec_copy_output_buffer (self, frame)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, WRITE,
+        ("Could not copy the decoded image."), (NULL));
+    gst_video_decoder_drop_frame (decoder, frame);
+    return GST_FLOW_ERROR;
+  }
+
+  return gst_video_decoder_finish_frame (decoder, frame);
+
+error:
+  if (request)
+    gst_v4l2_request_unref (request);
+  gst_video_decoder_drop_frame (decoder, frame);
+  return GST_FLOW_ERROR;
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_set_flushing (GstV4l2CodecJpegDec * self,
+    gboolean flushing)
+{
+  if (self->sink_allocator)
+    gst_v4l2_codec_allocator_set_flushing (self->sink_allocator, flushing);
+  if (self->src_allocator)
+    gst_v4l2_codec_allocator_set_flushing (self->src_allocator, flushing);
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_flush (GstVideoDecoder * decoder)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+
+  GST_DEBUG_OBJECT (self, "Flushing decoder state.");
+
+  gst_v4l2_decoder_flush (self->decoder);
+  gst_v4l2_codec_jpeg_dec_set_flushing (self, FALSE);
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_jpeg_dec_sink_event (GstVideoDecoder * decoder,
+    GstEvent * event)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (decoder);
+
+  switch (GST_EVENT_TYPE (event)) {
+    case GST_EVENT_FLUSH_START:
+      GST_DEBUG_OBJECT (self, "flush start");
+      gst_v4l2_codec_jpeg_dec_set_flushing (self, TRUE);
+      break;
+    default:
+      break;
+  }
+
+  return GST_VIDEO_DECODER_CLASS (parent_class)->sink_event (decoder, event);
+}
+
+static GstStateChangeReturn
+gst_v4l2_codec_jpeg_dec_change_state (GstElement * element,
+    GstStateChange transition)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (element);
+
+  if (transition == GST_STATE_CHANGE_PAUSED_TO_READY)
+    gst_v4l2_codec_jpeg_dec_set_flushing (self, TRUE);
+
+  return GST_ELEMENT_CLASS (parent_class)->change_state (element, transition);
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_set_property (GObject * object, guint prop_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (object);
+  GObject *dec = G_OBJECT (self->decoder);
+
+  gst_v4l2_decoder_set_property (dec, prop_id - PROP_LAST, value, pspec);
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_get_property (GObject * object, guint prop_id,
+    GValue * value, GParamSpec * pspec)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (object);
+  GObject *dec = G_OBJECT (self->decoder);
+
+  gst_v4l2_decoder_get_property (dec, prop_id - PROP_LAST, value, pspec);
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_init (GstV4l2CodecJpegDec * self,
+    GstV4l2CodecJpegDecClass * klass)
+{
+  self->decoder = gst_v4l2_decoder_new (klass->device);
+  gst_video_info_dma_drm_init (&self->vinfo_drm);
+  gst_video_decoder_set_packetized (GST_VIDEO_DECODER (self), TRUE);
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_dispose (GObject * object)
+{
+  GstV4l2CodecJpegDec *self = GST_V4L2_CODEC_JPEG_DEC (object);
+
+  g_clear_object (&self->decoder);
+
+  G_OBJECT_CLASS (parent_class)->dispose (object);
+}
+
+static void
+gst_v4l2_codec_jpeg_dec_class_init (GstV4l2CodecJpegDecClass * klass,
+    GstV4l2DecoderClassData * cdata)
+{
+  GstV4l2CodecDevice *device = cdata->device;
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+  GstVideoDecoderClass *decoder_class = GST_VIDEO_DECODER_CLASS (klass);
+
+  gobject_class->set_property = gst_v4l2_codec_jpeg_dec_set_property;
+  gobject_class->get_property = gst_v4l2_codec_jpeg_dec_get_property;
+  gobject_class->dispose = gst_v4l2_codec_jpeg_dec_dispose;
+
+  gst_element_class_set_static_metadata (element_class,
+      "V4L2 Stateless JPEG Image Decoder",
+      "Codec/Decoder/Image/Hardware",
+      "A V4L2 request-based JPEG image decoder",
+      "Arun Iyengar <aiyengar1990@gmail.com>");
+
+  parent_class = g_type_class_peek_parent (klass);
+
+  gst_element_class_add_pad_template (element_class,
+      gst_pad_template_new (GST_VIDEO_DECODER_SINK_NAME, GST_PAD_SINK,
+          GST_PAD_ALWAYS, cdata->sink_caps));
+  gst_element_class_add_pad_template (element_class,
+      gst_pad_template_new ("src", GST_PAD_SRC, GST_PAD_ALWAYS,
+          cdata->src_caps));
+
+  element_class->change_state =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_change_state);
+
+  decoder_class->open = GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_open);
+  decoder_class->close = GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_close);
+  decoder_class->start = GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_start);
+  decoder_class->stop = GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_stop);
+  decoder_class->set_format =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_set_format);
+  decoder_class->negotiate =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_negotiate);
+  decoder_class->decide_allocation =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_decide_allocation);
+  decoder_class->flush = GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_flush);
+  decoder_class->sink_event =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_sink_event);
+  decoder_class->handle_frame =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_jpeg_dec_handle_frame);
+
+  klass->device = device;
+  gst_v4l2_decoder_install_properties (gobject_class, PROP_LAST, device);
+}
+
+void
+gst_v4l2_codec_jpeg_dec_register (GstPlugin * plugin, GstV4l2Decoder * decoder,
+    GstV4l2CodecDevice * device, guint rank)
+{
+  GTypeInfo type_info = {
+    .class_size = sizeof (GstV4l2CodecJpegDecClass),
+    .class_init = (GClassInitFunc) gst_v4l2_codec_jpeg_dec_class_init,
+    .instance_size = sizeof (GstV4l2CodecJpegDec),
+    .instance_init = (GInstanceInitFunc) gst_v4l2_codec_jpeg_dec_init,
+  };
+  GstCaps *tmpl_src_caps = NULL, *sink_caps = NULL, *src_caps = NULL;
+
+  GST_DEBUG_CATEGORY_INIT (v4l2_jpegdec_debug, "v4l2codecs-jpegdec", 0,
+      "V4L2 stateless JPEG decoder");
+
+  if (gst_v4l2_decoder_in_doc_mode (decoder)) {
+    tmpl_src_caps = gst_static_caps_get (&static_src_caps);
+    goto register_element;
+  }
+
+  if (!gst_v4l2_decoder_set_sink_fmt (decoder, V4L2_PIX_FMT_JPEG,
+          320, 240, 12))
+    return;
+
+  src_caps = gst_v4l2_decoder_enum_src_formats (decoder, &static_src_caps);
+  if (!src_caps || gst_caps_is_empty (src_caps)) {
+    GST_WARNING ("Not registering JPEG decoder since it produces no "
+        "supported format");
+    goto done;
+  }
+
+  tmpl_src_caps =
+      gst_v4l2_decoder_enum_all_src_formats (decoder, &static_src_caps);
+
+register_element:
+  sink_caps = gst_v4l2_decoder_probe_sink_caps (decoder, V4L2_PIX_FMT_JPEG,
+      &static_sink_caps);
+
+  type_info.class_data = gst_v4l2_decoder_class_data_new (device,
+      sink_caps, tmpl_src_caps);
+  gst_v4l2_decoder_register (plugin, GST_TYPE_VIDEO_DECODER, &type_info,
+      "v4l2sl%sjpegdec", device, rank, NULL);
+
+done:
+  gst_clear_caps (&tmpl_src_caps);
+  gst_clear_caps (&sink_caps);
+  gst_clear_caps (&src_caps);
+}
