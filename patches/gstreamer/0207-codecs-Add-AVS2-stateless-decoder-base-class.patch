+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+#pragma once
+
+#include <gst/codecs/codecs-prelude.h>
+#include <gst/codecs/gstcodecpicture.h>
+#include <gst/codecparsers/gstavs2parser.h>
+
+G_BEGIN_DECLS
+
+#define GST_TYPE_AVS2_PICTURE     (gst_avs2_picture_get_type())
+#define GST_IS_AVS2_PICTURE(obj)  (GST_IS_MINI_OBJECT_TYPE(obj, GST_TYPE_AVS2_PICTURE))
+#define GST_AVS2_PICTURE(obj)     ((GstAvs2Picture *)obj)
+
+typedef struct _GstAvs2Picture GstAvs2Picture;
+
+/**
+ * GstAvs2Picture:
+ * @header: the picture header
+ * @data: the coded picture, from its picture start code to the end of its
+ *   last slice; only valid while the picture is decoded
+ * @size: the size of @data
+ * @data_offset: the offset in @data of the start code of the first slice
+ * @doi: decode_order_index, made monotonic across its 8-bit wrap around
+ * @poc: the picture order count: @doi plus picture_output_delay minus the
+ *   picture_reorder_delay of the sequence, @doi in low delay sequences
+ * @picture_output_delay: picture_output_delay, that of the previous
+ *   picture for a GB picture, which codes none
+ * @num_refs: the number of reference pictures of the picture
+ * @ref_poc: the @poc of the reference pictures of the picture, in the
+ *   order of its reference configuration set
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2Picture
+{
+  /*< private >*/
+  GstCodecPicture parent;
+
+  /*< public >*/
+  GstAvs2PictureHeader header;
+
+  const guint8 *data;
+  gsize size;
+  guint data_offset;
+
+  gint64 doi;
+  gint32 poc;
+  guint8 picture_output_delay;
+  guint num_refs;
+  gint32 ref_poc[GST_AVS2_MAX_REFS];
+
+  /*< private >*/
+  gboolean referenced;
+  gboolean needs_output;
+  gboolean background;
+};
+
+GST_CODECS_API
+GType gst_avs2_picture_get_type (void);
+
+GST_CODECS_API
+GstAvs2Picture * gst_avs2_picture_new (void) G_GNUC_WARN_UNUSED_RESULT;
+
+static inline GstAvs2Picture *
+gst_avs2_picture_ref (GstAvs2Picture * picture)
+{
+  return (GstAvs2Picture *) gst_mini_object_ref (GST_MINI_OBJECT_CAST (picture));
+}
+
+static inline void
+gst_avs2_picture_unref (GstAvs2Picture * picture)
+{
+  gst_mini_object_unref (GST_MINI_OBJECT_CAST (picture));
+}
+
+static inline gboolean
+gst_avs2_picture_replace (GstAvs2Picture ** old_picture,
+    GstAvs2Picture * new_picture)
+{
+  return gst_mini_object_replace ((GstMiniObject **) old_picture,
+      (GstMiniObject *) new_picture);
+}
+
+static inline void
+gst_clear_avs2_picture (GstAvs2Picture ** picture)
+{
+  if (picture && *picture) {
+    gst_avs2_picture_unref (*picture);
+    *picture = NULL;
+  }
+}
+
+static inline void
+gst_avs2_picture_set_user_data (GstAvs2Picture * picture, gpointer user_data,
+    GDestroyNotify notify)
+{
+  gst_codec_picture_set_user_data (GST_CODEC_PICTURE (picture),
+      user_data, notify);
+}
+
+static inline gpointer
+gst_avs2_picture_get_user_data (GstAvs2Picture * picture)
+{
+  return gst_codec_picture_get_user_data (GST_CODEC_PICTURE (picture));
+}
+
+static inline void
+gst_avs2_picture_set_discont_state (GstAvs2Picture * picture,
+    GstVideoCodecState * discont_state)
+{
+  gst_codec_picture_set_discont_state (GST_CODEC_PICTURE (picture),
+      discont_state);
+}
+
+G_END_DECLS
