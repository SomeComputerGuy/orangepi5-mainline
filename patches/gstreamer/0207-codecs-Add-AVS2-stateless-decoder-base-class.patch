+/**
+ * SECTION:gstavs2decoder
+ * @title: GstAvs2Decoder
+ * @short_description: Base class to implement stateless AVS2 decoders
+ * @sources:
+ * - gstavs2picture.h
+ *
+ * Takes one coded picture per input buffer (see avs2parse), manages the
+ * decoded picture buffer as GB/T 33475.2 section 9.2 describes it
+ * (reference configuration sets, background pictures) and outputs the
+ * pictures in picture order count order, delayed by the
+ * picture_reorder_delay of the sequence. Field coded sequences are not
+ * supported.
+ *
+ * Since: 1.30
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <gst/base/base.h>
+#include "gstavs2decoder.h"
+
+GST_DEBUG_CATEGORY (gst_avs2_decoder_debug);
+#define GST_CAT_DEFAULT gst_avs2_decoder_debug
+
+/* references further away in picture order count are dropped */
+#define MAX_POC_DISTANCE 128
+/* the largest decoded picture buffer GB/T 33475.2 allows */
+#define MAX_DPB_SIZE 32
+
+typedef struct
+{
+  GstVideoCodecFrame *frame;
+  GstAvs2Picture *picture;
+  GstAvs2Decoder *self;
+} GstAvs2DecoderOutputFrame;
+
+struct _GstAvs2DecoderPrivate
+{
+  gboolean have_sequence;
+  GstAvs2SequenceHeader seq;
+  guint dpb_size;
+
+  /* decoded pictures still referenced, waiting for output or background */
+  GPtrArray *dpb;
+  GstAvs2Picture *background;
+
+  gint64 doi_wrap;
+  gint prev_doi;
+  guint8 prev_output_delay;
+  gint32 last_output_poc;
+  gboolean output_started;
+  gboolean seen_intra;
+
+  guint preferred_output_delay;
+  GstVecDeque *output_queue;
+  gboolean is_live;
+  gboolean input_state_changed;
+};
+
+#define parent_class gst_avs2_decoder_parent_class
+G_DEFINE_ABSTRACT_TYPE_WITH_CODE (GstAvs2Decoder, gst_avs2_decoder,
+    GST_TYPE_VIDEO_DECODER,
+    G_ADD_PRIVATE (GstAvs2Decoder);
+    GST_DEBUG_CATEGORY_INIT (gst_avs2_decoder_debug, "avs2decoder", 0,
+        "AVS2 Video Decoder"));
+
+static void
+gst_avs2_decoder_clear_output_frame (GstAvs2DecoderOutputFrame * output_frame)
+{
+  if (!output_frame)
+    return;
+
+  if (output_frame->frame) {
+    gst_video_decoder_release_frame (GST_VIDEO_DECODER (output_frame->self),
+        output_frame->frame);
+    output_frame->frame = NULL;
+  }
+
+  gst_clear_avs2_picture (&output_frame->picture);
+}
+
+static void
+gst_avs2_decoder_reset_dpb (GstAvs2Decoder * self)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+
+  if (priv->dpb)
+    g_ptr_array_set_size (priv->dpb, 0);
+  gst_clear_avs2_picture (&priv->background);
+
+  priv->doi_wrap = 0;
+  priv->prev_doi = -1;
+  priv->prev_output_delay = 0;
+  priv->last_output_poc = 0;
+  priv->output_started = FALSE;
+  priv->seen_intra = FALSE;
+}
+
+static gboolean
+gst_avs2_decoder_start (GstVideoDecoder * decoder)
+{
+  GstAvs2Decoder *self = GST_AVS2_DECODER (decoder);
+  GstAvs2DecoderPrivate *priv = self->priv;
+
+  priv->have_sequence = FALSE;
+  memset (&priv->seq, 0, sizeof (priv->seq));
+
+  priv->dpb = g_ptr_array_new_with_free_func ((GDestroyNotify)
+      gst_avs2_picture_unref);
+  gst_avs2_decoder_reset_dpb (self);
+
+  priv->output_queue =
+      gst_vec_deque_new_for_struct (sizeof (GstAvs2DecoderOutputFrame), 1);
+  gst_vec_deque_set_clear_func (priv->output_queue,
+      (GDestroyNotify) gst_avs2_decoder_clear_output_frame);
+
+  return TRUE;
+}
+
+static gboolean
+gst_avs2_decoder_stop (GstVideoDecoder * decoder)
+{
+  GstAvs2Decoder *self = GST_AVS2_DECODER (decoder);
+  GstAvs2DecoderPrivate *priv = self->priv;
+
+  g_clear_pointer (&self->input_state, gst_video_codec_state_unref);
+
+  gst_avs2_decoder_reset_dpb (self);
+  g_clear_pointer (&priv->dpb, g_ptr_array_unref);
+  g_clear_pointer (&priv->output_queue, gst_vec_deque_free);
+
+  return TRUE;
+}
+
+static gboolean
+gst_avs2_decoder_set_format (GstVideoDecoder * decoder,
+    GstVideoCodecState * state)
+{
+  GstAvs2Decoder *self = GST_AVS2_DECODER (decoder);
+  GstAvs2DecoderPrivate *priv = self->priv;
+  GstQuery *query;
+
+  GST_DEBUG_OBJECT (decoder, "Set format");
+
+  priv->input_state_changed = TRUE;
+
+  if (self->input_state)
+    gst_video_codec_state_unref (self->input_state);
+
+  self->input_state = gst_video_codec_state_ref (state);
+
+  query = gst_query_new_latency ();
+  if (gst_pad_peer_query (GST_VIDEO_DECODER_SINK_PAD (self), query))
+    gst_query_parse_latency (query, &priv->is_live, NULL, NULL);
+  gst_query_unref (query);
+
+  return TRUE;
+}
+
+static gboolean
+gst_avs2_decoder_negotiate (GstVideoDecoder * decoder)
+{
+  GstAvs2Decoder *self = GST_AVS2_DECODER (decoder);
+
+  /* output state must be updated by subclass using new input state already */
+  self->priv->input_state_changed = FALSE;
+
+  return GST_VIDEO_DECODER_CLASS (parent_class)->negotiate (decoder);
+}
+
+static void
+gst_avs2_decoder_drain_output_queue (GstAvs2Decoder * self, guint num,
+    GstFlowReturn * ret)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+  GstAvs2DecoderClass *klass = GST_AVS2_DECODER_GET_CLASS (self);
+
+  g_assert (klass->output_picture);
+
+  while (gst_vec_deque_get_length (priv->output_queue) > num) {
+    GstAvs2DecoderOutputFrame *output_frame = (GstAvs2DecoderOutputFrame *)
+        gst_vec_deque_pop_head_struct (priv->output_queue);
+    /* output all queued frames, whatever the flow return */
+    GstFlowReturn flow_ret = klass->output_picture (self,
+        output_frame->frame, output_frame->picture);
+
+    if (*ret == GST_FLOW_OK)
+      *ret = flow_ret;
+  }
+}
+
+static GstAvs2Picture *
+gst_avs2_decoder_find_ref (GstAvs2Decoder * self, gint64 doi)
+{
+  GPtrArray *dpb = self->priv->dpb;
+  guint i;
+
+  for (i = 0; i < dpb->len; i++) {
+    GstAvs2Picture *p = g_ptr_array_index (dpb, i);
+
+    if (p->referenced && p->doi == doi)
+      return p;
+  }
+
+  return NULL;
+}
+
+/* a stand-in for a missing reference: the latest picture still referenced */
+static GstAvs2Picture *
+gst_avs2_decoder_any_ref (GstAvs2Decoder * self)
+{
+  GPtrArray *dpb = self->priv->dpb;
+  GstAvs2Picture *best = NULL;
+  guint i;
+
+  for (i = 0; i < dpb->len; i++) {
+    GstAvs2Picture *p = g_ptr_array_index (dpb, i);
+
+    if (p->referenced && (!best || p->doi > best->doi))
+      best = p;
+  }
+
+  return best;
+}
+
+static GstAvs2Picture *
+gst_avs2_decoder_smallest_pending (GstAvs2Decoder * self, guint * count)
+{
+  GPtrArray *dpb = self->priv->dpb;
+  GstAvs2Picture *best = NULL;
+  guint i, n = 0;
+
+  for (i = 0; i < dpb->len; i++) {
+    GstAvs2Picture *p = g_ptr_array_index (dpb, i);
+
+    if (!p->needs_output)
+      continue;
+    n++;
+    if (!best || p->poc < best->poc)
+      best = p;
+  }
+
+  if (count)
+    *count = n;
+
+  return best;
+}
+
+static void
+gst_avs2_decoder_release_unused (GstAvs2Decoder * self)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+  guint i;
+
+  for (i = 0; i < priv->dpb->len;) {
+    GstAvs2Picture *p = g_ptr_array_index (priv->dpb, i);
+
+    if (!p->referenced && !p->needs_output && p != priv->background)
+      g_ptr_array_remove_index (priv->dpb, i);
+    else
+      i++;
+  }
+}
+
+static void
+gst_avs2_decoder_output (GstAvs2Decoder * self, GstAvs2Picture * picture)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+  GstAvs2DecoderOutputFrame output_frame;
+  GstVideoCodecFrame *frame;
+
+  picture->needs_output = FALSE;
+  priv->last_output_poc = picture->poc;
+  priv->output_started = TRUE;
+
+  frame = gst_video_decoder_get_frame (GST_VIDEO_DECODER (self),
+      GST_CODEC_PICTURE_FRAME_NUMBER (picture));
+  if (!frame) {
+    GST_ERROR_OBJECT (self, "No frame for picture poc %d", picture->poc);
+    return;
+  }
+
+  GST_LOG_OBJECT (self, "output poc %d (doi %" G_GINT64_FORMAT ")",
+      picture->poc, picture->doi);
+
+  output_frame.frame = frame;
+  output_frame.picture = gst_avs2_picture_ref (picture);
+  output_frame.self = self;
+  gst_vec_deque_push_tail_struct (priv->output_queue, &output_frame);
+}
+
+/* Outputs the pictures in POC order once no earlier picture can still
+ * arrive: when the POC continues the output sequence, when more pictures
+ * wait than picture_reorder_delay allows, or at the end of the sequence. */
+static void
+gst_avs2_decoder_bump (GstAvs2Decoder * self, gboolean flush)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+
+  for (;;) {
+    guint pending;
+    GstAvs2Picture *p = gst_avs2_decoder_smallest_pending (self, &pending);
+
+    if (!p)
+      break;
+    if (!flush && !priv->seq.low_delay &&
+        !(priv->output_started && p->poc <= priv->last_output_poc + 1) &&
+        pending <= priv->seq.picture_reorder_delay + 1u)
+      break;
+
+    gst_avs2_decoder_output (self, p);
+  }
+
+  gst_avs2_decoder_release_unused (self);
+}
+
+static GstFlowReturn
+gst_avs2_decoder_drain_internal (GstAvs2Decoder * self)
+{
+  GstFlowReturn ret = GST_FLOW_OK;
+
+  gst_avs2_decoder_bump (self, TRUE);
+  gst_avs2_decoder_drain_output_queue (self, 0, &ret);
+  gst_avs2_decoder_reset_dpb (self);
+
+  return ret;
+}
+
+static GstFlowReturn
+gst_avs2_decoder_finish (GstVideoDecoder * decoder)
+{
+  GST_DEBUG_OBJECT (decoder, "finish");
+
+  return gst_avs2_decoder_drain_internal (GST_AVS2_DECODER (decoder));
+}
+
+static GstFlowReturn
+gst_avs2_decoder_drain (GstVideoDecoder * decoder)
+{
+  GST_DEBUG_OBJECT (decoder, "drain");
+
+  return gst_avs2_decoder_drain_internal (GST_AVS2_DECODER (decoder));
+}
+
+static gboolean
+gst_avs2_decoder_flush (GstVideoDecoder * decoder)
+{
+  GstAvs2Decoder *self = GST_AVS2_DECODER (decoder);
+
+  GST_DEBUG_OBJECT (decoder, "flush");
+
+  gst_avs2_decoder_reset_dpb (self);
+  gst_vec_deque_clear (self->priv->output_queue);
+
+  return TRUE;
+}
+
+static GstFlowReturn
+gst_avs2_decoder_process_sequence (GstAvs2Decoder * self,
+    const GstAvs2SequenceHeader * seq)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+  GstAvs2DecoderClass *klass = GST_AVS2_DECODER_GET_CLASS (self);
+  GstFlowReturn ret;
+
+  if (priv->have_sequence &&
+      seq->horizontal_size == priv->seq.horizontal_size &&
+      seq->vertical_size == priv->seq.vertical_size &&
+      seq->chroma_format == priv->seq.chroma_format &&
+      seq->sample_precision == priv->seq.sample_precision &&
+      seq->encoding_precision == priv->seq.encoding_precision &&
+      seq->profile_id == priv->seq.profile_id &&
+      seq->picture_reorder_delay == priv->seq.picture_reorder_delay) {
+    priv->seq = *seq;
+    return GST_FLOW_OK;
+  }
+
+  GST_INFO_OBJECT (self, "new sequence: profile 0x%02x %ux%u "
+      "encoding precision %u reorder delay %u", seq->profile_id,
+      seq->horizontal_size, seq->vertical_size, seq->encoding_precision,
+      seq->picture_reorder_delay);
+
+  ret = gst_avs2_decoder_drain_internal (self);
+  if (ret != GST_FLOW_OK)
+    return ret;
+
+  priv->seq = *seq;
+  priv->have_sequence = TRUE;
+  /* references, the background picture, the pictures waiting for output
+   * and the picture being decoded */
+  priv->dpb_size = MIN (GST_AVS2_MAX_REFS + 1 + seq->picture_reorder_delay +
+      1, MAX_DPB_SIZE);
+
+  if (klass->get_preferred_output_delay)
+    priv->preferred_output_delay =
+        klass->get_preferred_output_delay (self, priv->is_live);
+  else
+    priv->preferred_output_delay = 0;
+
+  g_assert (klass->new_sequence);
+
+  return klass->new_sequence (self, seq,
+      priv->dpb_size + 1 + priv->preferred_output_delay);
+}
+
+/* The reference pictures of the picture, in the order of its RCS. */
+static gboolean
+gst_avs2_decoder_set_refs (GstAvs2Decoder * self, GstAvs2Picture * picture,
+    GstAvs2Picture ** refs, guint * num_refs, gboolean * skip)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+  const GstAvs2PictureHeader *hdr = &picture->header;
+  gboolean missing = FALSE;
+  guint i, n = 0;
+
+  *skip = FALSE;
+  *num_refs = 0;
+
+  if (hdr->picture_type == GST_AVS2_PICTURE_TYPE_I)
+    return TRUE;
+
+  n = hdr->rcs.num_of_reference_picture;
+  for (i = 0; i < n; i++) {
+    gint64 doi = picture->doi - hdr->rcs.delta_doi_of_reference_picture[i];
+
+    refs[i] = gst_avs2_decoder_find_ref (self, doi);
+    if (!refs[i]) {
+      GST_DEBUG_OBJECT (self, "Reference doi %" G_GINT64_FORMAT
+          " of picture doi %" G_GINT64_FORMAT " is missing", doi,
+          picture->doi);
+      missing = TRUE;
+    }
+  }
+
+  if (hdr->background_pred) {
+    /* S picture: the background picture is its only reference */
+    refs[0] = priv->background;
+    n = MAX (n, 1);
+    missing |= !priv->background;
+  } else if (hdr->background_reference && n) {
+    refs[n - 1] = priv->background;
+    missing |= !priv->background;
+  }
+
+  *num_refs = n;
+
+  if (!missing)
+    return TRUE;
+
+  /* pictures before the first intra picture of an open GOP */
+  if (!priv->seen_intra) {
+    *skip = TRUE;
+    return TRUE;
+  }
+
+  GST_WARNING_OBJECT (self, "Missing reference picture, concealing");
+  for (i = 0; i < n; i++) {
+    if (!refs[i]) {
+      refs[i] = gst_avs2_decoder_any_ref (self);
+      if (!refs[i])
+        return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+/* Marking after the picture is decoded, GB/T 33475.2 section 9.2. */
+static void
+gst_avs2_decoder_mark_refs (GstAvs2Decoder * self, GstAvs2Picture * cur)
+{
+  GstAvs2DecoderPrivate *priv = self->priv;
+  const GstAvs2PictureHeader *hdr = &cur->header;
+  gboolean gb = hdr->background_picture && !hdr->background_picture_output;
+  guint i;
+
+  for (i = 0; i < hdr->rcs.num_of_removed_picture; i++) {
+    GstAvs2Picture *p = gst_avs2_decoder_find_ref (self,
+        cur->doi - hdr->rcs.delta_doi_of_removed_picture[i]);
+
+    if (p)
+      p->referenced = FALSE;
+  }
+
+  for (i = 0; i < priv->dpb->len; i++) {
+    GstAvs2Picture *p = g_ptr_array_index (priv->dpb, i);
+
+    if (p->referenced && ABS (p->poc - cur->poc) >= MAX_POC_DISTANCE)
+      p->referenced = FALSE;
+  }
+
+  /* a GB picture is never a regular reference, only the background */
+  cur->referenced = hdr->rcs.refered_by_others && !gb;
+  cur->needs_output = !gb;
+
+  if (hdr->background_picture) {
+    if (priv->background)
+      priv->background->background = FALSE;
+    cur->background = TRUE;
+    gst_avs2_picture_replace (&priv->background, cur);
+  }
+}
+
+static GstFlowReturn
+gst_avs2_decoder_handle_frame (GstVideoDecoder * decoder,
+    GstVideoCodecFrame * frame)
+{
+  GstAvs2Decoder *self = GST_AVS2_DECODER (decoder);
+  GstAvs2DecoderClass *klass = GST_AVS2_DECODER_GET_CLASS (self);
+  GstAvs2DecoderPrivate *priv = self->priv;
+  GstBuffer *in_buf = frame->input_buffer;
+  GstAvs2PictureHeader header;
+  GstAvs2Picture *picture = NULL;
+  GstAvs2Picture *refs[GST_AVS2_MAX_REFS] = { NULL, };
+  guint num_refs = 0, i;
+  GstAvs2Packet packet;
+  GstMapInfo map;
+  gboolean have_picture = FALSE, end_of_seq = FALSE, in_picture = FALSE;
+  gboolean skip;
+  guint offset = 0, pic_start = 0, first_slice = 0, end = 0;
+  gint64 doi;
+  GstFlowReturn ret = GST_FLOW_OK;
+  GstFlowReturn output_ret = GST_FLOW_OK;
+
+  GST_LOG_OBJECT (self, "handle frame, PTS: %" GST_TIME_FORMAT ", DTS: %"
+      GST_TIME_FORMAT, GST_TIME_ARGS (GST_BUFFER_PTS (in_buf)),
+      GST_TIME_ARGS (GST_BUFFER_DTS (in_buf)));
+
+  if (!gst_buffer_map (in_buf, &map, GST_MAP_READ)) {
+    GST_ERROR_OBJECT (self, "Cannot map buffer");
+    ret = GST_FLOW_ERROR;
+    goto error;
+  }
+
+  while (gst_avs2_parse (&packet, map.data, map.size, offset) ==
+      GST_AVS2_PARSER_OK) {
+    guint8 type = packet.type;
+
+    offset = packet.offset;
+
+    if (type == GST_AVS2_START_CODE_SEQUENCE_END) {
+      end_of_seq = TRUE;
+      in_picture = FALSE;
+      continue;
+    }
+
+    if (!have_picture) {
+      if (type == GST_AVS2_START_CODE_SEQUENCE) {
+        GstAvs2SequenceHeader seq;
+
+        if (gst_avs2_parse_sequence_header (&packet, &seq) !=
+            GST_AVS2_PARSER_OK) {
+          GST_WARNING_OBJECT (self, "Invalid sequence header");
+          continue;
+        }
+        ret = gst_avs2_decoder_process_sequence (self, &seq);
+        if (ret != GST_FLOW_OK)
+          goto unmap_and_error;
+      } else if (type == GST_AVS2_START_CODE_INTRA_PICTURE ||
+          type == GST_AVS2_START_CODE_INTER_PICTURE) {
+        if (!priv->have_sequence) {
+          GST_DEBUG_OBJECT (self, "No sequence header yet, dropping picture");
+          break;
+        }
+        if (gst_avs2_parse_picture_header (&packet, &priv->seq, &header) !=
+            GST_AVS2_PARSER_OK) {
+          GST_WARNING_OBJECT (self, "Invalid picture header");
+          break;
+        }
+        have_picture = TRUE;
+        in_picture = TRUE;
+        pic_start = packet.offset - 4;
+        end = packet.offset + packet.size;
+      }
+      continue;
+    }
+
+    if (!in_picture)
+      continue;
+
+    /* the picture runs to its last slice, extension and user data between
+     * its header and its first slice belong to it */
+    if (type <= GST_AVS2_START_CODE_SLICE_MAX) {
+      if (!first_slice)
+        first_slice = packet.offset - 4 - pic_start;
+      end = packet.offset + packet.size;
+    } else if ((type == GST_AVS2_START_CODE_EXTENSION ||
+            type == GST_AVS2_START_CODE_USER_DATA) && !first_slice) {
+      end = packet.offset + packet.size;
+    } else {
+      if (type == GST_AVS2_START_CODE_INTRA_PICTURE ||
+          type == GST_AVS2_START_CODE_INTER_PICTURE)
+        GST_WARNING_OBJECT (self, "More than one picture in a buffer");
+      in_picture = FALSE;
+    }
+  }
+
+  if (!have_picture || !first_slice) {
+    if (have_picture)
+      GST_WARNING_OBJECT (self, "Picture without slices");
+    gst_buffer_unmap (in_buf, &map);
+    gst_video_decoder_release_frame (decoder, frame);
+    if (end_of_seq)
+      gst_avs2_decoder_bump (self, TRUE);
+    goto output;
+  }
+
+  if (priv->seq.field_coded_sequence || !header.picture_structure) {
+    GST_ELEMENT_ERROR (self, STREAM, NOT_IMPLEMENTED, (NULL),
+        ("Field coded pictures are not supported"));
+    ret = GST_FLOW_NOT_NEGOTIATED;
+    goto unmap_and_error;
+  }
+
+  /* decode_order_index without its 8-bit wrap around */
+  if (priv->prev_doi >= 0 && header.decode_order_index < priv->prev_doi)
+    priv->doi_wrap += 256;
+  priv->prev_doi = header.decode_order_index;
+  doi = header.decode_order_index + priv->doi_wrap;
+
+  picture = gst_avs2_picture_new ();
+  picture->header = header;
+  picture->doi = doi;
+  /* a GB picture carries no output delay: it keeps the previous one */
+  picture->picture_output_delay = header.output_delay_present ?
+      header.picture_output_delay : priv->prev_output_delay;
+  priv->prev_output_delay = picture->picture_output_delay;
+  picture->poc = priv->seq.low_delay ? doi :
+      doi + picture->picture_output_delay - priv->seq.picture_reorder_delay;
+  picture->data = map.data + pic_start;
+  picture->size = end - pic_start;
+  picture->data_offset = first_slice;
+  GST_CODEC_PICTURE_FRAME_NUMBER (picture) = frame->system_frame_number;
+
+  if (!gst_avs2_decoder_set_refs (self, picture, refs, &num_refs, &skip)) {
+    GST_WARNING_OBJECT (self, "No reference picture at all");
+    ret = GST_FLOW_ERROR;
+    goto unmap_and_error;
+  }
+
+  if (skip) {
+    GST_DEBUG_OBJECT (self, "Skipping picture doi %" G_GINT64_FORMAT
+        " before the first intra picture", doi);
+    gst_avs2_picture_unref (picture);
+    gst_buffer_unmap (in_buf, &map);
+    gst_video_decoder_release_frame (decoder, frame);
+    goto output;
+  }
+
+  picture->num_refs = header.background_pred ? 1 : num_refs;
+  for (i = 0; i < num_refs; i++)
+    picture->ref_poc[i] = refs[i]->poc;
+
+  if (priv->input_state_changed) {
+    gst_avs2_picture_set_discont_state (picture, self->input_state);
+    priv->input_state_changed = FALSE;
+  }
+
+  /* no room in the decoded picture buffer: output the earliest pending
+   * picture early */
+  gst_avs2_decoder_release_unused (self);
+  while (priv->dpb->len >= priv->dpb_size) {
+    GstAvs2Picture *p = gst_avs2_decoder_smallest_pending (self, NULL);
+
+    if (!p)
+      break;
+    gst_avs2_decoder_output (self, p);
+    gst_avs2_decoder_release_unused (self);
+  }
+
+  if (klass->new_picture) {
+    ret = klass->new_picture (self, frame, picture);
+    if (ret != GST_FLOW_OK) {
+      GST_WARNING_OBJECT (self, "subclass failed to handle new picture");
+      goto unmap_and_error;
+    }
+  }
+
+  GST_LOG_OBJECT (self, "picture %c doi %" G_GINT64_FORMAT " poc %d refs %u "
+      "size %" G_GSIZE_FORMAT " offset %u", "IPBF"[header.picture_type], doi,
+      picture->poc, num_refs, picture->size, picture->data_offset);
+
+  g_assert (klass->decode_picture);
+  ret = klass->decode_picture (self, picture, &priv->seq, refs, num_refs,
+      priv->background);
+  picture->data = NULL;
+  gst_buffer_unmap (in_buf, &map);
+  if (ret != GST_FLOW_OK) {
+    GST_WARNING_OBJECT (self, "subclass failed to decode current picture");
+    goto error;
+  }
+
+  if (header.picture_type == GST_AVS2_PICTURE_TYPE_I)
+    priv->seen_intra = TRUE;
+
+  gst_avs2_decoder_mark_refs (self, picture);
+  if (picture->needs_output) {
+    /* output later, by its frame number */
+    gst_video_codec_frame_unref (frame);
+  } else {
+    gst_video_decoder_release_frame (decoder, frame);
+  }
+  g_ptr_array_add (priv->dpb, picture);
+
+  gst_avs2_decoder_bump (self, end_of_seq);
+
+output:
+  gst_avs2_decoder_drain_output_queue (self, priv->preferred_output_delay,
+      &output_ret);
+
+  return output_ret;
+
+unmap_and_error:
+  gst_buffer_unmap (in_buf, &map);
+
+error:
+  if (picture)
+    gst_avs2_picture_unref (picture);
+
+  if (ret == GST_FLOW_ERROR) {
+    GST_VIDEO_DECODER_ERROR (self, 1, STREAM, DECODE,
+        ("Failed to decode data"), (NULL), ret);
+  }
+
+  gst_video_decoder_release_frame (decoder, frame);
+
+  return ret;
+}
+
+static void
+gst_avs2_decoder_init (GstAvs2Decoder * self)
+{
+  gst_video_decoder_set_packetized (GST_VIDEO_DECODER (self), TRUE);
+  gst_video_decoder_set_needs_format (GST_VIDEO_DECODER (self), TRUE);
+
+  self->priv = gst_avs2_decoder_get_instance_private (self);
+}
+
+static void
+gst_avs2_decoder_class_init (GstAvs2DecoderClass * klass)
+{
+  GstVideoDecoderClass *decoder_class = GST_VIDEO_DECODER_CLASS (klass);
+
+  decoder_class->start = GST_DEBUG_FUNCPTR (gst_avs2_decoder_start);
+  decoder_class->stop = GST_DEBUG_FUNCPTR (gst_avs2_decoder_stop);
+  decoder_class->set_format = GST_DEBUG_FUNCPTR (gst_avs2_decoder_set_format);
+  decoder_class->negotiate = GST_DEBUG_FUNCPTR (gst_avs2_decoder_negotiate);
+  decoder_class->finish = GST_DEBUG_FUNCPTR (gst_avs2_decoder_finish);
+  decoder_class->flush = GST_DEBUG_FUNCPTR (gst_avs2_decoder_flush);
+  decoder_class->drain = GST_DEBUG_FUNCPTR (gst_avs2_decoder_drain);
+  decoder_class->handle_frame =
+      GST_DEBUG_FUNCPTR (gst_avs2_decoder_handle_frame);
+}
diff --git a/gst-libs/gst/codecs/gstavs2decoder.h b/gst-libs/gst/codecs/gstavs2decoder.h
