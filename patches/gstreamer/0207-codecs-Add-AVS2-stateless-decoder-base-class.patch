+ * Boston, MA 02110-1301, USA.
+ */
+
+#pragma once
+
+#include <gst/codecs/codecs-prelude.h>
+
+#include <gst/video/video.h>
+#include <gst/codecparsers/gstavs2parser.h>
+#include <gst/codecs/gstavs2picture.h>
+
+G_BEGIN_DECLS
+
+#define GST_TYPE_AVS2_DECODER            (gst_avs2_decoder_get_type())
+#define GST_AVS2_DECODER(obj)            (G_TYPE_CHECK_INSTANCE_CAST((obj),GST_TYPE_AVS2_DECODER,GstAvs2Decoder))
+#define GST_AVS2_DECODER_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST((klass),GST_TYPE_AVS2_DECODER,GstAvs2DecoderClass))
+#define GST_AVS2_DECODER_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS((obj),GST_TYPE_AVS2_DECODER,GstAvs2DecoderClass))
+#define GST_IS_AVS2_DECODER(obj)         (G_TYPE_CHECK_INSTANCE_TYPE((obj),GST_TYPE_AVS2_DECODER))
+#define GST_IS_AVS2_DECODER_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE((klass),GST_TYPE_AVS2_DECODER))
+#define GST_AVS2_DECODER_CAST(obj)       ((GstAvs2Decoder*)obj)
+
+typedef struct _GstAvs2Decoder GstAvs2Decoder;
+typedef struct _GstAvs2DecoderClass GstAvs2DecoderClass;
+typedef struct _GstAvs2DecoderPrivate GstAvs2DecoderPrivate;
+
+/**
+ * GstAvs2Decoder:
+ *
+ * The opaque #GstAvs2Decoder data structure.
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2Decoder
+{
+  /*< private >*/
+  GstVideoDecoder parent;
+
+  /*< protected >*/
+  GstVideoCodecState * input_state;
+
+  /*< private >*/
+  GstAvs2DecoderPrivate *priv;
+  gpointer padding[GST_PADDING_LARGE];
+};
+
+/**
+ * GstAvs2DecoderClass:
+ *
+ * Since: 1.30
+ */
+struct _GstAvs2DecoderClass
+{
+  /*< private >*/
+  GstVideoDecoderClass parent_class;
+
+  /**
+   * GstAvs2DecoderClass::new_sequence:
+   * @decoder: a #GstAvs2Decoder
+   * @seq: the new #GstAvs2SequenceHeader
+   * @max_dpb_size: the number of pictures the decoder holds at most: the
+   *   decoded picture buffer, the picture being decoded and the preferred
+   *   output delay
+   *
+   * Notifies the subclass of a new sequence (the first one, or a sequence
+   * header with a different size, format or profile). Pictures of the
+   * previous sequence have been output.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*new_sequence)     (GstAvs2Decoder * decoder,
+                                     const GstAvs2SequenceHeader * seq,
+                                     gint max_dpb_size);
+
+  /**
+   * GstAvs2DecoderClass::new_picture:
+   * @decoder: a #GstAvs2Decoder
+   * @frame: (transfer none): a #GstVideoCodecFrame
+   * @picture: (transfer none): a #GstAvs2Picture
+   *
+   * Optional. Called whenever a new #GstAvs2Picture is created.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*new_picture)      (GstAvs2Decoder * decoder,
+                                     GstVideoCodecFrame * frame,
+                                     GstAvs2Picture * picture);
+
+  /**
+   * GstAvs2DecoderClass::decode_picture:
+   * @decoder: a #GstAvs2Decoder
+   * @picture: (transfer none): the #GstAvs2Picture to decode
+   * @seq: the active #GstAvs2SequenceHeader
+   * @refs: (array length=num_refs) (transfer none): the reference pictures,
+   *   in the order of the reference configuration set of the picture; for a
+   *   P or F picture with background_reference the last one, for an S
+   *   picture the first one, is the background picture
+   * @num_refs: the number of reference pictures
+   * @background: (transfer none) (nullable): the current background picture
+   *
+   * Decodes one picture.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*decode_picture)   (GstAvs2Decoder * decoder,
+                                     GstAvs2Picture * picture,
+                                     const GstAvs2SequenceHeader * seq,
+                                     GstAvs2Picture ** refs,
+                                     guint num_refs,
+                                     GstAvs2Picture * background);
+
+  /**
+   * GstAvs2DecoderClass::output_picture:
+   * @decoder: a #GstAvs2Decoder
+   * @frame: (transfer full): a #GstVideoCodecFrame
+   * @picture: (transfer full): a #GstAvs2Picture
+   *
+   * Called with a #GstAvs2Picture which is to be output, in display order.
+   * The #GstVideoCodecFrame must be consumed by the subclass.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*output_picture)   (GstAvs2Decoder * decoder,
+                                     GstVideoCodecFrame * frame,
+                                     GstAvs2Picture * picture);
+
+  /**
+   * GstAvs2DecoderClass::get_preferred_output_delay:
+   * @decoder: a #GstAvs2Decoder
+   * @is_live: whether upstream is live or not
+   *
+   * Optional. Returns the number of pictures by which the subclass prefers
+   * the output to be delayed, so that it can keep decoding meanwhile.
+   *
+   * Since: 1.30
+   */
+  guint (*get_preferred_output_delay) (GstAvs2Decoder * decoder,
+                                       gboolean is_live);
+
+  /*< private >*/
+  gpointer padding[GST_PADDING_LARGE];
+};
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC(GstAvs2Decoder, gst_object_unref)
+
+GST_CODECS_API
+GType gst_avs2_decoder_get_type (void);
+
+G_END_DECLS
