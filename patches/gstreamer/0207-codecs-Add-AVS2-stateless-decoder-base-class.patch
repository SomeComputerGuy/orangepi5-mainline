+GST_DEFINE_MINI_OBJECT_TYPE (GstAvs2Picture, gst_avs2_picture);
+
+/**
+ * gst_avs2_picture_new:
+ *
+ * Create new #GstAvs2Picture
+ *
+ * Returns: a new #GstAvs2Picture
+ *
+ * Since: 1.30
+ */
+GstAvs2Picture *
+gst_avs2_picture_new (void)
+{
+  GstAvs2Picture *pic;
+
+  pic = g_new0 (GstAvs2Picture, 1);
