From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 10 Nov 2026 01:17:29 +0000
Subject: [PATCH 202/210] v4l2codecs: Add the MPEG-4, H.263, AVS and AVS2 uAPI
 to the private kernel headers

Add the proposed stateless decoder uAPI for MPEG-4 Part 2, H.263 and
Sorenson Spark (V4L2_PIX_FMT_MPEG4_SLICE, H263_SLICE and SPK_SLICE with
the MPEG4_VOL, MPEG4_VOP, MPEG4_QUANTISATION, MPEG4_SLICE_PARAMS,
MPEG4_QUIRKS, H263_PICTURE and H263_SLICE_PARAMS controls), AVS1 and
AVS+ (V4L2_PIX_FMT_AVS_FRAME with the AVS_SEQUENCE, AVS_PICTURE and
AVS_WEIGHT_QUANT controls) and AVS2 (V4L2_PIX_FMT_AVS2_FRAME with the
AVS2_SEQUENCE, AVS2_PICTURE, AVS2_WEIGHT_QUANT and AVS2_ALF controls),
as implemented by the hantro (Rockchip VPU2 and AVS+ decoder), rkvdec
(VDPU381) and cedrus drivers, so that decoders can be built for them.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 sys/v4l2codecs/linux/v4l2-controls.h | 630 +++++++++++++++++++++++++++
 sys/v4l2codecs/linux/videodev2.h     |  22 +
 2 files changed, 652 insertions(+)

diff --git a/sys/v4l2codecs/linux/v4l2-controls.h b/sys/v4l2codecs/linux/v4l2-controls.h
index 60ae202..83cc5f0 100644
--- a/sys/v4l2codecs/linux/v4l2-controls.h
+++ b/sys/v4l2codecs/linux/v4l2-controls.h
@@ -3759,6 +3759,636 @@ struct v4l2_ctrl_av1_film_grain {
 	__u8 reserved[4];
 };
 
+/* Stateless MPEG-4 Part 2 controls */
+
+#define V4L2_MPEG4_VOL_FLAG_INTERLACED			0x01
+#define V4L2_MPEG4_VOL_FLAG_QUANT_TYPE			0x02
+#define V4L2_MPEG4_VOL_FLAG_QUARTER_SAMPLE		0x04
+#define V4L2_MPEG4_VOL_FLAG_RESYNC_MARKER_DISABLE	0x08
+#define V4L2_MPEG4_VOL_FLAG_DATA_PARTITIONED		0x10
+#define V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC		0x20
+#define V4L2_MPEG4_VOL_FLAG_LOW_DELAY			0x40
+
+#define V4L2_MPEG4_SPRITE_ENABLE_NONE			0
+#define V4L2_MPEG4_SPRITE_ENABLE_GMC			2
+
+#define V4L2_MPEG4_MAX_GMC_WARPING_POINTS		3
+
+#define V4L2_CID_STATELESS_MPEG4_VOL	(V4L2_CID_CODEC_STATELESS_BASE + 700)
+/**
+ * struct v4l2_ctrl_mpeg4_vol - MPEG-4 video object layer
+ *
+ * All the members, except the flags, carry the syntax elements of the same
+ * name of the video_object_layer() syntax of ISO/IEC 14496-2. Only the
+ * rectangular, 8-bit, 4:2:0 video object layers of the Simple and Advanced
+ * Simple profiles are covered.
+ *
+ * @flags: see V4L2_MPEG4_VOL_FLAG_{}.
+ * @video_object_layer_width: width of the VOP in luma samples.
+ * @video_object_layer_height: height of the VOP in luma samples.
+ * @vop_time_increment_resolution: number of ticks in one second.
+ * @sprite_enable: V4L2_MPEG4_SPRITE_ENABLE_NONE or
+ *	V4L2_MPEG4_SPRITE_ENABLE_GMC; static sprites are not supported.
+ * @no_of_sprite_warping_points: number of GMC warping points, 0 to 3.
+ * @sprite_warping_accuracy: GMC warping accuracy code, 0 to 3.
+ * @reserved: padding field. Should be zeroed by applications.
+ */
+struct v4l2_ctrl_mpeg4_vol {
+	__u32	flags;
+	__u16	video_object_layer_width;
+	__u16	video_object_layer_height;
+	__u16	vop_time_increment_resolution;
+	__u8	sprite_enable;
+	__u8	no_of_sprite_warping_points;
+	__u8	sprite_warping_accuracy;
+	__u8	reserved[3];
+};
+
+#define V4L2_MPEG4_VOP_CODING_TYPE_I			0
+#define V4L2_MPEG4_VOP_CODING_TYPE_P			1
+#define V4L2_MPEG4_VOP_CODING_TYPE_B			2
+#define V4L2_MPEG4_VOP_CODING_TYPE_S			3
+
+#define V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE		0x01
+#define V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST		0x02
+#define V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN	0x04
+
+#define V4L2_CID_STATELESS_MPEG4_VOP	(V4L2_CID_CODEC_STATELESS_BASE + 701)
+/**
+ * struct v4l2_ctrl_mpeg4_vop - MPEG-4 video object plane
+ *
+ * @backward_ref_ts: timestamp of the V4L2 capture buffer to use as backward
+ *	reference, used with B-VOPs.
+ * @forward_ref_ts: timestamp of the V4L2 capture buffer to use as forward
+ *	reference, used with P-VOPs, S-VOPs and B-VOPs.
+ * @data_bit_offset: offset in bits from the first bit of the VOP start code
+ *	to the first macroblock.
+ * @flags: see V4L2_MPEG4_VOP_FLAG_{}.
+ * @trb: TRB of B-VOPs, in ticks of vop_time_increment_resolution.
+ * @trd: TRD of B-VOPs, in ticks of vop_time_increment_resolution.
+ * @trb_field: TRB of field B-VOP macroblocks, in field periods.
+ * @trd_field: TRD of field B-VOP macroblocks, in field periods.
+ * @sprite_trajectory_du: horizontal GMC warping point trajectories of
+ *	S-VOPs, as decoded from sprite_trajectory().
+ * @sprite_trajectory_dv: vertical GMC warping point trajectories of S-VOPs.
+ * @vop_coding_type: see V4L2_MPEG4_VOP_CODING_TYPE_{}.
+ * @vop_quant: vop_quant syntax element, 1 to 31.
+ * @intra_dc_vlc_thr: intra_dc_vlc_thr syntax element, 0 to 7.
+ * @vop_fcode_forward: vop_fcode_forward syntax element, 1 to 7.
+ * @vop_fcode_backward: vop_fcode_backward syntax element, 1 to 7.
+ * @backward_ref_vop_coding_type: coding type of the backward reference of
+ *	B-VOPs, V4L2_MPEG4_VOP_CODING_TYPE_I, P or S.
+ * @reserved: padding field. Should be zeroed by applications.
+ */
+struct v4l2_ctrl_mpeg4_vop {
+	__u64	backward_ref_ts;
+	__u64	forward_ref_ts;
+	__u32	data_bit_offset;
+	__u32	flags;
+	__u32	trb;
+	__u32	trd;
+	__u16	trb_field;
+	__u16	trd_field;
+	__s16	sprite_trajectory_du[V4L2_MPEG4_MAX_GMC_WARPING_POINTS];
+	__s16	sprite_trajectory_dv[V4L2_MPEG4_MAX_GMC_WARPING_POINTS];
+	__u8	vop_coding_type;
+	__u8	vop_quant;
+	__u8	intra_dc_vlc_thr;
+	__u8	vop_fcode_forward;
+	__u8	vop_fcode_backward;
+	__u8	backward_ref_vop_coding_type;
+	__u8	reserved[2];
+};
+
+#define V4L2_CID_STATELESS_MPEG4_QUANTISATION	(V4L2_CID_CODEC_STATELESS_BASE + 702)
+/**
+ * struct v4l2_ctrl_mpeg4_quantisation - MPEG-4 quantisation matrices
+ *
+ * The matrices are in zigzag scan order and always complete. They default
+ * to the default matrices of ISO/IEC 14496-2. Used with
+ * V4L2_MPEG4_VOL_FLAG_QUANT_TYPE.
+ *
+ * @intra_quantiser_matrix: intra quantisation matrix.
+ * @non_intra_quantiser_matrix: non-intra quantisation matrix.
+ */
+struct v4l2_ctrl_mpeg4_quantisation {
+	__u8	intra_quantiser_matrix[64];
+	__u8	non_intra_quantiser_matrix[64];
+};
+
+#define V4L2_CID_STATELESS_MPEG4_SLICE_PARAMS	(V4L2_CID_CODEC_STATELESS_BASE + 703)
+/**
+ * struct v4l2_ctrl_mpeg4_slice_params - MPEG-4 video packet
+ *
+ * One element per segment of the VOP that starts with a header: the first
+ * one starts with the VOP header, the following ones with a video packet
+ * header (resync marker).
+ *
+ * @offset: offset in bytes from the start of the OUTPUT buffer to the
+ *	first byte of the VOP start code or of the resync marker.
+ * @size: size in bytes of the segment, header included.
+ * @data_bit_offset: offset in bits from the first bit of the segment to its
+ *	first macroblock.
+ * @macroblock_number: number of the first macroblock of the segment, in
+ *	raster scan order.
+ * @quant_scale: quantiser scale of the first macroblock of the segment:
+ *	vop_quant for the first segment, quant_scale for video packets.
+ * @reserved: padding field. Should be zeroed by applications.
+ */
+struct v4l2_ctrl_mpeg4_slice_params {
+	__u32	offset;
+	__u32	size;
+	__u32	data_bit_offset;
+	__u16	macroblock_number;
+	__u8	quant_scale;
+	__u8	reserved;
+};
+
+#define V4L2_MPEG4_QUIRK_EDGE_EXACT_SIZE		0x01
+#define V4L2_MPEG4_QUIRK_QPEL_CHROMA			0x02
+#define V4L2_MPEG4_QUIRK_QPEL_CHROMA2			0x04
+#define V4L2_MPEG4_QUIRK_FIELD_HPEL_CHROMA		0x08
+#define V4L2_MPEG4_QUIRK_DC_NO_CLIP			0x10
+#define V4L2_MPEG4_QUIRK_XVID_ILACE			0x20
+#define V4L2_MPEG4_QUIRK_GMC_UNSCALED_REF		0x40
+
+#define V4L2_CID_STATELESS_MPEG4_QUIRKS		(V4L2_CID_CODEC_STATELESS_BASE + 704)
+
+/* Stateless H.263 and Sorenson Spark controls */
+
+#define V4L2_H263_PICTURE_CODING_TYPE_I			0
+#define V4L2_H263_PICTURE_CODING_TYPE_P			1
+
+#define V4L2_H263_PICTURE_FLAG_ROUNDING_TYPE		0x0001
+#define V4L2_H263_PICTURE_FLAG_PLUSPTYPE		0x0002
+#define V4L2_H263_PICTURE_FLAG_UMV			0x0004
+#define V4L2_H263_PICTURE_FLAG_SAC			0x0008
+#define V4L2_H263_PICTURE_FLAG_AP			0x0010
+#define V4L2_H263_PICTURE_FLAG_AIC			0x0020
+#define V4L2_H263_PICTURE_FLAG_DF			0x0040
+#define V4L2_H263_PICTURE_FLAG_SS			0x0080
+#define V4L2_H263_PICTURE_FLAG_SS_RECTANGULAR		0x0100
+#define V4L2_H263_PICTURE_FLAG_SS_ARBITRARY		0x0200
+#define V4L2_H263_PICTURE_FLAG_ISD			0x0400
+#define V4L2_H263_PICTURE_FLAG_AIV			0x0800
+#define V4L2_H263_PICTURE_FLAG_MQ			0x1000
+#define V4L2_H263_PICTURE_FLAG_RRU			0x2000
+
+#define V4L2_CID_STATELESS_H263_PICTURE	(V4L2_CID_CODEC_STATELESS_BASE + 800)
+/**
+ * struct v4l2_ctrl_h263_picture - H.263 or Sorenson Spark picture
+ *
+ * @forward_ref_ts: timestamp of the V4L2 capture buffer to use as reference,
+ *	used with P pictures.
+ * @data_bit_offset: offset in bits from the first bit of the picture start
+ *	code to the first macroblock.
+ * @flags: see V4L2_H263_PICTURE_FLAG_{}.
+ * @width: width of the picture in luma samples.
+ * @height: height of the picture in luma samples.
+ * @picture_coding_type: see V4L2_H263_PICTURE_CODING_TYPE_{}.
+ * @pquant: PQUANT syntax element, 1 to 31.
+ * @spk_version: version of the Sorenson Spark bitstream, 0 or 1. Zero for
+ *	H.263.
+ * @reserved: padding field. Should be zeroed by applications.
+ */
+struct v4l2_ctrl_h263_picture {
+	__u64	forward_ref_ts;
+	__u32	data_bit_offset;
+	__u32	flags;
+	__u16	width;
+	__u16	height;
+	__u8	picture_coding_type;
+	__u8	pquant;
+	__u8	spk_version;
+	__u8	reserved;
+};
+
+#define V4L2_CID_STATELESS_H263_SLICE_PARAMS	(V4L2_CID_CODEC_STATELESS_BASE + 801)
+/**
+ * struct v4l2_ctrl_h263_slice_params - H.263 GOB or slice
+ *
+ * One element per segment of the picture that starts with a header: the
+ * first one starts with the picture header, the following ones with a GOB
+ * or slice header. GOBs without a header continue the previous segment.
+ *
+ * @offset: offset in bytes from the start of the OUTPUT buffer to the byte
+ *	which holds the first bit of the picture, GOB or slice start code.
+ * @size: size in bytes of the segment, header included.
+ * @data_bit_offset: offset in bits from the first bit of the byte at
+ *	@offset to the first macroblock of the segment.
+ * @macroblock_number: number of the first macroblock of the segment, in
+ *	raster scan order.
+ * @quant_scale: quantiser of the first macroblock of the segment: PQUANT,
+ *	GQUANT or SQUANT.
+ * @reserved: padding field. Should be zeroed by applications.
+ */
+struct v4l2_ctrl_h263_slice_params {
+	__u32	offset;
+	__u32	size;
+	__u32	data_bit_offset;
+	__u16	macroblock_number;
+	__u8	quant_scale;
+	__u8	reserved;
+};
+
+/* Stateless AVS2 (GB/T 33475.2, IEEE 1857.4) decoder controls */
+
+#define V4L2_AVS2_PROFILE_MAIN_PICTURE			0x12
+#define V4L2_AVS2_PROFILE_MAIN				0x20
+#define V4L2_AVS2_PROFILE_MAIN10			0x22
+
+#define V4L2_AVS2_SEQUENCE_FLAG_PROGRESSIVE_SEQUENCE	0x00000001
+#define V4L2_AVS2_SEQUENCE_FLAG_FIELD_CODED_SEQUENCE	0x00000002
+#define V4L2_AVS2_SEQUENCE_FLAG_LOW_DELAY		0x00000004
+#define V4L2_AVS2_SEQUENCE_FLAG_TEMPORAL_ID_ENABLE	0x00000008
+#define V4L2_AVS2_SEQUENCE_FLAG_WEIGHT_QUANT_ENABLE	0x00000010
+#define V4L2_AVS2_SEQUENCE_FLAG_BACKGROUND_PICTURE_ENABLE 0x00000020
+#define V4L2_AVS2_SEQUENCE_FLAG_MHP_SKIP_ENABLE		0x00000040
+#define V4L2_AVS2_SEQUENCE_FLAG_DHP_ENABLE		0x00000080
+#define V4L2_AVS2_SEQUENCE_FLAG_WSM_ENABLE		0x00000100
+#define V4L2_AVS2_SEQUENCE_FLAG_AMP_ENABLE		0x00000200
+#define V4L2_AVS2_SEQUENCE_FLAG_NSQT_ENABLE		0x00000400
+#define V4L2_AVS2_SEQUENCE_FLAG_NSIP_ENABLE		0x00000800
+#define V4L2_AVS2_SEQUENCE_FLAG_SECONDARY_TRANSFORM_ENABLE 0x00001000
+#define V4L2_AVS2_SEQUENCE_FLAG_SAO_ENABLE		0x00002000
+#define V4L2_AVS2_SEQUENCE_FLAG_ALF_ENABLE		0x00004000
+#define V4L2_AVS2_SEQUENCE_FLAG_PMVR_ENABLE		0x00008000
+#define V4L2_AVS2_SEQUENCE_FLAG_CROSS_SLICE_LOOPFILTER_ENABLE 0x00010000
+#define V4L2_AVS2_SEQUENCE_FLAG_BCBR_ENABLE		0x00020000
+
+#define V4L2_CID_STATELESS_AVS2_SEQUENCE	(V4L2_CID_CODEC_STATELESS_BASE + 900)
+/**
+ * struct v4l2_ctrl_avs2_sequence - AVS2 sequence header
+ *
+ * Syntax elements of sequence_header(), GB/T 33475.2 section 7.1.2.2. The
+ * reference configuration sets (RCS) of the sequence header are not part
+ * of the control: the reference pictures of each picture are passed,
+ * resolved, with struct v4l2_ctrl_avs2_picture. The weighting quantization
+ * matrices of the sequence header are passed, resolved for each picture,
+ * with struct v4l2_ctrl_avs2_weight_quant.
+ *
+ * @flags: see V4L2_AVS2_SEQUENCE_FLAG_{}. BACKGROUND_PICTURE_ENABLE is set
+ *	when background_picture_disable is 0.
+ * @horizontal_size: horizontal_size, the width of the picture in luma
+ *	samples.
+ * @vertical_size: vertical_size, the height of the picture in luma samples.
+ * @profile_id: profile_id, see V4L2_AVS2_PROFILE_{}.
+ * @level_id: level_id.
+ * @chroma_format: chroma_format, 1 for 4:2:0.
+ * @sample_precision: sample_precision: 1 for 8-bit, 2 for 10-bit samples.
+ * @encoding_precision: encoding_precision: 1 for 8-bit, 2 for 10-bit
+ *	coding. Set to 1 when the profile has no encoding_precision.
+ * @lcu_size: lcu_size, the base 2 logarithm of the largest coding unit
+ *	size, 4 to 6.
+ * @picture_reorder_delay: picture_reorder_delay, 0 when LOW_DELAY is set.
+ * @reserved: padding field. Should be zeroed by applications.
+ */
+struct v4l2_ctrl_avs2_sequence {
+	__u32	flags;
+	__u16	horizontal_size;
+	__u16	vertical_size;
+	__u8	profile_id;
+	__u8	level_id;
+	__u8	chroma_format;
+	__u8	sample_precision;
+	__u8	encoding_precision;
+	__u8	lcu_size;
+	__u8	picture_reorder_delay;
+	__u8	reserved[5];
+};
+
+#define V4L2_AVS2_PICTURE_TYPE_I			0
+#define V4L2_AVS2_PICTURE_TYPE_P			1
+#define V4L2_AVS2_PICTURE_TYPE_B			2
+#define V4L2_AVS2_PICTURE_TYPE_F			3
+
+#define V4L2_AVS2_PICTURE_FLAG_PROGRESSIVE_FRAME	0x00000001
+#define V4L2_AVS2_PICTURE_FLAG_PICTURE_STRUCTURE	0x00000002
+#define V4L2_AVS2_PICTURE_FLAG_TOP_FIELD_FIRST		0x00000004
+#define V4L2_AVS2_PICTURE_FLAG_REPEAT_FIRST_FIELD	0x00000008
+#define V4L2_AVS2_PICTURE_FLAG_IS_TOP_FIELD		0x00000010
+#define V4L2_AVS2_PICTURE_FLAG_FIXED_PICTURE_QP		0x00000020
+#define V4L2_AVS2_PICTURE_FLAG_LOOP_FILTER_DISABLE	0x00000040
+#define V4L2_AVS2_PICTURE_FLAG_REFERED_BY_OTHERS	0x00000080
+#define V4L2_AVS2_PICTURE_FLAG_BACKGROUND_PICTURE	0x00000100
+#define V4L2_AVS2_PICTURE_FLAG_BACKGROUND_PICTURE_OUTPUT 0x00000200
+#define V4L2_AVS2_PICTURE_FLAG_BACKGROUND_PRED		0x00000400
+#define V4L2_AVS2_PICTURE_FLAG_BACKGROUND_REFERENCE	0x00000800
+#define V4L2_AVS2_PICTURE_FLAG_RANDOM_ACCESS_DECODABLE	0x00001000
+#define V4L2_AVS2_PICTURE_FLAG_WEIGHT_QUANT_ENABLE	0x00002000
+
+#define V4L2_AVS2_MAX_REF_PICS				7
+
+#define V4L2_AVS2_REF_PIC_FLAG_BACKGROUND		0x01
+
+/**
+ * struct v4l2_avs2_ref_pic - AVS2 reference picture
+ *
+ * @timestamp: timestamp of the V4L2 capture buffer holding the reference
+ *	picture. See note in struct v4l2_ctrl_avs2_picture.
+ * @poc: picture order count of the reference picture, derived as for
+ *	@poc of struct v4l2_ctrl_avs2_picture when it was decoded.
+ * @ref_poc: picture order counts of the reference pictures of the
+ *	reference picture itself, in the order of its own reference list
+ *	(ref_pics[] of the picture control it was decoded with).
+ * @picture_type: picture type of the reference picture when it was decoded,
+ *	see V4L2_AVS2_PICTURE_TYPE_{}.
+ * @num_ref_pics: number of valid entries in @ref_poc.
+ * @flags: see V4L2_AVS2_REF_PIC_FLAG_{}.
+ * @reserved: padding field. Should be zeroed by applications.
+ */
+struct v4l2_avs2_ref_pic {
+	__u64	timestamp;
+	__s32	poc;
+	__s32	ref_poc[V4L2_AVS2_MAX_REF_PICS];
+	__u8	picture_type;
+	__u8	num_ref_pics;
+	__u8	flags;
+	__u8	reserved[5];
+};
+
+#define V4L2_CID_STATELESS_AVS2_PICTURE		(V4L2_CID_CODEC_STATELESS_BASE + 901)
+/**
+ * struct v4l2_ctrl_avs2_picture - AVS2 picture header and reference list
+ *
+ * Syntax elements of intra_picture_header() or inter_picture_header(),
+ * GB/T 33475.2 sections 7.1.3.1 and 7.1.3.2, and the reference picture
+ * list of the picture.
+ *
+ * The OUTPUT buffer holds one coded picture: its picture header and all
+ * its slices, in decoding order, with their start codes and as found in
+ * the elementary stream (pseudo start code bits not removed). Sequence
+ * headers, extensions and user data may precede the picture header.
+ *
+ * @ref_pics: the reference pictures, in the order of the reference
+ *	configuration set of the picture. For a P or F picture with
+ *	BACKGROUND_REFERENCE, the last entry is the background picture. For a
+ *	P picture with BACKGROUND_PRED (an S picture), the first entry is the
+ *	background picture.
+ * @data_offset: offset in bytes from the start of the OUTPUT buffer to the
+ *	first byte of the start code prefix of the first slice.
+ * @flags: see V4L2_AVS2_PICTURE_FLAG_{}.
+ * @poc: picture order count: decode_order_index, made monotonic across its
+ *	8-bit wrap around, plus picture_output_delay minus
+ *	picture_reorder_delay of the sequence (decode_order_index only when the
+ *	sequence is low delay).
+ * @picture_type: V4L2_AVS2_PICTURE_TYPE_I for intra_picture_header(),
+ *	otherwise the picture type from picture_coding_type.
+ * @num_ref_pics: num_of_reference_picture of the reference configuration set
+ *	of the picture, the number of valid entries in @ref_pics.
+ * @decode_order_index: decode_order_index.
+ * @temporal_id: temporal_id, 0 when the sequence has no temporal id.
+ * @picture_output_delay: picture_output_delay.
+ * @picture_qp: picture_qp.
+ * @alpha_c_offset: alpha_c_offset, 0 unless loop_filter_parameter_flag.
+ * @beta_offset: beta_offset, 0 unless loop_filter_parameter_flag.
+ * @chroma_quant_param_delta_cb: chroma_quant_param_delta_cb, 0 when
+ *	chroma_quant_param_disable is set.
+ * @chroma_quant_param_delta_cr: chroma_quant_param_delta_cr, 0 when
+ *	chroma_quant_param_disable is set.
+ * @reserved: padding field. Should be zeroed by applications.
+ *
+ * Note: the timestamp refers to the timestamp field in struct v4l2_buffer.
+ * Use v4l2_timeval_to_ns() to convert the struct timeval to a __u64.
+ */
+struct v4l2_ctrl_avs2_picture {
+	struct v4l2_avs2_ref_pic ref_pics[V4L2_AVS2_MAX_REF_PICS];
+	__u32	data_offset;
+	__u32	flags;
+	__s32	poc;
+	__u8	picture_type;
+	__u8	num_ref_pics;
+	__u8	decode_order_index;
+	__u8	temporal_id;
+	__u8	picture_output_delay;
+	__u8	picture_qp;
+	__s8	alpha_c_offset;
