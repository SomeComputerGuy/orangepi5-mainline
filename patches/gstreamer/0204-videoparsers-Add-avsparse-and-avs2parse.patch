+static GstFlowReturn
+gst_avs_parse_handle_frame (GstBaseParse * parse, GstBaseParseFrame * frame,
+    gint * skipsize)
+{
+  GstAvsParse *self = GST_AVS_PARSE (parse);
+  GstByteReader br;
+  GstMapInfo map;
+  gint off, end = -1;
+  GstFlowReturn ret = GST_FLOW_OK;
+
