+    /* sync to a sequence header first, then to any start code */
+    off = gst_byte_reader_masked_scan_uint32 (&br,
+        self->synced ? 0xffffff00 : 0xffffffff,
+        self->synced ? 0x00000100 : 0x000001b0, 0, map.size);
+    if (off < 0) {
+      *skipsize = map.size - 3;
+      goto out;
+    }
+    if (off > 0) {
+      *skipsize = off;
+      goto out;
+    }
+    self->have_picture = is_picture (map.data[3]);
+    self->scanned = 4;
+    self->synced = TRUE;
+  }
+
+  /* the frame ends where a sequence header or the next picture starts */
+  while (self->scanned + 4 <= map.size) {
+    guint8 type;
+
+    off = gst_byte_reader_masked_scan_uint32 (&br, 0xffffff00, 0x00000100,
+        self->scanned, map.size - self->scanned);
+    if (off < 0) {
+      self->scanned = map.size - 3;
+      break;
+    }
+
+    type = map.data[off + 3];
+    if (self->have_picture && (is_picture (type) ||
+            type == GST_AVS_START_CODE_SEQUENCE)) {
+      end = off;
+      break;
+    }
+    if (is_picture (type))
+      self->have_picture = TRUE;
+    self->scanned = off + 4;
+  }
+
+  if (end < 0) {
+    if (!GST_BASE_PARSE_DRAINING (parse) || !self->have_picture)
+      goto out;
+    end = map.size;
+  }
+
+  gst_avs_parse_process_frame (self, frame, map.data, end);
+  gst_avs_parse_reset (self);
+  gst_buffer_unmap (frame->buffer, &map);
+
+  gst_avs_parse_update_src_caps (self);
+  return gst_base_parse_finish_frame (parse, frame, end);
+
+out:
+  gst_buffer_unmap (frame->buffer, &map);
+  return ret;
+}
+
+static gboolean
+gst_avs_parse_sink_event (GstBaseParse * parse, GstEvent * event)
+{
+  if (GST_EVENT_TYPE (event) == GST_EVENT_FLUSH_STOP)
+    gst_avs_parse_reset (GST_AVS_PARSE (parse));
+
+  return GST_BASE_PARSE_CLASS (parent_class)->sink_event (parse, event);
+}
+
+static void
+gst_avs_parse_class_init (GstAvsParseClass * klass)
+{
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+  GstBaseParseClass *parse_class = GST_BASE_PARSE_CLASS (klass);
+
+  GST_DEBUG_CATEGORY_INIT (gst_avs_parse_debug, "avsparse", 0,
+      "AVS1/AVS+ video parser");
+
+  gst_element_class_add_static_pad_template (element_class, &src_template);
+  gst_element_class_add_static_pad_template (element_class, &sink_template);
+  gst_element_class_set_static_metadata (element_class,
+      "AVS1/AVS+ video parser", "Codec/Parser/Converter/Video",
+      "Splits AVS1 and AVS+ video into pictures",
+      "Arun Iyengar <aiyengar1990@gmail.com>");
+
+  parse_class->start = GST_DEBUG_FUNCPTR (gst_avs_parse_start);
+  parse_class->handle_frame = GST_DEBUG_FUNCPTR (gst_avs_parse_handle_frame);
+  parse_class->sink_event = GST_DEBUG_FUNCPTR (gst_avs_parse_sink_event);
+}
+
+static void
+gst_avs_parse_init (GstAvsParse * self)
+{
+  gst_base_parse_set_pts_interpolation (GST_BASE_PARSE (self), FALSE);
+  GST_PAD_SET_ACCEPT_INTERSECT (GST_BASE_PARSE_SINK_PAD (self));
+  GST_PAD_SET_ACCEPT_TEMPLATE (GST_BASE_PARSE_SINK_PAD (self));
+}
