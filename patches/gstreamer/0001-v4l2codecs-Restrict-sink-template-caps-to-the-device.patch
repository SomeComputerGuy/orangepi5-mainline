diff --git a/sys/v4l2codecs/gstv4l2decoder.c b/sys/v4l2codecs/gstv4l2decoder.c
index b8b9aec..2d65fab 100644
--- a/sys/v4l2codecs/gstv4l2decoder.c
+++ b/sys/v4l2codecs/gstv4l2decoder.c
@@ -407,6 +407,92 @@ gst_v4l2_decoder_set_sink_fmt (GstV4l2Decoder * self, guint32 pix_fmt,
   return TRUE;
 }
 
+static void
+gst_v4l2_decoder_set_size_range (GstCaps * caps, const gchar * field,
+    guint32 min, guint32 max)
+{
+  min = CLAMP (min, 1, (guint32) G_MAXINT);
+  max = CLAMP (max, min, (guint32) G_MAXINT);
+
+  if (min == max)
+    gst_caps_set_simple (caps, field, G_TYPE_INT, (gint) min, NULL);
+  else
+    gst_caps_set_simple (caps, field, GST_TYPE_INT_RANGE, (gint) min,
+        (gint) max, NULL);
+}
+
+/*
+ * gst_v4l2_decoder_probe_sink_caps:
+ * @self: a #GstV4l2Decoder pointer
+ * @pix_fmt: the coded (OUTPUT queue) pixel format
+ * @static_caps: the unrestricted sink caps for this codec
+ *
+ * Restrict @static_caps to the coded frame sizes the driver reports for
+ * @pix_fmt through VIDIOC_ENUM_FRAMESIZES. This is meant to be used for the
+ * sink pad template, so that autopluggers can skip a decoder that cannot
+ * handle the stream resolution, which matters when a SoC exposes multiple
+ * decoders for the same codec. If the driver does not implement frame size
+ * enumeration, the unrestricted caps are returned.
+ *
+ * Returns: (transfer full): the sink caps
+ */
+GstCaps *
+gst_v4l2_decoder_probe_sink_caps (GstV4l2Decoder * self, guint32 pix_fmt,
+    GstStaticCaps * static_caps)
+{
+  struct v4l2_frmsizeenum size = {
+    .index = 0,
+    .pixel_format = pix_fmt,
+  };
+  GstCaps *caps = gst_static_caps_get (static_caps);
+  gint ret;
+
+  if (self->doc_mode)
+    return caps;
+
+  g_return_val_if_fail (self->opened, caps);
+
+  ret = ioctl (self->video_fd, VIDIOC_ENUM_FRAMESIZES, &size);
+  if (ret < 0) {
+    GST_DEBUG_OBJECT (self, "Could not enumerate frame sizes for %"
+        GST_FOURCC_FORMAT ": %s", GST_FOURCC_ARGS (pix_fmt),
+        g_strerror (errno));
+    return caps;
+  }
+
+  if (size.type == V4L2_FRMSIZE_TYPE_DISCRETE) {
+    GstCaps *sized_caps = gst_caps_new_empty ();
+
+    do {
+      GstCaps *tmp = gst_caps_copy (caps);
+
+      gst_v4l2_decoder_set_size_range (tmp, "width", size.discrete.width,
+          size.discrete.width);
+      gst_v4l2_decoder_set_size_range (tmp, "height", size.discrete.height,
+          size.discrete.height);
+      sized_caps = gst_caps_merge (sized_caps, tmp);
+
+      size.index++;
+      ret = ioctl (self->video_fd, VIDIOC_ENUM_FRAMESIZES, &size);
+    } while (ret >= 0 && size.type == V4L2_FRMSIZE_TYPE_DISCRETE);
+
+    gst_caps_unref (caps);
+    caps = sized_caps;
+  } else {
+    /* For STEPWISE, the step is not expressed in the caps, since the caps
+     * carry the display size, which may not be aligned to the step */
+    caps = gst_caps_make_writable (caps);
+    gst_v4l2_decoder_set_size_range (caps, "width", size.stepwise.min_width,
+        size.stepwise.max_width);
+    gst_v4l2_decoder_set_size_range (caps, "height",
+        size.stepwise.min_height, size.stepwise.max_height);
+  }
+
+  GST_DEBUG_OBJECT (self, "Probed sink caps: %" GST_PTR_FORMAT, caps);
+
+  return caps;
+}
+
 static GstCaps *
 gst_v4l2_decoder_enum_size_for_format (GstV4l2Decoder * self,
     guint32 pixelformat, gint index, gint unscaled_width, gint unscaled_height)
