+
+/**
+ * SECTION:gstavsdecoder
+ * @title: GstAvsDecoder
+ * @short_description: Base class to implement stateless AVS1 and AVS+
+ * decoders
+ * @sources:
+ * - gstavspicture.h
+ *
+ * Takes one coded picture per input buffer (see avsparse), keeps the
+ * reference pictures and outputs the pictures in display order: B pictures
+ * as soon as they are decoded, I and P pictures when the next I or P
+ * picture is decoded, or at once in low delay sequences.
+ *
+ * Since: 1.30
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <gst/base/base.h>
+#include "gstavsdecoder.h"
+
+GST_DEBUG_CATEGORY (gst_avs_decoder_debug);
+#define GST_CAT_DEFAULT gst_avs_decoder_debug
+
+typedef struct
+{
+  GstVideoCodecFrame *frame;
+  GstAvsPicture *picture;
+  GstAvsDecoder *self;
+} GstAvsDecoderOutputFrame;
+
+struct _GstAvsDecoderPrivate
+{
+  gboolean have_sequence;
+  GstAvsSequenceHeader seq;
+  gboolean final_revision;
+
+  /* R0 (the I or P picture decoded last), R1 and R2 */
+  GstAvsPicture *refs[3];
+  /* R0, until the next I or P picture is decoded */
+  GstAvsDecoderOutputFrame held;
+
+  guint preferred_output_delay;
+  GstVecDeque *output_queue;
+  gboolean is_live;
+  gboolean input_state_changed;
+};
+
+#define parent_class gst_avs_decoder_parent_class
+G_DEFINE_ABSTRACT_TYPE_WITH_CODE (GstAvsDecoder, gst_avs_decoder,
+    GST_TYPE_VIDEO_DECODER,
+    G_ADD_PRIVATE (GstAvsDecoder);
+    GST_DEBUG_CATEGORY_INIT (gst_avs_decoder_debug, "avsdecoder", 0,
+        "AVS1/AVS+ Video Decoder"));
+
+static void
+gst_avs_decoder_clear_output_frame (GstAvsDecoderOutputFrame * output_frame)
+{
+  if (!output_frame)
+    return;
+
+  if (output_frame->frame) {
+    gst_video_decoder_release_frame (GST_VIDEO_DECODER (output_frame->self),
+        output_frame->frame);
+    output_frame->frame = NULL;
+  }
+
+  gst_clear_avs_picture (&output_frame->picture);
+}
+
+static void
+gst_avs_decoder_clear_refs (GstAvsDecoder * self)
+{
+  GstAvsDecoderPrivate *priv = self->priv;
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (priv->refs); i++)
+    gst_clear_avs_picture (&priv->refs[i]);
+}
+
+static void
+gst_avs_decoder_reset (GstAvsDecoder * self)
+{
+  GstAvsDecoderPrivate *priv = self->priv;
+
+  gst_avs_decoder_clear_refs (self);
+  gst_avs_decoder_clear_output_frame (&priv->held);
+  if (priv->output_queue)
+    gst_vec_deque_clear (priv->output_queue);
+}
+
+static gboolean
+gst_avs_decoder_start (GstVideoDecoder * decoder)
+{
+  GstAvsDecoder *self = GST_AVS_DECODER (decoder);
+  GstAvsDecoderPrivate *priv = self->priv;
+
+  priv->have_sequence = FALSE;
+  priv->final_revision = FALSE;
+  memset (&priv->seq, 0, sizeof (priv->seq));
+  memset (&priv->held, 0, sizeof (priv->held));
+
+  priv->output_queue =
+      gst_vec_deque_new_for_struct (sizeof (GstAvsDecoderOutputFrame), 1);
+  gst_vec_deque_set_clear_func (priv->output_queue,
+      (GDestroyNotify) gst_avs_decoder_clear_output_frame);
+
+  return TRUE;
+}
+
+static gboolean
+gst_avs_decoder_stop (GstVideoDecoder * decoder)
+{
+  GstAvsDecoder *self = GST_AVS_DECODER (decoder);
+  GstAvsDecoderPrivate *priv = self->priv;
+
+  g_clear_pointer (&self->input_state, gst_video_codec_state_unref);
+
+  gst_avs_decoder_reset (self);
+  g_clear_pointer (&priv->output_queue, gst_vec_deque_free);
+
+  return TRUE;
+}
+
+static gboolean
+gst_avs_decoder_set_format (GstVideoDecoder * decoder,
+    GstVideoCodecState * state)
+{
+  GstAvsDecoder *self = GST_AVS_DECODER (decoder);
+  GstAvsDecoderPrivate *priv = self->priv;
+  GstQuery *query;
+
+  GST_DEBUG_OBJECT (decoder, "Set format");
+
+  priv->input_state_changed = TRUE;
+
+  if (self->input_state)
+    gst_video_codec_state_unref (self->input_state);
+
+  self->input_state = gst_video_codec_state_ref (state);
+
+  query = gst_query_new_latency ();
+  if (gst_pad_peer_query (GST_VIDEO_DECODER_SINK_PAD (self), query))
+    gst_query_parse_latency (query, &priv->is_live, NULL, NULL);
+  gst_query_unref (query);
+
+  return TRUE;
+}
+
+static gboolean
+gst_avs_decoder_negotiate (GstVideoDecoder * decoder)
+{
+  GstAvsDecoder *self = GST_AVS_DECODER (decoder);
+
+  /* output state must be updated by subclass using new input state already */
+  self->priv->input_state_changed = FALSE;
+
+  return GST_VIDEO_DECODER_CLASS (parent_class)->negotiate (decoder);
+}
+
+static void
+gst_avs_decoder_drain_output_queue (GstAvsDecoder * self, guint num,
+    GstFlowReturn * ret)
+{
+  GstAvsDecoderPrivate *priv = self->priv;
+  GstAvsDecoderClass *klass = GST_AVS_DECODER_GET_CLASS (self);
+
+  g_assert (klass->output_picture);
+
+  while (gst_vec_deque_get_length (priv->output_queue) > num) {
+    GstAvsDecoderOutputFrame *output_frame = (GstAvsDecoderOutputFrame *)
+        gst_vec_deque_pop_head_struct (priv->output_queue);
+    /* output all queued frames, whatever the flow return */
+    GstFlowReturn flow_ret = klass->output_picture (self,
+        output_frame->frame, output_frame->picture);
+
+    if (*ret == GST_FLOW_OK)
+      *ret = flow_ret;
+  }
+}
+
+static void
+gst_avs_decoder_queue_output (GstAvsDecoder * self,
+    GstVideoCodecFrame * frame, GstAvsPicture * picture)
+{
+  GstAvsDecoderOutputFrame output_frame = {
+    .frame = frame,
+    .picture = picture,
+    .self = self,
+  };
+
+  gst_vec_deque_push_tail_struct (self->priv->output_queue, &output_frame);
+}
+
+static GstFlowReturn
+gst_avs_decoder_drain_internal (GstAvsDecoder * self)
+{
+  GstAvsDecoderPrivate *priv = self->priv;
+  GstFlowReturn ret = GST_FLOW_OK;
+
+  if (priv->held.frame) {
+    gst_avs_decoder_queue_output (self, priv->held.frame, priv->held.picture);
+    memset (&priv->held, 0, sizeof (priv->held));
+  }
+
+  gst_avs_decoder_drain_output_queue (self, 0, &ret);
+  gst_avs_decoder_clear_refs (self);
+
+  return ret;
+}
+
+static GstFlowReturn
+gst_avs_decoder_finish (GstVideoDecoder * decoder)
+{
+  GST_DEBUG_OBJECT (decoder, "finish");
+
+  return gst_avs_decoder_drain_internal (GST_AVS_DECODER (decoder));
+}
+
+static GstFlowReturn
+gst_avs_decoder_drain (GstVideoDecoder * decoder)
+{
+  GST_DEBUG_OBJECT (decoder, "drain");
+
+  return gst_avs_decoder_drain_internal (GST_AVS_DECODER (decoder));
+}
+
+static gboolean
+gst_avs_decoder_flush (GstVideoDecoder * decoder)
+{
+  GST_DEBUG_OBJECT (decoder, "flush");
+
+  gst_avs_decoder_reset (GST_AVS_DECODER (decoder));
+
+  return TRUE;
+}
+
+static GstFlowReturn
+gst_avs_decoder_process_sequence (GstAvsDecoder * self,
+    const GstAvsSequenceHeader * seq)
+{
+  GstAvsDecoderPrivate *priv = self->priv;
+  GstAvsDecoderClass *klass = GST_AVS_DECODER_GET_CLASS (self);
+  GstFlowReturn ret;
+
+  if (priv->have_sequence &&
+      seq->horizontal_size == priv->seq.horizontal_size &&
+      seq->vertical_size == priv->seq.vertical_size &&
+      seq->profile_id == priv->seq.profile_id &&
+      seq->progressive_sequence == priv->seq.progressive_sequence &&
+      seq->low_delay == priv->seq.low_delay) {
+    priv->seq = *seq;
+    return GST_FLOW_OK;
+  }
+
+  GST_INFO_OBJECT (self, "new sequence: profile 0x%02x %ux%u %s%s",
+      seq->profile_id, seq->horizontal_size, seq->vertical_size,
+      seq->progressive_sequence ? "progressive" : "interlaced",
+      seq->low_delay ? " low delay" : "");
+
+  ret = gst_avs_decoder_drain_internal (self);
+  if (ret != GST_FLOW_OK)
+    return ret;
+
+  priv->seq = *seq;
+  priv->have_sequence = TRUE;
+
+  if (klass->get_preferred_output_delay)
+    priv->preferred_output_delay =
+        klass->get_preferred_output_delay (self, priv->is_live);
+  else
+    priv->preferred_output_delay = 0;
+
+  g_assert (klass->new_sequence);
+
+  /* R0, R1, R2, the picture being decoded and the preferred delay */
+  return klass->new_sequence (self, seq, 4 + priv->preferred_output_delay);
+}
+
+static GstFlowReturn
+gst_avs_decoder_handle_frame (GstVideoDecoder * decoder,
+    GstVideoCodecFrame * frame)
+{
+  GstAvsDecoder *self = GST_AVS_DECODER (decoder);
+  GstAvsDecoderClass *klass = GST_AVS_DECODER_GET_CLASS (self);
+  GstAvsDecoderPrivate *priv = self->priv;
+  GstBuffer *in_buf = frame->input_buffer;
+  GstAvsPictureHeader header;
+  GstAvsPicture *picture = NULL;
+  GstAvsPacket packet;
+  GstMapInfo map;
+  gboolean have_picture = FALSE;
+  guint offset = 0, pic_start = 0, first_slice = 0, end = 0;
+  GstFlowReturn ret = GST_FLOW_OK;
+  GstFlowReturn output_ret = GST_FLOW_OK;
+
+  GST_LOG_OBJECT (self, "handle frame, PTS: %" GST_TIME_FORMAT ", DTS: %"
+      GST_TIME_FORMAT, GST_TIME_ARGS (GST_BUFFER_PTS (in_buf)),
+      GST_TIME_ARGS (GST_BUFFER_DTS (in_buf)));
+
+  if (!gst_buffer_map (in_buf, &map, GST_MAP_READ)) {
+    GST_ERROR_OBJECT (self, "Cannot map buffer");
+    ret = GST_FLOW_ERROR;
+    goto error;
+  }
+
+  while (gst_avs_parse (&packet, map.data, map.size, offset) ==
+      GST_AVS_PARSER_OK) {
+    guint8 type = packet.type;
+
+    offset = packet.offset;
+
+    if (!have_picture) {
+      if (type == GST_AVS_START_CODE_SEQUENCE) {
+        GstAvsSequenceHeader seq;
+
+        if (gst_avs_parse_sequence_header (&packet, &seq) !=
+            GST_AVS_PARSER_OK) {
+          GST_WARNING_OBJECT (self, "Invalid sequence header");
+          continue;
+        }
+        ret = gst_avs_decoder_process_sequence (self, &seq);
+        if (ret != GST_FLOW_OK)
+          goto unmap_and_error;
+      } else if (type == GST_AVS_START_CODE_I_PICTURE ||
+          type == GST_AVS_START_CODE_PB_PICTURE) {
+        if (!priv->have_sequence) {
+          GST_DEBUG_OBJECT (self, "No sequence header yet, dropping picture");
+          break;
+        }
+        if (gst_avs_parse_picture_header (&packet, &priv->seq,
+                &priv->final_revision, &header) != GST_AVS_PARSER_OK) {
+          GST_WARNING_OBJECT (self, "Invalid picture header");
+          break;
+        }
+        have_picture = TRUE;
+        pic_start = packet.offset - 4;
+        end = packet.offset + packet.size;
+      }
+      continue;
+    }
+
+    /* the picture runs to its last slice, extension and user data between
+     * its header and its first slice belong to it */
+    if (type <= GST_AVS_START_CODE_SLICE_MAX) {
+      if (!first_slice)
+        first_slice = packet.offset - 4 - pic_start;
+      end = packet.offset + packet.size;
+    } else if ((type == GST_AVS_START_CODE_EXTENSION ||
+            type == GST_AVS_START_CODE_USER_DATA) && !first_slice) {
+      end = packet.offset + packet.size;
+    } else if (type == GST_AVS_START_CODE_I_PICTURE ||
+        type == GST_AVS_START_CODE_PB_PICTURE) {
+      GST_WARNING_OBJECT (self, "More than one picture in a buffer");
+      break;
+    }
+  }
+
+  if (!have_picture) {
+    gst_buffer_unmap (in_buf, &map);
+    gst_video_decoder_release_frame (decoder, frame);
+    return GST_FLOW_OK;
+  }
+
+  /* missing references at the start of the stream or after a seek */
+  if ((header.picture_type == GST_AVS_PICTURE_TYPE_P && !priv->refs[0]) ||
+      (header.picture_type == GST_AVS_PICTURE_TYPE_B &&
+          (!priv->refs[0] || !priv->refs[1]))) {
+    GST_DEBUG_OBJECT (self, "Missing reference, dropping %c picture",
+        "IPB"[header.picture_type]);
+    gst_buffer_unmap (in_buf, &map);
+    gst_video_decoder_release_frame (decoder, frame);
+    return GST_FLOW_OK;
+  }
+
+  picture = gst_avs_picture_new ();
+  picture->header = header;
+  picture->data = map.data + pic_start;
+  picture->size = end - pic_start;
+  picture->data_offset = first_slice;
+  GST_CODEC_PICTURE_FRAME_NUMBER (picture) = frame->system_frame_number;
+
+  if (priv->input_state_changed) {
+    gst_avs_picture_set_discont_state (picture, self->input_state);
+    priv->input_state_changed = FALSE;
+  }
+
+  if (klass->new_picture) {
+    ret = klass->new_picture (self, frame, picture);
+    if (ret != GST_FLOW_OK) {
+      GST_WARNING_OBJECT (self, "subclass failed to handle new picture");
+      goto unmap_and_error;
+    }
+  }
+
+  g_assert (klass->decode_picture);
+  ret = klass->decode_picture (self, picture, &priv->seq, priv->refs[0],
+      priv->refs[1], priv->refs[2]);
+  picture->data = NULL;
+  gst_buffer_unmap (in_buf, &map);
+  if (ret != GST_FLOW_OK) {
+    GST_WARNING_OBJECT (self, "subclass failed to decode current picture");
+    goto error;
+  }
+
+  if (header.picture_type == GST_AVS_PICTURE_TYPE_B) {
+    gst_avs_decoder_queue_output (self, frame, picture);
+  } else {
+    if (priv->held.frame) {
+      gst_avs_decoder_queue_output (self, priv->held.frame,
+          priv->held.picture);
+      memset (&priv->held, 0, sizeof (priv->held));
+    }
+
+    gst_avs_picture_replace (&priv->refs[2], priv->refs[1]);
+    gst_avs_picture_replace (&priv->refs[1], priv->refs[0]);
+    gst_avs_picture_replace (&priv->refs[0], picture);
+
+    if (priv->seq.low_delay) {
+      gst_avs_decoder_queue_output (self, frame, picture);
+    } else {
+      priv->held.frame = frame;
+      priv->held.picture = picture;
+      priv->held.self = self;
+    }
+  }
+
+  gst_avs_decoder_drain_output_queue (self, priv->preferred_output_delay,
+      &output_ret);
+
+  return output_ret;
+
+unmap_and_error:
+  gst_buffer_unmap (in_buf, &map);
+
+error:
+  if (picture)
+    gst_avs_picture_unref (picture);
+
+  if (ret == GST_FLOW_ERROR) {
+    GST_VIDEO_DECODER_ERROR (self, 1, STREAM, DECODE,
+        ("Failed to decode data"), (NULL), ret);
+  }
+
+  gst_video_decoder_release_frame (decoder, frame);
+
+  return ret;
+}
+
+static void
+gst_avs_decoder_init (GstAvsDecoder * self)
+{
+  gst_video_decoder_set_packetized (GST_VIDEO_DECODER (self), TRUE);
+  gst_video_decoder_set_needs_format (GST_VIDEO_DECODER (self), TRUE);
+
+  self->priv = gst_avs_decoder_get_instance_private (self);
+}
+
+static void
+gst_avs_decoder_class_init (GstAvsDecoderClass * klass)
+{
+  GstVideoDecoderClass *decoder_class = GST_VIDEO_DECODER_CLASS (klass);
+
+  decoder_class->start = GST_DEBUG_FUNCPTR (gst_avs_decoder_start);
+  decoder_class->stop = GST_DEBUG_FUNCPTR (gst_avs_decoder_stop);
+  decoder_class->set_format = GST_DEBUG_FUNCPTR (gst_avs_decoder_set_format);
+  decoder_class->negotiate = GST_DEBUG_FUNCPTR (gst_avs_decoder_negotiate);
+  decoder_class->finish = GST_DEBUG_FUNCPTR (gst_avs_decoder_finish);
+  decoder_class->flush = GST_DEBUG_FUNCPTR (gst_avs_decoder_flush);
+  decoder_class->drain = GST_DEBUG_FUNCPTR (gst_avs_decoder_drain);
+  decoder_class->handle_frame =
+      GST_DEBUG_FUNCPTR (gst_avs_decoder_handle_frame);
+}
