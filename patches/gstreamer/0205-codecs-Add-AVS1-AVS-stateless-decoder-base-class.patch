+
+#pragma once
+
+#include <gst/codecs/codecs-prelude.h>
+
+#include <gst/video/video.h>
+#include <gst/codecparsers/gstavsparser.h>
+#include <gst/codecs/gstavspicture.h>
+
+G_BEGIN_DECLS
+
+#define GST_TYPE_AVS_DECODER            (gst_avs_decoder_get_type())
+#define GST_AVS_DECODER(obj)            (G_TYPE_CHECK_INSTANCE_CAST((obj),GST_TYPE_AVS_DECODER,GstAvsDecoder))
+#define GST_AVS_DECODER_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST((klass),GST_TYPE_AVS_DECODER,GstAvsDecoderClass))
+#define GST_AVS_DECODER_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS((obj),GST_TYPE_AVS_DECODER,GstAvsDecoderClass))
+#define GST_IS_AVS_DECODER(obj)         (G_TYPE_CHECK_INSTANCE_TYPE((obj),GST_TYPE_AVS_DECODER))
+#define GST_IS_AVS_DECODER_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE((klass),GST_TYPE_AVS_DECODER))
+#define GST_AVS_DECODER_CAST(obj)       ((GstAvsDecoder*)obj)
+
+typedef struct _GstAvsDecoder GstAvsDecoder;
+typedef struct _GstAvsDecoderClass GstAvsDecoderClass;
+typedef struct _GstAvsDecoderPrivate GstAvsDecoderPrivate;
+
+/**
+ * GstAvsDecoder:
+ *
+ * The opaque #GstAvsDecoder data structure.
+ *
+ * Since: 1.30
+ */
+struct _GstAvsDecoder
+{
+  /*< private >*/
+  GstVideoDecoder parent;
+
+  /*< protected >*/
+  GstVideoCodecState * input_state;
+
+  /*< private >*/
+  GstAvsDecoderPrivate *priv;
+  gpointer padding[GST_PADDING_LARGE];
+};
+
+/**
+ * GstAvsDecoderClass:
+ *
+ * Since: 1.30
+ */
+struct _GstAvsDecoderClass
+{
+  /*< private >*/
+  GstVideoDecoderClass parent_class;
+
+  /**
+   * GstAvsDecoderClass::new_sequence:
+   * @decoder: a #GstAvsDecoder
+   * @seq: the new #GstAvsSequenceHeader
+   * @max_dpb_size: the number of pictures the decoder holds at most: the
+   *   references, the picture being decoded and the preferred output delay
+   *
+   * Notifies the subclass of a new sequence (the first one, or a sequence
+   * header with a different size, profile or scan). Pictures of the
+   * previous sequence have been output.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*new_sequence)     (GstAvsDecoder * decoder,
+                                     const GstAvsSequenceHeader * seq,
+                                     gint max_dpb_size);
+
+  /**
+   * GstAvsDecoderClass::new_picture:
+   * @decoder: a #GstAvsDecoder
+   * @frame: (transfer none): a #GstVideoCodecFrame
+   * @picture: (transfer none): a #GstAvsPicture
+   *
+   * Optional. Called whenever a new #GstAvsPicture is created.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*new_picture)      (GstAvsDecoder * decoder,
+                                     GstVideoCodecFrame * frame,
+                                     GstAvsPicture * picture);
+
+  /**
+   * GstAvsDecoderClass::decode_picture:
+   * @decoder: a #GstAvsDecoder
+   * @picture: (transfer none): the #GstAvsPicture to decode
+   * @seq: the active #GstAvsSequenceHeader
+   * @ref0: (transfer none) (nullable): R0, the I or P picture decoded last
+   * @ref1: (transfer none) (nullable): R1, the I or P picture before @ref0
+   * @ref2: (transfer none) (nullable): R2, the I or P picture before @ref1
+   *
+   * Decodes one picture. I and P pictures refer to @ref0 and @ref1, B
+   * pictures to @ref1 (forward) and @ref0 (backward); of @ref2 only the
+   * picture header matters (B picture distance scaling).
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*decode_picture)   (GstAvsDecoder * decoder,
+                                     GstAvsPicture * picture,
+                                     const GstAvsSequenceHeader * seq,
+                                     GstAvsPicture * ref0,
+                                     GstAvsPicture * ref1,
+                                     GstAvsPicture * ref2);
+
+  /**
+   * GstAvsDecoderClass::output_picture:
+   * @decoder: a #GstAvsDecoder
+   * @frame: (transfer full): a #GstVideoCodecFrame
+   * @picture: (transfer full): a #GstAvsPicture
+   *
+   * Called with a #GstAvsPicture which is to be output, in display order.
+   * The #GstVideoCodecFrame must be consumed by the subclass.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*output_picture)   (GstAvsDecoder * decoder,
+                                     GstVideoCodecFrame * frame,
+                                     GstAvsPicture * picture);
+
+  /**
+   * GstAvsDecoderClass::get_preferred_output_delay:
+   * @decoder: a #GstAvsDecoder
+   * @is_live: whether upstream is live or not
+   *
+   * Optional. Returns the number of pictures by which the subclass prefers
+   * the output to be delayed, so that it can keep decoding meanwhile.
+   *
+   * Since: 1.30
+   */
+  guint (*get_preferred_output_delay) (GstAvsDecoder * decoder,
+                                       gboolean is_live);
+
+  /*< private >*/
+  gpointer padding[GST_PADDING_LARGE];
+};
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC(GstAvsDecoder, gst_object_unref)
+
+GST_CODECS_API
+GType gst_avs_decoder_get_type (void);
+
+G_END_DECLS
