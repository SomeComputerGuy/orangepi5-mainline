new file mode 100644
index 0000000..82de5bd
--- /dev/null
+++ b/gst-libs/gst/codecs/gstavspicture.h
@@ -0,0 +1,115 @@
+/* GStreamer
+ * Copyright (C) 2026 Arun Iyengar <aiyengar1990@gmail.com>
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Library General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Library General Public License for more details.
+ *
+ * You should have received a copy of the GNU Library General Public
+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+#pragma once
+
+#include <gst/codecs/codecs-prelude.h>
+#include <gst/codecs/gstcodecpicture.h>
+#include <gst/codecparsers/gstavsparser.h>
+
+G_BEGIN_DECLS
+
+#define GST_TYPE_AVS_PICTURE     (gst_avs_picture_get_type())
+#define GST_IS_AVS_PICTURE(obj)  (GST_IS_MINI_OBJECT_TYPE(obj, GST_TYPE_AVS_PICTURE))
+#define GST_AVS_PICTURE(obj)     ((GstAvsPicture *)obj)
+
+typedef struct _GstAvsPicture GstAvsPicture;
+
+/**
+ * GstAvsPicture:
+ * @header: the picture header
+ * @data: the coded picture, from its picture start code to the end of its
+ *   last slice; only valid while the picture is decoded
+ * @size: the size of @data
+ * @data_offset: the offset in @data of the start code of the first slice,
+ *   0 for streams of the pre-final revision without slice start codes
+ *
+ * Since: 1.30
+ */
+struct _GstAvsPicture
+{
+  /*< private >*/
+  GstCodecPicture parent;
+
+  /*< public >*/
+  GstAvsPictureHeader header;
+
+  const guint8 *data;
+  gsize size;
+  guint data_offset;
+};
+
+GST_CODECS_API
+GType gst_avs_picture_get_type (void);
+
+GST_CODECS_API
+GstAvsPicture * gst_avs_picture_new (void) G_GNUC_WARN_UNUSED_RESULT;
+
+static inline GstAvsPicture *
+gst_avs_picture_ref (GstAvsPicture * picture)
+{
+  return (GstAvsPicture *) gst_mini_object_ref (GST_MINI_OBJECT_CAST (picture));
+}
+
+static inline void
+gst_avs_picture_unref (GstAvsPicture * picture)
+{
+  gst_mini_object_unref (GST_MINI_OBJECT_CAST (picture));
+}
+
+static inline gboolean
+gst_avs_picture_replace (GstAvsPicture ** old_picture,
+    GstAvsPicture * new_picture)
+{
+  return gst_mini_object_replace ((GstMiniObject **) old_picture,
+      (GstMiniObject *) new_picture);
+}
+
+static inline void
+gst_clear_avs_picture (GstAvsPicture ** picture)
+{
+  if (picture && *picture) {
+    gst_avs_picture_unref (*picture);
+    *picture = NULL;
+  }
+}
+
+static inline void
+gst_avs_picture_set_user_data (GstAvsPicture * picture, gpointer user_data,
+    GDestroyNotify notify)
+{
+  gst_codec_picture_set_user_data (GST_CODEC_PICTURE (picture),
+      user_data, notify);
+}
+
+static inline gpointer
+gst_avs_picture_get_user_data (GstAvsPicture * picture)
+{
+  return gst_codec_picture_get_user_data (GST_CODEC_PICTURE (picture));
+}
+
+static inline void
+gst_avs_picture_set_discont_state (GstAvsPicture * picture,
+    GstVideoCodecState * discont_state)
+{
+  gst_codec_picture_set_discont_state (GST_CODEC_PICTURE (picture),
+      discont_state);
+}
+
+G_END_DECLS
