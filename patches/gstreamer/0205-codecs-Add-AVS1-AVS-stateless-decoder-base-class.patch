 gst-libs/gst/codecs/gstavsdecoder.h | 162 +++++++++
 gst-libs/gst/codecs/gstavspicture.c |  55 ++++
 gst-libs/gst/codecs/gstavspicture.h | 115 +++++++
 gst-libs/gst/codecs/meson.build     |   4 +
 5 files changed, 830 insertions(+)
