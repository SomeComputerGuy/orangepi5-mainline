+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+
+#pragma once
+
+#include <gst/codecs/codecs-prelude.h>
+#include <gst/codecs/gstcodecpicture.h>
+#include <gst/codecparsers/gstmpeg4parser.h>
+
+G_BEGIN_DECLS
+
+#define GST_TYPE_MPEG4_PICTURE     (gst_mpeg4_picture_get_type())
+#define GST_IS_MPEG4_PICTURE(obj)  (GST_IS_MINI_OBJECT_TYPE(obj, GST_TYPE_MPEG4_PICTURE))
+#define GST_MPEG4_PICTURE(obj)     ((GstMpeg4Picture *)obj)
+
+typedef struct _GstMpeg4Picture GstMpeg4Picture;
+typedef struct _GstMpeg4H263PictureHeader GstMpeg4H263PictureHeader;
+
+/**
+ * GstMpeg4H263PictureFlags:
+ * @GST_MPEG4_H263_PICTURE_FLAG_PLUSPTYPE: the picture header has an extended
+ *   picture type (PLUSPTYPE, H.263 version 2 and later)
+ * @GST_MPEG4_H263_PICTURE_FLAG_UMV: unrestricted motion vectors (annex D)
+ * @GST_MPEG4_H263_PICTURE_FLAG_SAC: syntax-based arithmetic coding (annex E)
+ * @GST_MPEG4_H263_PICTURE_FLAG_AP: advanced prediction (annex F)
+ * @GST_MPEG4_H263_PICTURE_FLAG_PB_FRAMES: PB-frame (annex G) or improved
+ *   PB-frame (annex M)
+ * @GST_MPEG4_H263_PICTURE_FLAG_AIC: advanced intra coding (annex I)
+ * @GST_MPEG4_H263_PICTURE_FLAG_DF: deblocking filter (annex J)
+ * @GST_MPEG4_H263_PICTURE_FLAG_SS: slice structured (annex K)
+ * @GST_MPEG4_H263_PICTURE_FLAG_SS_RECTANGULAR: rectangular slices
+ * @GST_MPEG4_H263_PICTURE_FLAG_SS_ARBITRARY: arbitrary slice ordering
+ * @GST_MPEG4_H263_PICTURE_FLAG_RPS: reference picture selection (annex N)
+ * @GST_MPEG4_H263_PICTURE_FLAG_ISD: independent segment decoding (annex R)
+ * @GST_MPEG4_H263_PICTURE_FLAG_AIV: alternative inter VLC (annex S)
+ * @GST_MPEG4_H263_PICTURE_FLAG_MQ: modified quantization (annex T)
+ * @GST_MPEG4_H263_PICTURE_FLAG_RPR: reference picture resampling (annex P)
+ * @GST_MPEG4_H263_PICTURE_FLAG_RRU: reduced resolution update (annex Q)
+ * @GST_MPEG4_H263_PICTURE_FLAG_ROUNDING_TYPE: rounding type (RTYPE)
+ * @GST_MPEG4_H263_PICTURE_FLAG_DISPOSABLE: Sorenson Spark disposable
+ *   inter picture, not used as a reference
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_MPEG4_H263_PICTURE_FLAG_PLUSPTYPE = (1 << 0),
+  GST_MPEG4_H263_PICTURE_FLAG_UMV = (1 << 1),
+  GST_MPEG4_H263_PICTURE_FLAG_SAC = (1 << 2),
+  GST_MPEG4_H263_PICTURE_FLAG_AP = (1 << 3),
+  GST_MPEG4_H263_PICTURE_FLAG_PB_FRAMES = (1 << 4),
+  GST_MPEG4_H263_PICTURE_FLAG_AIC = (1 << 5),
+  GST_MPEG4_H263_PICTURE_FLAG_DF = (1 << 6),
+  GST_MPEG4_H263_PICTURE_FLAG_SS = (1 << 7),
+  GST_MPEG4_H263_PICTURE_FLAG_SS_RECTANGULAR = (1 << 8),
+  GST_MPEG4_H263_PICTURE_FLAG_SS_ARBITRARY = (1 << 9),
+  GST_MPEG4_H263_PICTURE_FLAG_RPS = (1 << 10),
+  GST_MPEG4_H263_PICTURE_FLAG_ISD = (1 << 11),
+  GST_MPEG4_H263_PICTURE_FLAG_AIV = (1 << 12),
+  GST_MPEG4_H263_PICTURE_FLAG_MQ = (1 << 13),
+  GST_MPEG4_H263_PICTURE_FLAG_RPR = (1 << 14),
+  GST_MPEG4_H263_PICTURE_FLAG_RRU = (1 << 15),
+  GST_MPEG4_H263_PICTURE_FLAG_ROUNDING_TYPE = (1 << 16),
+  GST_MPEG4_H263_PICTURE_FLAG_DISPOSABLE = (1 << 17),
+} GstMpeg4H263PictureFlags;
+
+/**
+ * GstMpeg4H263PictureHeader:
+ * @temporal_reference: temporal reference (TR)
+ * @flags: see #GstMpeg4H263PictureFlags
+ * @width: the width in luma samples
+ * @height: the height in luma samples
+ * @pquant: the picture quantizer (PQUANT)
+ * @spk_version: the Sorenson Spark bitstream version, 0 or 1, 0 for H.263
+ *
+ * The picture header of an H.263 (ITU-T H.263, version 1 and 2) or Sorenson
+ * Spark picture.
+ *
+ * Since: 1.30
+ */
+struct _GstMpeg4H263PictureHeader
+{
+  guint8 temporal_reference;
+  GstMpeg4H263PictureFlags flags;
+  guint16 width;
+  guint16 height;
+  guint8 pquant;
+  guint8 spk_version;
+};
+
+/**
+ * GstMpeg4Picture:
+ * @coding_type: the coding type of the picture (I, P, B or S)
+ * @vop: the VOP header (MPEG-4 Part 2)
+ * @trb: TRB of a B-VOP, in ticks of vop_time_increment_resolution
+ * @trd: TRD of a B-VOP
+ * @trb_field: TRB of the field macroblocks of a B-VOP, in field periods
+ * @trd_field: TRD of the field macroblocks of a B-VOP
+ * @h263: the picture header (H.263 and Sorenson Spark)
+ * @data: the coded picture, from the first byte of its start code (VOP start
+ *   code or picture start code) to its end; only valid while the picture is
+ *   decoded
+ * @size: the size of @data
+ * @header_size: the size in bits of the picture header, from the first bit
+ *   of @data to the first macroblock
+ *
+ * Since: 1.30
+ */
+struct _GstMpeg4Picture
+{
+  /*< private >*/
+  GstCodecPicture parent;
+
+  /*< public >*/
+  GstMpeg4VideoObjectCodingType coding_type;
+
+  GstMpeg4VideoObjectPlane vop;
+  guint32 trb;
+  guint32 trd;
+  guint16 trb_field;
+  guint16 trd_field;
+
+  GstMpeg4H263PictureHeader h263;
+
+  const guint8 *data;
+  gsize size;
+  guint header_size;
+};
+
+GST_CODECS_API
+GType gst_mpeg4_picture_get_type (void);
+
+GST_CODECS_API
+GstMpeg4Picture * gst_mpeg4_picture_new (void) G_GNUC_WARN_UNUSED_RESULT;
+
+static inline GstMpeg4Picture *
+gst_mpeg4_picture_ref (GstMpeg4Picture * picture)
+{
+  return (GstMpeg4Picture *) gst_mini_object_ref (GST_MINI_OBJECT_CAST (picture));
+}
+
+static inline void
+gst_mpeg4_picture_unref (GstMpeg4Picture * picture)
+{
+  gst_mini_object_unref (GST_MINI_OBJECT_CAST (picture));
+}
+
+static inline gboolean
+gst_mpeg4_picture_replace (GstMpeg4Picture ** old_picture,
+    GstMpeg4Picture * new_picture)
+{
+  return gst_mini_object_replace ((GstMiniObject **) old_picture,
+      (GstMiniObject *) new_picture);
+}
+
+static inline void
+gst_clear_mpeg4_picture (GstMpeg4Picture ** picture)
+{
+  if (picture && *picture) {
+    gst_mpeg4_picture_unref (*picture);
+    *picture = NULL;
+  }
+}
+
+static inline void
+gst_mpeg4_picture_set_user_data (GstMpeg4Picture * picture, gpointer user_data,
+    GDestroyNotify notify)
+{
+  gst_codec_picture_set_user_data (GST_CODEC_PICTURE (picture),
+      user_data, notify);
+}
+
+static inline gpointer
+gst_mpeg4_picture_get_user_data (GstMpeg4Picture * picture)
+{
+  return gst_codec_picture_get_user_data (GST_CODEC_PICTURE (picture));
+}
+
+static inline void
+gst_mpeg4_picture_set_discont_state (GstMpeg4Picture * picture,
+    GstVideoCodecState * discont_state)
+{
+  gst_codec_picture_set_discont_state (GST_CODEC_PICTURE (picture),
+      discont_state);
+}
+
+G_END_DECLS
