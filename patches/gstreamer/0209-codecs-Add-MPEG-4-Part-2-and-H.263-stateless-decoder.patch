+ * You should have received a copy of the GNU Library General Public
+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+
+#pragma once
+
+#include <gst/codecs/codecs-prelude.h>
+
+#include <gst/video/video.h>
+#include <gst/codecparsers/gstmpeg4parser.h>
+#include <gst/codecs/gstmpeg4picture.h>
+
+G_BEGIN_DECLS
+
+#define GST_TYPE_MPEG4_DECODER            (gst_mpeg4_decoder_get_type())
+#define GST_MPEG4_DECODER(obj)            (G_TYPE_CHECK_INSTANCE_CAST((obj),GST_TYPE_MPEG4_DECODER,GstMpeg4Decoder))
+#define GST_MPEG4_DECODER_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST((klass),GST_TYPE_MPEG4_DECODER,GstMpeg4DecoderClass))
+#define GST_MPEG4_DECODER_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS((obj),GST_TYPE_MPEG4_DECODER,GstMpeg4DecoderClass))
+#define GST_IS_MPEG4_DECODER(obj)         (G_TYPE_CHECK_INSTANCE_TYPE((obj),GST_TYPE_MPEG4_DECODER))
+#define GST_IS_MPEG4_DECODER_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE((klass),GST_TYPE_MPEG4_DECODER))
+#define GST_MPEG4_DECODER_CAST(obj)       ((GstMpeg4Decoder*)obj)
+
+typedef struct _GstMpeg4Decoder GstMpeg4Decoder;
+typedef struct _GstMpeg4DecoderClass GstMpeg4DecoderClass;
+typedef struct _GstMpeg4DecoderPrivate GstMpeg4DecoderPrivate;
+
+/**
+ * GstMpeg4DecoderFormat:
+ * @GST_MPEG4_DECODER_FORMAT_NONE: no input format yet
+ * @GST_MPEG4_DECODER_FORMAT_MPEG4: MPEG-4 Part 2 (video/mpeg, mpegversion 4)
+ * @GST_MPEG4_DECODER_FORMAT_H263: H.263 (video/x-h263, variant itu)
+ * @GST_MPEG4_DECODER_FORMAT_SPARK: Sorenson Spark (video/x-flash-video,
+ *   flvversion 1)
+ *
+ * The bitstream format, chosen by the sink caps.
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_MPEG4_DECODER_FORMAT_NONE,
+  GST_MPEG4_DECODER_FORMAT_MPEG4,
+  GST_MPEG4_DECODER_FORMAT_H263,
+  GST_MPEG4_DECODER_FORMAT_SPARK,
+} GstMpeg4DecoderFormat;
+
+/**
+ * GstMpeg4DecoderEncoderBugs:
+ * @GST_MPEG4_DECODER_BUG_EDGE: motion vectors point outside the picture
+ *   relative to its exact size, not its macroblock aligned size
+ * @GST_MPEG4_DECODER_BUG_QPEL_CHROMA: quarter sample chroma vectors are
+ *   derived with the rounding of old DivX 5 and Xvid releases
+ * @GST_MPEG4_DECODER_BUG_QPEL_CHROMA2: quarter sample chroma vectors are
+ *   derived with the rounding of DivX 5.0.3 and later
+ * @GST_MPEG4_DECODER_BUG_STD_QPEL: quarter sample interpolation of old
+ *   libavcodec releases
+ * @GST_MPEG4_DECODER_BUG_DIRECT_BLOCKSIZE: direct mode chroma vectors of
+ *   quarter sample B-VOPs are derived per macroblock
+ * @GST_MPEG4_DECODER_BUG_HPEL_CHROMA: chroma vectors of field macroblocks are
+ *   rounded as frame vectors
+ * @GST_MPEG4_DECODER_BUG_DC_CLIP: intra DC values are not clipped
+ * @GST_MPEG4_DECODER_BUG_IEDGE: intra blocks use edge emulation (some
+ *   libavcodec 54 to 57 releases)
+ * @GST_MPEG4_DECODER_BUG_GMC_UNSCALED_REF: GMC reference points are not
+ *   scaled (DivX 5.0.0 build 413)
+ * @GST_MPEG4_DECODER_BUG_PACKED_BITSTREAM: the encoder packs B-VOPs with the
+ *   following VOP (DivX packed bitstream)
+ *
+ * The deviations from ISO/IEC 14496-2 of the encoder of the stream, as far
+ * as they can be detected from its user data.
+ *
+ * Since: 1.30
+ */
+typedef enum
+{
+  GST_MPEG4_DECODER_BUG_EDGE = (1 << 0),
+  GST_MPEG4_DECODER_BUG_QPEL_CHROMA = (1 << 1),
+  GST_MPEG4_DECODER_BUG_QPEL_CHROMA2 = (1 << 2),
+  GST_MPEG4_DECODER_BUG_STD_QPEL = (1 << 3),
+  GST_MPEG4_DECODER_BUG_DIRECT_BLOCKSIZE = (1 << 4),
+  GST_MPEG4_DECODER_BUG_HPEL_CHROMA = (1 << 5),
+  GST_MPEG4_DECODER_BUG_DC_CLIP = (1 << 6),
+  GST_MPEG4_DECODER_BUG_IEDGE = (1 << 7),
+  GST_MPEG4_DECODER_BUG_GMC_UNSCALED_REF = (1 << 8),
+  GST_MPEG4_DECODER_BUG_PACKED_BITSTREAM = (1 << 9),
+} GstMpeg4DecoderEncoderBugs;
+
+/**
+ * GstMpeg4Decoder:
+ *
+ * The opaque #GstMpeg4Decoder data structure.
+ *
+ * Since: 1.30
+ */
+struct _GstMpeg4Decoder
+{
+  /*< private >*/
+  GstVideoDecoder parent;
+
+  /*< protected >*/
+  GstVideoCodecState * input_state;
+
+  /*< private >*/
+  GstMpeg4DecoderPrivate *priv;
+  gpointer padding[GST_PADDING_LARGE];
+};
+
+/**
+ * GstMpeg4DecoderClass:
+ *
+ * Since: 1.30
+ */
+struct _GstMpeg4DecoderClass
+{
+  /*< private >*/
+  GstVideoDecoderClass parent_class;
+
+  /**
+   * GstMpeg4DecoderClass::new_sequence:
+   * @decoder: a #GstMpeg4Decoder
+   * @vol: (nullable): the new #GstMpeg4VideoObjectLayer, %NULL for H.263
+   *   and Sorenson Spark
+   * @width: the picture width
+   * @height: the picture height
+   * @max_dpb_size: the number of pictures the decoder holds at most: the
+   *   references, the picture being decoded and the preferred output delay
+   *
+   * Notifies the subclass of a new sequence: the first one, a video object
+   * layer of a different size or scan, or an H.263 picture of a different
+   * size. Pictures of the previous sequence have been output.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*new_sequence)     (GstMpeg4Decoder * decoder,
+                                     const GstMpeg4VideoObjectLayer * vol,
+                                     gint width,
+                                     gint height,
+                                     gint max_dpb_size);
+
+  /**
+   * GstMpeg4DecoderClass::new_picture:
+   * @decoder: a #GstMpeg4Decoder
+   * @frame: (transfer none): a #GstVideoCodecFrame
+   * @picture: (transfer none): a #GstMpeg4Picture
+   *
+   * Optional. Called whenever a new #GstMpeg4Picture is created.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*new_picture)      (GstMpeg4Decoder * decoder,
+                                     GstVideoCodecFrame * frame,
+                                     GstMpeg4Picture * picture);
+
+  /**
+   * GstMpeg4DecoderClass::decode_picture:
+   * @decoder: a #GstMpeg4Decoder
+   * @picture: (transfer none): the #GstMpeg4Picture to decode
+   * @vol: (nullable): the active #GstMpeg4VideoObjectLayer, %NULL for H.263
+   *   and Sorenson Spark
+   * @forward_ref: (transfer none) (nullable): the forward reference of P, S
+   *   and B pictures
+   * @backward_ref: (transfer none) (nullable): the backward reference of B
+   *   pictures
+   *
+   * Decodes one picture.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*decode_picture)   (GstMpeg4Decoder * decoder,
+                                     GstMpeg4Picture * picture,
+                                     const GstMpeg4VideoObjectLayer * vol,
+                                     GstMpeg4Picture * forward_ref,
+                                     GstMpeg4Picture * backward_ref);
+
+  /**
+   * GstMpeg4DecoderClass::output_picture:
+   * @decoder: a #GstMpeg4Decoder
+   * @frame: (transfer full): a #GstVideoCodecFrame
+   * @picture: (transfer full): a #GstMpeg4Picture
+   *
+   * Called with a #GstMpeg4Picture which is to be output, in display order.
+   * The #GstVideoCodecFrame must be consumed by the subclass.
+   *
+   * Since: 1.30
+   */
+  GstFlowReturn (*output_picture)   (GstMpeg4Decoder * decoder,
+                                     GstVideoCodecFrame * frame,
+                                     GstMpeg4Picture * picture);
+
+  /**
+   * GstMpeg4DecoderClass::get_preferred_output_delay:
+   * @decoder: a #GstMpeg4Decoder
+   * @is_live: whether upstream is live or not
+   *
+   * Optional. Returns the number of pictures by which the subclass prefers
+   * the output to be delayed, so that it can keep decoding meanwhile.
+   *
+   * Since: 1.30
+   */
+  guint (*get_preferred_output_delay) (GstMpeg4Decoder * decoder,
+                                       gboolean is_live);
+
+  /*< private >*/
+  gpointer padding[GST_PADDING_LARGE];
+};
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC(GstMpeg4Decoder, gst_object_unref)
+
+GST_CODECS_API
+GType gst_mpeg4_decoder_get_type (void);
+
+GST_CODECS_API
+GstMpeg4DecoderFormat gst_mpeg4_decoder_get_format (GstMpeg4Decoder * decoder);
+
+GST_CODECS_API
+GstMpeg4DecoderEncoderBugs gst_mpeg4_decoder_get_encoder_bugs (GstMpeg4Decoder * decoder);
+
+GST_CODECS_API
+gboolean gst_mpeg4_decoder_get_low_delay (GstMpeg4Decoder * decoder);
+
+G_END_DECLS
