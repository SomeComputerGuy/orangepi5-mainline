+/*
+ * Common part of the V4L2 stateless encoders (v4l2slh264enc, v4l2slh265enc).
+ *
+ * The stateless encode uAPIs this targets are "kernel-driven": the kernel
+ * writes the parameter sets and slice headers and tracks the reference
+ * pictures, and it runs the bitrate control for CBR. Userspace configures
+ * the sequence with SPS/PPS controls and describes each picture (type,
+ * reference marking, POC) in a request. This class does the format and
+ * buffer handling, the GOP structure, the rate control setup (constant QP
+ * and CBR in the kernel, a frame-level VBR in userspace with per-request
+ * QPs), and keeps a few requests queued so that the hardware never waits
+ * for userspace between pictures.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include "gstv4l2codecbaseenc.h"
+#include "linux/v4l2-controls.h"
+
+#include <math.h>
+#include <string.h>
+
+GST_DEBUG_CATEGORY_STATIC (v4l2_base_enc_debug);
+#define GST_CAT_DEFAULT v4l2_base_enc_debug
+
+#define DEFAULT_RATE_CONTROL GST_V4L2_ENC_RC_CBR
+#define DEFAULT_BITRATE 0
+#define DEFAULT_MAX_BITRATE 0
+#define DEFAULT_QP_I 26
+#define DEFAULT_QP_P 28
+#define DEFAULT_QP_MIN 10
+#define DEFAULT_QP_MAX 51
+#define DEFAULT_KEY_INT_MAX 0
+#define DEFAULT_MAX_INFLIGHT 2
+#define MAX_INFLIGHT 8
+
+#define REQUEST_TIMEOUT (2 * GST_SECOND)
+
+enum
+{
+  PROP_0,
+  PROP_RATE_CONTROL,
+  PROP_BITRATE,
+  PROP_MAX_BITRATE,
+  PROP_QP_I,
+  PROP_QP_P,
+  PROP_QP_MIN,
+  PROP_QP_MAX,
+  PROP_KEY_INT_MAX,
+  PROP_MAX_INFLIGHT,
+};
+
+enum
+{
+  PROP_DEVICE_0 = 0x100,
+};
+
+#define GST_TYPE_V4L2_ENC_RATE_CONTROL (gst_v4l2_enc_rate_control_get_type ())
+static GType
+gst_v4l2_enc_rate_control_get_type (void)
+{
+  static const GEnumValue values[] = {
+    {GST_V4L2_ENC_RC_CQP, "Constant QP (qp-i, qp-p)", "cqp"},
+    {GST_V4L2_ENC_RC_CBR, "Constant bitrate (driver rate control)", "cbr"},
+    {GST_V4L2_ENC_RC_VBR, "Variable bitrate (frame-level, in the element)",
+        "vbr"},
+    {0, NULL, NULL},
+  };
+  static GType type = 0;
+
+  if (g_once_init_enter (&type)) {
+    GType t = g_enum_register_static ("GstV4l2EncRateControl", values);
+    g_once_init_leave (&type, t);
+  }
+
+  return type;
+}
+
+#define parent_class gst_v4l2_codec_base_enc_parent_class
+G_DEFINE_ABSTRACT_TYPE_WITH_CODE (GstV4l2CodecBaseEnc, gst_v4l2_codec_base_enc,
+    GST_TYPE_VIDEO_ENCODER,
+    GST_DEBUG_CATEGORY_INIT (v4l2_base_enc_debug, "v4l2codecs-enc", 0,
+        "V4L2 stateless encoder"));
+
+static void
+enc_frame_free (GstV4l2CodecEncFrame * f)
+{
+  if (f->request)
+    gst_v4l2_encode_request_recycle (f->request);
+  if (f->frame)
+    gst_video_codec_frame_unref (f->frame);
+  g_free (f);
+}
+
+static void
+gst_v4l2_codec_base_enc_drop_pending (GstV4l2CodecBaseEnc * self)
+{
+  GstV4l2CodecEncFrame *f;
+
+  while ((f = g_queue_pop_head (&self->pending)))
+    enc_frame_free (f);
+}
+
+static void
+gst_v4l2_codec_base_enc_set_flushing (GstV4l2CodecBaseEnc * self,
+    gboolean flushing)
+{
+  if (self->sink_allocator)
+    gst_v4l2_codec_allocator_set_flushing (self->sink_allocator, flushing);
+  if (self->src_allocator)
+    gst_v4l2_codec_allocator_set_flushing (self->src_allocator, flushing);
+}
+
+static void
+gst_v4l2_codec_base_enc_reset_allocation (GstV4l2CodecBaseEnc * self)
+{
+  if (self->sink_allocator) {
+    gst_v4l2_codec_allocator_detach (self->sink_allocator);
+    g_clear_object (&self->sink_pool);
+    g_clear_object (&self->sink_allocator);
+  }
+
+  if (self->src_allocator) {
+    gst_v4l2_codec_allocator_detach (self->src_allocator);
+    g_clear_object (&self->src_pool);
+    g_clear_object (&self->src_allocator);
+  }
+}
+
+static void
+gst_v4l2_codec_base_enc_streamoff (GstV4l2CodecBaseEnc * self)
+{
+  if (!self->streaming)
+    return;
+
+  gst_v4l2_encoder_streamoff (self->encoder, GST_PAD_SINK);
+  gst_v4l2_encoder_streamoff (self->encoder, GST_PAD_SRC);
+  self->streaming = FALSE;
+  /* STREAMOFF cancelled whatever was still queued. */
+  gst_v4l2_codec_base_enc_drop_pending (self);
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_open (GstVideoEncoder * encoder)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+
+  if (!gst_v4l2_encoder_open (self->encoder)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, OPEN_READ_WRITE,
+        ("Failed to open the encoder"),
+        ("gst_v4l2_encoder_open() failed: %s", g_strerror (errno)));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_close (GstVideoEncoder * encoder)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+
+  gst_v4l2_encoder_close (self->encoder);
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_start (GstVideoEncoder * encoder)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+
+  self->next_id = 1;
+  self->last_id = 0;
+  self->frames_since_idr = 0;
+  self->idr_count = 0;
+  self->force_idr = TRUE;
+  self->total_bytes = 0;
+  self->total_frames = 0;
+  self->copied_frames = 0;
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_stop (GstVideoEncoder * encoder)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+
+  if (self->total_frames)
+    GST_INFO_OBJECT (self, "Encoded %" G_GUINT64_FORMAT " pictures (%"
+        G_GUINT64_FORMAT " copied), %" G_GUINT64_FORMAT " bytes, %.1f kbit/s",
+        self->total_frames, self->copied_frames, self->total_bytes,
+        self->total_bytes * 8.0 * self->fps_n / self->fps_d /
+        self->total_frames / 1000.0);
+
+  gst_v4l2_codec_base_enc_streamoff (self);
+  gst_v4l2_codec_base_enc_reset_allocation (self);
+  g_clear_pointer (&self->output_state, gst_video_codec_state_unref);
+  g_clear_pointer (&self->vbr_win, g_free);
+
+  return TRUE;
+}
+
+static GstCaps *
+gst_v4l2_codec_base_enc_getcaps (GstVideoEncoder * encoder, GstCaps * filter)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+  GstV4l2CodecBaseEncClass *klass = GST_V4L2_CODEC_BASE_ENC_GET_CLASS (self);
+  GstCaps *caps = NULL, *result;
+  struct v4l2_frmsize_stepwise range;
+
+  caps = gst_v4l2_encoder_list_sink_formats (self->encoder);
+  if (caps && gst_v4l2_encoder_get_frame_size_range (self->encoder,
+          klass->coded_fourcc, &range)) {
+    GstStructure *s = gst_caps_get_structure (caps, 0);
+
+    if (range.min_width == range.max_width)
+      gst_structure_set (s, "width", G_TYPE_INT, range.min_width, NULL);
+    else
+      gst_structure_set (s, "width", GST_TYPE_INT_RANGE, range.min_width,
+          range.max_width, NULL);
+    if (range.min_height == range.max_height)
+      gst_structure_set (s, "height", G_TYPE_INT, range.min_height, NULL);
+    else
+      gst_structure_set (s, "height", GST_TYPE_INT_RANGE, range.min_height,
+          range.max_height, NULL);
+  }
+
+  result = gst_video_encoder_proxy_getcaps (encoder, caps, filter);
+  gst_clear_caps (&caps);
+
+  GST_DEBUG_OBJECT (self, "Returning sink caps %" GST_PTR_FORMAT, result);
+
+  return result;
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_propose_allocation (GstVideoEncoder * encoder,
+    GstQuery * query)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+  gboolean need_pool;
+
+  gst_query_parse_allocation (query, NULL, &need_pool);
+
+  /* Pictures written into the encoder's own buffers are imported without a
+   * copy. */
+  if (need_pool && self->sink_pool)
+    gst_query_add_allocation_pool (query, GST_BUFFER_POOL (self->sink_pool),
+        self->vinfo_drm.vinfo.size, 0, 0);
+  gst_query_add_allocation_meta (query, GST_VIDEO_META_API_TYPE, NULL);
+
+  return GST_VIDEO_ENCODER_CLASS (parent_class)->propose_allocation (encoder,
+      query);
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_set_rc_controls (GstV4l2CodecBaseEnc * self)
+{
+  GstV4l2CodecBaseEncClass *klass = GST_V4L2_CODEC_BASE_ENC_GET_CLASS (self);
+  struct v4l2_query_ext_ctrl q;
+  struct v4l2_ext_control c[8];
+  guint n = 0;
+
+  memset (c, 0, sizeof (c));
+  c[n].id = klass->cid_min_qp;
+  c[n++].value = self->qp_min;
+  c[n].id = klass->cid_max_qp;
+  c[n++].value = self->qp_max;
+
+  switch (self->rate_control) {
+    case GST_V4L2_ENC_RC_CBR:
+      c[n].id = V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE;
+      c[n++].value = 1;
+      c[n].id = V4L2_CID_MPEG_VIDEO_BITRATE_MODE;
+      c[n++].value = V4L2_MPEG_VIDEO_BITRATE_MODE_CBR;
+      c[n].id = V4L2_CID_MPEG_VIDEO_BITRATE;
+      c[n++].value = self->bitrate;
+      break;
+    case GST_V4L2_ENC_RC_CQP:
+    case GST_V4L2_ENC_RC_VBR:
+      c[n].id = V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE;
+      c[n++].value = 0;
+      c[n].id = klass->cid_i_qp;
+      c[n++].value = self->qp_i;
+      c[n].id = klass->cid_p_qp;
+      c[n++].value = self->qp_p;
+      break;
+  }
+
+  if (gst_v4l2_encoder_query_control (self->encoder,
+          V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR, &q)) {
+    c[n].id = V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR;
+    c[n++].value = 1;
+  }
+
+  if (self->rate_control == GST_V4L2_ENC_RC_CBR &&
+      !gst_v4l2_encoder_query_menu (self->encoder,
+          V4L2_CID_MPEG_VIDEO_BITRATE_MODE, V4L2_MPEG_VIDEO_BITRATE_MODE_CBR)) {
+    GST_ELEMENT_ERROR (self, CORE, NEGOTIATION,
+        ("The driver has no constant bitrate control."), (NULL));
+    return FALSE;
+  }
+
+  if (!gst_v4l2_encoder_set_controls (self->encoder, NULL, c, n)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, SETTINGS,
+        ("Driver did not accept the rate control settings."), (NULL));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static void
+gst_v4l2_codec_base_enc_latch_properties (GstV4l2CodecBaseEnc * self)
+{
+  GstV4l2CodecBaseEncClass *klass = GST_V4L2_CODEC_BASE_ENC_GET_CLASS (self);
+  gdouble pixels_per_s;
+
+  GST_OBJECT_LOCK (self);
+  self->rate_control = self->prop_rate_control;
+  self->bitrate = self->prop_bitrate * 1000;
+  self->max_bitrate = self->prop_max_bitrate * 1000;
+  self->qp_i = self->prop_qp_i;
+  self->qp_p = self->prop_qp_p;
+  self->qp_min = MIN (self->prop_qp_min, self->prop_qp_max);
+  self->qp_max = MAX (self->prop_qp_min, self->prop_qp_max);
+  self->key_int = self->prop_key_int_max;
+  self->max_inflight = self->prop_max_inflight;
+  GST_OBJECT_UNLOCK (self);
+
+  pixels_per_s = (gdouble) GST_VIDEO_INFO_WIDTH (&self->in_info) *
+      GST_VIDEO_INFO_HEIGHT (&self->in_info) * self->fps_n / self->fps_d;
+  if (!self->bitrate)
+    self->bitrate = MIN (pixels_per_s * klass->default_bpp, G_MAXINT32);
+  if (!self->max_bitrate || self->max_bitrate < self->bitrate)
+    self->max_bitrate = MIN ((guint64) self->bitrate * 3 / 2, G_MAXINT32);
+  /* Default: an IDR picture every 2 seconds */
+  if (!self->key_int)
+    self->key_int = MAX (1, (2 * self->fps_n + self->fps_d / 2) / self->fps_d);
+  self->qp_i = CLAMP (self->qp_i, self->qp_min, self->qp_max);
+  self->qp_p = CLAMP (self->qp_p, self->qp_min, self->qp_max);
+
+  GST_INFO_OBJECT (self, "rate control %d, bitrate %u (max %u), qp i/p %u/%u "
+      "[%u, %u], key-int %u, in flight %u", self->rate_control, self->bitrate,
+      self->max_bitrate, self->qp_i, self->qp_p, self->qp_min, self->qp_max,
+      self->key_int, self->max_inflight);
+}
+
+/* Frame-level VBR: a rate model bits = complexity * 2^(-qp/6) per picture
+ * type, the P QP chosen so that a GOP meets the target, a correction from
+ * the accumulated error over about two seconds, a peak constraint over one
+ * second, and at most one QP step per picture. */
+static void
+vbr_reset (GstV4l2CodecBaseEnc * self)
+{
+  gdouble bpp = (gdouble) self->bitrate * self->fps_d / self->fps_n /
+      (GST_VIDEO_INFO_WIDTH (&self->in_info) *
+      GST_VIDEO_INFO_HEIGHT (&self->in_info));
+
+  /* Rough start: QP 26 at 0.15 bit per pixel for an average picture */
+  self->vbr_qp = CLAMP (26.0 - 6.0 * log2 (bpp / 0.15), self->qp_min,
+      self->qp_max);
+  self->vbr_cplx[0] = self->vbr_cplx[1] = 0;
+  self->vbr_err = 0;
+  g_free (self->vbr_win);
+  self->vbr_win_len = MAX (1, self->fps_n / self->fps_d);
+  self->vbr_win = g_new0 (guint64, self->vbr_win_len);
+  self->vbr_win_pos = 0;
+  self->vbr_win_sum = 0;
+}
+
+static gint
+vbr_pick_qp (GstV4l2CodecBaseEnc * self, gboolean idr)
+{
+  gdouble target = (gdouble) self->bitrate * self->fps_d / self->fps_n;
+  gdouble n = self->key_int, qp = self->vbr_qp, want;
+  gdouble ci = self->vbr_cplx[0], cp = self->vbr_cplx[1];
+  gdouble window = 2.0 * self->fps_n / self->fps_d;
+  gdouble peak = (gdouble) self->max_bitrate;
+
+  if (ci > 0 || cp > 0) {
+    if (cp <= 0)
+      cp = ci / 4;
+    if (ci <= 0)
+      ci = cp * 4;
+    /* I pictures are coded 3 QP lower than P pictures */
+    want = 6.0 * log2 ((ci * pow (2.0, 0.5) + (n - 1) * cp) / (n * target));
+    want += 6.0 * log2 (MAX (0.25, 1.0 + self->vbr_err / (window * target)));
+    if (self->vbr_win_sum > peak)
+      want += 2;
+    want = CLAMP (want, self->qp_min, self->qp_max);
+    /* Smooth: one step per picture */
+    qp += CLAMP (want - qp, -1.0, 1.0);
+    self->vbr_qp = qp;
+  }
+
+  qp = idr ? qp - 3 : qp;
+  return CLAMP ((gint) lround (qp), (gint) self->qp_min, (gint) self->qp_max);
+}
+
+static void
+vbr_record (GstV4l2CodecBaseEnc * self, gboolean idr, gint qp, gsize bytes)
+{
+  gdouble target = (gdouble) self->bitrate * self->fps_d / self->fps_n;
+  gdouble bits = bytes * 8.0;
+  gdouble c = bits * pow (2.0, qp / 6.0);
+  gdouble window = 2.0 * self->fps_n / self->fps_d;
+  gint t = idr ? 0 : 1;
+
+  if (self->vbr_cplx[t] <= 0)
+    self->vbr_cplx[t] = c;
+  else
+    self->vbr_cplx[t] += (c - self->vbr_cplx[t]) * (idr ? 0.5 : 0.2);
+
+  self->vbr_err = self->vbr_err * (1.0 - 1.0 / window) + (bits - target);
+
+  self->vbr_win_sum -= self->vbr_win[self->vbr_win_pos];
+  self->vbr_win[self->vbr_win_pos] = bytes * 8;
+  self->vbr_win_sum += bytes * 8;
+  self->vbr_win_pos = (self->vbr_win_pos + 1) % self->vbr_win_len;
+}
+
+static GstFlowReturn gst_v4l2_codec_base_enc_complete_oldest (GstV4l2CodecBaseEnc * self);
+
+static gboolean
+gst_v4l2_codec_base_enc_set_format (GstVideoEncoder * encoder,
+    GstVideoCodecState * state)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+  GstV4l2CodecBaseEncClass *klass = GST_V4L2_CODEC_BASE_ENC_GET_CLASS (self);
+  GstClockTime latency;
+  GstCaps *caps;
+  guint pool_size;
+
+  GST_DEBUG_OBJECT (self, "Input caps %" GST_PTR_FORMAT, state->caps);
+
+  /* Finish the pictures of the previous format first. */
+  while (self->streaming && self->pending.length)
+    if (gst_v4l2_codec_base_enc_complete_oldest (self) != GST_FLOW_OK)
+      break;
+  gst_v4l2_codec_base_enc_streamoff (self);
+  gst_v4l2_codec_base_enc_reset_allocation (self);
+
+  self->in_info = state->info;
+  self->fps_n = GST_VIDEO_INFO_FPS_N (&state->info);
+  self->fps_d = GST_VIDEO_INFO_FPS_D (&state->info);
+  if (self->fps_n <= 0 || self->fps_d <= 0) {
+    self->fps_n = 30;
+    self->fps_d = 1;
+  }
+
+  if (!gst_v4l2_encoder_set_src_fmt (self->encoder, klass->coded_fourcc,
+          GST_VIDEO_INFO_WIDTH (&state->info),
+          GST_VIDEO_INFO_HEIGHT (&state->info))) {
+    GST_ELEMENT_ERROR (self, CORE, NEGOTIATION, ("Unsupported coded format"),
+        ("The driver rejected %" GST_FOURCC_FORMAT " %dx%d",
+            GST_FOURCC_ARGS (klass->coded_fourcc),
+            GST_VIDEO_INFO_WIDTH (&state->info),
+            GST_VIDEO_INFO_HEIGHT (&state->info)));
+    return FALSE;
+  }
+
+  if (!gst_v4l2_encoder_select_sink_format (self->encoder, &self->in_info,
+          &self->vinfo_drm)) {
+    GST_ELEMENT_ERROR (self, CORE, NEGOTIATION, ("Unsupported input format"),
+        ("The driver rejected %" GST_PTR_FORMAT, state->caps));
+    return FALSE;
+  }
+
+  /* The kernel writes the VUI timing from it. */
+  gst_v4l2_encoder_set_fps (self->encoder, &self->in_info);
+
+  gst_v4l2_codec_base_enc_latch_properties (self);
+  vbr_reset (self);
+
+  caps = klass->negotiate_codec (self, state);
+  if (!caps)
+    return FALSE;
+
+  g_clear_pointer (&self->output_state, gst_video_codec_state_unref);
+  self->output_state = gst_video_encoder_set_output_state (encoder, caps,
+      state);
+  if (!gst_video_encoder_negotiate (encoder)) {
+    GST_ELEMENT_ERROR (self, CORE, NEGOTIATION, (NULL),
+        ("Downstream did not accept %" GST_PTR_FORMAT,
+            self->output_state->caps));
+    return FALSE;
+  }
+
+  if (!gst_v4l2_codec_base_enc_set_rc_controls (self))
+    return FALSE;
+
+  if (!klass->configure (self))
+    return FALSE;
+
+  pool_size = self->max_inflight + 3;
+  self->sink_allocator = gst_v4l2_codec_encoder_allocator_new (self->encoder,
+      GST_PAD_SINK, pool_size);
+  if (!self->sink_allocator) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Not enough memory to allocate picture buffers."), (NULL));
+    return FALSE;
+  }
+  self->sink_pool = gst_v4l2_codec_pool_new (self->sink_allocator,
+      &self->vinfo_drm);
+
+  self->src_allocator = gst_v4l2_codec_encoder_allocator_new (self->encoder,
+      GST_PAD_SRC, self->max_inflight + 1);
+  if (!self->src_allocator) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Not enough memory to allocate bitstream buffers."), (NULL));
+    gst_v4l2_codec_base_enc_reset_allocation (self);
+    return FALSE;
+  }
+  self->src_pool = gst_v4l2_codec_pool_new (self->src_allocator,
+      &self->vinfo_drm);
+
+  if (!gst_v4l2_encoder_streamon (self->encoder, GST_PAD_SINK) ||
+      !gst_v4l2_encoder_streamon (self->encoder, GST_PAD_SRC)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, FAILED,
+        ("Could not start the encoder."), ("VIDIOC_STREAMON failed: %s",
+            g_strerror (errno)));
+    return FALSE;
+  }
+  self->streaming = TRUE;
+  self->force_idr = TRUE;
+
+  latency = gst_util_uint64_scale (self->max_inflight * GST_SECOND,
+      self->fps_d, self->fps_n);
+  gst_video_encoder_set_latency (encoder, latency, latency);
+
+  return TRUE;
+}
+
+static GstFlowReturn
+gst_v4l2_codec_base_enc_complete_oldest (GstV4l2CodecBaseEnc * self)
+{
+  GstV4l2CodecBaseEncClass *klass = GST_V4L2_CODEC_BASE_ENC_GET_CLASS (self);
+  GstVideoEncoder *venc = GST_VIDEO_ENCODER (self);
+  GstV4l2CodecEncFrame *f = g_queue_pop_head (&self->pending);
+  GstVideoCodecFrame *frame;
+  guint32 bytesused, flags;
+  GstMapInfo in, out;
+  GstBuffer *bitstream;
+  GstFlowReturn ret;
+
+  if (!f)
+    return GST_FLOW_OK;
+
+  if (!gst_v4l2_encode_request_wait (f->request, REQUEST_TIMEOUT, &bytesused,
+          &flags) || !bytesused) {
+    GST_ELEMENT_ERROR (self, STREAM, ENCODE, ("Failed to encode a picture."),
+        ("Picture %" G_GUINT64_FORMAT " failed, %u bytes", f->id, bytesused));
+    enc_frame_free (f);
+    return GST_FLOW_ERROR;
+  }
+
+  if (klass->frame_done)
+    klass->frame_done (self, f);
+
+  frame = f->frame;
+  f->frame = NULL;
+
+  ret = gst_video_encoder_allocate_output_frame (venc, frame, bytesused);
+  if (ret != GST_FLOW_OK) {
+    enc_frame_free (f);
+    gst_video_encoder_finish_frame (venc, frame);
+    return ret;
+  }
+
+  bitstream = gst_v4l2_encode_request_get_bitstream (f->request);
+  if (!gst_buffer_map (bitstream, &in, GST_MAP_READ)) {
+    enc_frame_free (f);
+    gst_video_codec_frame_unref (frame);
+    return GST_FLOW_ERROR;
+  }
+  gst_buffer_map (frame->output_buffer, &out, GST_MAP_WRITE);
+  memcpy (out.data, in.data, MIN (bytesused, in.size));
+  gst_buffer_unmap (frame->output_buffer, &out);
+  gst_buffer_unmap (bitstream, &in);
+
+  if (self->rate_control == GST_V4L2_ENC_RC_VBR)
+    vbr_record (self, f->idr, f->qp, bytesused);
+
+  GST_LOG_OBJECT (self, "Picture %" G_GUINT64_FORMAT " %c: %u bytes, qp %d, "
+      "average qp %d", f->id, f->idr ? 'I' : 'P', bytesused, f->qp, f->avg_qp);
+
+  self->total_bytes += bytesused;
+  self->total_frames++;
+
+  if (f->idr) {
+    GST_VIDEO_CODEC_FRAME_SET_SYNC_POINT (frame);
+    GST_BUFFER_FLAG_UNSET (frame->output_buffer, GST_BUFFER_FLAG_DELTA_UNIT);
+  } else {
+    GST_VIDEO_CODEC_FRAME_UNSET_SYNC_POINT (frame);
+    GST_BUFFER_FLAG_SET (frame->output_buffer, GST_BUFFER_FLAG_DELTA_UNIT);
+  }
+  /* No reordering */
+  frame->dts = frame->pts;
+
+  enc_frame_free (f);
+
+  return gst_video_encoder_finish_frame (venc, frame);
+}
+
+static GstFlowReturn
+gst_v4l2_codec_base_enc_copy_input (GstV4l2CodecBaseEnc * self,
+    GstVideoCodecFrame * frame, GstBuffer ** out)
+{
+  GstVideoFrame src, dst;
+  GstBuffer *buffer = NULL;
+  GstFlowReturn flow;
+  gboolean ok = FALSE;
+
+  flow = gst_buffer_pool_acquire_buffer (GST_BUFFER_POOL (self->sink_pool),
+      &buffer, NULL);
+  if (flow != GST_FLOW_OK)
+    return flow;
+
+  if (gst_video_frame_map (&src, &self->in_info, frame->input_buffer,
+          GST_MAP_READ)) {
+    if (gst_video_frame_map (&dst, &self->vinfo_drm.vinfo, buffer,
+            GST_MAP_WRITE)) {
+      ok = gst_video_frame_copy (&dst, &src);
+      gst_video_frame_unmap (&dst);
+    }
+    gst_video_frame_unmap (&src);
+  }
+
+  if (!ok) {
+    gst_buffer_unref (buffer);
+    GST_ELEMENT_ERROR (self, STREAM, ENCODE,
+        ("Failed to copy the picture into the encoder's buffer."), (NULL));
+    return GST_FLOW_ERROR;
+  }
+
+  *out = buffer;
+  return GST_FLOW_OK;
+}
+
+static GstFlowReturn
+gst_v4l2_codec_base_enc_handle_frame (GstVideoEncoder * encoder,
+    GstVideoCodecFrame * frame)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+  GstV4l2CodecBaseEncClass *klass = GST_V4L2_CODEC_BASE_ENC_GET_CLASS (self);
+  GstV4l2CodecEncFrame *f;
+  GstBuffer *pic = NULL, *bitstream = NULL;
+  GstFlowReturn ret = GST_FLOW_OK;
+
+  if (!self->streaming) {
+    gst_video_codec_frame_unref (frame);
+    return GST_FLOW_NOT_NEGOTIATED;
+  }
+
+  f = g_new0 (GstV4l2CodecEncFrame, 1);
+  f->frame = frame;
+  f->qp = -1;
+  f->avg_qp = -1;
+  f->id = self->next_id++;
+  f->prev_id = self->last_id;
+
+  if (self->force_idr || GST_VIDEO_CODEC_FRAME_IS_FORCE_KEYFRAME (frame) ||
+      self->frames_since_idr >= self->key_int) {
+    f->idr = TRUE;
+    self->frames_since_idr = 0;
+    self->force_idr = FALSE;
+    f->idr_count = self->idr_count++;
+  } else {
+    f->idr_count = self->idr_count - 1;
+  }
+  f->poc = self->frames_since_idr++;
+  self->last_id = f->id;
+
+  if (gst_v4l2_encoder_can_import (self->encoder, frame->input_buffer)) {
+    pic = gst_buffer_ref (frame->input_buffer);
+  } else {
+    GST_LOG_OBJECT (self, "Copying the picture, it cannot be imported");
+    self->copied_frames++;
+    ret = gst_v4l2_codec_base_enc_copy_input (self, frame, &pic);
+    if (ret != GST_FLOW_OK) {
+      GST_DEBUG_OBJECT (self, "No picture buffer: %s", gst_flow_get_name (ret));
+      goto drop;
+    }
+  }
+
+  ret = gst_buffer_pool_acquire_buffer (GST_BUFFER_POOL (self->src_pool),
+      &bitstream, NULL);
+  if (ret != GST_FLOW_OK)
+    goto drop;
+
+  f->request = gst_v4l2_encoder_alloc_request (self->encoder, f->id, pic,
+      bitstream);
+  gst_clear_buffer (&pic);
+  gst_clear_buffer (&bitstream);
+  if (!f->request) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+        ("Failed to allocate a media request object."), (NULL));
+    ret = GST_FLOW_ERROR;
+    goto drop;
+  }
+
+  switch (self->rate_control) {
+    case GST_V4L2_ENC_RC_CQP:
+      f->qp = f->idr ? self->qp_i : self->qp_p;
+      break;
+    case GST_V4L2_ENC_RC_VBR:{
+      struct v4l2_ext_control c[2] = { {0} };
+
+      f->qp = vbr_pick_qp (self, f->idr);
+      c[0].id = klass->cid_i_qp;
+      c[0].value = f->qp;
+      c[1].id = klass->cid_p_qp;
+      c[1].value = f->qp;
+      if (!gst_v4l2_encoder_set_controls (self->encoder, f->request, c, 2)) {
+        GST_ELEMENT_ERROR (self, RESOURCE, WRITE,
+            ("Driver did not accept the picture QP."), (NULL));
+        ret = GST_FLOW_ERROR;
+        goto drop;
+      }
+      break;
+    }
+    case GST_V4L2_ENC_RC_CBR:
+      break;
+  }
+
+  if (!klass->prepare_frame (self, f)) {
+    ret = GST_FLOW_ERROR;
+    goto drop;
+  }
+
+  if (!gst_v4l2_encode_request_queue (f->request)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, WRITE,
+        ("Driver did not accept the encode request."), (NULL));
+    ret = GST_FLOW_ERROR;
+    goto drop;
+  }
+
+  g_queue_push_tail (&self->pending, f);
+
+  while (ret == GST_FLOW_OK && self->pending.length >= self->max_inflight)
+    ret = gst_v4l2_codec_base_enc_complete_oldest (self);
+
+  return ret;
+
+drop:
+  gst_clear_buffer (&pic);
+  gst_clear_buffer (&bitstream);
+  f->frame = NULL;
+  enc_frame_free (f);
+  /* An IDR that was not sent must be sent again. */
+  self->force_idr = TRUE;
+  gst_video_encoder_finish_frame (encoder, frame);
+  return ret;
+}
+
+static GstFlowReturn
+gst_v4l2_codec_base_enc_finish (GstVideoEncoder * encoder)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+  GstFlowReturn ret = GST_FLOW_OK;
+
+  while (ret == GST_FLOW_OK && self->pending.length)
+    ret = gst_v4l2_codec_base_enc_complete_oldest (self);
+
+  return ret;
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_flush (GstVideoEncoder * encoder)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+
+  GST_DEBUG_OBJECT (self, "Flushing");
+
+  if (self->streaming) {
+    gst_v4l2_codec_base_enc_streamoff (self);
+    if (gst_v4l2_encoder_streamon (self->encoder, GST_PAD_SINK) &&
+        gst_v4l2_encoder_streamon (self->encoder, GST_PAD_SRC))
+      self->streaming = TRUE;
+  }
+  gst_v4l2_codec_base_enc_set_flushing (self, FALSE);
+  self->force_idr = TRUE;
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_base_enc_sink_event (GstVideoEncoder * encoder,
+    GstEvent * event)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (encoder);
+
+  if (GST_EVENT_TYPE (event) == GST_EVENT_FLUSH_START)
+    gst_v4l2_codec_base_enc_set_flushing (self, TRUE);
+
+  return GST_VIDEO_ENCODER_CLASS (parent_class)->sink_event (encoder, event);
+}
+
+static GstStateChangeReturn
+gst_v4l2_codec_base_enc_change_state (GstElement * element,
+    GstStateChange transition)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (element);
+
+  if (transition == GST_STATE_CHANGE_PAUSED_TO_READY)
+    gst_v4l2_codec_base_enc_set_flushing (self, TRUE);
+
+  return GST_ELEMENT_CLASS (parent_class)->change_state (element, transition);
+}
+
+static void
+gst_v4l2_codec_base_enc_set_property (GObject * object, guint prop_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (object);
+
+  GST_OBJECT_LOCK (self);
+  switch (prop_id) {
+    case PROP_RATE_CONTROL:
+      self->prop_rate_control = g_value_get_enum (value);
+      break;
+    case PROP_BITRATE:
+      self->prop_bitrate = g_value_get_uint (value);
+      break;
+    case PROP_MAX_BITRATE:
+      self->prop_max_bitrate = g_value_get_uint (value);
+      break;
+    case PROP_QP_I:
+      self->prop_qp_i = g_value_get_uint (value);
+      break;
+    case PROP_QP_P:
+      self->prop_qp_p = g_value_get_uint (value);
+      break;
+    case PROP_QP_MIN:
+      self->prop_qp_min = g_value_get_uint (value);
+      break;
+    case PROP_QP_MAX:
+      self->prop_qp_max = g_value_get_uint (value);
+      break;
+    case PROP_KEY_INT_MAX:
+      self->prop_key_int_max = g_value_get_uint (value);
+      break;
+    case PROP_MAX_INFLIGHT:
+      self->prop_max_inflight = g_value_get_uint (value);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+  GST_OBJECT_UNLOCK (self);
+}
+
+static void
+gst_v4l2_codec_base_enc_get_property (GObject * object, guint prop_id,
+    GValue * value, GParamSpec * pspec)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (object);
+
+  GST_OBJECT_LOCK (self);
+  switch (prop_id) {
+    case PROP_RATE_CONTROL:
+      g_value_set_enum (value, self->prop_rate_control);
+      break;
+    case PROP_BITRATE:
+      g_value_set_uint (value, self->prop_bitrate);
+      break;
+    case PROP_MAX_BITRATE:
+      g_value_set_uint (value, self->prop_max_bitrate);
+      break;
+    case PROP_QP_I:
+      g_value_set_uint (value, self->prop_qp_i);
+      break;
+    case PROP_QP_P:
+      g_value_set_uint (value, self->prop_qp_p);
+      break;
+    case PROP_QP_MIN:
+      g_value_set_uint (value, self->prop_qp_min);
+      break;
+    case PROP_QP_MAX:
+      g_value_set_uint (value, self->prop_qp_max);
+      break;
+    case PROP_KEY_INT_MAX:
+      g_value_set_uint (value, self->prop_key_int_max);
+      break;
+    case PROP_MAX_INFLIGHT:
+      g_value_set_uint (value, self->prop_max_inflight);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+  GST_OBJECT_UNLOCK (self);
+}
+
+static void
+gst_v4l2_codec_base_enc_dispose (GObject * object)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (object);
+
+  gst_v4l2_codec_base_enc_drop_pending (self);
+  gst_clear_object (&self->encoder);
+
+  G_OBJECT_CLASS (parent_class)->dispose (object);
+}
+
+static void
+gst_v4l2_codec_base_enc_init (GstV4l2CodecBaseEnc * self)
+{
+  g_queue_init (&self->pending);
+  self->prop_rate_control = DEFAULT_RATE_CONTROL;
+  self->prop_bitrate = DEFAULT_BITRATE;
+  self->prop_max_bitrate = DEFAULT_MAX_BITRATE;
+  self->prop_qp_i = DEFAULT_QP_I;
+  self->prop_qp_p = DEFAULT_QP_P;
+  self->prop_qp_min = DEFAULT_QP_MIN;
+  self->prop_qp_max = DEFAULT_QP_MAX;
+  self->prop_key_int_max = DEFAULT_KEY_INT_MAX;
+  self->prop_max_inflight = DEFAULT_MAX_INFLIGHT;
+}
+
+static void
+gst_v4l2_codec_base_enc_class_init (GstV4l2CodecBaseEncClass * klass)
+{
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+  GstVideoEncoderClass *encoder_class = GST_VIDEO_ENCODER_CLASS (klass);
+  const GParamFlags flags = G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS |
+      GST_PARAM_MUTABLE_READY;
+
+  gobject_class->set_property = gst_v4l2_codec_base_enc_set_property;
+  gobject_class->get_property = gst_v4l2_codec_base_enc_get_property;
+  gobject_class->dispose = gst_v4l2_codec_base_enc_dispose;
+
+  element_class->change_state =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_change_state);
+
+  encoder_class->open = GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_open);
+  encoder_class->close = GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_close);
+  encoder_class->start = GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_start);
+  encoder_class->stop = GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_stop);
+  encoder_class->set_format =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_set_format);
+  encoder_class->handle_frame =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_handle_frame);
+  encoder_class->finish = GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_finish);
+  encoder_class->flush = GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_flush);
+  encoder_class->sink_event =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_sink_event);
+  encoder_class->getcaps = GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_getcaps);
+  encoder_class->propose_allocation =
+      GST_DEBUG_FUNCPTR (gst_v4l2_codec_base_enc_propose_allocation);
+
+  g_object_class_install_property (gobject_class, PROP_RATE_CONTROL,
+      g_param_spec_enum ("rate-control", "Rate control",
+          "Rate control mode", GST_TYPE_V4L2_ENC_RATE_CONTROL,
+          DEFAULT_RATE_CONTROL, flags));
+  g_object_class_install_property (gobject_class, PROP_BITRATE,
+      g_param_spec_uint ("bitrate", "Bitrate",
+          "Target bitrate in kbit/s for cbr and vbr (0: from the resolution "
+          "and frame rate)", 0, G_MAXINT32 / 1000, DEFAULT_BITRATE, flags));
+  g_object_class_install_property (gobject_class, PROP_MAX_BITRATE,
+      g_param_spec_uint ("max-bitrate", "Maximum bitrate",
+          "Peak bitrate in kbit/s over one second for vbr (0: 1.5 x bitrate)",
+          0, G_MAXINT32 / 1000, DEFAULT_MAX_BITRATE, flags));
+  g_object_class_install_property (gobject_class, PROP_QP_I,
+      g_param_spec_uint ("qp-i", "I QP", "QP of IDR pictures for cqp",
+          0, 51, DEFAULT_QP_I, flags));
+  g_object_class_install_property (gobject_class, PROP_QP_P,
+      g_param_spec_uint ("qp-p", "P QP", "QP of P pictures for cqp",
+          0, 51, DEFAULT_QP_P, flags));
+  g_object_class_install_property (gobject_class, PROP_QP_MIN,
+      g_param_spec_uint ("qp-min", "Minimum QP",
+          "Minimum QP for cbr and vbr", 0, 51, DEFAULT_QP_MIN, flags));
+  g_object_class_install_property (gobject_class, PROP_QP_MAX,
+      g_param_spec_uint ("qp-max", "Maximum QP",
+          "Maximum QP for cbr and vbr", 0, 51, DEFAULT_QP_MAX, flags));
+  g_object_class_install_property (gobject_class, PROP_KEY_INT_MAX,
+      g_param_spec_uint ("key-int-max", "Maximum key frame interval",
+          "Pictures from one IDR picture to the next (0: 2 seconds)",
+          0, G_MAXINT32, DEFAULT_KEY_INT_MAX, flags));
+  g_object_class_install_property (gobject_class, PROP_MAX_INFLIGHT,
+      g_param_spec_uint ("max-inflight", "Pictures in flight",
+          "Pictures queued to the driver at a time (more hides the time "
+          "userspace takes per picture, adds latency)", 1, MAX_INFLIGHT,
+          DEFAULT_MAX_INFLIGHT, flags));
+
+  gst_type_mark_as_plugin_api (GST_TYPE_V4L2_CODEC_BASE_ENC, 0);
+  gst_type_mark_as_plugin_api (GST_TYPE_V4L2_ENC_RATE_CONTROL, 0);
+}
+
+/* Per-device element classes: the device paths */
+
+static void
+device_set_property (GObject * object, guint prop_id, const GValue * value,
+    GParamSpec * pspec)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (object);
+
+  gst_v4l2_encoder_set_property (G_OBJECT (self->encoder),
+      prop_id - PROP_DEVICE_0, value, pspec);
+}
+
+static void
+device_get_property (GObject * object, guint prop_id, GValue * value,
+    GParamSpec * pspec)
+{
+  GstV4l2CodecBaseEnc *self = GST_V4L2_CODEC_BASE_ENC (object);
+
+  gst_v4l2_encoder_get_property (G_OBJECT (self->encoder),
+      prop_id - PROP_DEVICE_0, value, pspec);
+}
+
+void
+gst_v4l2_codec_base_enc_install_device_properties (GObjectClass *
+    gobject_class, GstV4l2CodecDevice * device)
+{
+  gobject_class->set_property = device_set_property;
+  gobject_class->get_property = device_get_property;
+  gst_v4l2_encoder_install_properties (gobject_class, PROP_DEVICE_0, device);
+}
+
+void
+gst_v4l2_codec_base_enc_init_device (GstV4l2CodecBaseEnc * self,
+    GstV4l2CodecDevice * device)
+{
+  self->encoder = gst_v4l2_encoder_new (device);
+}
