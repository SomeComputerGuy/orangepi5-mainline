+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Library General Public License for more details.
+ *
+ * You should have received a copy of the GNU Library General Public
+ * License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ */
+
+/**
+ * SECTION:element-v4l2slh264enc
+ * @title: v4l2slh264enc
+ *
+ * H.264 encoder for V4L2 stateless (request API) encoders that implement the
+ * H.264 stateless encode uAPI (V4L2_CID_STATELESS_H264_ENCODE_PARAMS). The
+ * kernel writes the parameter sets and slice headers; the element sets the
+ * SPS and PPS and describes every picture. Outputs I and P pictures with one
+ * reference, as an Annex B byte-stream with SPS and PPS before every IDR.
+ *
+ * ## Example launch line
+ * |[
+ * gst-launch-1.0 videotestsrc num-buffers=300 ! video/x-raw,width=1920,height=1080 ! \
+ *     v4l2slh264enc bitrate=8000 ! h264parse ! mp4mux ! filesink location=out.mp4
+ * ]|
+ *
+ * The profile, level and entropy coding derive from the original work on
+ * the v4l2codecs stateless H.264 encoder (gstreamer MR !5676 and Paul
+ * Kocialkowski's v4l2codecs/h264enc branch).
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include "gstv4l2codech264enc.h"
+#include "linux/v4l2-controls.h"
+
+#include <string.h>
+
+#define V4L2_MIN_KERNEL_VER_MAJOR 5
+#define V4L2_MIN_KERNEL_VER_MINOR 17
+#define V4L2_MIN_KERNEL_VERSION KERNEL_VERSION(V4L2_MIN_KERNEL_VER_MAJOR, V4L2_MIN_KERNEL_VER_MINOR, 0)
+#define KERNEL_VERSION(a,b,c) (((a) << 16) + ((b) << 8) + (c))
+
+GST_DEBUG_CATEGORY_STATIC (v4l2_h264enc_debug);
+#define GST_CAT_DEFAULT v4l2_h264enc_debug
+
+#define DEFAULT_CABAC TRUE
+
+enum
+{
+  PROP_0,
+  PROP_CABAC,
+};
+
+#define GST_TYPE_V4L2_CODEC_H264_ENC (gst_v4l2_codec_h264_enc_get_type ())
+G_DECLARE_DERIVABLE_TYPE (GstV4l2CodecH264Enc, gst_v4l2_codec_h264_enc,
+    GST, V4L2_CODEC_H264_ENC, GstV4l2CodecBaseEnc);
+
+struct _GstV4l2CodecH264EncClass
+{
+  GstV4l2CodecBaseEncClass parent_class;
+};
+
+typedef struct
+{
+  gboolean prop_cabac;
+
+  /* negotiated */
+  guint8 profile_idc;
+  guint8 constraint_set_flags;
+  guint8 level_idc;
+  gboolean cabac;
+  gboolean transform_8x8;
+  const gchar *profile_name;
+  const gchar *level_name;
+  gboolean has_average_qp;
+} GstV4l2CodecH264EncPrivate;
+
+G_DEFINE_ABSTRACT_TYPE_WITH_PRIVATE (GstV4l2CodecH264Enc,
+    gst_v4l2_codec_h264_enc, GST_TYPE_V4L2_CODEC_BASE_ENC);
+
+#define parent_class gst_v4l2_codec_h264_enc_parent_class
+#define PRIV(self) ((GstV4l2CodecH264EncPrivate *) \
+    gst_v4l2_codec_h264_enc_get_instance_private (GST_V4L2_CODEC_H264_ENC (self)))
+
+static GstStaticPadTemplate sink_template =
+GST_STATIC_PAD_TEMPLATE (GST_VIDEO_ENCODER_SINK_NAME,
+    GST_PAD_SINK, GST_PAD_ALWAYS,
+    GST_STATIC_CAPS (GST_VIDEO_CAPS_MAKE ("{ NV12, NV21, I420, YUY2, UYVY }")));
+
+static GstStaticPadTemplate src_template =
+GST_STATIC_PAD_TEMPLATE (GST_VIDEO_ENCODER_SRC_NAME,
+    GST_PAD_SRC, GST_PAD_ALWAYS,
+    GST_STATIC_CAPS ("video/x-h264, "
+        "framerate = (fraction) [0/1, MAX], "
+        "width = (int) [ 1, MAX ], height = (int) [ 1, MAX ], "
+        "stream-format = (string) byte-stream, alignment = (string) au, "
+        "profile = (string) { high, main, constrained-baseline }"));
+
+/* From the VA plugin: ITU-T H.264 Table A-1 */
+typedef struct
+{
+  const char *level;
+  guint8 idc;
+  guint max_mbs_per_second;
+  guint max_frame_size_in_mbs;
+  guint max_dpb_mbs;
+  guint max_bitrate;            /* kbit/s, Baseline/Main; x1.25 for High */
+} H264LevelLimits;
+
+static const H264LevelLimits h264_levels[] = {
+  {"1", 10, 1485, 99, 396, 64},
+  {"1.1", 11, 3000, 396, 900, 192},
+  {"1.2", 12, 6000, 396, 2376, 384},
+  {"1.3", 13, 11880, 396, 2376, 768},
+  {"2", 20, 11880, 396, 2376, 2000},
+  {"2.1", 21, 19800, 792, 4752, 4000},
+  {"2.2", 22, 20250, 1620, 8100, 4000},
+  {"3", 30, 40500, 1620, 8100, 10000},
+  {"3.1", 31, 108000, 3600, 18000, 14000},
+  {"3.2", 32, 216000, 5120, 20480, 20000},
+  {"4", 40, 245760, 8192, 32768, 20000},
+  {"4.1", 41, 245760, 8192, 32768, 50000},
+  {"4.2", 42, 522240, 8704, 34816, 50000},
+  {"5", 50, 589824, 22080, 110400, 135000},
+  {"5.1", 51, 983040, 36864, 184320, 240000},
+  {"5.2", 52, 2073600, 36864, 184320, 240000},
+  {"6", 60, 4177920, 139264, 696320, 240000},
+  {"6.1", 61, 8355840, 139264, 696320, 480000},
+  {"6.2", 62, 16711680, 139264, 696320, 800000},
+};
+
+static gboolean
+gst_v4l2_codec_h264_enc_api_check (GstV4l2Encoder * encoder)
+{
+  /* *INDENT-OFF* */
+  static const struct
+  {
+    const gchar *name;
+    guint32 id;
+    guint32 size;
+  } controls[] = {
+    { "ENCODE_PARAMS", V4L2_CID_STATELESS_H264_ENCODE_PARAMS,
+      sizeof (struct v4l2_ctrl_h264_encode_params) },
+    { "SPS", V4L2_CID_STATELESS_H264_SPS, sizeof (struct v4l2_ctrl_h264_sps) },
+    { "PPS", V4L2_CID_STATELESS_H264_PPS, sizeof (struct v4l2_ctrl_h264_pps) },
+  };
+  /* *INDENT-ON* */
+  struct v4l2_query_ext_ctrl q;
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (controls); i++) {
+    if (!gst_v4l2_encoder_query_control (encoder, controls[i].id, &q)) {
+      GST_WARNING ("Driver is missing the %s control", controls[i].name);
+      return FALSE;
+    }
+    if (q.elem_size != controls[i].size) {
+      GST_WARNING ("%s control size mismatch: got %u bytes, %u expected",
+          controls[i].name, q.elem_size, controls[i].size);
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+static GstCaps *
+gst_v4l2_codec_h264_enc_negotiate_codec (GstV4l2CodecBaseEnc * base,
+    GstVideoCodecState * state)
+{
+  GstV4l2CodecH264EncPrivate *priv = PRIV (base);
+  GstCaps *allowed;
+  const gchar *profile = NULL, *level = NULL;
+  guint width_mbs, height_mbs, frame_mbs, mbs_per_s, kbps, i, min_level;
+  gdouble factor;
+
+  allowed = gst_pad_get_allowed_caps (GST_VIDEO_ENCODER_SRC_PAD (base));
+  if (allowed && !gst_caps_is_empty (allowed)) {
+    GstStructure *s;
+
+    allowed = gst_caps_fixate (allowed);
+    s = gst_caps_get_structure (allowed, 0);
+    profile = gst_structure_get_string (s, "profile");
+    level = gst_structure_get_string (s, "level");
+  }
+
+  priv->transform_8x8 = FALSE;
+  priv->constraint_set_flags = 0;
+  GST_OBJECT_LOCK (base);
+  priv->cabac = priv->prop_cabac;
+  GST_OBJECT_UNLOCK (base);
+
+  if (!profile || g_str_equal (profile, "high")) {
+    priv->profile_name = "high";
+    priv->profile_idc = 100;
+    priv->transform_8x8 = TRUE;
+  } else if (g_str_equal (profile, "main")) {
+    priv->profile_name = "main";
+    priv->profile_idc = 77;
+  } else if (g_str_equal (profile, "constrained-baseline")) {
+    priv->profile_name = "constrained-baseline";
+    priv->profile_idc = 66;
+    priv->constraint_set_flags = V4L2_H264_SPS_CONSTRAINT_SET0_FLAG |
+        V4L2_H264_SPS_CONSTRAINT_SET1_FLAG;
+    priv->cabac = FALSE;
+  } else {
+    GST_ELEMENT_ERROR (base, CORE, NEGOTIATION,
+        ("Unsupported H.264 profile '%s'.", profile), (NULL));
+    gst_clear_caps (&allowed);
+    return NULL;
+  }
+
+  /* Lowest level that fits the stream */
+  width_mbs = (GST_VIDEO_INFO_WIDTH (&state->info) + 15) / 16;
+  height_mbs = (GST_VIDEO_INFO_HEIGHT (&state->info) + 15) / 16;
+  frame_mbs = width_mbs * height_mbs;
+  mbs_per_s = gst_util_uint64_scale_ceil (frame_mbs, base->fps_n, base->fps_d);
+  factor = priv->profile_idc == 100 ? 1.25 : 1.0;
+  kbps = (base->rate_control == GST_V4L2_ENC_RC_VBR ? base->max_bitrate :
+      base->bitrate) / 1000;
+  if (base->rate_control == GST_V4L2_ENC_RC_CQP)
+    kbps = 0;
+
+  for (min_level = 0; min_level < G_N_ELEMENTS (h264_levels); min_level++) {
+    const H264LevelLimits *l = &h264_levels[min_level];
+
+    /* One reference picture plus the current one in the DPB */
+    if (mbs_per_s <= l->max_mbs_per_second &&
+        frame_mbs <= l->max_frame_size_in_mbs &&
+        frame_mbs <= l->max_dpb_mbs && kbps <= l->max_bitrate * factor &&
+        width_mbs * width_mbs <= 8 * l->max_frame_size_in_mbs &&
+        height_mbs * height_mbs <= 8 * l->max_frame_size_in_mbs)
+      break;
+  }
+  if (min_level == G_N_ELEMENTS (h264_levels))
+    min_level--;
+
+  i = min_level;
+  if (level) {
+    for (i = 0; i < G_N_ELEMENTS (h264_levels); i++)
+      if (g_str_equal (h264_levels[i].level, level))
+        break;
+    if (i == G_N_ELEMENTS (h264_levels) || i < min_level) {
+      GST_ELEMENT_ERROR (base, CORE, NEGOTIATION,
+          ("H.264 level '%s' cannot be used, at least %s is needed.", level,
+              h264_levels[min_level].level), (NULL));
+      gst_clear_caps (&allowed);
+      return NULL;
+    }
+  }
+  priv->level_idc = h264_levels[i].idc;
+  priv->level_name = h264_levels[i].level;
+  gst_clear_caps (&allowed);
+
+  GST_INFO_OBJECT (base, "H.264 profile %s level %s, %s", priv->profile_name,
+      priv->level_name, priv->cabac ? "CABAC" : "CAVLC");
+
+  return gst_caps_new_simple ("video/x-h264",
+      "stream-format", G_TYPE_STRING, "byte-stream",
+      "alignment", G_TYPE_STRING, "au",
+      "profile", G_TYPE_STRING, priv->profile_name,
+      "level", G_TYPE_STRING, priv->level_name, NULL);
+}
+
+static gint
+sar_idc (gint par_n, gint par_d)
+{
+  static const gint sar[][2] = {
+    {0, 0}, {1, 1}, {12, 11}, {10, 11}, {16, 11}, {40, 33}, {24, 11},
+    {20, 11}, {32, 11}, {80, 33}, {18, 11}, {15, 11}, {64, 33}, {160, 99},
+    {4, 3}, {3, 2}, {2, 1},
+  };
+  guint i;
+
+  for (i = 1; i < G_N_ELEMENTS (sar); i++)
+    if (sar[i][0] == par_n && sar[i][1] == par_d)
+      return i;
+  return V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_EXTENDED;
+}
+
+static gboolean
+gst_v4l2_codec_h264_enc_configure (GstV4l2CodecBaseEnc * base)
+{
+  GstV4l2CodecH264EncPrivate *priv = PRIV (base);
+  struct v4l2_ctrl_h264_sps sps = { 0 };
+  struct v4l2_ctrl_h264_pps pps = { 0 };
+  struct v4l2_ext_control c[2] = { {0} };
+  struct v4l2_query_ext_ctrl q;
+  gint par_n = GST_VIDEO_INFO_PAR_N (&base->in_info);
+  gint par_d = GST_VIDEO_INFO_PAR_D (&base->in_info);
+
+  sps.profile_idc = priv->profile_idc;
+  sps.constraint_set_flags = priv->constraint_set_flags;
+  sps.level_idc = priv->level_idc;
+  sps.chroma_format_idc = 1;
+  /* frame_num and the POC LSB wrap after 65536 pictures */
+  sps.log2_max_frame_num_minus4 = 12;
+  sps.pic_order_cnt_type = 0;
+  sps.log2_max_pic_order_cnt_lsb_minus4 = 12;
+  sps.max_num_ref_frames = 1;
+  sps.pic_width_in_mbs_minus1 =
+      (GST_VIDEO_INFO_WIDTH (&base->in_info) + 15) / 16 - 1;
+  sps.pic_height_in_map_units_minus1 =
+      (GST_VIDEO_INFO_HEIGHT (&base->in_info) + 15) / 16 - 1;
+  sps.flags = V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY |
+      V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE;
+
+  pps.pic_init_qp_minus26 = 0;
+  pps.flags = V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT;
+  if (priv->cabac)
+    pps.flags |= V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE;
+  if (priv->transform_8x8)
+    pps.flags |= V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE;
+
+  c[0].id = V4L2_CID_STATELESS_H264_SPS;
+  c[0].ptr = &sps;
+  c[0].size = sizeof (sps);
+  c[1].id = V4L2_CID_STATELESS_H264_PPS;
+  c[1].ptr = &pps;
+  c[1].size = sizeof (pps);
+
+  if (!gst_v4l2_encoder_set_controls (base->encoder, NULL, c, 2)) {
+    GST_ELEMENT_ERROR (base, RESOURCE, SETTINGS,
+        ("Driver did not accept the SPS and PPS."), (NULL));
+    return FALSE;
+  }
+
+  priv->has_average_qp = gst_v4l2_encoder_query_control (base->encoder,
+      V4L2_CID_MPEG_VIDEO_AVERAGE_QP, &q);
+
+  /* Sample aspect ratio, when it is not square */
+  if (par_n > 0 && par_d > 0 && par_n != par_d &&
+      gst_v4l2_encoder_query_control (base->encoder,
+          V4L2_CID_MPEG_VIDEO_H264_VUI_SAR_ENABLE, &q)) {
+    struct v4l2_ext_control sar[4] = { {0} };
+    gint idc = sar_idc (par_n, par_d);
+
+    sar[0].id = V4L2_CID_MPEG_VIDEO_H264_VUI_SAR_ENABLE;
+    sar[0].value = 1;
+    sar[1].id = V4L2_CID_MPEG_VIDEO_H264_VUI_SAR_IDC;
+    sar[1].value = idc;
+    sar[2].id = V4L2_CID_MPEG_VIDEO_H264_VUI_EXT_SAR_WIDTH;
+    sar[2].value = par_n;
+    sar[3].id = V4L2_CID_MPEG_VIDEO_H264_VUI_EXT_SAR_HEIGHT;
+    sar[3].value = par_d;
+    gst_v4l2_encoder_set_controls (base->encoder, NULL, sar,
+        idc == V4L2_MPEG_VIDEO_H264_VUI_SAR_IDC_EXTENDED ? 4 : 2);
+  }
+
+  return TRUE;
+}
+
+static gboolean
+gst_v4l2_codec_h264_enc_prepare_frame (GstV4l2CodecBaseEnc * base,
+    GstV4l2CodecEncFrame * f)
+{
+  GstV4l2CodecH264EncPrivate *priv = PRIV (base);
+  struct v4l2_ctrl_h264_encode_params ep = { 0 };
+  struct v4l2_ext_control c = {
+    .id = V4L2_CID_STATELESS_H264_ENCODE_PARAMS,
+    .ptr = &ep,
+    .size = sizeof (ep),
+  };
+
+  /* Every picture is a reference for the next one (sliding window, one
+   * reference picture). */
+  ep.nal_ref_idc = f->idr ? 3 : 2;
+  ep.slice_type = f->idr ? V4L2_H264_SLICE_TYPE_I : V4L2_H264_SLICE_TYPE_P;
+  ep.pic_parameter_set_id = 0;
+  ep.frame_num = f->poc & 0xffff;
+  /* Consecutive IDR pictures need different idr_pic_id */
+  ep.idr_pic_id = f->idr_count & 1;
+  ep.pic_order_cnt_lsb = (f->poc * 2) & 0xffff;
+  ep.cabac_init_idc = 0;
+  ep.disable_deblocking_filter_idc = 0;
+  if (f->idr)
+    ep.flags |= V4L2_H264_ENCODE_FLAG_IDR_PIC;
+
+  (void) priv;
+
+  if (!gst_v4l2_encoder_set_controls (base->encoder, f->request, &c, 1)) {
+    GST_ELEMENT_ERROR (base, RESOURCE, WRITE,
+        ("Driver did not accept the encode parameters."), (NULL));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static void
+gst_v4l2_codec_h264_enc_frame_done (GstV4l2CodecBaseEnc * base,
+    GstV4l2CodecEncFrame * f)
+{
+  struct v4l2_ext_control c = {.id = V4L2_CID_MPEG_VIDEO_AVERAGE_QP, };
+
+  if (PRIV (base)->has_average_qp &&
+      gst_v4l2_encoder_get_controls (base->encoder, f->request, &c, 1))
+    f->avg_qp = c.value;
+}
+
+static void
+gst_v4l2_codec_h264_enc_set_property (GObject * object, guint prop_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstV4l2CodecH264EncPrivate *priv = PRIV (object);
+
+  GST_OBJECT_LOCK (object);
+  switch (prop_id) {
+    case PROP_CABAC:
+      priv->prop_cabac = g_value_get_boolean (value);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+  GST_OBJECT_UNLOCK (object);
+}
+
+static void
+gst_v4l2_codec_h264_enc_get_property (GObject * object, guint prop_id,
+    GValue * value, GParamSpec * pspec)
+{
+  GstV4l2CodecH264EncPrivate *priv = PRIV (object);
+
+  GST_OBJECT_LOCK (object);
+  switch (prop_id) {
+    case PROP_CABAC:
+      g_value_set_boolean (value, priv->prop_cabac);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+  GST_OBJECT_UNLOCK (object);
+}
+
+static void
+gst_v4l2_codec_h264_enc_init (GstV4l2CodecH264Enc * self)
+{
+  PRIV (self)->prop_cabac = DEFAULT_CABAC;
+}
+
+static void
+gst_v4l2_codec_h264_enc_class_init (GstV4l2CodecH264EncClass * klass)
+{
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  GstV4l2CodecBaseEncClass *base_class = GST_V4L2_CODEC_BASE_ENC_CLASS (klass);
+
+  gobject_class->set_property = gst_v4l2_codec_h264_enc_set_property;
+  gobject_class->get_property = gst_v4l2_codec_h264_enc_get_property;
+
+  base_class->coded_fourcc = V4L2_PIX_FMT_H264_SLICE;
+  base_class->default_bpp = 0.07;
+  base_class->cid_i_qp = V4L2_CID_MPEG_VIDEO_H264_I_FRAME_QP;
+  base_class->cid_p_qp = V4L2_CID_MPEG_VIDEO_H264_P_FRAME_QP;
+  base_class->cid_min_qp = V4L2_CID_MPEG_VIDEO_H264_MIN_QP;
+  base_class->cid_max_qp = V4L2_CID_MPEG_VIDEO_H264_MAX_QP;
+  base_class->negotiate_codec = gst_v4l2_codec_h264_enc_negotiate_codec;
+  base_class->configure = gst_v4l2_codec_h264_enc_configure;
+  base_class->prepare_frame = gst_v4l2_codec_h264_enc_prepare_frame;
+  base_class->frame_done = gst_v4l2_codec_h264_enc_frame_done;
+
+  g_object_class_install_property (gobject_class, PROP_CABAC,
+      g_param_spec_boolean ("cabac", "CABAC",
+          "CABAC entropy coding (main and high profiles)", DEFAULT_CABAC,
+          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS |
+          GST_PARAM_MUTABLE_READY));
+
+  gst_type_mark_as_plugin_api (GST_TYPE_V4L2_CODEC_H264_ENC, 0);
+}
+
+static void
+gst_v4l2_codec_h264_enc_subinit (GstV4l2CodecH264Enc * self,
+    GstV4l2CodecBaseEncClass * klass)
+{
+  gst_v4l2_codec_base_enc_init_device (GST_V4L2_CODEC_BASE_ENC (self),
+      klass->device);
+}
+
+static void
+gst_v4l2_codec_h264_enc_subclass_init (GstV4l2CodecBaseEncClass * klass,
+    GstV4l2CodecDevice * device)
+{
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+
+  gst_element_class_set_metadata (element_class,
+      "V4L2 Stateless H.264 Video Encoder",
+      "Codec/Encoder/Video/Hardware",
+      "A V4L2 based H.264 video encoder",
+      "Arun Iyengar <aiyengar1990@gmail.com>");
+
+  gst_element_class_add_static_pad_template (element_class, &sink_template);
+  gst_element_class_add_static_pad_template (element_class, &src_template);
+
+  klass->device = device;
+  gst_v4l2_codec_base_enc_install_device_properties (gobject_class, device);
+}
+
+void
+gst_v4l2_codec_h264_enc_register (GstPlugin * plugin, GstV4l2Encoder * encoder,
+    GstV4l2CodecDevice * device, guint rank)
+{
+  guint version;
+
+  GST_DEBUG_CATEGORY_INIT (v4l2_h264enc_debug, "v4l2codecs-h264enc", 0,
+      "V4L2 stateless H.264 encoder");
+
+  version = gst_v4l2_encoder_get_version (encoder);
+  if (version < V4L2_MIN_KERNEL_VERSION)
+    GST_WARNING ("V4L2 API v%u.%u too old, at least v%u.%u required",
+        (version >> 16) & 0xff, (version >> 8) & 0xff,
+        V4L2_MIN_KERNEL_VER_MAJOR, V4L2_MIN_KERNEL_VER_MINOR);
+
+  if (!gst_v4l2_codec_h264_enc_api_check (encoder)) {
+    GST_WARNING ("Not registering the H.264 encoder, it failed the API check");
+    return;
+  }
+
+  gst_v4l2_encoder_register (plugin, GST_TYPE_V4L2_CODEC_H264_ENC,
+      (GClassInitFunc) gst_v4l2_codec_h264_enc_subclass_init,
+      gst_mini_object_ref (GST_MINI_OBJECT (device)),
+      (GInstanceInitFunc) gst_v4l2_codec_h264_enc_subinit,
+      "v4l2sl%sh264enc", device, rank, NULL);
+}
