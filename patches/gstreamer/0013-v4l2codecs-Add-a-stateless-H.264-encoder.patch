+G_BEGIN_DECLS
+
+#define GST_TYPE_V4L2_CODEC_BASE_ENC           (gst_v4l2_codec_base_enc_get_type())
+#define GST_V4L2_CODEC_BASE_ENC(obj)           (G_TYPE_CHECK_INSTANCE_CAST((obj),GST_TYPE_V4L2_CODEC_BASE_ENC,GstV4l2CodecBaseEnc))
+#define GST_V4L2_CODEC_BASE_ENC_CLASS(klass)   (G_TYPE_CHECK_CLASS_CAST((klass),GST_TYPE_V4L2_CODEC_BASE_ENC,GstV4l2CodecBaseEncClass))
+#define GST_V4L2_CODEC_BASE_ENC_GET_CLASS(obj) (G_TYPE_INSTANCE_GET_CLASS((obj),GST_TYPE_V4L2_CODEC_BASE_ENC,GstV4l2CodecBaseEncClass))
+
+typedef struct _GstV4l2CodecBaseEnc GstV4l2CodecBaseEnc;
+typedef struct _GstV4l2CodecBaseEncClass GstV4l2CodecBaseEncClass;
+typedef struct _GstV4l2CodecEncFrame GstV4l2CodecEncFrame;
+
+typedef enum
+{
+  GST_V4L2_ENC_RC_CQP,
+  GST_V4L2_ENC_RC_CBR,
+  GST_V4L2_ENC_RC_VBR,
+} GstV4l2EncRateControl;
+
+/* One picture on its way through the encoder. */
+struct _GstV4l2CodecEncFrame
+{
+  GstVideoCodecFrame *frame;
+  GstV4l2EncodeRequest *request;
+  guint64 id;                   /* V4L2 timestamp: GST_V4L2_ENCODER_FRAME_TS (id) */
+  guint64 prev_id;              /* previous picture, the reference of a P picture */
+  gboolean idr;
+  guint idr_count;              /* number of IDR pictures before this one */
+  guint poc;                    /* pictures since the last IDR */
+  gint qp;                      /* frame QP chosen by the element, or -1 */
+  gint avg_qp;                  /* reported by the driver, or -1 */
+};
+
+struct _GstV4l2CodecBaseEnc
+{
+  GstVideoEncoder parent;
+
+  /* < protected > */
+  GstV4l2Encoder *encoder;
+  GstVideoInfo in_info;         /* negotiated input */
+  GstVideoInfoDmaDrm vinfo_drm; /* driver picture layout */
+  gint fps_n, fps_d;            /* never 0 */
+
+  /* properties, latched at set_format */
+  GstV4l2EncRateControl rate_control;
+  guint bitrate;                /* bit/s, resolved (never 0) */
+  guint max_bitrate;            /* bit/s, resolved */
+  guint qp_i, qp_p, qp_min, qp_max;
+  guint key_int;                /* resolved */
+
+  /* < private > */
+  guint prop_bitrate, prop_max_bitrate, prop_key_int_max;
+  guint prop_max_inflight;
+  GstV4l2EncRateControl prop_rate_control;
+  guint prop_qp_i, prop_qp_p, prop_qp_min, prop_qp_max;
+
+  GstV4l2CodecAllocator *sink_allocator, *src_allocator;
+  GstV4l2CodecPool *sink_pool, *src_pool;
+  GstVideoCodecState *output_state;
+  GQueue pending;               /* GstV4l2CodecEncFrame, oldest first */
+  guint max_inflight;
+  gboolean streaming;
+
+  guint64 next_id, last_id;
+  guint frames_since_idr, idr_count;
+  gboolean force_idr;
+
+  /* userspace VBR state */
+  gdouble vbr_cplx[2];          /* bits * 2^(qp/6), [0] intra, [1] inter */
+  gdouble vbr_err;              /* leaky sum of actual - target bits */
+  gdouble vbr_qp;
+  guint64 *vbr_win;             /* bits of the last fps frames */
+  guint vbr_win_len, vbr_win_pos;
+  guint64 vbr_win_sum;
+
+  /* statistics */
+  guint64 total_bytes;
+  guint64 total_frames;
+  guint64 copied_frames;        /* input pictures that could not be imported */
+};
+
+struct _GstV4l2CodecBaseEncClass
+{
+  GstVideoEncoderClass parent_class;
+
+  GstV4l2CodecDevice *device;
+  guint32 coded_fourcc;
+  gdouble default_bpp;          /* bits per pixel of the default bitrate */
+  guint32 cid_i_qp, cid_p_qp, cid_min_qp, cid_max_qp;
+
+  /* Chooses profile and level and returns the src caps (transfer full) */
+  GstCaps *   (*negotiate_codec) (GstV4l2CodecBaseEnc * self,
+                                  GstVideoCodecState * state);
+
+  /* Sets the sequence-level controls, after S_FMT and before STREAMON */
+  gboolean    (*configure)       (GstV4l2CodecBaseEnc * self);
+
+  /* Sets the per-picture controls in the request */
+  gboolean    (*prepare_frame)   (GstV4l2CodecBaseEnc * self,
+                                  GstV4l2CodecEncFrame * frame);
+
+  /* Optional, reads the feedback of a completed picture */
+  void        (*frame_done)      (GstV4l2CodecBaseEnc * self,
+                                  GstV4l2CodecEncFrame * frame);
+};
+
+GType gst_v4l2_codec_base_enc_get_type (void);
