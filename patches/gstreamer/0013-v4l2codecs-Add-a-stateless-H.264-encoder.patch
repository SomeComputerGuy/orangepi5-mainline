 sys/v4l2codecs/gstv4l2codecbaseenc.h |  151 ++++
 sys/v4l2codecs/gstv4l2codech264enc.c |  538 +++++++++++++
 sys/v4l2codecs/gstv4l2codech264enc.h |   34 +
 sys/v4l2codecs/meson.build           |    6 +-
 sys/v4l2codecs/plugin.c              |   35 +
