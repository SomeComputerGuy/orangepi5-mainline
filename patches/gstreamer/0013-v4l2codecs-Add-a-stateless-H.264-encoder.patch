+#ifndef __GST_V4L2_CODEC_BASE_ENC_H__
+#define __GST_V4L2_CODEC_BASE_ENC_H__
+
+#define GST_USE_UNSTABLE_API
+#include <gst/video/video.h>
+
+#include "gstv4l2codecallocator.h"
+#include "gstv4l2codecdevice.h"
