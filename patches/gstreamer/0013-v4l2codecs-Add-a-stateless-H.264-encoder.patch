+/* Installs the media-device and video-device properties of a per-device
+ * element class and their handlers. */
+void  gst_v4l2_codec_base_enc_install_device_properties (GObjectClass * gobject_class,
+                                                         GstV4l2CodecDevice * device);
+
+/* Creates the GstV4l2Encoder of a per-device element instance. */
+void  gst_v4l2_codec_base_enc_init_device (GstV4l2CodecBaseEnc * self,
+                                           GstV4l2CodecDevice * device);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (GstV4l2CodecBaseEnc, gst_object_unref)
+
+G_END_DECLS
