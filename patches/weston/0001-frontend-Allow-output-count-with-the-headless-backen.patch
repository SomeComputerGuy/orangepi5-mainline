From a46fda10e8e85ea94a99b2c3492ebfde672f800a Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 03:48:27 +0000
Subject: [PATCH 1/3] frontend: Allow --output-count with the headless backend

The wayland and x11 backends accept --output-count to create several
outputs, but the headless backend always creates exactly one head. This
makes it impossible to exercise multi-output shell behaviour in the
test suite, which runs on the headless backend.

Accept --output-count for the headless backend as well. The first head
keeps its "headless" name so existing users and tests are unaffected;
additional heads are named "headless-1", "headless-2", and so on.

Assisted-by: Claude:claude-opus-5-5
---
 frontend/main.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/frontend/main.c b/frontend/main.c
index 6f552a3..698a0cb 100644
--- a/frontend/main.c
+++ b/frontend/main.c
@@ -771,6 +771,7 @@ usage(int error_code)
 		"  --use-gl\t\tUse the GL renderer (deprecated alias for --renderer=gl)\n"
 		"  --use-vulkan\t\tUse the Vulkan renderer (deprecated alias for --renderer=vulkan)\n"
 		"  --no-outputs\t\tDo not create any virtual outputs\n"
+		"  --output-count=COUNT\tCreate multiple outputs\n"
 		"  --refresh-rate=RATE\tThe output refresh rate (in mHz)\n"
 		"  --fake-seat\t\tUse a fake seat for compatibility\n"
 		"\n");
@@ -4222,6 +4223,8 @@ load_headless_backend(struct weston_compositor *c,
 	bool no_outputs = false;
 	bool output_straight_alpha;
 	char *transform = NULL;
+	int output_count = 1;
+	int i;
 
 	struct wet_output_config *parsed_options = wet_init_parsed_options(c);
 	if (!parsed_options)
@@ -4248,6 +4251,7 @@ load_headless_backend(struct weston_compositor *c,
 		{ WESTON_OPTION_BOOLEAN, "use-vulkan", 0, &force_vulkan },
 		{ WESTON_OPTION_STRING, "transform", 0, &transform },
 		{ WESTON_OPTION_BOOLEAN, "no-outputs", 0, &no_outputs },
+		{ WESTON_OPTION_INTEGER, "output-count", 0, &output_count },
 		{ WESTON_OPTION_INTEGER, "refresh-rate", 0, &config.refresh },
 		{ WESTON_OPTION_BOOLEAN, "fake-seat", 0, &config.fake_seat },
 	};
@@ -4303,6 +4307,19 @@ load_headless_backend(struct weston_compositor *c,
 
 		if (api->create_head(wb->backend, "headless") < 0)
 			return -1;
+
+		for (i = 1; i < output_count; i++) {
+			char *name;
+			int ret;
+
+			if (asprintf(&name, "headless-%d", i) < 0)
+				return -1;
+
+			ret = api->create_head(wb->backend, name);
+			free(name);
+			if (ret < 0)
+				return -1;
+		}
 	}
 
 	return 0;
-- 
