+#include "config.h"
+
+#include <string.h>
+
+#include "weston-test-client-helper.h"
+#include "weston-test-fixture-compositor.h"
+#include "weston-test-assert.h"
+#include "xdg-client-helper.h"
+
+static enum test_result_code
+fixture_setup(struct weston_test_harness *harness)
+{
+	struct compositor_setup setup;
+
+	compositor_setup_defaults(&setup);
+	setup.renderer = WESTON_RENDERER_PIXMAN;
+	setup.width = 320;
+	setup.height = 240;
+	setup.shell = SHELL_KIOSK;
+	setup.output_count = 2;
+	setup.logging_scopes = "log,test-harness-plugin";
+	setup.refresh = HIGHEST_OUTPUT_REFRESH;
+
+	return weston_test_harness_execute_as_client(harness, &setup);
+}
+DECLARE_FIXTURE_SETUP(fixture_setup);
+
+static struct output *
+find_output(struct client *client, const char *name)
+{
+	struct output *output;
+
+	wl_list_for_each(output, &client->output_list, link) {
+		if (output->name && strcmp(output->name, name) == 0)
+			return output;
+	}
+
+	return NULL;
+}
+
+/*
+ * A client that passes a wl_output to xdg_toplevel.set_fullscreen() before
+ * the initial commit must be shown on that output, and not on whichever
+ * output kiosk-shell would otherwise pick (the focused or default one).
+ */
+static enum test_result_code
+fullscreen_on_requested_output(struct wet_testsuite_data *suite_data)
+{
+	static const char * const names[] = { "headless-1", "headless" };
+	struct xdg_client *xdg_client = create_xdg_client();
+	struct xdg_surface_data *xdg_surface[ARRAY_LENGTH(names)];
+	unsigned int i;
+
+	test_assert_ptr_not_null(xdg_client);
+
+	for (i = 0; i < ARRAY_LENGTH(names); i++) {
+		struct client *client = xdg_client->client;
+		struct output *target = find_output(client, names[i]);
+		int frame;
+
+		test_assert_ptr_not_null(target);
+
+		xdg_surface[i] = create_xdg_surface(xdg_client);
+		test_assert_ptr_not_null(xdg_surface[i]);
+		xdg_surface_make_toplevel(xdg_surface[i], "weston.test.kiosk",
+					  names[i]);
+		xdg_toplevel_set_fullscreen(xdg_surface[i]->xdg_toplevel,
+					    target->wl_output);
+
+		xdg_surface_wait_configure(xdg_surface[i]);
+		test_assert_true(xdg_surface[i]->configure.fullscreen);
+		test_assert_int_eq(xdg_surface[i]->configure.width,
+				   target->width);
+		test_assert_int_eq(xdg_surface[i]->configure.height,
+				   target->height);
+
+		frame_callback_set(xdg_surface[i]->surface->wl_surface, &frame);
+		xdg_surface_commit_solid(xdg_surface[i], 0, 0, 255);
+		frame_callback_wait(client, &frame);
+		client_roundtrip(client);
+
+		testlog("surface \"%s\" requested output %s, entered %s\n",
+			names[i], target->name,
+			xdg_surface[i]->surface->output ?
+			xdg_surface[i]->surface->output->name : "(none)");
+		test_assert_ptr_eq(xdg_surface[i]->surface->output, target);
+	}
+
+	for (i = 0; i < ARRAY_LENGTH(names); i++)
+		destroy_xdg_surface(xdg_surface[i]);
+	xdg_client_destroy(xdg_client);
+
+	return RESULT_OK;
+}
+
+DECLARE_TEST_LIST(
+	TESTFN(fullscreen_on_requested_output),
+);
