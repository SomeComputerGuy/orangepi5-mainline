+++ b/tests/meson.build
@@ -274,6 +274,9 @@ if get_option('shell-kiosk')
 		{
 			'name': 'kiosk-shell',
 		},
+		{
+			'name': 'kiosk-shell-multi-output',
+		},
 	]
 endif
 
