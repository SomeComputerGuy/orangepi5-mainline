From 8fd2f003048cb1722a57fc4bc01198b62297ad8f Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 03:50:00 +0000
Subject: [PATCH 3/3] kiosk-shell: Honour the output passed to set_fullscreen
 before mapping

A client that calls xdg_toplevel.set_fullscreen() with a wl_output
before its first buffer commit ends up on whatever output kiosk-shell
would have picked on its own (the output holding keyboard focus, or the
default output), instead of the output it asked for. With two outputs
and two such clients each asking for a different output, both surfaces
are shown on the same one. desktop-shell honours the request.

desktop_surface_fullscreen_requested() does assign the requested
output, but when the first buffer is committed and the surface has an
app_id, desktop_surface_committed() unconditionally clears
shsurf->output so that the output cached in desktop_surface_added() is
not reused, and then picks a new one with
kiosk_shell_surface_find_best_output(). This throws away the client's
choice along with the cached one. Clients without an app_id are not
affected, since that path is skipped for them.

Remember whether the client requested a specific output, and only reset
the output on the first commit when it did not. The [output] app-ids
setting still applies to clients that leave the output choice to the
compositor; an explicit request now wins, as it already does when
set_fullscreen() is sent after the surface is mapped.

Add kiosk-shell-multi-output-test, which creates two headless outputs
and maps one fullscreen surface on each through set_fullscreen(output),
checking the wl_surface.enter output. Without this change the surface
that asks for "headless-1" enters "headless".

Assisted-by: Claude:claude-opus-5-5
---
 kiosk-shell/kiosk-shell.c             |  10 ++-
 kiosk-shell/kiosk-shell.h             |   2 +
 tests/kiosk-shell-multi-output-test.c | 123 ++++++++++++++++++++++++++
 tests/meson.build                     |   3 +
 4 files changed, 136 insertions(+), 2 deletions(-)
 create mode 100644 tests/kiosk-shell-multi-output-test.c

diff --git a/kiosk-shell/kiosk-shell.c b/kiosk-shell/kiosk-shell.c
index 2b9cb23..e8cdf8f 100644
--- a/kiosk-shell/kiosk-shell.c
+++ b/kiosk-shell/kiosk-shell.c
@@ -1007,8 +1007,9 @@ desktop_surface_committed(struct weston_desktop_surface *desktop_surface,
 		struct kiosk_shell_output *shoutput = NULL;
 
 		/* reset previous output being set in _added() as the output is
-		 * being cached */
-		shsurf->output = NULL;
+		 * being cached, unless the client explicitly asked for one */
+		if (!shsurf->output_requested)
+			shsurf->output = NULL;
 		shoutput = kiosk_shell_surface_find_best_output(shsurf);
 
 		kiosk_shell_surface_set_output(shsurf, shoutput);
@@ -1150,6 +1151,11 @@ desktop_surface_fullscreen_requested(struct weston_desktop_surface *desktop_surf
 	if (output)
 		shoutput = weston_output_get_shell_private(output);
 
+	/* Remember that the client picked the output, so that the initial
+	 * commit does not move the surface somewhere else. */
+	if (fullscreen)
+		shsurf->output_requested = shoutput != NULL;
+
 	/* We should normally be able to ignore fullscreen requests for
 	 * top-level surfaces, since we set them as fullscreen at creation
 	 * time. However, xwayland surfaces set their internal WM state
diff --git a/kiosk-shell/kiosk-shell.h b/kiosk-shell/kiosk-shell.h
index 2c112ca..0604a36 100644
--- a/kiosk-shell/kiosk-shell.h
+++ b/kiosk-shell/kiosk-shell.h
@@ -80,6 +80,8 @@ struct kiosk_shell_surface {
 	} xwayland;
 
 	bool appid_output_assigned;
+	/* the client asked for a specific output with set_fullscreen() */
+	bool output_requested;
 
 	struct wl_listener surface_label_update;
 };
