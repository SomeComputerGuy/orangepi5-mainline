diff --git a/ucm2/Rockchip/es8388/HiFi.conf b/ucm2/Rockchip/es8388/HiFi.conf
new file mode 100644
index 0000000..b417c3e
--- /dev/null
+++ b/ucm2/Rockchip/es8388/HiFi.conf
@@ -0,0 +1,73 @@
+SectionDevice."Headphones" {
+	Comment "Headphones"
+
+	Value {
+		PlaybackPriority 200
+		PlaybackPCM "hw:${CardId}"
+		PlaybackMixerElem "PCM"
+	}
+}
+
+If.hpjack {
+	Condition {
+		Type ControlExists
+		Control "iface=CARD,name='Headphones Jack'"
+	}
+	True.SectionDevice."Headphones".Value.JackControl "Headphones Jack"
+}
+
+# Boards that route the jack through an amplifier expose a pin switch
+If.hpswitch {
+	Condition {
+		Type ControlExists
+		Control "name='Headphones Switch'"
+	}
+	True.SectionDevice."Headphones" {
+		EnableSequence [
+			cset "name='Headphones Switch' on"
+		]
+		DisableSequence [
+			cset "name='Headphones Switch' off"
+		]
+	}
+}
+
+SectionDevice."Mic" {
+	Comment "Internal Microphone"
+
+	EnableSequence [
+		cset "name='Differential Mux' 'Line 2'"
+		cset "name='Left PGA Mux' 'Line 2'"
+		cset "name='Right PGA Mux' 'Line 2'"
+	]
+
+	Value {
+		CapturePriority 200
+		CapturePCM "hw:${CardId}"
+		CaptureMixerElem "Capture Digital"
+	}
+
+	ConflictingDevice [
+		"Headset"
+	]
+}
+
+SectionDevice."Headset" {
+	Comment "Microphone Jack"
+
+	EnableSequence [
+		cset "name='Differential Mux' 'Line 1'"
+		cset "name='Left PGA Mux' 'Line 1'"
+		cset "name='Right PGA Mux' 'Line 1'"
+	]
+
+	Value {
+		CapturePriority 100
+		CapturePCM "hw:${CardId}"
+		CaptureMixerElem "Capture Digital"
+	}
+
+	ConflictingDevice [
+		"Mic"
+	]
+}
diff --git a/ucm2/Rockchip/es8388/es8388.conf b/ucm2/Rockchip/es8388/es8388.conf
new file mode 100644
index 0000000..3d52987
--- /dev/null
+++ b/ucm2/Rockchip/es8388/es8388.conf
@@ -0,0 +1,34 @@
+# ES8388 (ES8328 driver) on a simple-audio-card named "rockchip,es8388":
+# Orange Pi 5, 5B and 5 Pro, Firefly ROC-RK3588S-PC.
+Syntax 4
+
+SectionUseCase."HiFi" {
+	File "/Rockchip/es8388/HiFi.conf"
+	Comment "Play HiFi quality Music"
+}
+
+# The codec resets with the DAC at -96 dB and both output stages at -30 dB.
+# Bring the digital and analog gains to 0 dB; the PCM control is the volume.
+BootSequence [
+	cset "name='PCM Volume' 192"
+	cset "name='Output 1 Playback Volume' 30"
+	cset "name='Output 2 Playback Volume' 30"
+	cset "name='Route' 'Stereo'"
+	cset "name='DAC Deemphasis Switch' off"
+
+	# No analog bypass of the inputs into the output mixers
+	cset "name='Left Mixer Left Bypass Switch' off"
+	cset "name='Left Mixer Right Bypass Switch' off"
+	cset "name='Right Mixer Left Bypass Switch' off"
+	cset "name='Right Mixer Right Bypass Switch' off"
+	# Left DAC to the right output and vice versa: off (stereo)
+	cset "name='Left Mixer Right Playback Switch' off"
+	cset "name='Right Mixer Left Playback Switch' off"
+
+	# Capture: on-board microphone (LINPUT2/RINPUT2), +12 dB PGA, 0 dB ADC
+	cset "name='Differential Mux' 'Line 2'"
+	cset "name='Left PGA Mux' 'Line 2'"
+	cset "name='Right PGA Mux' 'Line 2'"
+	cset "name='Mic PGA Volume' 4"
+	cset "name='Capture Digital Volume' 192"
+]
diff --git a/ucm2/Rockchip/rk3588-hdmi-dp/HiFi.conf b/ucm2/Rockchip/rk3588-hdmi-dp/HiFi.conf
new file mode 100644
index 0000000..50df68d
--- /dev/null
+++ b/ucm2/Rockchip/rk3588-hdmi-dp/HiFi.conf
@@ -0,0 +1,20 @@
+SectionDevice."HDMI1" {
+	Comment "HDMI"
+
+	Value {
+		PlaybackPriority 150
+		PlaybackPCM "hw:${CardId}"
+	}
+}
+
+If.dp {
+	Condition {
+		Type RegexMatch
+		Regex "^dp[0-9]$"
+		String "${CardName}"
+	}
+	True.SectionDevice."HDMI1" {
+		Comment "DisplayPort"
+		Value.PlaybackPriority 140
+	}
+}
diff --git a/ucm2/Rockchip/rk3588-hdmi-dp/rk3588-hdmi-dp.conf b/ucm2/Rockchip/rk3588-hdmi-dp/rk3588-hdmi-dp.conf
new file mode 100644
index 0000000..04f2c4d
--- /dev/null
+++ b/ucm2/Rockchip/rk3588-hdmi-dp/rk3588-hdmi-dp.conf
@@ -0,0 +1,9 @@
+# RK3588 HDMI and DisplayPort outputs: the simple-audio-cards "hdmi0" and
+# "dp0" (rk3588-base.dtsi) and "hdmi1" (rk3588-extra.dtsi), I2S or SPDIF into
+# the hdmi-codec of the DW HDMI QP or DW DP controller. No mixer controls.
+Syntax 4
+
+SectionUseCase."HiFi" {
+	File "/Rockchip/rk3588-hdmi-dp/HiFi.conf"
+	Comment "Play HiFi quality Music"
+}
