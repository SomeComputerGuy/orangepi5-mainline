From c7c00f7a491658b829c23830ae3738559d074792 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 09:14:59 +0000
Subject: [PATCH] media: rkisp2: Fix missing HIST_BIG2 entry in stats block
 info table

rkisp2_stats_blocks_info[] lists RKISP2_STATS_BLOCK_HIST_BIG1 twice and
never RKISP2_STATS_BLOCK_HIST_BIG2, so the BIG2 histogram block is
registered with a size of 0 while the driver does fill it in
rkisp2_stats_hist_read(). W=1 flags the duplicate designated initializer
(-Woverride-init). Replace the second HIST_BIG1 with HIST_BIG2.

To be squashed into "media: rkisp2: Add statistics capture video node".

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/rockchip/rkisp2/rkisp2-stats.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/media/platform/rockchip/rkisp2/rkisp2-stats.c b/drivers/media/platform/rockchip/rkisp2/rkisp2-stats.c
index 7bbc1e25b..6900e6b80 100644
--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-stats.c
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-stats.c
@@ -28,7 +28,7 @@ rkisp2_stats_blocks_info[] = {
 	RKISP2_STATS_BLOCK_INFO(HIST_LITE, hist),
 	RKISP2_STATS_BLOCK_INFO(HIST_BIG0, hist),
 	RKISP2_STATS_BLOCK_INFO(HIST_BIG1, hist),
-	RKISP2_STATS_BLOCK_INFO(HIST_BIG1, hist),
+	RKISP2_STATS_BLOCK_INFO(HIST_BIG2, hist),
 	RKISP2_STATS_BLOCK_INFO(AWB, awb),
 };
 
