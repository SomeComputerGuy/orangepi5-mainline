+ * V4L2 Request API AVS2 hwaccel
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config.h"
+
+#include "avs2dec.h"
+#include "hwaccel_internal.h"
+#include "hwconfig.h"
+#include "internal.h"
+#include "v4l2_request.h"
+#include "v4l2-stateless-avs2.h"
+
+typedef struct V4L2RequestControlsAVS2 {
+    V4L2RequestPictureContext pic;
+    struct v4l2_ctrl_avs2_sequence sequence;
+    struct v4l2_ctrl_avs2_picture picture;
+    struct v4l2_ctrl_avs2_weight_quant weight_quant;
+    struct v4l2_ctrl_avs2_alf alf;
+} V4L2RequestControlsAVS2;
+
+static void fill_sequence(struct v4l2_ctrl_avs2_sequence *ctrl,
+                          const AVS2SequenceHeader *seq)
+{
+    *ctrl = (struct v4l2_ctrl_avs2_sequence) {
+        .horizontal_size       = seq->width,
+        .vertical_size         = seq->height,
+        .profile_id            = seq->profile_id,
+        .level_id              = seq->level_id,
+        .chroma_format         = seq->chroma_format,
+        .sample_precision      = seq->sample_precision,
+        .encoding_precision    = seq->encoding_precision,
+        .lcu_size              = seq->lcu_size,
+        .picture_reorder_delay = seq->picture_reorder_delay,
+    };
+
+    if (seq->progressive_sequence)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_PROGRESSIVE_SEQUENCE;
+    if (seq->field_coded_sequence)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_FIELD_CODED_SEQUENCE;
+    if (seq->low_delay)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_LOW_DELAY;
+    if (seq->temporal_id_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_TEMPORAL_ID_ENABLE;
+    if (seq->weight_quant_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_WEIGHT_QUANT_ENABLE;
+    if (seq->background_picture_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_BACKGROUND_PICTURE_ENABLE;
+    if (seq->mhp_skip_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_MHP_SKIP_ENABLE;
+    if (seq->dhp_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_DHP_ENABLE;
+    if (seq->wsm_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_WSM_ENABLE;
+    if (seq->amp_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_AMP_ENABLE;
+    if (seq->nsqt_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_NSQT_ENABLE;
+    if (seq->nsip_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_NSIP_ENABLE;
+    if (seq->secondary_transform_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_SECONDARY_TRANSFORM_ENABLE;
+    if (seq->sao_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_SAO_ENABLE;
+    if (seq->alf_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_ALF_ENABLE;
+    if (seq->pmvr_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_PMVR_ENABLE;
+    if (seq->cross_slice_loopfilter_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_CROSS_SLICE_LOOPFILTER_ENABLE;
+    if (seq->bcbr_enable)
+        ctrl->flags |= V4L2_AVS2_SEQUENCE_FLAG_BCBR_ENABLE;
+}
+
+static void fill_picture(struct v4l2_ctrl_avs2_picture *ctrl,
+                         const AVS2DecContext *s)
+{
+    const AVS2PictureHeader *pic = &s->pic;
+    const AVS2Frame *cur = s->cur;
+
+    *ctrl = (struct v4l2_ctrl_avs2_picture) {
+        .data_offset                 = s->data_offset,
+        .poc                         = cur->poc,
+        .picture_type                = pic->picture_type,
+        .num_ref_pics                = s->num_refs,
+        .decode_order_index          = pic->doi,
+        .temporal_id                 = pic->temporal_id,
+        .picture_output_delay        = pic->output_delay,
+        .picture_qp                  = pic->picture_qp,
+        .alpha_c_offset              = pic->alpha_c_offset,
+        .beta_offset                 = pic->beta_offset,
+        .chroma_quant_param_delta_cb = pic->chroma_quant_param_delta_cb,
+        .chroma_quant_param_delta_cr = pic->chroma_quant_param_delta_cr,
+    };
+
+    if (pic->progressive_frame)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_PROGRESSIVE_FRAME;
+    if (pic->picture_structure)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_PICTURE_STRUCTURE;
+    if (pic->top_field_first)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_TOP_FIELD_FIRST;
+    if (pic->repeat_first_field)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_REPEAT_FIRST_FIELD;
+    if (pic->is_top_field)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_IS_TOP_FIELD;
+    if (pic->fixed_picture_qp)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_FIXED_PICTURE_QP;
+    if (pic->loop_filter_disable)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_LOOP_FILTER_DISABLE;
+    if (pic->rcs.refered_by_others)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_REFERED_BY_OTHERS;
+    if (pic->background_picture)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_BACKGROUND_PICTURE;
+    if (pic->background_output)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_BACKGROUND_PICTURE_OUTPUT;
+    if (pic->background_pred)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_BACKGROUND_PRED;
+    if (pic->background_reference)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_BACKGROUND_REFERENCE;
+    if (pic->random_access_decodable)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_RANDOM_ACCESS_DECODABLE;
+    if (pic->weight_quant_enable)
+        ctrl->flags |= V4L2_AVS2_PICTURE_FLAG_WEIGHT_QUANT_ENABLE;
+
+    for (int i = 0; i < s->num_refs; i++) {
+        const AVS2Frame *ref = s->refs[i];
+        struct v4l2_avs2_ref_pic *r = &ctrl->ref_pics[i];
+
+        r->timestamp    = ff_v4l2_request_get_capture_timestamp(ref->f);
+        r->poc          = ref->poc;
+        r->picture_type = ref->picture_type;
+        r->num_ref_pics = ref->num_refs;
+        for (int j = 0; j < ref->num_refs; j++)
+            r->ref_poc[j] = ref->ref_poc[j];
+        if (ref->background && ref == s->background)
+            r->flags |= V4L2_AVS2_REF_PIC_FLAG_BACKGROUND;
+    }
+}
+
+static void fill_alf(struct v4l2_ctrl_avs2_alf *ctrl, const AVS2ALFParams *alf)
+{
+    memset(ctrl, 0, sizeof(*ctrl));
+
+    if (alf->enable[0])
+        ctrl->flags |= V4L2_AVS2_ALF_FLAG_LUMA_ENABLE;
+    if (alf->enable[1])
+        ctrl->flags |= V4L2_AVS2_ALF_FLAG_CB_ENABLE;
+    if (alf->enable[2])
+        ctrl->flags |= V4L2_AVS2_ALF_FLAG_CR_ENABLE;
+
+    ctrl->num_luma_filters = alf->num_luma_filters;
+    for (int f = 0; f < AVS2_ALF_MAX_FILTERS; f++)
+        for (int i = 0; i < AVS2_ALF_NUM_COEFFS; i++)
+            ctrl->luma_coeff[f][i] = alf->luma_coeff[f][i];
+    for (int c = 0; c < 2; c++)
+        for (int i = 0; i < AVS2_ALF_NUM_COEFFS; i++)
+            ctrl->chroma_coeff[c][i] = alf->chroma_coeff[c][i];
+    memcpy(ctrl->luma_region_filter, alf->region_filter,
+           sizeof(ctrl->luma_region_filter));
+}
+
+static int v4l2_request_avs2_start_frame(AVCodecContext *avctx,
+                                         av_unused const AVBufferRef *buf_ref,
+                                         const uint8_t *buffer,
+                                         uint32_t size)
+{
+    const AVS2DecContext *s = avctx->priv_data;
+    V4L2RequestControlsAVS2 *controls = s->cur->hwaccel_picture_private;
+    int ret;
+
+    ret = ff_v4l2_request_start_frame(avctx, &controls->pic, s->cur->f);
+    if (ret)
+        return ret;
+
+    fill_sequence(&controls->sequence, &s->seq);
+    fill_picture(&controls->picture, s);
+    memcpy(controls->weight_quant.matrix_4x4, s->pic.wqm[0],
+           sizeof(controls->weight_quant.matrix_4x4));
+    memcpy(controls->weight_quant.matrix_8x8, s->pic.wqm[1],
+           sizeof(controls->weight_quant.matrix_8x8));
+    fill_alf(&controls->alf, &s->pic.alf);
+
+    /* The picture header and all its slices, with their start codes. */
+    return ff_v4l2_request_append_output(avctx, &controls->pic, buffer, size);
+}
+
+static int v4l2_request_avs2_decode_slice(AVCodecContext *avctx,
+                                          av_unused const uint8_t *buffer,
+                                          av_unused uint32_t size)
+{
+    /* The whole picture is appended by start_frame(). */
+    return 0;
+}
+
+static int v4l2_request_avs2_end_frame(AVCodecContext *avctx)
+{
+    const AVS2DecContext *s = avctx->priv_data;
+    V4L2RequestControlsAVS2 *controls = s->cur->hwaccel_picture_private;
+    struct v4l2_ext_control control[] = {
+        {
+            .id   = V4L2_CID_STATELESS_AVS2_SEQUENCE,
+            .ptr  = &controls->sequence,
+            .size = sizeof(controls->sequence),
+        },
+        {
+            .id   = V4L2_CID_STATELESS_AVS2_PICTURE,
+            .ptr  = &controls->picture,
+            .size = sizeof(controls->picture),
+        },
+        {
+            .id   = V4L2_CID_STATELESS_AVS2_WEIGHT_QUANT,
+            .ptr  = &controls->weight_quant,
+            .size = sizeof(controls->weight_quant),
+        },
+        {
+            .id   = V4L2_CID_STATELESS_AVS2_ALF,
+            .ptr  = &controls->alf,
+            .size = sizeof(controls->alf),
+        },
+    };
+
+    return ff_v4l2_request_decode_frame(avctx, &controls->pic,
+                                        control, FF_ARRAY_ELEMS(control));
+}
+
+static int v4l2_request_avs2_init(AVCodecContext *avctx)
+{
+    const AVS2DecContext *s = avctx->priv_data;
+    struct v4l2_ctrl_avs2_sequence sequence;
+    struct v4l2_ext_control control[] = {
+        {
+            .id   = V4L2_CID_STATELESS_AVS2_SEQUENCE,
+            .ptr  = &sequence,
+            .size = sizeof(sequence),
+        },
+    };
+
+    if (!s->seq_valid)
+        return AVERROR(EINVAL);
+
+    /*
+     * The sequence sets the bit depth, with it the CAPTURE formats, and lets
+     * the driver refuse the size or the coding tools before decoding.
+     */
+    fill_sequence(&sequence, &s->seq);
+
+    return ff_v4l2_request_init(avctx, control, FF_ARRAY_ELEMS(control), NULL);
+}
+
+static int v4l2_request_avs2_frame_params(AVCodecContext *avctx,
+                                          AVBufferRef *hw_frames_ctx)
+{
+    const AVS2DecContext *s = avctx->priv_data;
+    uint8_t bit_depth = s->seq_valid ? 6 + 2 * s->seq.sample_precision : 0;
+
+    return ff_v4l2_request_frame_params(avctx, hw_frames_ctx,
+                                        V4L2_PIX_FMT_AVS2_FRAME, bit_depth);
+}
+
+const FFHWAccel ff_avs2_v4l2request_hwaccel = {
+    .p.name             = "avs2_v4l2request",
+    .p.type             = AVMEDIA_TYPE_VIDEO,
+    .p.id               = AV_CODEC_ID_AVS2,
+    .p.pix_fmt          = AV_PIX_FMT_DRM_PRIME,
+    .start_frame        = v4l2_request_avs2_start_frame,
+    .decode_slice       = v4l2_request_avs2_decode_slice,
+    .end_frame          = v4l2_request_avs2_end_frame,
+    .flush              = ff_v4l2_request_flush,
+    .frame_priv_data_size = sizeof(V4L2RequestControlsAVS2),
+    .init               = v4l2_request_avs2_init,
+    .uninit             = ff_v4l2_request_uninit,
+    .priv_data_size     = sizeof(V4L2RequestContext),
+    .frame_params       = v4l2_request_avs2_frame_params,
+    .caps_internal      = HWACCEL_CAP_ASYNC_SAFE,
+};
