From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 06:07:39 +0000
Subject: [PATCH 304/311] avcodec: add V4L2 Request API MPEG-1 hwaccel

Cedrus and the Hantro/Rockchip VPU2 decode MPEG-1 through the MPEG-2
stateless controls with a small downstream uAPI extension:
V4L2_MPEG2_SEQ_FLAG_MPEG1 and the FULL_PEL_FORWARD/BACKWARD picture
flags (the MPEG-1 picture header fields that MPEG-2 dropped), plus
D-pictures as picture coding type 4.
Register mpeg1_v4l2request on top of the MPEG-2 hwaccel. D-pictures are
passed to the hwaccel as I-pictures in the parser; the software decoder
still rejects them.

The decoders advertise MPEG-1 with their own coded format,
V4L2_PIX_FMT_MPEG1_SLICE ('MG1S'), and use the MPEG-2 controls for it.
The MPEG-1 hwaccel only probes that format: decoders that only offer
V4L2_PIX_FMT_MPEG2_SLICE ignore the MPEG-1 flags and would decode MPEG-1
as MPEG-2, so on them the hwaccel fails to initialise and MPEG-1 is
decoded in software.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 configure                       |  2 +
 libavcodec/Makefile             |  1 +
 libavcodec/hwaccels.h           |  1 +
 libavcodec/mpeg12dec.c          | 12 ++++++
 libavcodec/mpegvideo.h          |  1 +
 libavcodec/v4l2_request_mpeg2.c | 72 +++++++++++++++++++++++++--------
 6 files changed, 73 insertions(+), 16 deletions(-)

diff --git a/configure b/configure
index 985428bbff..e6e6c91d2a 100755
--- a/configure
+++ b/configure
@@ -3431,6 +3431,8 @@ mjpeg_vaapi_hwaccel_deps="vaapi"
 mjpeg_vaapi_hwaccel_select="mjpeg_decoder"
 mpeg1_nvdec_hwaccel_deps="nvdec"
 mpeg1_nvdec_hwaccel_select="mpeg1video_decoder"
+mpeg1_v4l2request_hwaccel_deps="v4l2_request mpeg2_v4l2_request"
+mpeg1_v4l2request_hwaccel_select="mpeg1video_decoder"
 mpeg1_vdpau_hwaccel_deps="vdpau"
 mpeg1_vdpau_hwaccel_select="mpeg1video_decoder"
 mpeg1_videotoolbox_hwaccel_deps="videotoolbox"
diff --git a/libavcodec/Makefile b/libavcodec/Makefile
index f4ec9e3121..3d2bfce211 100644
--- a/libavcodec/Makefile
+++ b/libavcodec/Makefile
@@ -1091,6 +1091,7 @@ OBJS-$(CONFIG_MPEG2_DXVA2_HWACCEL)        += dxva2_mpeg2.o
 OBJS-$(CONFIG_MPEG2_D3D12VA_HWACCEL)      += dxva2_mpeg2.o d3d12va_mpeg2.o
 OBJS-$(CONFIG_MPEG2_NVDEC_HWACCEL)        += nvdec_mpeg12.o
 OBJS-$(CONFIG_MPEG2_QSV_HWACCEL)          += qsvdec.o
+OBJS-$(CONFIG_MPEG1_V4L2REQUEST_HWACCEL)  += v4l2_request_mpeg2.o
 OBJS-$(CONFIG_MPEG2_V4L2REQUEST_HWACCEL)  += v4l2_request_mpeg2.o
 OBJS-$(CONFIG_MPEG2_VAAPI_HWACCEL)        += vaapi_mpeg2.o
 OBJS-$(CONFIG_MPEG2_VDPAU_HWACCEL)        += vdpau_mpeg12.o
diff --git a/libavcodec/hwaccels.h b/libavcodec/hwaccels.h
index 94b877368d..1f88024791 100644
--- a/libavcodec/hwaccels.h
+++ b/libavcodec/hwaccels.h
@@ -58,6 +58,7 @@ extern const struct FFHWAccel ff_hevc_vulkan_hwaccel;
 extern const struct FFHWAccel ff_mjpeg_nvdec_hwaccel;
 extern const struct FFHWAccel ff_mjpeg_vaapi_hwaccel;
 extern const struct FFHWAccel ff_mpeg1_nvdec_hwaccel;
+extern const struct FFHWAccel ff_mpeg1_v4l2request_hwaccel;
 extern const struct FFHWAccel ff_mpeg1_vdpau_hwaccel;
 extern const struct FFHWAccel ff_mpeg1_videotoolbox_hwaccel;
 extern const struct FFHWAccel ff_mpeg2_d3d11va_hwaccel;
diff --git a/libavcodec/mpeg12dec.c b/libavcodec/mpeg12dec.c
index c65e9e3b86..1a52f87b77 100644
--- a/libavcodec/mpeg12dec.c
+++ b/libavcodec/mpeg12dec.c
@@ -794,6 +794,9 @@ static const enum AVPixelFormat mpeg1_hwaccel_pixfmt_list_420[] = {
 #endif
 #if CONFIG_MPEG1_VDPAU_HWACCEL
     AV_PIX_FMT_VDPAU,
+#endif
+#if CONFIG_MPEG1_V4L2REQUEST_HWACCEL
+    AV_PIX_FMT_DRM_PRIME,
 #endif
     AV_PIX_FMT_YUV420P,
     AV_PIX_FMT_NONE
@@ -991,6 +994,12 @@ static int mpeg1_decode_picture(AVCodecContext *avctx, const uint8_t *buf,
 
     ref = get_bits(gb, 10); /* temporal ref */
     s->pict_type = get_bits(gb, 3);
+    s->mpeg1_d_picture = 0;
+    /* D-pictures: only a hwaccel can decode them; carry them as I-pictures. */
+    if (s->pict_type == 4 && avctx->hwaccel) {
+        s->mpeg1_d_picture = 1;
+        s->pict_type       = AV_PICTURE_TYPE_I;
+    }
     if (s->pict_type == 0 || s->pict_type > 3)
         return AVERROR_INVALIDDATA;
 
@@ -2665,6 +2674,9 @@ const FFCodec ff_mpeg1video_decoder = {
 #endif
 #if CONFIG_MPEG1_VIDEOTOOLBOX_HWACCEL
                                HWACCEL_VIDEOTOOLBOX(mpeg1),
+#endif
+#if CONFIG_MPEG1_V4L2REQUEST_HWACCEL
+                               HWACCEL_V4L2REQUEST(mpeg1),
 #endif
                                NULL
                            },
diff --git a/libavcodec/mpegvideo.h b/libavcodec/mpegvideo.h
index d448ac6b5a..989a78c85c 100644
--- a/libavcodec/mpegvideo.h
+++ b/libavcodec/mpegvideo.h
@@ -269,6 +269,7 @@ typedef struct MpegEncContext {
 
     int progressive_frame;
     int full_pel[2];
+    int mpeg1_d_picture;    ///< MPEG-1 D-picture (DC only); decoded as I by the code here, only hwaccels decode it
     int interlaced_dct;
     int first_field;         ///< is 1 for the first field of a field picture 0 otherwise
 
diff --git a/libavcodec/v4l2_request_mpeg2.c b/libavcodec/v4l2_request_mpeg2.c
index 5d89b7168e..33d4cdd9ec 100644
--- a/libavcodec/v4l2_request_mpeg2.c
+++ b/libavcodec/v4l2_request_mpeg2.c
@@ -17,6 +17,7 @@
  */
 
 #include "config.h"
+#include "config_components.h"
 
 #include "hwaccel_internal.h"
 #include "hwconfig.h"
@@ -24,6 +25,16 @@
 #include "mpegvideo.h"
 #include "v4l2_request.h"
 
+/* MPEG-1 uAPI (media: uapi: mpeg2: add MPEG-1 sequence and full pel flags) */
+#ifndef V4L2_MPEG2_SEQ_FLAG_MPEG1
+#define V4L2_MPEG2_SEQ_FLAG_MPEG1               0x02
+#define V4L2_MPEG2_PIC_FLAG_FULL_PEL_FORWARD    0x0100
+#define V4L2_MPEG2_PIC_FLAG_FULL_PEL_BACKWARD   0x0200
+#endif
+#ifndef V4L2_PIX_FMT_MPEG1_SLICE
+#define V4L2_PIX_FMT_MPEG1_SLICE v4l2_fourcc('M', 'G', '1', 'S')
+#endif
+
 typedef struct V4L2RequestControlsMPEG2 {
     V4L2RequestPictureContext pic;
     struct v4l2_ctrl_mpeg2_sequence sequence;
@@ -58,9 +69,17 @@ static int v4l2_request_mpeg2_start_frame(AVCodecContext *avctx,
     if (s->progressive_sequence)
         controls->sequence.flags |= V4L2_MPEG2_SEQ_FLAG_PROGRESSIVE;
 
+    /*
+     * ISO/IEC 11172-2: no extensions; the decoder context holds the values
+     * ISO/IEC 13818-2 defines for MPEG-1 (frame pictures, frame_pred_frame_dct,
+     * both f_code components from forward_f_code/backward_f_code).
+     */
+    if (avctx->codec_id == AV_CODEC_ID_MPEG1VIDEO)
+        controls->sequence.flags |= V4L2_MPEG2_SEQ_FLAG_MPEG1;
+
     controls->picture = (struct v4l2_ctrl_mpeg2_picture) {
         /* ISO/IEC 13818-2, ITU-T Rec. H.262: Picture header */
-        .picture_coding_type = s->pict_type,
+        .picture_coding_type = s->mpeg1_d_picture ? V4L2_MPEG2_PIC_CODING_TYPE_D : s->pict_type,
 
         /* ISO/IEC 13818-2, ITU-T Rec. H.262: Picture coding extension */
         .f_code[0][0] = s->mpeg_f_code[0][0],
@@ -95,6 +114,13 @@ static int v4l2_request_mpeg2_start_frame(AVCodecContext *avctx,
     if (s->progressive_frame)
         controls->picture.flags |= V4L2_MPEG2_PIC_FLAG_PROGRESSIVE;
 
+    if (avctx->codec_id == AV_CODEC_ID_MPEG1VIDEO) {
+        if (s->full_pel[0])
+            controls->picture.flags |= V4L2_MPEG2_PIC_FLAG_FULL_PEL_FORWARD;
+        if (s->pict_type == AV_PICTURE_TYPE_B && s->full_pel[1])
+            controls->picture.flags |= V4L2_MPEG2_PIC_FLAG_FULL_PEL_BACKWARD;
+    }
+
     switch (s->pict_type) {
     case AV_PICTURE_TYPE_B:
         if (s->next_pic.ptr)
@@ -162,23 +188,37 @@ static int v4l2_request_mpeg2_init(AVCodecContext *avctx)
 static int v4l2_request_mpeg2_frame_params(AVCodecContext *avctx,
                                            AVBufferRef *hw_frames_ctx)
 {
+    /*
+     * MPEG-1 has its own coded format: only decoders that enumerate it
+     * decode MPEG-1, MPEG-2 decoders would decode it as MPEG-2.
+     */
     return ff_v4l2_request_frame_params(avctx, hw_frames_ctx,
+                                        avctx->codec_id == AV_CODEC_ID_MPEG1VIDEO ?
+                                        V4L2_PIX_FMT_MPEG1_SLICE :
                                         V4L2_PIX_FMT_MPEG2_SLICE, 8);
 }
 
-const FFHWAccel ff_mpeg2_v4l2request_hwaccel = {
-    .p.name             = "mpeg2_v4l2request",
-    .p.type             = AVMEDIA_TYPE_VIDEO,
-    .p.id               = AV_CODEC_ID_MPEG2VIDEO,
-    .p.pix_fmt          = AV_PIX_FMT_DRM_PRIME,
-    .start_frame        = v4l2_request_mpeg2_start_frame,
-    .decode_slice       = v4l2_request_mpeg2_decode_slice,
-    .end_frame          = v4l2_request_mpeg2_end_frame,
-    .flush              = ff_v4l2_request_flush,
-    .frame_priv_data_size = sizeof(V4L2RequestControlsMPEG2),
-    .init               = v4l2_request_mpeg2_init,
-    .uninit             = ff_v4l2_request_uninit,
-    .priv_data_size     = sizeof(V4L2RequestContext),
-    .frame_params       = v4l2_request_mpeg2_frame_params,
-    .caps_internal      = HWACCEL_CAP_ASYNC_SAFE,
+#define V4L2_REQUEST_MPEG12_HWACCEL(codec, id_)                                 \
+const FFHWAccel ff_ ## codec ## _v4l2request_hwaccel = {                     \
+    .p.name             = #codec "_v4l2request",                             \
+    .p.type             = AVMEDIA_TYPE_VIDEO,                                \
+    .p.id               = id_,                                               \
+    .p.pix_fmt          = AV_PIX_FMT_DRM_PRIME,                              \
+    .start_frame        = v4l2_request_mpeg2_start_frame,                    \
+    .decode_slice       = v4l2_request_mpeg2_decode_slice,                   \
+    .end_frame          = v4l2_request_mpeg2_end_frame,                      \
+    .flush              = ff_v4l2_request_flush,                             \
+    .frame_priv_data_size = sizeof(V4L2RequestControlsMPEG2),                \
+    .init               = v4l2_request_mpeg2_init,                           \
+    .uninit             = ff_v4l2_request_uninit,                            \
+    .priv_data_size     = sizeof(V4L2RequestContext),                        \
+    .frame_params       = v4l2_request_mpeg2_frame_params,                   \
+    .caps_internal      = HWACCEL_CAP_ASYNC_SAFE,                            \
 };
+
+#if CONFIG_MPEG1_V4L2REQUEST_HWACCEL
+V4L2_REQUEST_MPEG12_HWACCEL(mpeg1, AV_CODEC_ID_MPEG1VIDEO)
+#endif
+#if CONFIG_MPEG2_V4L2REQUEST_HWACCEL
+V4L2_REQUEST_MPEG12_HWACCEL(mpeg2, AV_CODEC_ID_MPEG2VIDEO)
+#endif
