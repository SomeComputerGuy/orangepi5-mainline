+#ifndef AVCODEC_AVS2DEC_H
+#define AVCODEC_AVS2DEC_H
+
+#include <stdint.h>
+
+#include "libavutil/frame.h"
+#include "avcodec.h"
+#include "avs2_ps.h"
+#include "packet.h"
+
+/* Decoded picture buffer entries: references, pending output, background. */
+#define AVS2_MAX_DPB 32
+
+typedef struct AVS2Frame {
+    AVFrame *f;
+    void *hwaccel_picture_private;  ///< RefStruct reference
+
+    uint8_t used;           ///< holds a decoded picture
+    uint8_t referenced;     ///< may be used for reference by later pictures
+    uint8_t background;     ///< the background (scene) reference, G or GB
+    uint8_t needs_output;
+
+    int64_t doi;            ///< decode_order_index without its 8-bit wrap
+    int32_t poc;
+    uint8_t picture_type;   ///< enum AVS2PictureType
+
+    /* the reference list of this picture when it was decoded, by POC */
+    uint8_t num_refs;
+    int32_t ref_poc[AVS2_MAX_REFS];
+} AVS2Frame;
+
+typedef struct AVS2DecContext {
+    AVCodecContext *avctx;
+    AVPacket *pkt;
+
+    AVS2SequenceHeader seq;
+    int seq_valid;
+    enum AVPixelFormat pix_fmt;
+
+    /* the picture being decoded */
+    AVS2PictureHeader pic;
+    AVS2Frame *cur;
+    /* its references, in the order of the reference configuration set */
+    AVS2Frame *refs[AVS2_MAX_REFS];
+    int num_refs;
+    /* its coded data: picture header and slices, with start codes */
+    const uint8_t *pic_data;
+    uint32_t pic_size;
+    uint32_t data_offset;   ///< offset of the first slice in pic_data
+
+    AVS2Frame dpb[AVS2_MAX_DPB];
+    AVS2Frame *background;  ///< the current background picture, if any
+    int64_t doi_wrap;
+    int prev_doi;
+    int prev_output_delay;
+    int64_t last_output_poc;
+    int output_started;
+    int seen_intra;
+
+    /* pictures bumped out of the DPB, waiting for receive_frame() */
+    AVFrame *out[AVS2_MAX_DPB + 1];
+    int nb_out;
+
+    uint8_t *hdr_buf;
+    unsigned hdr_buf_size;
+} AVS2DecContext;
+
+#endif /* AVCODEC_AVS2DEC_H */
