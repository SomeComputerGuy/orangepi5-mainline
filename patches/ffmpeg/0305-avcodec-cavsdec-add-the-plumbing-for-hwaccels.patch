+/**
+ * Hand the whole picture to the hwaccel, from its start code to the end of
+ * its last slice. Annex A keeps start code prefixes out of the slice data,
+ * so the next start code of another unit ends the picture; extensions and
+ * user data before the first slice belong to it.
+ */
+static int decode_pic_hwaccel(AVSContext *h)
+{
+    const FFHWAccel *hwaccel = ffhwaccel(h->avctx->hwaccel);
+    const uint8_t *buf = h->gb.buffer - 4;       /* the picture start code */
+    const uint8_t *end = h->gb.buffer + (h->gb.size_in_bits >> 3);
+    const uint8_t *p = h->gb.buffer, *slice = NULL, *pic_end = end;
+    uint32_t stc = -1;
+    int ret;
+
+    while (p < end) {
+        p = avpriv_find_start_code(p, end, &stc);
+        if ((stc & 0xFFFFFF00) != 0x100)
+            break;
+        if (stc <= SLICE_MAX_START_CODE) {
+            if (!slice)
+                slice = p - 4;
+        } else if (slice || (stc != EXT_START_CODE && stc != USER_START_CODE)) {
+            pic_end = p - 4;
+            break;
+        }
+    }
+    /* streams of the pre-final revision have no slice start codes */
+    if (!slice)
+        slice = buf + 4;
+
+    ret = hwaccel->start_frame(h->avctx, NULL, buf, pic_end - buf);
+    if (ret < 0)
+        return ret;
+    ret = hwaccel->decode_slice(h->avctx, slice, pic_end - slice);
+    if (ret < 0)
+        return ret;
+    return hwaccel->end_frame(h->avctx);
+}
+
 static int decode_pic(AVSContext *h)
 {
     int ret;
@@ -994,10 +1038,15 @@ static int decode_pic(AVSContext *h)
