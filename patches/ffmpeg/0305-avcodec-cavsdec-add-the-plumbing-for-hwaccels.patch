     }
     h->loop_filter_disable     = get_bits1(&h->gb);
@@ -1098,8 +1165,47 @@ static int decode_pic(AVSContext *h)
         h->alpha_offset = h->beta_offset  = 0;
     }
 
+    /* the Guangdian profile ends the header with the weighting
+       quantization parameters and aec_enable */
+    h->weighting_quant = h->aec_enable = 0;
+    if (h->profile == CAVS_PROFILE_GUANGDIAN) {
+        h->weighting_quant = get_bits1(&h->gb);
+        if (h->weighting_quant) {
