+            memset(wq, 0, sizeof(*wq));
+            wq->chroma_quant_param_disable = get_bits1(&h->gb);
+            if (!wq->chroma_quant_param_disable) {
+                wq->chroma_quant_param_delta_cb = get_se_golomb(&h->gb);
+                wq->chroma_quant_param_delta_cr = get_se_golomb(&h->gb);
+            }
+            wq->weighting_quant_param_index = get_bits(&h->gb, 2);
+            wq->weighting_quant_model       = get_bits(&h->gb, 2);
+            if (wq->weighting_quant_param_index == 1) {
+                for (int i = 0; i < 6; i++)
+                    wq->weighting_quant_param_delta1[i] = get_se_golomb(&h->gb);
+            } else if (wq->weighting_quant_param_index == 2) {
+                for (int i = 0; i < 6; i++)
+                    wq->weighting_quant_param_delta2[i] = get_se_golomb(&h->gb);
+            }
+        }
+        h->aec_enable = get_bits1(&h->gb);
+        if (get_bits_left(&h->gb) < 0)
