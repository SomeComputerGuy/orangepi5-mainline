From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 21:51:26 +0000
Subject: [PATCH] media: rkvdec: Let a timed-out core finish its job before
 resetting it

The watchdog of a job fires at twice the hardware timeout of the core.
It can still fire on a core that is decoding: a frame that takes long,
or, with the RK3588 CCU, a core that was waiting for the other core when
that one was reset. rkvdec_core_recover() then soft resets the core
right away. On RK3588 the soft reset resets the IOMMU of the core into
bypass at once (MMU_DTE_ADDR 0, paging disabled), and the bus accesses
the core still makes go out untranslated, to the physical addresses of
their IOVAs. With the watchdog shortened so that it fires while jobs are
still being decoded, on both cores with the CCU, kernel memory got
corrupted right after such a reset of a core that was still busy (a wait
queue entry on a task stack: "list_del corruption. next->prev should be
..., but was 0000000000000020", then an SP/PC alignment exception).

The Rockchip BSP only resets cores that reported the end of their job.
Do the same: remember whether the core reported (any interrupt) since it
was started, and if it didn't, wait up to 100 ms for VDPU381 to report
before resetting it. A core that still doesn't is stuck, and is reset
anyway.

Assisted-by: Claude:claude-opus-5-5
---
 .../media/platform/rockchip/rkvdec/rkvdec.c   | 27 ++++++++++++++++++-
 .../media/platform/rockchip/rkvdec/rkvdec.h   |  2 ++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.c b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
index 47b2d0adfc4f..6ff855454a7b 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
@@ -1271,6 +1271,9 @@ void rkvdec_schedule_watchdog(struct rkvdec_core *core, u32 timeout_threshold)
 	u32 watchdog_time;
 	unsigned long axi_rate = clk_get_rate(core->axi_clk);
 
+	/* The core starts its job right after this. */
+	WRITE_ONCE(core->stopped, false);
+
 	if (axi_rate)
 		watchdog_time = 2 * div_u64(1000 * (u64)timeout_threshold, axi_rate);
 	else
@@ -1634,6 +1637,15 @@ static bool vdpu381_reset(struct rkvdec_core *core)
 				   status & VDPU381_DEBUG_INT_BUS_IDLE, 1, 1000);
 }
 
+/* Waits for a core that is still decoding to report the end of its job. */
+static bool vdpu381_wait_stopped(struct rkvdec_core *core)
+{
+	u32 status;
+
+	return !readl_poll_timeout(core->regs + VDPU381_REG_STA_INT, status,
+				   status, 100, 100 * USEC_PER_MSEC);
+}
+
 static bool vdpu383_reset(struct rkvdec_core *core)
 {
 	writel(FIELD_PREP_WM16(VDPU383_INT_EN_IRQ | VDPU383_INT_EN_LINE_IRQ, 0),
@@ -1655,7 +1667,10 @@ static bool vdpu383_reset(struct rkvdec_core *core)
  * bus transactions, then pulse its reset lines. On RK3588, both the soft
  * reset and the AXI reset line reset the IOMMU of the core too, leaving it
  * in bypass (the core also soft resets itself when its hardware timeout
- * fires). Reprogram the IOMMU last, before the core can be started again.
+ * fires). A core whose watchdog fired while it was still decoding would go
+ * on accessing memory untranslated: as the BSP only resets cores that
+ * reported the end of their job, give it time to do so first. Reprogram the
+ * IOMMU last, before the core can be started again.
  *
  * Must be called with the interrupt of the core masked. Returns false if
  * the core couldn't be stopped or its IOMMU couldn't be programmed: it is
@@ -1667,6 +1682,11 @@ static bool rkvdec_core_recover(struct rkvdec_core *core)
 	bool idle;
 	int ret;
 
+	if (!READ_ONCE(core->stopped) && core->variant->ops->wait_stopped &&
+	    !core->variant->ops->wait_stopped(core))
+		dev_warn(core->dev, "the core is still busy, resetting it anyway\n");
+	WRITE_ONCE(core->stopped, true);
+
 	idle = core->variant->ops->reset(core);
 	if (core->resets) {
 		if (!idle)
@@ -1705,6 +1725,9 @@ static void rkvdec_irq_job_done(struct rkvdec_core *core,
 {
 	struct rkvdec_ctx *ctx;
 
+	/* Whatever the job and its state, the core is done with it. */
+	WRITE_ONCE(core->stopped, true);
+
 	/*
 	 * The watchdog is pending only while the core has a job, and whoever
 	 * cancels it owns the job. Only then take the context: until then, the
@@ -1909,6 +1932,7 @@ static const struct rcb_size_info vdpu381_rcb_sizes[] = {
 static const struct rkvdec_variant_ops vdpu381_variant_ops = {
 	.irq_handler = vdpu381_irq_handler,
 	.reset = vdpu381_reset,
+	.wait_stopped = vdpu381_wait_stopped,
 	.colmv_size = vdpu381_colmv_size,
 	.flatten_matrices = transpose_and_flatten_matrices,
 };
@@ -2036,6 +2060,7 @@ static int rkvdec_core_probe(struct platform_device *pdev)
 
 	core->dev = &pdev->dev;
 	core->variant = variant;
+	core->stopped = true;
 	INIT_DELAYED_WORK(&core->watchdog_work, rkvdec_watchdog_func);
 
 	ret = devm_clk_bulk_get_all_enabled(&pdev->dev, &core->clocks);
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.h b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
index f014d97c8464..d10d57e39a10 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
@@ -77,6 +77,7 @@ struct rkvdec_core;
 struct rkvdec_variant_ops {
 	irqreturn_t (*irq_handler)(struct rkvdec_core *core);
 	bool (*reset)(struct rkvdec_core *core);
+	bool (*wait_stopped)(struct rkvdec_core *core);
 	u32 (*colmv_size)(u16 width, u16 height);
 	void (*flatten_matrices)(u8 *output, const u8 *input, int matrices, int row_length);
 };
@@ -142,6 +143,7 @@ struct rkvdec_core {
 	struct reset_control *resets;
 	int irq;
 	bool broken;
+	bool stopped;
 	struct gen_pool *sram_pool;
 	struct iommu_domain *empty_domain;
 	struct rkvdec_rcb_config *rcb_config;
-- 
2.55.0

