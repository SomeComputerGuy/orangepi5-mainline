From be0f17e0509cc88ce03e723a91790a277957ca20 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 6 Nov 2026 00:44:37 +0000
Subject: [PATCH 2359/2409] media: rockchip: rga: Keep a larger bytesperline of
 userspace

VIDIOC_S_FMT always replaces bytesperline with the smallest stride of the
width. A DMA-BUF of another device, for instance a frame of the Rockchip
video decoder whose stride is aligned to more than the width needs (416
pixels wide NV12 is 448 bytes per line there), then can't be imported:
the RGA reads it with the wrong stride.

Keep a bytesperline of userspace that is larger than the format needs,
aligned to the stride alignment of the core and within the 15-bit word
count of its stride registers. The chroma planes of a single memory
plane follow the luma stride, as the hardware derives them. The RGA3 has
a chroma stride of its own and also keeps a larger one for formats with
separate memory planes, the RGA2 derives it from the luma stride there
too. The size of the planes follows the strides.

The RGA2 worked out the bytes per pixel as the stride divided by the
width, which only holds for the smallest stride: take them from the
format instead.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/platform/rockchip/rga/rga-hw.c  |  9 ++-
 drivers/media/platform/rockchip/rga/rga.c     | 79 +++++++++++++++++++
 drivers/media/platform/rockchip/rga/rga.h     |  4 +
 drivers/media/platform/rockchip/rga/rga3-hw.c |  3 +
 4 files changed, 94 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/rockchip/rga/rga-hw.c b/drivers/media/platform/rockchip/rga/rga-hw.c
index 62e8b2c2b3d3..f4fd54e8983a 100644
--- a/drivers/media/platform/rockchip/rga/rga-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga-hw.c
@@ -46,6 +46,11 @@ rga_get_corner_addrs(struct rga_frame *frm, struct rga_addrs *addrs,
 	unsigned int x_div = 0,
 		     y_div = 0, y_stride = 0, uv_stride = 0, pixel_width = 0;
 
+	/*
+	 * The stride can be larger than the width needs, the bytes per pixel
+	 * come from the format.
+	 */
+
 	lt = &corner_addrs.left_top;
 	lb = &corner_addrs.left_bottom;
 	rt = &corner_addrs.right_top;
@@ -63,7 +68,7 @@ rga_get_corner_addrs(struct rga_frame *frm, struct rga_addrs *addrs,
 	y_div = format_info->vdiv;
 	y_stride = frm->pix.plane_fmt[0].bytesperline;
 	uv_stride = y_stride / x_div;
-	pixel_width = y_stride / frm->pix.width;
+	pixel_width = format_info->bpp[0] / format_info->bpp_div[0];
 
 	lt->y_addr = addrs->y_addr + y * y_stride + x * pixel_width;
 	lt->u_addr = addrs->u_addr + (y / y_div) * uv_stride + x / x_div;
@@ -612,6 +617,8 @@ const struct rga_hw rga2_hw = {
 	.max_dst_height = MAX_DST_HEIGHT,
 	.max_scaling_factor = MAX_SCALING_FACTOR,
 	.stride_alignment = 4,
+	/* the virtual strides are 15-bit word counts */
+	.max_bytesperline = 0x7fff * 4,
 	.features = RGA_FEATURE_FLIP
 		  | RGA_FEATURE_ROTATE
 		  | RGA_FEATURE_BG_COLOR
diff --git a/drivers/media/platform/rockchip/rga/rga.c b/drivers/media/platform/rockchip/rga/rga.c
index 12b5da26624b..32c6fccfd91b 100644
--- a/drivers/media/platform/rockchip/rga/rga.c
+++ b/drivers/media/platform/rockchip/rga/rga.c
@@ -576,6 +576,74 @@ static int vidioc_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
 	return 0;
 }
 
+/*
+ * Keep a bytesperline of userspace that is larger than the format needs, for
+ * instance the stride of a buffer that another device allocated, as long as
+ * the core can address it. The other planes of a single memory plane follow
+ * the luma stride; a core without a chroma stride of its own derives it from
+ * the luma stride for separate memory planes too.
+ */
+static void rga_apply_bytesperline(const struct rga_hw *hw,
+				   struct v4l2_pix_format_mplane *pix_fmt,
+				   const u32 *user_bpl)
+{
+	const struct v4l2_format_info *info;
+	unsigned int i, align, luma;
+	u32 bpl;
+
+	info = v4l2_format_info(pix_fmt->pixelformat);
+	if (!info)
+		return;
+
+	align = hw->stride_alignment;
+	/* a chroma stride derived from luma must stay aligned as well */
+	if (info->comp_planes > 1 &&
+	    (info->mem_planes == 1 || !hw->has_chroma_stride))
+		align *= DIV_ROUND_UP(info->hdiv * info->bpp[0], info->bpp[1]);
+
+	luma = pix_fmt->plane_fmt[0].bytesperline;
+	bpl = ALIGN(user_bpl[0], align);
+	if (bpl > luma && bpl <= hw->max_bytesperline)
+		luma = bpl;
+
+	if (info->mem_planes == 1) {
+		struct v4l2_plane_pix_format *plane = &pix_fmt->plane_fmt[0];
+
+		if (luma == plane->bytesperline)
+			return;
+
+		plane->bytesperline = luma;
+		plane->sizeimage = luma * pix_fmt->height;
+		for (i = 1; i < info->comp_planes; i++)
+			plane->sizeimage += luma * info->bpp[i] /
+					    (info->hdiv * info->bpp[0]) *
+					    DIV_ROUND_UP(pix_fmt->height, info->vdiv);
+		return;
+	}
+
+	for (i = 0; i < info->mem_planes; i++) {
+		struct v4l2_plane_pix_format *plane = &pix_fmt->plane_fmt[i];
+		unsigned int height = pix_fmt->height;
+
+		if (i == 0) {
+			bpl = luma;
+		} else {
+			height = DIV_ROUND_UP(height, info->vdiv);
+			bpl = luma * info->bpp[i] / (info->hdiv * info->bpp[0]);
+			if (hw->has_chroma_stride) {
+				u32 user = ALIGN(user_bpl[i], hw->stride_alignment);
+
+				bpl = plane->bytesperline;
+				if (user > bpl && user <= hw->max_bytesperline)
+					bpl = user;
+			}
+		}
+
+		plane->bytesperline = bpl;
+		plane->sizeimage = bpl * height;
+	}
+}
+
 static int vidioc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
 {
 	struct v4l2_pix_format_mplane *pix_fmt = &f->fmt.pix_mp;
@@ -589,6 +657,9 @@ static int vidioc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
 		.step_width = 1,
 		.step_height = 1,
 	};
+	u32 user_bpl[VIDEO_MAX_PLANES];
+	u32 pixelformat;
+	unsigned int i;
 
 	/*
 	 * Technically 4:2:2 YUV formats don't need a step_height of 2.
@@ -624,11 +695,19 @@ static int vidioc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
 		pix_fmt->xfer_func = frm->pix.xfer_func;
 	}
 
+	for (i = 0; i < VIDEO_MAX_PLANES; i++)
+		user_bpl[i] = i < pix_fmt->num_planes ?
+			      pix_fmt->plane_fmt[i].bytesperline : 0;
+	pixelformat = pix_fmt->pixelformat;
+
 	hw->adjust_and_map_format(ctx, pix_fmt, V4L2_TYPE_IS_OUTPUT(f->type));
 
 	v4l2_apply_frmsize_constraints(&pix_fmt->width, &pix_fmt->height, &frmsize);
 	v4l2_fill_pixfmt_mp_aligned(pix_fmt, pix_fmt->pixelformat,
 				    pix_fmt->width, pix_fmt->height, hw->stride_alignment);
+	/* the strides of another format don't apply */
+	if (pix_fmt->pixelformat == pixelformat)
+		rga_apply_bytesperline(hw, pix_fmt, user_bpl);
 	pix_fmt->field = V4L2_FIELD_NONE;
 
 	return 0;
diff --git a/drivers/media/platform/rockchip/rga/rga.h b/drivers/media/platform/rockchip/rga/rga.h
index 7245941314f8..d550e28c8b56 100644
--- a/drivers/media/platform/rockchip/rga/rga.h
+++ b/drivers/media/platform/rockchip/rga/rga.h
@@ -204,6 +204,10 @@ struct rga_hw {
 	u32 max_dst_width, max_dst_height;
 	u8 max_scaling_factor;
 	u8 stride_alignment;
+	/* Largest bytesperline the core can address */
+	u32 max_bytesperline;
+	/* The chroma plane has a stride of its own, not one derived from luma */
+	bool has_chroma_stride;
 	u8 features;
 
 	/*
diff --git a/drivers/media/platform/rockchip/rga/rga3-hw.c b/drivers/media/platform/rockchip/rga/rga3-hw.c
index f59b7f0ee5c7..77fec0d32699 100644
--- a/drivers/media/platform/rockchip/rga/rga3-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga3-hw.c
@@ -624,6 +624,9 @@ const struct rga_hw rga3_hw = {
 	.max_dst_height = RGA3_MAX_OUTPUT_HEIGHT,
 	.max_scaling_factor = RGA3_MAX_SCALING_FACTOR,
 	.stride_alignment = 16,
+	/* the virtual strides are 15-bit word counts, 16 byte aligned */
+	.max_bytesperline = ALIGN_DOWN(0x7fff * 4, 16),
+	.has_chroma_stride = true,
 	.features = RGA_FEATURE_FLIP | RGA_FEATURE_ROTATE,
 
 	.setup_cmdbuf = rga3_hw_setup_cmdbuf,
-- 
2.55.0

