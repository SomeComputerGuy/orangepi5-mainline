From 2a354b2e4ea37e53689e1d355a21c2d75d00e373 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 08:44:45 +0000
Subject: [PATCH 2355/2409] media: rkvdec: Let VP9 change the frame size of a
 running stream

VP9 can change the frame size on an inter frame, which then predicts
from the references of the previous size (scaled when the sizes
differ). Frames that fit in the CAPTURE buffers are already decoded in
place, but a frame larger than them needs new buffers while the old
ones still hold references. The V4L2 way to do that is to add buffers
of the new size with VIDIOC_CREATE_BUFS and drop the old ones with
VIDIOC_REMOVE_BUFS once they are no longer referenced; GStreamer's
v4l2slvp9dec does so when the driver supports VIDIOC_REMOVE_BUFS. rkvdec
doesn't implement it and refuses a format change while streaming, so
growing inter frames (vp90-2-22-svc_1280x720_3, whose larger spatial
layers predict from the smaller ones) cannot be decoded.

Now that the VDPU381 VP9 back-end addresses each reference with its own
layout, allow formats with a new frame size on both queues while
streaming for the coded formats that support it (VDPU381 VP9 only),
keeping the image format of the stream, and implement
VIDIOC_REMOVE_BUFS. A CAPTURE buffer that is smaller than the current
format is not decoded into.

With VIDIOC_REMOVE_BUFS, userspace no longer frees the CAPTURE queue
with VIDIOC_REQBUFS(0) before setting a new format: it stops the queue
and removes the buffers it doesn't need. So, for every codec, refuse
OUTPUT format and image format changes only while the CAPTURE queue is
streaming, not while it merely has buffers, as hantro does. Buffers
allocated for the previous format keep their layout and are protected
by the size check above.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../rockchip/rkvdec/rkvdec-vdpu381-vp9.c      | 10 ++-
 .../media/platform/rockchip/rkvdec/rkvdec.c   | 75 +++++++++++++------
 .../media/platform/rockchip/rkvdec/rkvdec.h   |  7 ++
 3 files changed, 68 insertions(+), 24 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-vp9.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-vp9.c
index c9f08e255fc6..786e0c8c2609 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-vp9.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-vp9.c
@@ -984,9 +984,17 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	regs->vp9_addr.avp9_segidcur_base = segmap_base +
 		RKVDEC_VP9_MAX_SEGMAP_SIZE * !vp9_ctx->last.segmapid;
 
+	/*
+	 * The previous frame's motion vectors are only used by a frame of the
+	 * same size (use_prev_frame_mvs, see reg75). Don't point the decoder
+	 * at the motion vectors of a frame of another size: they live in a
+	 * buffer laid out (and possibly allocated) for that size.
+	 */
 	if (!intra_only &&
 	    !(dec_params->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) &&
-	    vp9_ctx->last.valid)
+	    vp9_ctx->last.valid &&
+	    vp9_ctx->last.width == vp9_ctx->cur.width &&
+	    vp9_ctx->last.height == vp9_ctx->cur.height)
 		mv_ref = last;
 	else
 		mv_ref = dst;
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.c b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
index 0efe55344ca5..221b521e2c60 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
@@ -212,7 +212,7 @@ static int rkvdec_s_ctrl(struct v4l2_ctrl *ctrl)
 	if (rkvdec_image_fmt_changed(ctx, image_fmt)) {
 		vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
 				     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
-		if (vb2_is_busy(vq))
+		if (vb2_is_streaming(vq))
 			return -EBUSY;
 
 		ctx->image_fmt = image_fmt;
@@ -732,7 +732,7 @@ static const struct rkvdec_coded_fmt_desc vdpu381_coded_fmts[] = {
 		.ops = &rkvdec_vdpu381_vp9_fmt_ops,
 		.num_decoded_fmts = ARRAY_SIZE(rkvdec_vdpu381_vp9_decoded_fmts),
 		.decoded_fmts = rkvdec_vdpu381_vp9_decoded_fmts,
-		.flags = RKVDEC_FMT_FLAG_PIPELINE,
+		.flags = RKVDEC_FMT_FLAG_PIPELINE | RKVDEC_FMT_FLAG_RES_CHANGE,
 	},
 	{
 		.fourcc = V4L2_PIX_FMT_AVS2_FRAME,
@@ -938,16 +938,23 @@ static int rkvdec_s_capture_fmt(struct file *file, void *priv,
 	struct vb2_queue *vq;
 	int ret;
 
-	/* Change not allowed if queue is busy */
-	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
-			     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
-	if (vb2_is_busy(vq))
-		return -EBUSY;
-
 	ret = rkvdec_try_capture_fmt(file, priv, f);
 	if (ret)
 		return ret;
 
+	/*
+	 * Change not allowed while streaming, except for a new frame size
+	 * when the codec supports it. Buffers allocated with another format
+	 * keep their layout: they can be removed with VIDIOC_REMOVE_BUFS, and
+	 * one too small for the new format isn't decoded into.
+	 */
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+			     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (vb2_is_streaming(vq) &&
+	    (!(ctx->coded_fmt_desc->flags & RKVDEC_FMT_FLAG_RES_CHANGE) ||
+	     f->fmt.pix_mp.pixelformat != ctx->decoded_fmt.fmt.pix_mp.pixelformat))
+		return -EBUSY;
+
 	ctx->decoded_fmt = *f;
 	rkvdec_update_colmv_offset(ctx);
 	return 0;
@@ -961,26 +968,29 @@ static int rkvdec_s_output_fmt(struct file *file, void *priv,
 	const struct rkvdec_coded_fmt_desc *desc;
 	struct v4l2_format *cap_fmt;
 	struct vb2_queue *peer_vq, *vq;
+	bool res_change;
 	int ret;
 
 	/*
 	 * In order to support dynamic resolution change, the decoder admits
 	 * a resolution change, as long as the pixelformat remains. Can't be
-	 * done if streaming.
+	 * done if streaming, unless the codec supports changing the frame
+	 * size of a running stream.
 	 */
 	vq = v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
-	if (vb2_is_streaming(vq) ||
-	    (vb2_is_busy(vq) &&
-	     f->fmt.pix_mp.pixelformat != ctx->coded_fmt.fmt.pix_mp.pixelformat))
+	peer_vq = v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (vb2_is_busy(vq) &&
+	    f->fmt.pix_mp.pixelformat != ctx->coded_fmt.fmt.pix_mp.pixelformat)
 		return -EBUSY;
 
 	/*
-	 * Since format change on the OUTPUT queue will reset the CAPTURE
-	 * queue, we can't allow doing so when the CAPTURE queue has buffers
-	 * allocated.
+	 * A format change on the OUTPUT queue resets the CAPTURE format:
+	 * not allowed while streaming, unless the codec supports a new frame
+	 * size in a running stream. CAPTURE buffers that are only allocated
+	 * keep their layout (see rkvdec_s_capture_fmt()).
 	 */
-	peer_vq = v4l2_m2m_get_vq(m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
-	if (vb2_is_busy(peer_vq))
+	res_change = vb2_is_streaming(vq) || vb2_is_streaming(peer_vq);
+	if (res_change && !(ctx->coded_fmt_desc->flags & RKVDEC_FMT_FLAG_RES_CHANGE))
 		return -EBUSY;
 
 	ret = rkvdec_try_output_fmt(file, priv, f);
@@ -1002,14 +1012,20 @@ static int rkvdec_s_output_fmt(struct file *file, void *priv,
 	 *
 	 * Note that this will propagates any size changes to the decoded format.
 	 */
-	ctx->image_fmt = RKVDEC_IMG_FMT_ANY;
+	if (!res_change) {
+		ctx->image_fmt = RKVDEC_IMG_FMT_ANY;
 
-	/* VP9 bit depth is per-frame, not up-front like HEVC's SPS;
-	 * default to 8-bit/NV12 until get_image_fmt() switches it.
-	 */
-	if (desc->fourcc == V4L2_PIX_FMT_VP9_FRAME)
-		ctx->image_fmt = RKVDEC_IMG_FMT_420_8BIT;
+		/* VP9 bit depth is per-frame, not up-front like HEVC's SPS;
+		 * default to 8-bit/NV12 until get_image_fmt() switches it.
+		 */
+		if (desc->fourcc == V4L2_PIX_FMT_VP9_FRAME)
+			ctx->image_fmt = RKVDEC_IMG_FMT_420_8BIT;
+	}
 
+	/*
+	 * A frame size change of a running stream keeps the image format
+	 * (bit depth, chroma subsampling) of the stream.
+	 */
 	rkvdec_reset_decoded_fmt(ctx);
 
 	/* Propagate colorspace information to capture. */
@@ -1090,6 +1106,7 @@ static const struct v4l2_ioctl_ops rkvdec_ioctl_ops = {
 	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
 	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
 	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_remove_bufs = v4l2_m2m_ioctl_remove_bufs,
 	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
 
 	.vidioc_subscribe_event = v4l2_ctrl_subscribe_event,
@@ -1892,6 +1909,18 @@ static void rkvdec_device_run(void *priv)
 
 	rkvdec_core_reset_cache(core);
 
+	/*
+	 * CAPTURE buffers allocated for an earlier format stay in the queue
+	 * until they are removed: don't decode into one that is too small.
+	 */
+	if (vb2_plane_size(&job->dst->vb2_buf, 0) <
+	    ctx->decoded_fmt.fmt.pix_mp.plane_fmt[0].sizeimage) {
+		dev_err_ratelimited(core->dev, "CAPTURE buffer too small for %ux%u\n",
+				    ctx->decoded_fmt.fmt.pix_mp.width,
+				    ctx->decoded_fmt.fmt.pix_mp.height);
+		goto err;
+	}
+
 	if (!rkvdec_rcb_buf_validate_size(ctx)) {
 		rkvdec_free_rcb(ctx->dev, core);
 
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.h b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
index c0a4ff39b5b6..4f2558332271 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
@@ -144,6 +144,13 @@ struct rkvdec_decoded_fmt_desc {
  */
 #define RKVDEC_FMT_FLAG_PIPELINE	BIT(0)
 
+/*
+ * The back-end decodes with references of another size and stores the layout
+ * of each frame with it: the frame size can change while streaming
+ * (VIDIOC_REMOVE_BUFS / VIDIOC_CREATE_BUFS).
+ */
+#define RKVDEC_FMT_FLAG_RES_CHANGE	BIT(1)
+
 struct rkvdec_coded_fmt_desc {
 	u32 fourcc;
 	struct v4l2_frmsize_stepwise frmsize;
-- 
2.55.0

