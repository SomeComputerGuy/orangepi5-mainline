From 8dcdd29f6083b48193c2aea0d276edfd801e9e40 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 31 Oct 2026 07:52:43 +0000
Subject: [PATCH 3/3] drm/bridge: synopsys: dw-dp: Re-detect when a branch's
 downstream port changes

A DP branch device (dock, adapter) stays connected while monitors are
plugged into or unplugged from its downstream port. It reports this with
a short HPD pulse, setting DOWNSTREAM_PORT_STATUS_CHANGED and updating
SINK_COUNT. dw-dp treats every short pulse as a link-status check only,
so the connector stays "connected" with a stale EDID after the monitor
is unplugged from the dock, and plugging one in is never noticed.

On a short pulse from a branch device, check those two fields and run a
full hotplug detection when either changed, like i915 does for
SINK_COUNT changes. Detection already reports a branch with
SINK_COUNT == 0 as disconnected.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/bridge/synopsys/dw-dp.c | 28 +++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-dp.c b/drivers/gpu/drm/bridge/synopsys/dw-dp.c
index 4164f08..646ea41 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-dp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-dp.c
@@ -2511,6 +2511,29 @@ static int dw_dp_link_retrain(struct dw_dp *dp)
 	return ret;
 }
 
+/*
+ * A branch device signals a change on its downstream side (e.g. a monitor
+ * plugged into or unplugged from a dock) with a short HPD pulse, setting
+ * DOWNSTREAM_PORT_STATUS_CHANGED and updating SINK_COUNT.
+ */
+static bool dw_dp_downstream_changed(struct dw_dp *dp)
+{
+	struct dw_dp_link *link = &dp->link;
+	u8 status;
+	int ret;
+
+	if (!drm_dp_is_branch(link->dpcd))
+		return false;
+
+	ret = drm_dp_dpcd_read_byte(&dp->aux, DP_LANE_ALIGN_STATUS_UPDATED, &status);
+	if (ret == 0 && (status & DP_DOWNSTREAM_PORT_STATUS_CHANGED))
+		return true;
+
+	ret = drm_dp_read_sink_count(&dp->aux);
+
+	return ret >= 0 && ret != link->sink_count;
+}
+
 static void dw_dp_hpd_work(struct work_struct *work)
 {
 	struct dw_dp *dp = container_of(work, struct dw_dp, hpd_work);
@@ -2528,6 +2551,11 @@ static void dw_dp_hpd_work(struct work_struct *work)
 
 	dev_dbg(dp->dev, "[drm] Get hpd irq - %s\n", long_hpd ? "long" : "short");
 
+	if (!long_hpd && dw_dp_downstream_changed(dp)) {
+		dev_dbg(dp->dev, "Downstream port status changed\n");
+		long_hpd = true;
+	}
+
 	if (!long_hpd) {
 		if (dw_dp_needs_link_retrain(dp)) {
 			ret = dw_dp_link_retrain(dp);
-- 
