From 25cdad1bfc09a982bfefa3f8992f667eaa9438f4 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 10 Nov 2026 01:16:53 +0000
Subject: [PATCH 2368/2409] media: uapi: mpeg4: add the low_delay flag to the
 VOL control

Some decoders cannot decode every B-VOP: Cedrus wraps the vertical field
motion vectors of interlaced B-VOPs to half their range. Such a driver
can only refuse those pictures when their VOP control arrives, after
decoding has started, while userspace has to choose between hardware
and software decoding when it sees the VOL.

Pass the low_delay syntax element of the VOL, which tells whether the
VOL can contain B-VOPs, as V4L2_MPEG4_VOL_FLAG_LOW_DELAY, so that a
driver can refuse the VOL control already, when userspace tries it.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../userspace-api/media/v4l/ext-ctrls-codec-stateless.rst   | 6 ++++++
 drivers/media/v4l2-core/v4l2-ctrls-core.c                   | 3 ++-
 include/uapi/linux/v4l2-controls.h                          | 1 +
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/Documentation/userspace-api/media/v4l/ext-ctrls-codec-stateless.rst b/Documentation/userspace-api/media/v4l/ext-ctrls-codec-stateless.rst
index 4becc67cfddd..df4427f982b1 100644
--- a/Documentation/userspace-api/media/v4l/ext-ctrls-codec-stateless.rst
+++ b/Documentation/userspace-api/media/v4l/ext-ctrls-codec-stateless.rst
@@ -4986,6 +4986,12 @@ AV1 Tx mode as described in section 6.8.21 "TX mode semantics" of :ref:`av1`.
     * - ``V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC``
       - 0x00000020
       - ``reversible_vlc`` syntax element.
+    * - ``V4L2_MPEG4_VOL_FLAG_LOW_DELAY``
+      - 0x00000040
+      - ``low_delay`` syntax element, or the value inferred for it when
+	``vol_control_parameters`` is 0: the VOL contains no B-VOPs. Drivers
+	which cannot decode some B-VOPs can refuse a VOL without this flag, so
+	that userspace finds out before decoding starts.
 
 ``V4L2_CID_STATELESS_MPEG4_VOP (struct)``
     Specifies the video object plane parameters (as extracted from the
diff --git a/drivers/media/v4l2-core/v4l2-ctrls-core.c b/drivers/media/v4l2-core/v4l2-ctrls-core.c
index 309593e4becd..9deb46fee3c4 100644
--- a/drivers/media/v4l2-core/v4l2-ctrls-core.c
+++ b/drivers/media/v4l2-core/v4l2-ctrls-core.c
@@ -1183,7 +1183,8 @@ static int validate_mpeg4_vol(struct v4l2_ctrl_mpeg4_vol *vol)
 			   V4L2_MPEG4_VOL_FLAG_QUARTER_SAMPLE |
 			   V4L2_MPEG4_VOL_FLAG_RESYNC_MARKER_DISABLE |
 			   V4L2_MPEG4_VOL_FLAG_DATA_PARTITIONED |
-			   V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC))
+			   V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC |
+			   V4L2_MPEG4_VOL_FLAG_LOW_DELAY))
 		return -EINVAL;
 
 	/* Reversible VLCs are only used with data partitioning. */
diff --git a/include/uapi/linux/v4l2-controls.h b/include/uapi/linux/v4l2-controls.h
index 278c6aadf154..95acbc7536bd 100644
--- a/include/uapi/linux/v4l2-controls.h
+++ b/include/uapi/linux/v4l2-controls.h
@@ -3844,6 +3844,7 @@ struct v4l2_ctrl_av1_film_grain {
 #define V4L2_MPEG4_VOL_FLAG_RESYNC_MARKER_DISABLE	0x08
 #define V4L2_MPEG4_VOL_FLAG_DATA_PARTITIONED		0x10
 #define V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC		0x20
+#define V4L2_MPEG4_VOL_FLAG_LOW_DELAY			0x40
 
 #define V4L2_MPEG4_SPRITE_ENABLE_NONE			0
 #define V4L2_MPEG4_SPRITE_ENABLE_GMC			2
-- 
