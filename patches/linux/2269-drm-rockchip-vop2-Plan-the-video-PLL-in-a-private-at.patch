 drivers/gpu/drm/rockchip/rockchip_drm_drv.h  |  17 +-
 drivers/gpu/drm/rockchip/rockchip_drm_fb.c   |  24 +-
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.c | 825 +++++++++++--------
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.h |  74 +-
 drivers/gpu/drm/rockchip/rockchip_vop2_reg.c |   4 +
 5 files changed, 572 insertions(+), 372 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_drv.h b/drivers/gpu/drm/rockchip/rockchip_drm_drv.h
index 7bf9a8262258..f2af4ea97b5f 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_drv.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_drv.h
@@ -60,7 +60,12 @@ struct rockchip_crtc_state {
 	/* RGB output in the limited quantization range (16-235 for 8 bpc) */
 	bool rgb_limited_range;
 	bool frl_enabled;
-	/* VOP2: rate to program into the dedicated video PLL for the DCLK, 0 if none */
+	/*
+	 * VOP2: CRU parent of the DCLK (enum vop2_dclk_parent + 1, 0 if the
+	 * DCLK doesn't come from a CRU parent chosen by atomic_check), and the
+	 * video PLL rate if that is the parent
+	 */
+	unsigned int dclk_parent;
 	unsigned long dclk_pll_rate;
 };
 #define to_rockchip_crtc_state(s) \
@@ -108,6 +113,16 @@ extern struct platform_driver vop_platform_driver;
 extern struct platform_driver rk3066_hdmi_driver;
 extern struct platform_driver vop2_platform_driver;
 
+#if IS_ENABLED(CONFIG_ROCKCHIP_VOP2)
+int vop2_atomic_check(struct drm_device *drm, struct drm_atomic_commit *state);
+#else
+static inline int vop2_atomic_check(struct drm_device *drm,
+				    struct drm_atomic_commit *state)
+{
+	return 0;
+}
+#endif
+
 static inline struct rockchip_encoder *to_rockchip_encoder(struct drm_encoder *encoder)
 {
 	return container_of(encoder, struct rockchip_encoder, encoder);
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_fb.c b/drivers/gpu/drm/rockchip/rockchip_drm_fb.c
index 45588b79b3d4..fb027b077dcc 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_fb.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_fb.c
@@ -59,9 +59,31 @@ rockchip_fb_create(struct drm_device *dev, struct drm_file *file,
 	return &afbc_fb->base;
 }
 
+/*
+ * VOP2 adds CRTCs to the state whose DCLK source changes with it, which then
+ * need the whole check as well.
+ */
+static int rockchip_drm_atomic_check(struct drm_device *dev,
+				     struct drm_atomic_commit *state)
+{
+	int i, ret;
+
+	for (i = 0; i <= ROCKCHIP_MAX_CRTC; i++) {
+		ret = drm_atomic_helper_check(dev, state);
+		if (ret)
+			return ret;
+
+		ret = vop2_atomic_check(dev, state);
+		if (ret <= 0)
+			return ret;
+	}
+
+	return -EINVAL;
+}
+
 static const struct drm_mode_config_funcs rockchip_drm_mode_config_funcs = {
 	.fb_create = rockchip_fb_create,
-	.atomic_check = drm_atomic_helper_check,
+	.atomic_check = rockchip_drm_atomic_check,
 	.atomic_commit = drm_atomic_helper_commit,
 };
 
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
index 990ea11f3e37..7d06092aad97 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -22,6 +22,7 @@
 
 #include <drm/drm.h>
