 			.step_height = MB_DIM,
 		},
 	},
+	{
+		/* 4:0:0 H.264: the decoder writes no chroma plane */
+		.fourcc = V4L2_PIX_FMT_GREY,
+		.codec_mode = HANTRO_MODE_NONE,
+		.monochrome = true,
