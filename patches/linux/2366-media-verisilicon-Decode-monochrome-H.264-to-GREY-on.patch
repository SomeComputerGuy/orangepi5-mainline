+	},
 	{
 		.fourcc = V4L2_PIX_FMT_H264_SLICE,
 		.codec_mode = HANTRO_MODE_H264_DEC,
@@ -394,6 +436,20 @@ static const struct hantro_fmt rk3588_vpu121_avsd_dec_fmts[] = {
 			.step_height = MB_DIM,
