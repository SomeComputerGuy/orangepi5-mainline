From afd1b4207b7fc20058459251286dd7b1758d8ae2 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 10 Nov 2026 01:14:29 +0000
Subject: [PATCH 2367/2409] media: verisilicon: rockchip: vpu2: size the
 decoded frames of 16CIF H.263

The VDPU2 H.263 coded format allows the 1152 lines of 16CIF, but the
NV12 decoded format still has the 1088 line limit, and its frame size
limits clamp the CAPTURE format and the reference frame format. A 16CIF
picture so got a 1408x1088 buffer and the decoder wrote its last 64
lines past the end of it (IOMMU write faults, corrupted pictures).

Allow 1152 lines for NV12 too. The CAPTURE size still follows the OUTPUT
one, so the other coded formats keep their 1088 line limit.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/platform/verisilicon/rockchip_vpu_hw.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
index 0666bc671cd9..a6aedec6d240 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
@@ -307,7 +307,7 @@ static const struct hantro_fmt rockchip_vdpu2_dec_fmts[] = {
 			.max_width = FMT_FHD_WIDTH,
 			.step_width = MB_DIM,
 			.min_height = FMT_MIN_HEIGHT,
-			.max_height = FMT_FHD_HEIGHT,
+			.max_height = FMT_16CIF_HEIGHT,
 			.step_height = MB_DIM,
 		},
 	},
@@ -432,7 +432,7 @@ static const struct hantro_fmt rk3588_vpu121_avsd_dec_fmts[] = {
 			.max_width = FMT_FHD_WIDTH,
 			.step_width = MB_DIM,
 			.min_height = FMT_MIN_HEIGHT,
-			.max_height = FMT_FHD_HEIGHT,
+			.max_height = FMT_16CIF_HEIGHT,
 			.step_height = MB_DIM,
 		},
 	},
@@ -565,7 +565,7 @@ static const struct hantro_fmt rk3399_vpu_dec_fmts[] = {
 			.max_width = FMT_FHD_WIDTH,
 			.step_width = MB_DIM,
 			.min_height = FMT_MIN_HEIGHT,
-			.max_height = FMT_FHD_HEIGHT,
+			.max_height = FMT_16CIF_HEIGHT,
 			.step_height = MB_DIM,
 		},
 	},
