From 3b83ee89f3454b02d7a46bc26ba68057f54c465e Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Wed, 8 Apr 2026 00:23:35 +0300
Subject: [PATCH] drm/rockchip: vop2: Scale ACLK rate up for RK3588 FRL display
 modes

At the default 500 MHz clock rate, the VOP2 AXI bus on RK3588 cannot
sustain the memory bandwidth required by high-resolution FRL modes (e.g.
4K@120Hz), leading to rendering artifacts and POST_BUF_EMPTY interrupt
errors.

Increase the ACLK_VOP rate from 500 MHz to 750 MHz when any video port
enters HDMI 2.1 FRL mode, and restore it to 500 MHz when the last FRL
video port is disabled.

In order for the FRL link state to be propagated from the HDMI encoder
into rockchip_crtc_state, introduce a new frl_enabled flag, and use a
reference counter (frl_vp_count) in struct vop2 to track how many video
ports are driving FRL outputs, so the rate boost is applied for the
first FRL VP and removed only after the last one goes idle.

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Link: https://gitlab.collabora.com/hardware-enablement/rockchip-3588/linux/-/commit/331a638a33ae3f0515669ff9bdad26f7c382aa76
---
 drivers/gpu/drm/rockchip/rockchip_drm_drv.h  |  1 +
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.c | 20 ++++++++++++++++++++
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.h |  1 +
 3 files changed, 22 insertions(+)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_drv.h b/drivers/gpu/drm/rockchip/rockchip_drm_drv.h
index 4705dc6b8..49fb5064c 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_drv.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_drv.h
@@ -57,6 +57,7 @@ struct rockchip_crtc_state {
 	u32 bus_format;
 	u32 bus_flags;
 	int color_space;
+	bool frl_enabled;
 };
 #define to_rockchip_crtc_state(s) \
 		container_of(s, struct rockchip_crtc_state, base)
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
index 4cce3e336..2704c0b05 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -103,6 +103,8 @@ enum vop2_afbc_format {
 };
 
 #define VOP2_MAX_DCLK_RATE		600000000UL
+#define VOP2_ACLK_RATE_DEFAULT		500000000UL
+#define VOP2_ACLK_RATE_FRL		750000000UL
 
 /*
  * bus-format types.
@@ -1048,6 +1050,17 @@ static void vop2_crtc_atomic_disable(struct drm_crtc *crtc,
 
 	clk_disable_unprepare(vp->dclk);
 
+	if (vop2->version == VOP_VERSION_RK3588) {
+		struct rockchip_crtc_state *vcstate = to_rockchip_crtc_state(old_crtc_state);
+
+		if (vcstate->frl_enabled) {
+			vop2->frl_vp_count--;
+
+			if (!vop2->frl_vp_count)
+				clk_set_rate(vop2->aclk, VOP2_ACLK_RATE_DEFAULT);
+		}
+	}
+
 	vop2->enable_count--;
 
 	if (!vop2->enable_count)
@@ -1793,6 +1806,13 @@ static void vop2_crtc_atomic_enable(struct drm_crtc *crtc,
 
 	vop2->enable_count++;
 
+	if (vop2->version == VOP_VERSION_RK3588 && vcstate->frl_enabled) {
+		if (!vop2->frl_vp_count)
+			clk_set_rate(vop2->aclk, VOP2_ACLK_RATE_FRL);
+
+		vop2->frl_vp_count++;
+	}
+
 	vcstate->yuv_overlay = is_yuv_output(vcstate->bus_format);
 
 	vop2_crtc_enable_irq(vp, VP_INT_POST_BUF_EMPTY);
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
index ffcb39c13..994609233 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
@@ -324,6 +324,7 @@ struct vop2 {
 	 * we need a ref counter here.
 	 */
 	unsigned int enable_count;
+	unsigned int frl_vp_count;
 	struct clk *hclk;
 	struct clk *aclk;
 	struct clk *pclk;
