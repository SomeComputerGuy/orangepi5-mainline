From ce09ebbba553e60862a264dd5661fa6db9d414d6 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 7 Nov 2026 20:44:21 +0000
Subject: [PATCH 2333/2409] drm/rockchip: vop2: Re-stretch VRR frames after
 commits without event

The VRR front porch is stretched again from the frame start interrupt.
That interrupt is only enabled while someone holds a vblank reference,
which a commit with an event does, but a commit without one (a legacy
cursor update, for instance) does not. After such a commit the video
port would keep running at the base vtotal, the highest refresh rate,
until the next commit with an event.

Take and drop a vblank reference for event-less commits while VRR is
active, so the interrupt stays on for the vblank off delay.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
index 8a1a53c3f600..022e79bd2bd8 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -3569,6 +3569,16 @@ static void vop2_crtc_atomic_flush(struct drm_crtc *crtc,
 		}
 
 		crtc->state->event = NULL;
+	} else if (vp->vrr_active) {
+		/*
+		 * A commit without an event (e.g. a legacy cursor update) holds
+		 * no vblank reference, so the frame start interrupt may be off
+		 * and the next frame would not be stretched again. Take and drop
+		 * a reference: it keeps the interrupt on for the vblank off
+		 * delay, and the last frame start in that time leaves max_vtotal.
+		 */
+		if (!drm_crtc_vblank_get(crtc))
+			drm_crtc_vblank_put(crtc);
 	}
 
 	spin_unlock_irq(&crtc->dev->event_lock);
-- 
