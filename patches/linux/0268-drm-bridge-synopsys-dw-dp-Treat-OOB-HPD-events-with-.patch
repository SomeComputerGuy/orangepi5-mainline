From 86cc5bb81aadacee70a217c18f68290d8040f195 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 22:17:26 +0000
Subject: [PATCH 2/3] drm/bridge: synopsys: dw-dp: Treat OOB HPD events with
 HPD high as IRQ_HPD

With USB-C DisplayPort Alt Mode the HPD signal reaches the controller
through dw_dp_bridge_oob_notify(), which only forces the HPD level. The
controller then reports plug and unplug edges, but an out-of-band event
that keeps HPD asserted is dropped: neither an Attention carrying IRQ_HPD
nor a reconfiguration of the lanes produces an HPD interrupt.

As a result the link is never retrained when the sink loses it. Writing
a new pin assignment to the Type-C altmode sysfs attribute reinitializes
the USBDP PHY, and the sink then reports CR/EQ lost on all lanes (DPCD
0x202 = 0x00) and keeps sending Attention with IRQ_HPD, while the screen
stays black until userspace does a full modeset.

Handle an OOB event that keeps HPD asserted like an HPD short pulse:
queue the HPD work with long_hpd cleared (unless a long pulse is already
pending), which checks the link status and retrains the link. Base that
check on the link being enabled rather than on the last training having
succeeded, so that a retrain that failed (for example while the sink was
still settling) is retried on the next IRQ_HPD.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/bridge/synopsys/dw-dp.c | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-dp.c b/drivers/gpu/drm/bridge/synopsys/dw-dp.c
index df149c52f..5b7490a2a 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-dp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-dp.c
@@ -1670,7 +1670,12 @@ static bool dw_dp_needs_link_retrain(struct dw_dp *dp)
 	struct dw_dp_link *link = &dp->link;
 	u8 link_status[DP_LINK_STATUS_SIZE];
 
-	if (!dw_dp_link_train_valid(&link->train))
+	/*
+	 * Check the link whenever it is enabled, not only after a successful
+	 * training: a retrain attempted while the sink was not ready clears
+	 * the training state, and a later IRQ_HPD must still retry.
+	 */
+	if (!link->enabled)
 		return false;
 
 	if (drm_dp_dpcd_read_link_status(&dp->aux, link_status) < 0)
@@ -2299,6 +2304,7 @@ static void dw_dp_bridge_oob_notify(struct drm_bridge *bridge,
 {
 	bool hpd_high = status != connector_status_disconnected;
 	struct dw_dp *dp = bridge_to_dp(bridge);
+	bool was_high = dp->usbc_hpd;
 	int ret;
 
 	dp->usbc_hpd = hpd_high;
@@ -2312,6 +2318,22 @@ static void dw_dp_bridge_oob_notify(struct drm_bridge *bridge,
 		dp->plat_data.hpd_sw_cfg(dp->plat_data.data, hpd_high);
 	else
 		dev_err_once(dp->dev, "Missing platform handler for OOB HPD handling\n");
+
+	/*
+	 * Forcing the HPD level only lets the controller see plug and unplug
+	 * edges. An out-of-band event that keeps HPD asserted (a DP Alt Mode
+	 * Attention with IRQ_HPD, or a new pin assignment, which reinitializes
+	 * the PHY) is the equivalent of an HPD short pulse: the sink may have
+	 * lost the link, so check the link status and retrain if needed.
+	 * Don't override a pending long pulse.
+	 */
+	if (hpd_high && was_high) {
+		mutex_lock(&dp->irq_lock);
+		if (!work_pending(&dp->hpd_work))
+			dp->hotplug.long_hpd = false;
+		mutex_unlock(&dp->irq_lock);
+		schedule_work(&dp->hpd_work);
+	}
 }
 
 static const struct drm_bridge_funcs dw_dp_bridge_funcs = {
