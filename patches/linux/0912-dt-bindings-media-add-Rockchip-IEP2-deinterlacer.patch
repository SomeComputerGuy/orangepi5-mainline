From b25dd081720222be9409ed02e4d7cc188706dc44 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 12:33:04 +0000
Subject: [PATCH] dt-bindings: media: add Rockchip IEP2 deinterlacer

Add a binding for the IEP2 (image enhancement processor, version 2)
found in the RK3568 and RK3588 SoCs. It is a memory to memory
deinterlacer behind its own IOMMU, with which it shares its interrupt
line. The RK3588 block is register compatible with the RK3568 one.

The clock and reset names follow the Rockchip RGA binding.

Assisted-by: Claude:claude-opus-5-5
---
 .../bindings/media/rockchip,rk3568-iep.yaml   | 98 +++++++++++++++++++
 1 file changed, 98 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/rockchip,rk3568-iep.yaml

diff --git a/Documentation/devicetree/bindings/media/rockchip,rk3568-iep.yaml b/Documentation/devicetree/bindings/media/rockchip,rk3568-iep.yaml
new file mode 100644
index 000000000..c38925f42
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rk3568-iep.yaml
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rk3568-iep.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip IEP2 image enhancement processor
+
+maintainers:
+  - Arun Iyengar <aiyengar1990@gmail.com>
+
+description:
+  The IEP2 (image enhancement processor, version 2) found in the Rockchip
+  RK3568 and RK3588 SoCs is a memory to memory video deinterlacer. It
+  supports intra-field and motion-adaptive, motion-compensated
+  deinterlacing of YUV 4:2:0 and 4:2:2 semi-planar frames. It is connected
+  to its own IOMMU, with which it shares its interrupt line.
+
+properties:
+  compatible:
+    oneOf:
+      - const: rockchip,rk3568-iep
+      - items:
+          - const: rockchip,rk3588-iep
+          - const: rockchip,rk3568-iep
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: AXI bus clock
+      - description: AHB bus clock
+      - description: Core clock
+
+  clock-names:
+    items:
+      - const: aclk
+      - const: hclk
+      - const: sclk
+
+  resets:
+    items:
+      - description: AXI reset
+      - description: AHB reset
+      - description: Core reset
+
+  reset-names:
+    items:
+      - const: axi
+      - const: ahb
+      - const: core
+
+  power-domains:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - power-domains
+  - iommus
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rockchip,rk3588-cru.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/rk3588-power.h>
+    #include <dt-bindings/reset/rockchip,rk3588-cru.h>
+
+    bus {
+      #address-cells = <2>;
+      #size-cells = <2>;
+
+      deinterlace@fdbb0000 {
+        compatible = "rockchip,rk3588-iep", "rockchip,rk3568-iep";
+        reg = <0x0 0xfdbb0000 0x0 0x500>;
+        interrupts = <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cru ACLK_IEP2P0>, <&cru HCLK_IEP2P0>,
+                 <&cru CLK_IEP2P0_CORE>;
+        clock-names = "aclk", "hclk", "sclk";
+        resets = <&cru SRST_A_IEP2P0>, <&cru SRST_H_IEP2P0>,
+                 <&cru SRST_IEP2P0_CORE>;
+        reset-names = "axi", "ahb", "core";
+        power-domains = <&power RK3588_PD_VDPU>;
+        iommus = <&iep_mmu>;
+      };
+    };
