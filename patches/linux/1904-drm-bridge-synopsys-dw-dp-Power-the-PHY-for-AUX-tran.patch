From 78f25e82c6fbb7045567f91f56b8718bca3588b6 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sun, 1 Nov 2026 06:02:29 +0000
Subject: [PATCH 04/33] drm/bridge: synopsys: dw-dp: Power the PHY for AUX
 transfers

The AUX channel goes through the PHY, and dw-dp powers the PHY only for
an enabled link, during detection and while reading the EDID. AUX
transfers made at any other time go out with the PHY powered off and
cannot get a reply:

 - the short HPD pulse handler reads DOWNSTREAM_PORT_STATUS_CHANGED and
   SINK_COUNT, and the CEC IRQ vector, also while the link is disabled
   (display off, or before the first modeset). A DP-to-HDMI protocol
   converter behind a USB-C dock sends such IRQ_HPDs periodically;
 - CEC-Tunneling-over-AUX transmits come from the CEC framework;
 - the AUX character device (/dev/drm_dp_auxN) used by e.g. fwupd.

drm_dp_aux.transfer() is documented to power up whatever it needs for
the transfer. Take a PHY power reference in dw_dp_aux_transfer(), like
i915 takes the AUX power domain for each transfer. phy_power_on() only
counts a reference when the PHY is already powered, so this costs
nothing on an enabled link or inside detection.

Power the PHY once around the short pulse handling too, as detection
does, so that its DPCD accesses don't power the PHY up and down each
time, and skip it if HPD is already low again: the unplug event follows.

Fixes: 86eecc3a9c2e ("drm/bridge: synopsys: Add DW DPTX Controller support library")
(cherry picked from commit af91bbbc8ceac8b993a9115187f7c674e87bf158)

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-dp.c | 108 ++++++++++++++++--------
 1 file changed, 73 insertions(+), 35 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-dp.c b/drivers/gpu/drm/bridge/synopsys/dw-dp.c
index b78a71beeb27..c48b94d23537 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-dp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-dp.c
@@ -1579,34 +1579,12 @@ static int dw_dp_aux_read_data(struct dw_dp *dp, u8 *buffer, size_t size)
 	return size;
 }
 
-static ssize_t dw_dp_aux_transfer(struct drm_dp_aux *aux,
-				  struct drm_dp_aux_msg *msg)
+static ssize_t dw_dp_aux_xfer(struct dw_dp *dp, struct drm_dp_aux_msg *msg)
 {
-	struct dw_dp *dp = container_of(aux, struct dw_dp, aux);
 	unsigned long timeout = msecs_to_jiffies(10);
 	u32 status, value;
 	ssize_t ret = 0;
 
-	if (WARN_ON(msg->size > 16))
-		return -E2BIG;
-
-	PM_RUNTIME_ACQUIRE_AUTOSUSPEND(dp->dev, pm);
-	ret = PM_RUNTIME_ACQUIRE_ERR(&pm);
-	if (ret)
-		return ret;
-
-	/*
-	 * The controller does not run an AUX transaction while its HPD state
-	 * machine reports the sink as unplugged: there is no reply event and
-	 * the transfer would only end with the software timeout. A source
-	 * must not start AUX transactions while HPD is deasserted anyway, so
-	 * fail right away. This happens e.g. when a branch device drops HPD
-	 * while a short pulse is being handled, or while the state machine is
-	 * still debouncing HPD after the controller has been (re)initialized.
-	 */
-	if (!dw_dp_hpd_detect(dp))
-		return -ENXIO;
-
 	reinit_completion(&dp->complete);
 
 	switch (msg->request & ~DP_AUX_I2C_MOT) {
@@ -1666,6 +1644,50 @@ static ssize_t dw_dp_aux_transfer(struct drm_dp_aux *aux,
 	return ret;
 }
 
+static ssize_t dw_dp_aux_transfer(struct drm_dp_aux *aux,
+				  struct drm_dp_aux_msg *msg)
+{
+	struct dw_dp *dp = container_of(aux, struct dw_dp, aux);
+	ssize_t ret;
+
+	if (WARN_ON(msg->size > 16))
+		return -E2BIG;
+
+	PM_RUNTIME_ACQUIRE_AUTOSUSPEND(dp->dev, pm);
+	ret = PM_RUNTIME_ACQUIRE_ERR(&pm);
+	if (ret)
+		return ret;
+
+	/*
+	 * The controller does not run an AUX transaction while its HPD state
+	 * machine reports the sink as unplugged: there is no reply event and
+	 * the transfer would only end with the software timeout. A source
+	 * must not start AUX transactions while HPD is deasserted anyway, so
+	 * fail right away. This happens e.g. when a branch device drops HPD
+	 * while a short pulse is being handled, or while the state machine is
+	 * still debouncing HPD after the controller has been (re)initialized.
+	 */
+	if (!dw_dp_hpd_detect(dp))
+		return -ENXIO;
+
+	/*
+	 * The AUX channel goes through the PHY. An enabled link, detection
+	 * and EDID reads keep it powered, but the transfer can be called at
+	 * any other time too (short pulse handling, CEC-Tunneling-over-AUX,
+	 * the AUX character device), so power it up for the transfer. This
+	 * only takes a reference if it is powered already.
+	 */
+	ret = phy_power_on(dp->phy);
+	if (ret)
+		return ret;
+
+	ret = dw_dp_aux_xfer(dp, msg);
+
+	phy_power_off(dp->phy);
+
+	return ret;
+}
+
 /*
  * Limits for the video timing for DP:
  * 1. the hfp should be 2 pixels aligned;
@@ -2589,22 +2611,38 @@ static void dw_dp_hpd_work(struct work_struct *work)
 
 	dev_dbg(dp->dev, "[drm] Get hpd irq - %s\n", long_hpd ? "long" : "short");
 
-	if (!long_hpd && dw_dp_downstream_changed(dp)) {
-		dev_dbg(dp->dev, "Downstream port status changed\n");
-		long_hpd = true;
-	}
-
 	if (!long_hpd) {
-		drm_dp_cec_irq(&dp->aux);
+		/* HPD went low since: the unplug event follows */
+		if (!dw_dp_hpd_detect(dp))
+			return;
+
+		/*
+		 * Keep the PHY, which carries the AUX channel, powered for
+		 * all the DPCD accesses below rather than for each of them,
+		 * as detection does. The link may be disabled.
+		 */
+		ret = phy_power_on(dp->phy);
+		if (ret)
+			return;
+
+		if (dw_dp_downstream_changed(dp)) {
+			dev_dbg(dp->dev, "Downstream port status changed\n");
+			long_hpd = true;
+		} else {
+			drm_dp_cec_irq(&dp->aux);
 
-		if (dw_dp_needs_link_retrain(dp)) {
-			ret = dw_dp_link_retrain(dp);
-			if (ret)
-				dev_warn(dp->dev, "Retrain link failed\n");
+			if (dw_dp_needs_link_retrain(dp)) {
+				ret = dw_dp_link_retrain(dp);
+				if (ret)
+					dev_warn(dp->dev, "Retrain link failed\n");
+			}
 		}
-	} else {
-		drm_helper_hpd_irq_event(dp->bridge.dev);
+
+		phy_power_off(dp->phy);
 	}
+
+	if (long_hpd)
+		drm_helper_hpd_irq_event(dp->bridge.dev);
 }
 
 static void dw_dp_handle_hpd_event(struct dw_dp *dp)
-- 
2.55.0

