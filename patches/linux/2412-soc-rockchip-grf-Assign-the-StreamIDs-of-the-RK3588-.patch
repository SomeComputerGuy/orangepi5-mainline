From 99065623e452ca247b03d1c0ddd033047d0f5006 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 12 Nov 2026 06:16:32 +0000
Subject: [PATCH 2412/2436] soc: rockchip: grf: Assign the StreamIDs of the
 RK3588 PHP SMMU masters

The second SMMU of the RK3588 (MMU600_PHP, one TBU) sits between the
PHP bus bridge and the interconnect and serves six AXI masters: GMAC0,
GMAC1, SATA0, SATA1, SATA2 and USB3OTG_2. The StreamID each of them
presents to the TBU is not hardwired. It comes from a pair of PHP GRF
registers per master, one for the read and one for the write channel
(PHP_GRF_*_SID_AR and PHP_GRF_*_SID_AW, offsets 0x74 to 0xcc), and all
of them reset to 0. Nothing programs them: not the boot ROM, not TF-A
(it only saves and restores them around system suspend), not U-Boot and
not the vendor kernel, which never enables this SMMU.

With every master on StreamID 0 the SMMU can not tell them apart, and
arm-smmu-v3 refuses devices that alias a StreamID. That is why the
mmu600_php node has been disabled since it was added.

Give each master a StreamID of its own, the same on both channels:
GMAC0 1, GMAC1 2, SATA0 3, SATA1 4, SATA2 5, USB3OTG_2 6. 0 is left
unused, so a master that lost its ID (for instance across a suspend
with a firmware that does not restore the PHP GRF) ends up on a stream
without a device and is aborted, rather than being translated with the
page tables of another device.

The writes are harmless while the SMMU is disabled: it then passes all
transactions whatever their StreamID. They happen at postcore_initcall
time, before the SMMU driver can probe.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/soc/rockchip/grf.c | 47 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/drivers/soc/rockchip/grf.c b/drivers/soc/rockchip/grf.c
index b459607c118a..bdc005c30372 100644
--- a/drivers/soc/rockchip/grf.c
+++ b/drivers/soc/rockchip/grf.c
@@ -168,6 +168,50 @@ static const struct rockchip_grf_info rk3588_sysgrf __initconst = {
 	.num_values = ARRAY_SIZE(rk3588_defaults),
 };
 
+/*
+ * The masters behind the second SMMU of the RK3588 (MMU600_PHP) take the
+ * StreamID of their AXI read (AR) and write (AW) channels from the PHP GRF.
+ * All of these registers reset to 0, which would make the six masters alias
+ * one stream, so give each master an ID of its own. The IDs match the iommus
+ * properties in rk3588-base.dtsi and rk3588-extra.dtsi. 0 stays unused, so
+ * that a master which lost its ID is not mistaken for another one.
+ *
+ * Bits 15:0 are the StreamID. Bit 16 (SubstreamID valid) and bit 17 (address
+ * already translated) stay 0. These registers have no write-enable mask.
+ */
+#define RK3588_PHP_GRF_GMAC0_SID_AW	0x0074
+#define RK3588_PHP_GRF_GMAC1_SID_AW	0x007c
+#define RK3588_PHP_GRF_SATA0_SID_AW	0x0084
+#define RK3588_PHP_GRF_SATA1_SID_AW	0x008c
+#define RK3588_PHP_GRF_SATA2_SID_AW	0x0094
+#define RK3588_PHP_GRF_GMAC0_SID_AR	0x009c
+#define RK3588_PHP_GRF_GMAC1_SID_AR	0x00a4
+#define RK3588_PHP_GRF_SATA0_SID_AR	0x00ac
+#define RK3588_PHP_GRF_SATA1_SID_AR	0x00b4
+#define RK3588_PHP_GRF_SATA2_SID_AR	0x00bc
+#define RK3588_PHP_GRF_USB3OTG2_SID_AR	0x00c4
+#define RK3588_PHP_GRF_USB3OTG2_SID_AW	0x00cc
+
+static const struct rockchip_grf_value rk3588_defaults_php_grf[] __initconst = {
+	{ "gmac0 write streamid", RK3588_PHP_GRF_GMAC0_SID_AW, 1 },
+	{ "gmac0 read streamid", RK3588_PHP_GRF_GMAC0_SID_AR, 1 },
+	{ "gmac1 write streamid", RK3588_PHP_GRF_GMAC1_SID_AW, 2 },
+	{ "gmac1 read streamid", RK3588_PHP_GRF_GMAC1_SID_AR, 2 },
+	{ "sata0 write streamid", RK3588_PHP_GRF_SATA0_SID_AW, 3 },
+	{ "sata0 read streamid", RK3588_PHP_GRF_SATA0_SID_AR, 3 },
+	{ "sata1 write streamid", RK3588_PHP_GRF_SATA1_SID_AW, 4 },
+	{ "sata1 read streamid", RK3588_PHP_GRF_SATA1_SID_AR, 4 },
+	{ "sata2 write streamid", RK3588_PHP_GRF_SATA2_SID_AW, 5 },
+	{ "sata2 read streamid", RK3588_PHP_GRF_SATA2_SID_AR, 5 },
+	{ "usb3otg2 write streamid", RK3588_PHP_GRF_USB3OTG2_SID_AW, 6 },
+	{ "usb3otg2 read streamid", RK3588_PHP_GRF_USB3OTG2_SID_AR, 6 },
+};
+
+static const struct rockchip_grf_info rk3588_phpgrf __initconst = {
+	.values = rk3588_defaults_php_grf,
+	.num_values = ARRAY_SIZE(rk3588_defaults_php_grf),
+};
+
 static const struct of_device_id rockchip_grf_dt_match[] __initconst = {
 	{
 		.compatible = "rockchip,rk3036-grf",
@@ -202,6 +246,9 @@ static const struct of_device_id rockchip_grf_dt_match[] __initconst = {
 	}, {
 		.compatible = "rockchip,rk3576-ioc-grf",
 		.data = (void *)&rk3576_iocgrf,
+	}, {
+		.compatible = "rockchip,rk3588-php-grf",
+		.data = (void *)&rk3588_phpgrf,
 	}, {
 		.compatible = "rockchip,rk3588-sys-grf",
 		.data = (void *)&rk3588_sysgrf,
-- 
2.55.0

