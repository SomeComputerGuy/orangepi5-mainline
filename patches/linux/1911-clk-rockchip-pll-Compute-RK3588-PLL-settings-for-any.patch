From 6e8a0f52d2fbaead481fd5cc15aeff33fc3cf2a0 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sun, 1 Nov 2026 06:35:55 +0000
Subject: [PATCH 11/33] clk: rockchip: pll: Compute RK3588 PLL settings for any
 rate

The RK3588 PLL is fractional: Fout = 24 MHz * (m + k / 65536) / p / 2^s
with a signed 16-bit k, but the driver can only set the rates listed in
rk3588_pll_rates[] and rounds everything else down to a table entry.
A display PLL needs arbitrary pixel clocks, e.g. 593.407 MHz for
3840x2160@59.94Hz, which the table cannot provide.

Add a ROCKCHIP_PLL_CALC_RATE flag that lets a PLL compute p, m, s and k
for rates that are not in its table: the highest VCO frequency in range
is used, and for each pre-divider the largest m + k / 65536 that does not
exceed the request, keeping the smallest error. The error is below
0.05 ppm for typical pixel clocks (593406990 Hz for 593407000 Hz). The
returned rate is computed with the same arithmetic as recalc_rate(), so
setting it yields exactly that rate, and it is never above the request,
like the table rounding, so dividers below the PLL keep their ratio.

PLLs without the flag (the system PLLs) keep their table-only behaviour.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/clk/rockchip/clk-pll.c | 106 ++++++++++++++++++++++++++++++++-
 drivers/clk/rockchip/clk.h     |   4 ++
 2 files changed, 109 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/rockchip/clk-pll.c b/drivers/clk/rockchip/clk-pll.c
index 706ca4b344d3..6961bcd339a6 100644
--- a/drivers/clk/rockchip/clk-pll.c
+++ b/drivers/clk/rockchip/clk-pll.c
@@ -993,17 +993,121 @@ static int rockchip_rk3588_pll_set_params(struct rockchip_clk_pll *pll,
 	return ret;
 }
 
+#define RK3588_PLL_FVCO_MIN		2250000000ULL
+#define RK3588_PLL_FVCO_MAX		4500000000ULL
+#define RK3588_PLL_M_MIN		64
+#define RK3588_PLL_M_MAX		1023
+#define RK3588_PLL_P_MAX		4
+#define RK3588_PLL_S_MAX		6
+
+/*
+ * Compute p, m, s and k for an arbitrary output rate (ROCKCHIP_PLL_CALC_RATE).
+ * The highest VCO frequency in range is used (lowest jitter), and for each
+ * pre-divider the largest m + k / 65536 not above the rate is taken; the
+ * pre-divider giving the smallest error wins, integer mode (k = 0) and
+ * smaller p preferred on a tie. The returned rate is what
+ * rockchip_rk3588_pll_recalc_rate() will report for the settings, so a later
+ * set_rate() of it gets exactly that rate.
+ */
+static unsigned long rockchip_rk3588_pll_calc(unsigned long fin,
+					      unsigned long fout,
+					      struct rockchip_pll_rate_table *rate)
+{
+	unsigned long best_rate = 0;
+	u64 fvco = 0, best_err = U64_MAX;
+	unsigned int p, s;
+
+	if (!fin || !fout)
+		return 0;
+
+	for (s = RK3588_PLL_S_MAX + 1; s-- > 0;) {
+		fvco = (u64)fout << s;
+		if (fvco >= RK3588_PLL_FVCO_MIN && fvco <= RK3588_PLL_FVCO_MAX)
+			break;
+	}
+	if (fvco < RK3588_PLL_FVCO_MIN || fvco > RK3588_PLL_FVCO_MAX)
+		return 0;
+
+	for (p = 1; p <= RK3588_PLL_P_MAX; p++) {
+		/* x = (m + k / 65536) * 65536, k signed: m = x / 65536 rounded */
+		u64 x = div_u64(fvco * p * 65536, fin) + 1;
+		unsigned int m;
+		u64 r, err;
+		s64 k;
+
+		/*
+		 * Round down like the table lookup does: the dividers below
+		 * the pll then still pick the intended ratio.
+		 */
+		for (;;) {
+			m = (x + 32768) >> 16;
+			k = (s64)x - ((s64)m << 16);
+
+			/* same arithmetic as rockchip_rk3588_pll_recalc_rate() */
+			r = div_u64((u64)fin * m, p);
+			if (k)
+				r += div_s64((s64)fin * k, p * 65536);
+			r >>= s;
+			if (r <= fout)
+				break;
+			x--;
+		}
+
+		if (m < RK3588_PLL_M_MIN || m > RK3588_PLL_M_MAX)
+			continue;
+
+		err = fout - r;
+		if (err < best_err || (err == best_err && !k && rate->k)) {
+			best_err = err;
+			best_rate = r;
+			rate->p = p;
+			rate->m = m;
+			rate->s = s;
+			rate->k = k;
+		}
+	}
+
+	if (best_rate)
+		rate->rate = best_rate;
+
+	return best_rate;
+}
+
+static int rockchip_rk3588_pll_determine_rate(struct clk_hw *hw,
+					      struct clk_rate_request *req)
+{
+	struct rockchip_clk_pll *pll = to_rockchip_clk_pll(hw);
+	struct rockchip_pll_rate_table calc = {};
+	unsigned long rate;
+
+	if (!(pll->flags & ROCKCHIP_PLL_CALC_RATE) ||
+	    rockchip_get_pll_settings(pll, req->rate))
+		return rockchip_pll_determine_rate(hw, req);
+
+	rate = rockchip_rk3588_pll_calc(req->best_parent_rate, req->rate, &calc);
+	if (!rate)
+		return rockchip_pll_determine_rate(hw, req);
+
+	req->rate = rate;
+
+	return 0;
+}
+
 static int rockchip_rk3588_pll_set_rate(struct clk_hw *hw, unsigned long drate,
 					unsigned long prate)
 {
 	struct rockchip_clk_pll *pll = to_rockchip_clk_pll(hw);
 	const struct rockchip_pll_rate_table *rate;
+	struct rockchip_pll_rate_table calc = {};
 
 	pr_debug("%s: changing %s to %lu with a parent rate of %lu\n",
 		 __func__, __clk_get_name(hw->clk), drate, prate);
 
 	/* Get required rate settings from table */
 	rate = rockchip_get_pll_settings(pll, drate);
+	if (!rate && (pll->flags & ROCKCHIP_PLL_CALC_RATE) &&
+	    rockchip_rk3588_pll_calc(prate, drate, &calc))
+		rate = &calc;
 	if (!rate) {
 		pr_err("%s: Invalid rate : %lu for pll clk %s\n", __func__,
 			drate, __clk_get_name(hw->clk));
@@ -1049,7 +1153,7 @@ static const struct clk_ops rockchip_rk3588_pll_clk_norate_ops = {
 
 static const struct clk_ops rockchip_rk3588_pll_clk_ops = {
 	.recalc_rate = rockchip_rk3588_pll_recalc_rate,
-	.determine_rate = rockchip_pll_determine_rate,
+	.determine_rate = rockchip_rk3588_pll_determine_rate,
 	.set_rate = rockchip_rk3588_pll_set_rate,
 	.enable = rockchip_rk3588_pll_enable,
 	.disable = rockchip_rk3588_pll_disable,
diff --git a/drivers/clk/rockchip/clk.h b/drivers/clk/rockchip/clk.h
index 72b36bba3152..ce0b5d1fcb03 100644
--- a/drivers/clk/rockchip/clk.h
+++ b/drivers/clk/rockchip/clk.h
@@ -662,6 +662,9 @@ struct rockchip_pll_rate_table {
  * ROCKCHIP_PLL_SYNC_RATE - check rate parameters to match against the
  *	rate_table parameters and adjust them if necessary.
  * ROCKCHIP_PLL_FIXED_MODE - the pll operates in normal mode only
+ * ROCKCHIP_PLL_CALC_RATE - compute the pll parameters for rates that are not
+ *	in the rate_table instead of rounding to a table entry. Meant for
+ *	dedicated (e.g. video) plls whose consumers need arbitrary rates.
  */
 struct rockchip_pll_clock {
 	unsigned int		id;
@@ -680,6 +683,7 @@ struct rockchip_pll_clock {
 
 #define ROCKCHIP_PLL_SYNC_RATE		BIT(0)
 #define ROCKCHIP_PLL_FIXED_MODE		BIT(1)
+#define ROCKCHIP_PLL_CALC_RATE		BIT(2)
 
 #define PLL(_type, _id, _name, _pnames, _flags, _con, _mode, _mshift,	\
 		_lshift, _pflags, _rtable)				\
-- 
