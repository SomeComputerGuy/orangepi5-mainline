From c7af00e2bdf405459460626a8d70dbb12232256d Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 3 Nov 2026 01:43:49 +0000
Subject: [PATCH 2259/2271] drm/rockchip: dw_hdmi_qp: Use the BT.2020 matrix
 for BT.2020 YCbCr output

Now that the Colorspace property is attached, the AVI InfoFrame can
signal BT.2020 colorimetry, but for YCbCr output the VOP2 still converts
from R'G'B' with its default BT.709 matrix, so the sink decodes the
picture with the wrong matrix and the colors are off.

Select the VOP2's BT.2020 R'G'B' to Y'C'bC'r matrix when a BT.2020
colorspace is requested with YCbCr output, like the dw-dp glue does.
RGB output is passed through unconverted, so it needs nothing. Reject
BT.2020 constant luminance YCbCr for YCbCr output, which the VOP2 has
no encoder for, instead of signalling it on a non-constant luminance
picture.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../gpu/drm/rockchip/dw_hdmi_qp-rockchip.c    | 36 +++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c b/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
index cec084bc683c..09a8ab58f371 100644
--- a/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
@@ -18,6 +18,7 @@
 #include <linux/phy/phy.h>
 #include <linux/phy/phy-hdmi.h>
 #include <linux/regmap.h>
+#include <linux/videodev2.h>
 #include <linux/workqueue.h>
 
 #include <drm/bridge/dw_hdmi_qp.h>
@@ -250,6 +251,34 @@ dw_hdmi_qp_rockchip_phy_cfg(struct rockchip_crtc_state *s,
 	return PHY_HDMI_MODE_TMDS;
 }
 
+/*
+ * The AVI InfoFrame signals the colorimetry of the Colorspace property, so for
+ * YCbCr output the VOP2 has to convert with the matching matrix. It has BT.601,
+ * BT.709 and BT.2020 non-constant luminance R'G'B' to Y'C'bC'r matrices; RGB
+ * output is passed through as is.
+ */
+static int
+dw_hdmi_qp_rockchip_set_color_space(struct rockchip_crtc_state *s,
+				    const struct drm_connector_state *conn_state)
+{
+	s->color_space = V4L2_COLORSPACE_DEFAULT;
+
+	if (conn_state->hdmi.output_format == DRM_OUTPUT_COLOR_FORMAT_RGB444)
+		return 0;
+
+	switch (conn_state->colorspace) {
+	case DRM_MODE_COLORIMETRY_BT2020_RGB:
+	case DRM_MODE_COLORIMETRY_BT2020_YCC:
+		s->color_space = V4L2_COLORSPACE_BT2020;
+		return 0;
+	case DRM_MODE_COLORIMETRY_BT2020_CYCC:
+		/* No constant luminance encoder */
+		return -EINVAL;
+	default:
+		return 0;
+	}
+}
+
 static int
 dw_hdmi_qp_rockchip_encoder_atomic_check(struct drm_encoder *encoder,
 					 struct drm_crtc_state *crtc_state,
@@ -302,6 +331,13 @@ dw_hdmi_qp_rockchip_encoder_atomic_check(struct drm_encoder *encoder,
 	s->output_bpc = conn_state->hdmi.output_bpc;
 	s->bus_format = ingest_fmt;
 
+	ret = dw_hdmi_qp_rockchip_set_color_space(s, conn_state);
+	if (ret) {
+		dev_dbg(hdmi->dev, "VOP2 can't encode colorspace %d\n",
+			conn_state->colorspace);
+		return ret;
+	}
+
 	return 0;
 }
 
