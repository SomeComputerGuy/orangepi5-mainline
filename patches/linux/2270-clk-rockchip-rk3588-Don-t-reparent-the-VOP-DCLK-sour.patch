From cf21c725a61a1d03bf83e9dfa03447b29c3c2e2b Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Wed, 4 Nov 2026 19:05:39 +0000
Subject: [PATCH 2270/2271] clk: rockchip: rk3588: Don't reparent the VOP DCLK
 sources on a rate change

The VOP2 DCLK sources dclk_vop0_src, dclk_vop1_src, dclk_vop2_src and
dclk_vop3 can divide their rate from GPLL, CPLL, AUPLL or the video PLL
(V0PLL). On a rate change the clock framework picks the parent that gives
the closest rate at the parents' current rates, which can be a leftover
rate of V0PLL that another video port is about to change, so the rate
the display driver checked is not the one it gets.

The display driver now chooses the parent of each source itself (as the
vendor kernel does, which sets the same flag). Set
CLK_SET_RATE_NO_REPARENT, so that a rate change only sets the divider.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/clk/rockchip/clk-rk3588.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/clk/rockchip/clk-rk3588.c b/drivers/clk/rockchip/clk-rk3588.c
index 6cc9d492d4db..f1cab1df27a2 100644
--- a/drivers/clk/rockchip/clk-rk3588.c
+++ b/drivers/clk/rockchip/clk-rk3588.c
@@ -2097,15 +2097,18 @@ static struct rockchip_clk_branch rk3588_early_clk_branches[] __initdata = {
 			RK3588_CLKGATE_CON(52), 8, GFLAGS),
 	GATE(ACLK_VOP, "aclk_vop", "aclk_vop_sub_src", 0,
 			RK3588_CLKGATE_CON(52), 9, GFLAGS),
-	COMPOSITE(DCLK_VOP0_SRC, "dclk_vop0_src", gpll_cpll_v0pll_aupll_p, 0,
+	COMPOSITE(DCLK_VOP0_SRC, "dclk_vop0_src", gpll_cpll_v0pll_aupll_p,
+			CLK_SET_RATE_NO_REPARENT,
 			RK3588_CLKSEL_CON(111), 7, 2, MFLAGS, 0, 7,
 			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(52), 10, GFLAGS),
-	COMPOSITE(DCLK_VOP1_SRC, "dclk_vop1_src", gpll_cpll_v0pll_aupll_p, 0,
+	COMPOSITE(DCLK_VOP1_SRC, "dclk_vop1_src", gpll_cpll_v0pll_aupll_p,
+			CLK_SET_RATE_NO_REPARENT,
 			RK3588_CLKSEL_CON(111), 14, 2, MFLAGS, 9, 5,
 			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(52), 11, GFLAGS),
-	COMPOSITE(DCLK_VOP2_SRC, "dclk_vop2_src", gpll_cpll_v0pll_aupll_p, 0,
+	COMPOSITE(DCLK_VOP2_SRC, "dclk_vop2_src", gpll_cpll_v0pll_aupll_p,
+			CLK_SET_RATE_NO_REPARENT,
 			RK3588_CLKSEL_CON(112), 5, 2, MFLAGS, 0, 5,
 			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(52), 12, GFLAGS),
@@ -2121,7 +2124,8 @@ static struct rockchip_clk_branch rk3588_early_clk_branches[] __initdata = {
 			CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT,
 			RK3588_CLKSEL_CON(112), 11, 2, MFLAGS,
 			RK3588_CLKGATE_CON(53), 1, GFLAGS),
-	COMPOSITE(DCLK_VOP3, "dclk_vop3", gpll_cpll_v0pll_aupll_p, 0,
+	COMPOSITE(DCLK_VOP3, "dclk_vop3", gpll_cpll_v0pll_aupll_p,
+			CLK_SET_RATE_NO_REPARENT,
 			RK3588_CLKSEL_CON(113), 7, 2, MFLAGS, 0, 7,
 			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(53), 2, GFLAGS),
