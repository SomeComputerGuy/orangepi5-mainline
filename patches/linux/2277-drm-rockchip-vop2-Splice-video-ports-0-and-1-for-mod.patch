+ * this one, and then sees that it shows the right half of another plane.
+ */
+static int vop2_win_plane_unused(struct drm_atomic_commit *state,
+				 struct vop2_win *win, bool *unused)
+{
+	struct drm_plane_state *pstate;
+	int ret;
