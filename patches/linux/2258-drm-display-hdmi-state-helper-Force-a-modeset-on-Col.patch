From 0038b5b6acb92b798e21403b098610e7d5a58a12 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 3 Nov 2026 01:43:48 +0000
Subject: [PATCH 2258/2271] drm/display: hdmi-state-helper: Force a modeset on
 Colorspace or HDR metadata changes

drm_atomic_helper_connector_hdmi_check() regenerates the InfoFrames into
the new connector state, but they only reach the hardware through
drm_atomic_helper_connector_hdmi_update_infoframes(), which drivers call
from their encoder or bridge enable path. A commit that changes nothing
but the Colorspace property or the HDR_OUTPUT_METADATA blob therefore
leaves the old AVI and HDR DRM InfoFrames on the link: a compositor that
enables HDR without asking for a full modeset keeps the sink in SDR
mode, and one that turns HDR off leaves the sink in PQ mode.

Force a modeset when either of them changes, as the helper already does
for the Broadcast RGB property and the output format, and as dw-hdmi and
meson do for the HDR metadata. A new blob with the same content as the
old one doesn't count as a change.

Add KUnit coverage for both cases.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../gpu/drm/display/drm_hdmi_state_helper.c   |   8 +-
 .../drm/tests/drm_hdmi_state_helper_test.c    | 205 ++++++++++++++++++
 2 files changed, 212 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/display/drm_hdmi_state_helper.c b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
index 14e4e9e29fb3..03ef4a10a998 100644
--- a/drivers/gpu/drm/display/drm_hdmi_state_helper.c
+++ b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
@@ -948,6 +948,10 @@ hdmi_generate_infoframes(const struct drm_connector *connector,
  * Checks that a desired connector update is valid, and updates various
  * fields of derived state.
  *
+ * The InfoFrames are only written when the encoder is enabled, so a change of
+ * the output configuration, the Colorspace property or the HDR output metadata
+ * forces a modeset on the connector's CRTC.
+ *
  * RETURNS:
  * Zero on success, or an errno code otherwise.
  */
@@ -979,7 +983,9 @@ int drm_atomic_helper_connector_hdmi_check(struct drm_connector *connector,
 	    old_conn_state->hdmi.output_bpc != new_conn_state->hdmi.output_bpc ||
 	    old_conn_state->hdmi.output_format != new_conn_state->hdmi.output_format ||
 	    old_conn_state->hdmi.frl_rate_per_lane != new_conn_state->hdmi.frl_rate_per_lane ||
-	    old_conn_state->hdmi.frl_lanes != new_conn_state->hdmi.frl_lanes) {
+	    old_conn_state->hdmi.frl_lanes != new_conn_state->hdmi.frl_lanes ||
+	    old_conn_state->colorspace != new_conn_state->colorspace ||
+	    !drm_connector_atomic_hdr_metadata_equal(old_conn_state, new_conn_state)) {
 		struct drm_crtc *crtc = new_conn_state->crtc;
 		struct drm_crtc_state *crtc_state;
 
diff --git a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
index 36a84321ed56..c22fa6638298 100644
--- a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
+++ b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
@@ -695,6 +695,209 @@ static void drm_test_check_broadcast_rgb_crtc_mode_not_changed(struct kunit *tes
 	drm_modeset_acquire_fini(&ctx);
 }
 
+static const struct drm_connector_hdmi_funcs hdr_connector_hdmi_funcs = {
+	.vendor = "Vendor",
+	.product = "Product",
+	.supported_hdmi_ver = HDMI_VERSION_1_4,
+	.supported_formats = BIT(DRM_OUTPUT_COLOR_FORMAT_RGB444),
+	.max_bpc = 10,
+	.avi = {
+		.clear_infoframe = accept_infoframe_clear_infoframe,
+		.write_infoframe = accept_infoframe_write_infoframe,
+	},
+	.hdmi = {
+		.clear_infoframe = accept_infoframe_clear_infoframe,
+		.write_infoframe = accept_infoframe_write_infoframe,
+	},
+	.hdr_drm = {
+		.clear_infoframe = accept_infoframe_clear_infoframe,
+		.write_infoframe = accept_infoframe_write_infoframe,
+	},
+};
+
+/*
+ * Test that if we change the Colorspace property, we trigger a mode change
+ * on the connector's CRTC, so that the new colorimetry is sent in the AVI
+ * InfoFrame.
+ */
+static void drm_test_check_colorspace_crtc_mode_changed(struct kunit *test)
+{
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *old_conn_state;
+	struct drm_connector_state *new_conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_atomic_commit *state;
+	struct drm_display_mode *preferred;
+	struct drm_connector *conn;
+	struct drm_device *drm;
+	struct drm_crtc *crtc;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init(test);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	crtc = priv->crtc;
+	conn = &priv->connector;
+
+	preferred = find_preferred_mode(conn);
+	KUNIT_ASSERT_NOT_NULL(test, preferred);
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+retry_conn_enable:
+	ret = drm_kunit_helper_enable_crtc_connector(test, drm,
+						     crtc, conn,
+						     preferred,
+						     &ctx);
+	if (ret == -EDEADLK) {
+		ret = drm_modeset_backoff(&ctx);
+		if (!ret)
+			goto retry_conn_enable;
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	new_conn_state = drm_atomic_get_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, new_conn_state);
+
+	old_conn_state = drm_atomic_get_old_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, old_conn_state);
+
+	KUNIT_ASSERT_EQ(test, old_conn_state->colorspace,
+			DRM_MODE_COLORIMETRY_DEFAULT);
+	new_conn_state->colorspace = DRM_MODE_COLORIMETRY_BT2020_RGB;
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, crtc_state);
+	KUNIT_EXPECT_TRUE(test, crtc_state->mode_changed);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+static void set_hdr_output_metadata(struct kunit *test,
+				    struct drm_device *drm,
+				    struct drm_connector_state *conn_state,
+				    u8 eotf)
+{
+	struct hdr_output_metadata hdr_data = {};
+	struct drm_property_blob *hdr_blob;
+	bool replaced;
+	int ret;
+
+	hdr_data.metadata_type = HDMI_STATIC_METADATA_TYPE1;
+	hdr_data.hdmi_metadata_type1.eotf = eotf;
+	hdr_data.hdmi_metadata_type1.metadata_type = HDMI_STATIC_METADATA_TYPE1;
+	hdr_data.hdmi_metadata_type1.max_display_mastering_luminance = 1000;
+
+	hdr_blob = drm_property_create_blob(drm, sizeof(hdr_data), &hdr_data);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, hdr_blob);
+
+	ret = drm_property_replace_blob_from_id(drm,
+						&conn_state->hdr_output_metadata,
+						hdr_blob->base.id,
+						-1, sizeof(struct hdr_output_metadata), -1,
+						&replaced);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_TRUE(test, replaced);
+
+	drm_property_blob_put(hdr_blob);
+}
+
+/*
+ * Test that if we set new HDR output metadata, we trigger a mode change on
+ * the connector's CRTC, so that the HDR DRM InfoFrame gets sent, and that
+ * setting a new blob with the same content doesn't.
+ */
+static void drm_test_check_hdr_metadata_crtc_mode_changed(struct kunit *test)
+{
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *new_conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_atomic_commit *state;
+	struct drm_display_mode *preferred;
+	struct drm_connector *conn;
+	struct drm_device *drm;
+	struct drm_crtc *crtc;
+	int ret;
+
+	priv = __connector_hdmi_init(test, &hdr_connector_hdmi_funcs,
+				     test_edid_hdmi_1080p_rgb_max_200mhz_hdr,
+				     ARRAY_SIZE(test_edid_hdmi_1080p_rgb_max_200mhz_hdr),
+				     NULL);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	crtc = priv->crtc;
+	conn = &priv->connector;
+
+	preferred = find_preferred_mode(conn);
+	KUNIT_ASSERT_NOT_NULL(test, preferred);
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+retry_conn_enable:
+	ret = drm_kunit_helper_enable_crtc_connector(test, drm,
+						     crtc, conn,
+						     preferred,
+						     &ctx);
+	if (ret == -EDEADLK) {
+		ret = drm_modeset_backoff(&ctx);
+		if (!ret)
+			goto retry_conn_enable;
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	new_conn_state = drm_atomic_get_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, new_conn_state);
+
+	set_hdr_output_metadata(test, drm, new_conn_state,
+				HDMI_EOTF_SMPTE_ST2084);
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, crtc_state);
+	KUNIT_EXPECT_TRUE(test, crtc_state->mode_changed);
+
+	ret = drm_atomic_commit(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	KUNIT_ASSERT_NOT_NULL(test, conn->state->hdr_output_metadata);
+	KUNIT_EXPECT_TRUE(test, conn->state->hdmi.infoframes.hdr_drm.set);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	new_conn_state = drm_atomic_get_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, new_conn_state);
+
+	set_hdr_output_metadata(test, drm, new_conn_state,
+				HDMI_EOTF_SMPTE_ST2084);
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, crtc_state);
+	KUNIT_EXPECT_FALSE(test, crtc_state->mode_changed);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
 /*
  * Test that for an HDMI connector, with an HDMI monitor, if the
  * Broadcast RGB property is set to auto with a mode that isn't the
@@ -3358,6 +3561,8 @@ static struct kunit_case drm_atomic_helper_connector_hdmi_check_tests[] = {
 			 check_broadcast_rgb_cea_mode_yuv420_gen_params),
 	KUNIT_CASE(drm_test_check_broadcast_rgb_crtc_mode_changed),
 	KUNIT_CASE(drm_test_check_broadcast_rgb_crtc_mode_not_changed),
+	KUNIT_CASE(drm_test_check_colorspace_crtc_mode_changed),
+	KUNIT_CASE(drm_test_check_hdr_metadata_crtc_mode_changed),
 	KUNIT_CASE(drm_test_check_disable_connector),
 	KUNIT_CASE(drm_test_check_hdmi_funcs_reject_rate),
 	KUNIT_CASE(drm_test_check_max_tmds_rate_bpc_fallback_rgb),
-- 
