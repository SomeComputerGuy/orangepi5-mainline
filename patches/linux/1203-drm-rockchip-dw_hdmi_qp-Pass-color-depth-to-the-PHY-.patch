From 6eb1fb15c960abd7178231404da442c2e4129107 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 31 Oct 2026 06:34:30 +0000
Subject: [PATCH] drm/rockchip: dw_hdmi_qp: Pass color depth to the PHY in FRL
 mode

The Samsung HDPTX PHY driver programs the color depth select of its
pixel clock generator (CMN_REG(0086) PLL_PCG_CLK_SEL) from
phy_configure_opts_hdmi.bpc for both TMDS and FRL link modes, see
rk_hdptx_frl_lcpll_cmn_config().  However, the encoder atomic check only
fills in .bpc for TMDS, leaving it zero for FRL, which the PHY then
treats as 8 bpc.  The .set_frl_rate() hook, used by the FRL link
training fallback, has the same problem.

FRL is required for 4K@60Hz RGB/YUV444 at 10 bpc (742.5 MHz TMDS
character rate, above the 600 MHz HDMI 2.0 limit).  In that case the FRL
link trains at 10 Gbps x 4 lanes and the sink reports all lanes locked
without character errors, yet the picture stays black, as the PHY is
running with the 8 bpc PCG setting while the controller is fed 10 bpc
data.  8 bpc FRL modes such as 4K@120Hz are not affected.

The vendor kernel passes the color depth to the PHY in FRL mode as well.
Compute the PHY bpc once for both link modes, keeping the existing 8 bpc
override for YUV422, and remember it so that FRL rate changes during
link training preserve it.

Assisted-by: Claude:claude-opus-5-5
---
 .../gpu/drm/rockchip/dw_hdmi_qp-rockchip.c    | 24 ++++++++++++-------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c b/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
index f9b03c3ed16b..9f6fc3d917db 100644
--- a/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
@@ -110,6 +110,7 @@ struct rockchip_hdmi_qp {
 	int port_id;
 	const struct rockchip_hdmi_qp_ctrl_ops *ctrl_ops;
 	unsigned long long tmds_char_rate;
+	unsigned int phy_bpc;
 };
 
 struct rockchip_hdmi_qp_ctrl_ops {
@@ -257,6 +258,18 @@ dw_hdmi_qp_rockchip_encoder_atomic_check(struct drm_encoder *encoder,
 		return -EINVAL;
 	}
 
+	/*
+	 * YUV422 always transmits two 12-bit components per clock cycle,
+	 * regardless of the color depth, which from a rate perspective is
+	 * equivalent to three 8-bit RGB components.  Force 8 bpc here to
+	 * keep the PHY pixel clock aligned with the character rate.
+	 *
+	 * The color depth is needed in FRL mode as well: the PHY derives
+	 * the pixel clock from the link PLL using a bpc dependent divider.
+	 */
+	phy_cfg.hdmi.bpc = (s->output_mode == ROCKCHIP_OUT_MODE_YUV422 ?
+				8 : conn_state->hdmi.output_bpc);
+
 	if (conn_state->hdmi.frl_rate_per_lane) {
 		s->frl_enabled = true;
 		mode = PHY_HDMI_MODE_FRL;
@@ -266,14 +279,6 @@ dw_hdmi_qp_rockchip_encoder_atomic_check(struct drm_encoder *encoder,
 		s->frl_enabled = false;
 		mode = PHY_HDMI_MODE_TMDS;
 		phy_cfg.hdmi.tmds_char_rate = conn_state->hdmi.tmds_char_rate;
-		/*
-		 * YUV422 always transmits two 12-bit components per clock cycle,
-		 * regardless of the color depth, which from a rate perspective is
-		 * equivalent to three 8-bit RGB components.  Force 8 bpc here to
-		 * keep the PHY PLL output aligned with the TMDS character rate.
-		 */
-		phy_cfg.hdmi.bpc = (s->output_mode == ROCKCHIP_OUT_MODE_YUV422 ?
-					8 : conn_state->hdmi.output_bpc);
 	}
 
 	ret = phy_set_mode_ext(hdmi->phy, PHY_MODE_HDMI, mode);
@@ -289,6 +294,7 @@ dw_hdmi_qp_rockchip_encoder_atomic_check(struct drm_encoder *encoder,
 	}
 
 	hdmi->tmds_char_rate = conn_state->hdmi.tmds_char_rate;
+	hdmi->phy_bpc = phy_cfg.hdmi.bpc;
 
 	s->output_type = DRM_MODE_CONNECTOR_HDMIA;
 	s->output_bpc = conn_state->hdmi.output_bpc;
@@ -390,6 +396,8 @@ static int dw_hdmi_qp_rk3588_set_frl_rate(struct dw_hdmi_qp *dw_hdmi, void *data
 	if (!rate_per_lane || !lanes)
 		return -EINVAL;
 
+	/* Keep the color depth of the current mode across FRL rate changes */
+	phy_cfg.hdmi.bpc = hdmi->phy_bpc;
 	phy_cfg.hdmi.frl.rate_per_lane = rate_per_lane;
 	phy_cfg.hdmi.frl.lanes = lanes;
 
-- 
2.55.0

