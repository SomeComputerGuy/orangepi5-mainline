From 5b1c1b2a0bcccd5aa33ae51ff51700cb5d221c91 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 31 Oct 2026 19:50:32 +0000
Subject: [PATCH 2/3] drm/bridge: dw-hdmi-qp: Add helper to wait for the video
 input clock to stop

The input pixel interface (IPI) of the controller is reinitialized by its
clock management unit only after the unit has detected that the IPI clock
stopped, which is reported by CMU_STATUS.IPI_CLK_OFF about 2 ms after the
clock is gated. There is no software reset covering the IPI: neither
AVP_DATAPATH_VIDEO_SWDISABLE nor AVP_DATAPATH_SWINIT_P brings it back to
its initial state.

On RK3588 a modeset that disables and re-enables the VOP within one commit
restarts the pixel clock well within those 2 ms. The clock monitor never
sees the clock stop and the IPI keeps the state of the previous mode. After
YCbCr 4:2:0 output this reliably breaks the next mode: the IPI does not
lock onto the new stream (VIDEO_INTERFACE_STATUS0 bit 18 stays clear and
the video monitor registers report nonsense timings), so the sink shows
"no signal" although the TMDS or FRL link itself is up. The state survives
any number of further back-to-back modesets, which looks like a permanently
dead output; only a modeset with the clock stopped long enough, e.g. after
disabling the output in a separate commit, recovers it.

Add dw_hdmi_qp_wait_input_clk_off() for platform drivers to wait for the
controller to observe the stopped clock before they restart it.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c | 33 ++++++++++++++++++++
 include/drm/bridge/dw_hdmi_qp.h              |  1 +
 2 files changed, 34 insertions(+)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
index e05c62b..9ed344c 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
@@ -1391,6 +1391,39 @@ struct dw_hdmi_qp *dw_hdmi_qp_bind(struct platform_device *pdev,
 }
 EXPORT_SYMBOL_GPL(dw_hdmi_qp_bind);
 
+/**
+ * dw_hdmi_qp_wait_input_clk_off() - Wait until the controller sees its video
+ * input clock stopped
+ * @hdmi: pointer to the DW HDMI QP controller
+ *
+ * The clock monitor of the controller reinitializes the input pixel interface
+ * (IPI) only once it has detected that the IPI clock stopped, which takes
+ * about 2 ms. There is no software reset for it: neither stopping the video
+ * datapath nor a datapath reset brings the IPI back to its initial state.
+ *
+ * When a modeset disables and re-enables the display controller feeding the
+ * IPI within the same commit, the pixel clock is usually restarted much faster
+ * than that. The IPI then keeps the state of the previous mode, e.g. of a
+ * YCbCr 4:2:0 input, and may never lock onto the new video stream, leaving the
+ * sink without a signal until the clock is stopped long enough again.
+ *
+ * Platform drivers gating the pixel clock between disabling and enabling the
+ * display controller should call this after the clock has been stopped and
+ * before it is restarted, e.g. from their encoder's .atomic_mode_set().
+ */
+void dw_hdmi_qp_wait_input_clk_off(struct dw_hdmi_qp *hdmi)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read_poll_timeout(hdmi->regm, CMU_STATUS, val,
+				       val & IPI_CLK_OFF, 100,
+				       20 * USEC_PER_MSEC);
+	if (ret)
+		dev_dbg(hdmi->dev, "video input clock still running\n");
+}
+EXPORT_SYMBOL_GPL(dw_hdmi_qp_wait_input_clk_off);
+
 /**
  * dw_hdmi_qp_hpd_notify() - Notify a hot-plug detection event
  * @hdmi: pointer to the DW HDMI QP controller
diff --git a/include/drm/bridge/dw_hdmi_qp.h b/include/drm/bridge/dw_hdmi_qp.h
index ee37e5f..8ab43d4 100644
--- a/include/drm/bridge/dw_hdmi_qp.h
+++ b/include/drm/bridge/dw_hdmi_qp.h
@@ -46,6 +46,7 @@ struct dw_hdmi_qp *dw_hdmi_qp_bind(struct platform_device *pdev,
 				   struct drm_encoder *encoder,
 				   const struct dw_hdmi_qp_plat_data *plat_data);
 void dw_hdmi_qp_hpd_notify(struct dw_hdmi_qp *hdmi);
+void dw_hdmi_qp_wait_input_clk_off(struct dw_hdmi_qp *hdmi);
 void dw_hdmi_qp_suspend(struct device *dev, struct dw_hdmi_qp *hdmi);
 void dw_hdmi_qp_resume(struct device *dev, struct dw_hdmi_qp *hdmi);
 #endif /* __DW_HDMI_QP__ */
