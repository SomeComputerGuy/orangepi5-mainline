-		   FIELD_PREP(VEPU580_ME_CFG_PMV_MDST_H, 5) |
-		   FIELD_PREP(VEPU580_ME_CFG_PMV_MDST_V, 5) |
-		   FIELD_PREP(VEPU580_ME_CFG_PMV_NUM, 2) |
-		   (colmv_stor ? VEPU580_ME_CFG_COLMV_STOR : 0) |
-		   (colmv_load ? VEPU580_ME_CFG_COLMV_LOAD : 0));
