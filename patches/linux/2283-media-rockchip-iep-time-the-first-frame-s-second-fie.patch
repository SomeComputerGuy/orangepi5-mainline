From 44e499d356581f1d507e3a4976f22e7bf0b66781 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 11:40:39 +0000
Subject: [PATCH 2283/2312] media: rockchip: iep: time the first frame's second
 field from the next input

In the field-rate deinterlacing modes every OUTPUT buffer produces two
CAPTURE buffers. The second one is placed half a frame period after the
first, and the period is taken from the previous OUTPUT buffer. The first
frame after STREAMON has no previous buffer, so both of its CAPTURE
buffers carried the same timestamp, and every stream started with two
CAPTURE buffers of equal timestamp.

Take the period from the next OUTPUT buffer for that frame when userspace
has already queued it, which is the case whenever the OUTPUT queue is
primed before streaming starts. If no next buffer is queued yet, the
period is unknown at the time the job runs and the offset stays 0. Do not
guess a period, do not hold back the second CAPTURE buffer (that would add
a frame of latency and stall clients that wait for both fields before
queueing more input), and do not add VIDIOC_S_PARM, which mem2mem devices
other than encoders do not implement. Document the rule next to the code.

The Rockchip MPP library never emits a field pair before it has a
previous frame and times the earlier field at the midpoint between the
two inputs, and rcar_fdp1 and ti-vpe give both fields of an interlaced
buffer the buffer's timestamp, so no implementation invents the period.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/platform/rockchip/iep/iep.c | 38 ++++++++++++++++++++---
 1 file changed, 33 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/rockchip/iep/iep.c b/drivers/media/platform/rockchip/iep/iep.c
index 0598d0d2f6aa..247856aeaf31 100644
--- a/drivers/media/platform/rockchip/iep/iep.c
+++ b/drivers/media/platform/rockchip/iep/iep.c
@@ -332,6 +332,38 @@ static void iep_set_dst_meta(struct iep_ctx *ctx, struct vb2_v4l2_buffer *src,
 			      ctx->dst_fmt.plane_fmt[0].sizeimage);
 }
 
+/*
+ * In field-rate mode both CAPTURE buffers of a job come from one OUTPUT
+ * buffer. The first carries the OUTPUT timestamp, the second one is placed
+ * half a frame period later. The period is taken from real timestamps only:
+ *  - the previous OUTPUT buffer of this stream, once there is one;
+ *  - for the first frame after STREAMON, the next OUTPUT buffer, if
+ *    userspace has queued it by the time the job starts.
+ * If neither is available, or the timestamps do not increase, the offset is
+ * 0 and both CAPTURE buffers carry the OUTPUT timestamp. The period is not
+ * guessed, and VIDIOC_S_PARM cannot supply it because mem2mem devices other
+ * than encoders do not implement it. Userspace that wants distinct
+ * timestamps from the first frame on queues two OUTPUT buffers before the
+ * later of the two STREAMON calls.
+ *
+ * Must be called after @src has been removed from the ready queue.
+ */
+static u64 iep_second_field_offset(struct iep_ctx *ctx,
+				   struct vb2_v4l2_buffer *src)
+{
+	u64 ts = src->vb2_buf.timestamp;
+	struct vb2_v4l2_buffer *next;
+
+	if (ctx->prev_ts_valid)
+		return ts > ctx->prev_ts ? (ts - ctx->prev_ts) / 2 : 0;
+
+	next = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	if (next && next->vb2_buf.timestamp > ts)
+		return (next->vb2_buf.timestamp - ts) / 2;
+
+	return 0;
+}
+
 static void iep_device_run(void *priv)
 {
 	struct iep_ctx *ctx = priv;
@@ -398,11 +430,7 @@ static void iep_device_run(void *priv)
 		dst1 = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
 		ctx->job_dst[1] = dst1;
 		ctx->job_ndst = 2;
-
-		if (ctx->prev_ts_valid &&
-		    src->vb2_buf.timestamp > ctx->prev_ts)
-			half_period = (src->vb2_buf.timestamp -
-				       ctx->prev_ts) / 2;
+		half_period = iep_second_field_offset(ctx, src);
 	}
 	ctx->prev_ts = src->vb2_buf.timestamp;
 	ctx->prev_ts_valid = true;
-- 
