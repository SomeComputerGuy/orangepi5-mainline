From b8141e07cef1ea716b7dad3bdce8fb023f56052f Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 10:52:49 +0000
Subject: [PATCH 2292/2312] media: v4l2-h264: Leave MVC inter-view references
 out of the reference lists

The initial reference picture lists of 8.2.4.2 hold the temporal
references of the view being decoded. The MVC inter-view references in
the DPB come after them (H.8.2.1), in an order which the subset SPS
gives: leave them out of the lists the builder makes, for the driver to
append.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/v4l2-core/v4l2-h264.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/media/v4l2-core/v4l2-h264.c b/drivers/media/v4l2-core/v4l2-h264.c
index a3e180444725..2f84f38b4aed 100644
--- a/drivers/media/v4l2-core/v4l2-h264.c
+++ b/drivers/media/v4l2-core/v4l2-h264.c
@@ -53,7 +53,12 @@ v4l2_h264_init_reflist_builder(struct v4l2_h264_reflist_builder *b,
 	}
 
 	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
-		if (!(dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+		/*
+		 * MVC inter-view references are appended to the initial
+		 * lists by the caller, see H.8.2.1.
+		 */
+		if (!(dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE) ||
+		    (dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_INTER_VIEW))
 			continue;
 
 		if (dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM)
@@ -122,7 +127,12 @@ v4l2_h264_init_reflist_builder_gen(struct v4l2_h264_reflist_builder *b,
 	b->cur_pic_fields = fields;
 
 	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
-		if (!(dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+		/*
+		 * MVC inter-view references are appended to the initial
+		 * lists by the caller, see H.8.2.1.
+		 */
+		if (!(dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE) ||
+		    (dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_INTER_VIEW))
 			continue;
 
 		if (dpb[i].flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM)
-- 
2.55.0

