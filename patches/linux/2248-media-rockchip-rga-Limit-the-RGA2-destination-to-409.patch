From 6a6bc659166a8c56b720cb28e69466d7195a9891 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 3 Nov 2026 05:12:29 +0000
Subject: [PATCH 2248/2271] media: rockchip: rga: Limit the RGA2 destination to
 4096x4096

The RGA2 accepts sources up to 8192x8192, but it cannot write a
destination wider or taller than 4096 pixels. The driver uses the 8192
source limit for both queues, so it accepts such a CAPTURE format and the
job then goes wrong.

On RK3588 (RGA2 at fdb80000) with XR24 on both queues, one frame per case,
random input, output compared with the input on the CPU:
 - a same-size copy at 4096x512 or 512x4096 matches the input exactly;
 - a copy at 4098x512, 6144x512, 8192x256, 512x4098 or 256x8192 gives
   wrong pixels (the whole frame for widths above 4096, rows 4096 and
   beyond for 256x8192);
 - an upscale to 8192x512 or 8192x256 never completes ("job timed out,
   resetting the core");
 - sources of 8192x256 and 256x8192 downscaled to 4096 are fine.

The Rockchip vendor driver gives every RGA2E the same limits: input
8192x8192, output 4096x4096.

Add a separate destination limit to struct rga_hw and apply it to the
CAPTURE queue. RGA2 gets 4096x4096. RGA3 keeps its current limit
(RGA3_MAX_OUTPUT_*) on both queues, so it behaves as before. The default
format comes from the destination limit, so it is valid on both queues.

Fixes: f7e7b48e6d79 ("[media] rockchip/rga: v4l2 m2m support")
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/platform/rockchip/rga/rga-hw.c  | 2 ++
 drivers/media/platform/rockchip/rga/rga-hw.h  | 2 ++
 drivers/media/platform/rockchip/rga/rga.c     | 7 +++++--
 drivers/media/platform/rockchip/rga/rga.h     | 2 ++
 drivers/media/platform/rockchip/rga/rga3-hw.c | 2 ++
 5 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/rockchip/rga/rga-hw.c b/drivers/media/platform/rockchip/rga/rga-hw.c
index 448c0806bfe6..d265519c03db 100644
--- a/drivers/media/platform/rockchip/rga/rga-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga-hw.c
@@ -594,6 +594,8 @@ const struct rga_hw rga2_hw = {
 	.max_width = MAX_WIDTH,
 	.min_height = MIN_HEIGHT,
 	.max_height = MAX_HEIGHT,
+	.max_dst_width = MAX_DST_WIDTH,
+	.max_dst_height = MAX_DST_HEIGHT,
 	.max_scaling_factor = MAX_SCALING_FACTOR,
 	.stride_alignment = 4,
 	.features = RGA_FEATURE_FLIP
diff --git a/drivers/media/platform/rockchip/rga/rga-hw.h b/drivers/media/platform/rockchip/rga/rga-hw.h
index 14ffa5ebd453..11827a958c90 100644
--- a/drivers/media/platform/rockchip/rga/rga-hw.h
+++ b/drivers/media/platform/rockchip/rga/rga-hw.h
@@ -13,6 +13,8 @@
 /* Hardware limits */
 #define MAX_WIDTH 8192
 #define MAX_HEIGHT 8192
+#define MAX_DST_WIDTH 4096
+#define MAX_DST_HEIGHT 4096
 
 #define MIN_WIDTH 34
 #define MIN_HEIGHT 34
diff --git a/drivers/media/platform/rockchip/rga/rga.c b/drivers/media/platform/rockchip/rga/rga.c
index 7dacbd85d853..6e95203b9b95 100644
--- a/drivers/media/platform/rockchip/rga/rga.c
+++ b/drivers/media/platform/rockchip/rga/rga.c
@@ -413,8 +413,8 @@ static int rga_open(struct file *file)
 	struct rockchip_rga *rga = video_drvdata(file);
 	struct rga_ctx *ctx = NULL;
 	int ret = 0;
-	u32 def_width = clamp(DEFAULT_WIDTH, rga->hw->min_width, rga->hw->max_width);
-	u32 def_height = clamp(DEFAULT_HEIGHT, rga->hw->min_height, rga->hw->max_height);
+	u32 def_width = clamp(DEFAULT_WIDTH, rga->hw->min_width, rga->hw->max_dst_width);
+	u32 def_height = clamp(DEFAULT_HEIGHT, rga->hw->min_height, rga->hw->max_dst_height);
 	struct rga_frame def_frame = {
 		.crop.left = 0,
 		.crop.top = 0,
@@ -596,6 +596,9 @@ static int vidioc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
 	if (V4L2_TYPE_IS_CAPTURE(f->type)) {
 		const struct rga_frame *frm;
 
+		frmsize.max_width = hw->max_dst_width;
+		frmsize.max_height = hw->max_dst_height;
+
 		frm = rga_get_frame(ctx, f->type);
 		if (IS_ERR(frm))
 			return PTR_ERR(frm);
diff --git a/drivers/media/platform/rockchip/rga/rga.h b/drivers/media/platform/rockchip/rga/rga.h
index c83cc7c546eb..517dee6ead64 100644
--- a/drivers/media/platform/rockchip/rga/rga.h
+++ b/drivers/media/platform/rockchip/rga/rga.h
@@ -197,6 +197,8 @@ struct rga_hw {
 	size_t cmdbuf_size;
 	u32 min_width, min_height;
 	u32 max_width, max_height;
+	/* Destination (CAPTURE) limit, can be smaller than the source one */
+	u32 max_dst_width, max_dst_height;
 	u8 max_scaling_factor;
 	u8 stride_alignment;
 	u8 features;
diff --git a/drivers/media/platform/rockchip/rga/rga3-hw.c b/drivers/media/platform/rockchip/rga/rga3-hw.c
index 972cf5ce9748..2760e8922026 100644
--- a/drivers/media/platform/rockchip/rga/rga3-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga3-hw.c
@@ -536,6 +536,8 @@ const struct rga_hw rga3_hw = {
 	/* use output size, as it's a bit smaller than the input size */
 	.max_width = RGA3_MAX_OUTPUT_WIDTH,
 	.max_height = RGA3_MAX_OUTPUT_HEIGHT,
+	.max_dst_width = RGA3_MAX_OUTPUT_WIDTH,
+	.max_dst_height = RGA3_MAX_OUTPUT_HEIGHT,
 	.max_scaling_factor = RGA3_MAX_SCALING_FACTOR,
 	.stride_alignment = 16,
 	.features = 0,
-- 
