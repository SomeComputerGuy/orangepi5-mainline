From ed2bec199d95a854c0b487b5f53cbca235dc0880 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 7 Nov 2026 23:24:15 +0000
Subject: [PATCH 2343/2409] drm/display: hdmi: Send the content type in the AVI
 InfoFrame

The "content type" connector property lets userspace tell the sink what
kind of content it shows (graphics, photo, cinema, game), which the AVI
InfoFrame carries in its ITC and CN fields. Drivers using the HDMI state
helper could attach the property, but the helper never put its value in
the AVI InfoFrame.

Fill the fields with drm_hdmi_avi_infoframe_content_type(), as i915 does.
Without the property the content type stays "No Data" (ITC 0), as before.
The InfoFrames are only written on a modeset, so a content type change
needs one, like a colorspace change.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/display/drm_hdmi_state_helper.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/gpu/drm/display/drm_hdmi_state_helper.c b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
index 38e32d174f3d..ede3fe9b6653 100644
--- a/drivers/gpu/drm/display/drm_hdmi_state_helper.c
+++ b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
@@ -817,6 +817,7 @@ static int hdmi_generate_avi_infoframe(const struct drm_connector *connector,
 	drm_hdmi_avi_infoframe_quant_range(frame, connector, mode, rgb_quant_range);
 	drm_hdmi_avi_infoframe_colorimetry(frame, conn_state);
 	drm_hdmi_avi_infoframe_bars(frame, conn_state);
+	drm_hdmi_avi_infoframe_content_type(frame, conn_state);
 
 	infoframe->set = true;
 
@@ -1266,6 +1267,7 @@ int drm_atomic_helper_connector_hdmi_check(struct drm_connector *connector,
 	    old_conn_state->hdmi.frl_rate_per_lane != new_conn_state->hdmi.frl_rate_per_lane ||
 	    old_conn_state->hdmi.frl_lanes != new_conn_state->hdmi.frl_lanes ||
 	    old_conn_state->colorspace != new_conn_state->colorspace ||
+	    old_conn_state->content_type != new_conn_state->content_type ||
 	    !drm_connector_atomic_hdr_metadata_equal(old_conn_state, new_conn_state)) {
 		struct drm_crtc *crtc = new_conn_state->crtc;
 		struct drm_crtc_state *crtc_state;
-- 
