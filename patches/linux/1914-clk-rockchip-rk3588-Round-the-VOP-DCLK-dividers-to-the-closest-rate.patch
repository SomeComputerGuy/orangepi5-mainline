From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 02 Nov 2026 06:21:51 +0000
Subject: [PATCH] clk: rockchip: rk3588: Round the VOP DCLK dividers to the closest rate

dclk_vop0/1/2_src and dclk_vop3 divide GPLL, CPLL, V0PLL or AUPLL by
an integer to make a VOP pixel clock. Their dividers round down, so
each parent only offers its closest rate not above the request, and
the composite then takes the parent whose offer is closest. A parent
that is a few Hz too fast is skipped in favour of one that is off by a
lot:

- 3840x2160@29.97Hz (296703 kHz) while V0PLL runs at 593406990 Hz for
  another video port's 3840x2160@59.94Hz (593407 kHz): V0PLL / 2 is
  296703495 Hz, 495 Hz too fast, so V0PLL offers / 3 = 197.8 MHz and
  the DCLK ends up on AUPLL / 3 = 262.144 MHz, 11.6 % slow (measured).
  1920x1080@59.94Hz (148352 kHz) only works because 4 x 148352 happens
  to round above 593407.
- With the PLLs at their usual rates (GPLL 1188 MHz, CPLL 1500 MHz,
  AUPLL 786.432 MHz), 1920x1080@59.94Hz cannot take GPLL / 8 =
  148.5 MHz (+0.1 %) and runs from CPLL / 11 = 136.36 MHz, 8 % slow.

A pixel clock's tolerance is symmetric (sinks accept +/- 0.5 %), so the
closest rate is the right one. Round these four dividers to the closest
rate; nothing but the VOP uses them. The dividers are 7 bits wide on
dclk_vop0_src and dclk_vop3 (up to 128) and 5 bits on dclk_vop1_src and
dclk_vop2_src (up to 32), which limits how far below a parent's rate
each video port can go.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/clk/rockchip/clk-rk3588.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/clk/rockchip/clk-rk3588.c b/drivers/clk/rockchip/clk-rk3588.c
index 6d4bc5b61341..6cc9d492d4db 100644
--- a/drivers/clk/rockchip/clk-rk3588.c
+++ b/drivers/clk/rockchip/clk-rk3588.c
@@ -2098,13 +2098,16 @@ static struct rockchip_clk_branch rk3588_early_clk_branches[] __initdata = {
 	GATE(ACLK_VOP, "aclk_vop", "aclk_vop_sub_src", 0,
 			RK3588_CLKGATE_CON(52), 9, GFLAGS),
 	COMPOSITE(DCLK_VOP0_SRC, "dclk_vop0_src", gpll_cpll_v0pll_aupll_p, 0,
-			RK3588_CLKSEL_CON(111), 7, 2, MFLAGS, 0, 7, DFLAGS,
+			RK3588_CLKSEL_CON(111), 7, 2, MFLAGS, 0, 7,
+			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(52), 10, GFLAGS),
 	COMPOSITE(DCLK_VOP1_SRC, "dclk_vop1_src", gpll_cpll_v0pll_aupll_p, 0,
-			RK3588_CLKSEL_CON(111), 14, 2, MFLAGS, 9, 5, DFLAGS,
+			RK3588_CLKSEL_CON(111), 14, 2, MFLAGS, 9, 5,
+			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(52), 11, GFLAGS),
 	COMPOSITE(DCLK_VOP2_SRC, "dclk_vop2_src", gpll_cpll_v0pll_aupll_p, 0,
-			RK3588_CLKSEL_CON(112), 5, 2, MFLAGS, 0, 5, DFLAGS,
+			RK3588_CLKSEL_CON(112), 5, 2, MFLAGS, 0, 5,
+			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(52), 12, GFLAGS),
 	COMPOSITE_NODIV(DCLK_VOP0, "dclk_vop0", dclk_vop0_p,
 			CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT,
@@ -2119,7 +2122,8 @@ static struct rockchip_clk_branch rk3588_early_clk_branches[] __initdata = {
 			RK3588_CLKSEL_CON(112), 11, 2, MFLAGS,
 			RK3588_CLKGATE_CON(53), 1, GFLAGS),
 	COMPOSITE(DCLK_VOP3, "dclk_vop3", gpll_cpll_v0pll_aupll_p, 0,
-			RK3588_CLKSEL_CON(113), 7, 2, MFLAGS, 0, 7, DFLAGS,
+			RK3588_CLKSEL_CON(113), 7, 2, MFLAGS, 0, 7,
+			DFLAGS | CLK_DIVIDER_ROUND_CLOSEST,
 			RK3588_CLKGATE_CON(53), 2, GFLAGS),
 	GATE(PCLK_DSIHOST0, "pclk_dsihost0", "pclk_vop_root", 0,
 			RK3588_CLKGATE_CON(53), 4, GFLAGS),
-- 
