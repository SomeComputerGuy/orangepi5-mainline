From 7a6d7225ae6ff3ae99f6b3c9cb4aef572a6f242a Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sun, 1 Nov 2026 06:05:37 +0000
Subject: [PATCH] drm/rockchip: vop2: Raise ACLK for every video port above 600
 Mpixel/s

Commit "drm/rockchip: vop2: Scale ACLK rate up for RK3588 FRL display
modes" raises ACLK_VOP from 500 to 750 MHz while a video port drives
an HDMI 2.1 FRL link, because the default rate can't sustain the memory
traffic of modes like 3840x2160@120Hz: the window line buffers run dry
and the video port reports POST_BUF_EMPTY.

The VOP doesn't know about the link, though: what it has to fetch and
blend is set by the pixel rate. 3840x2160@120Hz with YCbCr 4:2:0 at
8 bpc has a TMDS character rate of 594 MHz, so the HDMI state helpers
send it over TMDS, not FRL, and the video port then processes
1188 Mpixel/s with ACLK left at 500 MHz. On an Orange Pi 5 with an
HDMI 2.1 TV that mode underflows (POST_BUF_EMPTY, scrambled picture),
while the same mode in RGB, which needs FRL and so gets the raised
rate, is clean with a full screen layer.

Raise ACLK whenever the pixel clock of the video port is above
VOP2_MAX_DCLK_RATE (600 MHz), and keep doing so for FRL links. Track
the raised rate per video port, so that disable drops exactly the
reference enable took, and drop it as well when atomic_enable fails
after taking it, which leaked the reference before.

(cherry picked from commit 7710e0ef512c3ace8189d2547395fef1dc05d0de)

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.c | 67 +++++++++++++++-----
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.h |  9 ++-
 2 files changed, 58 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
index 86d5c3cb8812..61d2e2478210 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -105,7 +105,7 @@ enum vop2_afbc_format {
 
 #define VOP2_MAX_DCLK_RATE		600000000ULL
 #define VOP2_ACLK_RATE_DEFAULT		500000000UL
-#define VOP2_ACLK_RATE_FRL		750000000UL
+#define VOP2_ACLK_RATE_HIGH		750000000UL
 
 /*
  * bus-format types.
@@ -1048,6 +1048,50 @@ static bool vop2_gamma_lut_in_use(struct vop2 *vop2, struct vop2_video_port *vp)
 	return gamma_en_vp_id != nr_vps && gamma_en_vp_id != vp->id;
 }
 
+/*
+ * The default ACLK rate of the RK3588 VOP2 can't sustain the memory traffic
+ * of a video port that processes more than VOP2_MAX_DCLK_RATE pixels per
+ * second (e.g. 3840x2160@120Hz, 1188 MHz): its line buffers run dry and the
+ * port reports POST_BUF_EMPTY. That depends on the pixel rate, not on the
+ * HDMI link: the same mode can be sent with YCbCr 4:2:0 over TMDS (594 MHz
+ * TMDS character rate), and the VOP still fetches and blends 1188 Mpixel/s.
+ * Keep the FRL condition too, FRL modes below that rate have always used the
+ * raised rate.
+ */
+static bool vop2_crtc_needs_aclk_boost(struct drm_crtc_state *crtc_state)
+{
+	struct rockchip_crtc_state *vcstate = to_rockchip_crtc_state(crtc_state);
+
+	return vcstate->frl_enabled ||
+	       crtc_state->adjusted_mode.crtc_clock * 1000ULL > VOP2_MAX_DCLK_RATE;
+}
+
+static void vop2_crtc_get_aclk_boost(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+
+	if (vp->aclk_boost)
+		return;
+
+	if (!vop2->aclk_boost_count++)
+		clk_set_rate(vop2->aclk, VOP2_ACLK_RATE_HIGH);
+
+	vp->aclk_boost = true;
+}
+
+static void vop2_crtc_put_aclk_boost(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+
+	if (!vp->aclk_boost)
+		return;
+
+	vp->aclk_boost = false;
+
+	if (!--vop2->aclk_boost_count)
+		clk_set_rate(vop2->aclk, VOP2_ACLK_RATE_DEFAULT);
+}
+
 static void vop2_crtc_atomic_disable(struct drm_crtc *crtc,
 				     struct drm_atomic_commit *state)
 {
@@ -1091,16 +1135,7 @@ static void vop2_crtc_atomic_disable(struct drm_crtc *crtc,
 
 	clk_disable_unprepare(vp->dclk);
 
-	if (vop2->version == VOP_VERSION_RK3588) {
-		struct rockchip_crtc_state *vcstate = to_rockchip_crtc_state(old_crtc_state);
-
-		if (vcstate->frl_enabled) {
-			vop2->frl_vp_count--;
-
-			if (!vop2->frl_vp_count)
-				clk_set_rate(vop2->aclk, VOP2_ACLK_RATE_DEFAULT);
-		}
-	}
+	vop2_crtc_put_aclk_boost(vp);
 
 	vp->enabled = false;
 
@@ -1917,12 +1952,9 @@ static void vop2_crtc_atomic_enable(struct drm_crtc *crtc,
 
 	vop2->enable_count++;
 
-	if (vop2->version == VOP_VERSION_RK3588 && vcstate->frl_enabled) {
-		if (!vop2->frl_vp_count)
-			clk_set_rate(vop2->aclk, VOP2_ACLK_RATE_FRL);
-
-		vop2->frl_vp_count++;
-	}
+	if (vop2->version == VOP_VERSION_RK3588 &&
+	    vop2_crtc_needs_aclk_boost(crtc_state))
+		vop2_crtc_get_aclk_boost(vp);
 
 	vcstate->yuv_overlay = is_yuv_output(vcstate->bus_format);
 
@@ -2055,6 +2087,7 @@ static void vop2_crtc_atomic_enable(struct drm_crtc *crtc,
 	return;
 
 err_put_enable_count:
+	vop2_crtc_put_aclk_boost(vp);
 	if (!--vop2->enable_count)
 		vop2_disable(vop2);
 
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
index bb7492765e98..990ac3ea9da9 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
@@ -253,6 +253,12 @@ struct vop2_video_port {
 	 */
 	bool enabled;
 
+	/**
+	 * @aclk_boost: this video port holds a reference on the raised ACLK
+	 * rate, see vop2_crtc_needs_aclk_boost().
+	 */
+	bool aclk_boost;
+
 	/**
 	 * @win_mask: Bitmask of windows attached to the video port;
 	 */
@@ -337,7 +343,8 @@ struct vop2 {
 	 * we need a ref counter here.
 	 */
 	unsigned int enable_count;
-	unsigned int frl_vp_count;
+	/** @aclk_boost_count: number of video ports that need the raised ACLK rate */
+	unsigned int aclk_boost_count;
 	struct clk *hclk;
 	struct clk *aclk;
 	struct clk *pclk;
-- 
2.55.0

