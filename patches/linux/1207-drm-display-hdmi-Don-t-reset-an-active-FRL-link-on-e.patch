From 371c6c736996271bfd913678e2b01be6cb1a8255 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 31 Oct 2026 17:03:55 +0000
Subject: [PATCH 1/3] drm/display: hdmi: Don't reset an active FRL link on
 every connector probe

drm_connector_hdmi_sync_scdc() restores the sink's SCDC state after a
reconnect by resetting the CRTC when it finds the sink not configured.
With FRL support it is also called while the link runs in FRL mode, but
it still decides by the TMDS_Scrambler_Enable bit in SCDC TMDS_Config.
Scrambling is never enabled in FRL mode, so every .detect_ctx() call
while FRL is active, i.e. every connector probe from userspace or the
fbdev client, ends in a full modeset with a new link training, even
though the sink is perfectly configured. Each probe blanks the display
for a moment.

In FRL mode check the FRL_Rate field of SCDC Config_1 instead. The sink
clears it on a reset or reconnect, exactly when the link needs to be
trained again.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/display/drm_hdmi_helper.c | 29 +++++++++++++++++------
 1 file changed, 22 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/display/drm_hdmi_helper.c b/drivers/gpu/drm/display/drm_hdmi_helper.c
index a6de9f7..35cafb8 100644
--- a/drivers/gpu/drm/display/drm_hdmi_helper.c
+++ b/drivers/gpu/drm/display/drm_hdmi_helper.c
@@ -792,14 +792,29 @@ int drm_connector_hdmi_sync_scdc(struct drm_connector *connector, bool plugged,
 	    !try_wait_for_completion(&conn_state->commit->hw_done))
 		return 0;
 
-	ret = drm_scdc_readb(connector->ddc, SCDC_TMDS_CONFIG, &config);
-	if (ret) {
-		drm_dbg_kms(dev, "Failed to read TMDS config: %d\n", ret);
-		return ret;
-	}
+	/*
+	 * In FRL mode scrambling is not used, the sink is configured through
+	 * the FRL rate in SCDC Config_1 instead, which it clears upon reset.
+	 */
+	if (READ_ONCE(hdmi->frl_enabled)) {
+		ret = drm_scdc_readb(connector->ddc, SCDC_CONFIG_1, &config);
+		if (ret) {
+			drm_dbg_kms(dev, "Failed to read SCDC config: %d\n", ret);
+			return ret;
+		}
 
-	if (config & SCDC_SCRAMBLING_ENABLE)
-		return 0;
+		if (config & SCDC_FRL_RATE_MASK)
+			return 0;
+	} else {
+		ret = drm_scdc_readb(connector->ddc, SCDC_TMDS_CONFIG, &config);
+		if (ret) {
+			drm_dbg_kms(dev, "Failed to read TMDS config: %d\n", ret);
+			return ret;
+		}
+
+		if (config & SCDC_SCRAMBLING_ENABLE)
+			return 0;
+	}
 
 	/*
 	 * HDMI 2.0 requires that one should not send scrambled data prior
-- 
2.55.0

