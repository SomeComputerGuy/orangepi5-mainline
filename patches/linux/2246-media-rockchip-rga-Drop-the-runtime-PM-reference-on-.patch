From 6e264b6a6efbee9beeb822956b2b9201e2da74d9 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 3 Nov 2026 01:01:16 +0000
Subject: [PATCH 2246/2271] media: rockchip: rga: Drop the runtime PM reference
 on core bind errors

rga_core_bind() resumes the core with pm_runtime_resume_and_get() to
read its version. When it rejects a second core because the versions
differ, the first core has no IOMMU domain, or iommu_attach_device()
fails, it returns without pm_runtime_put(). The usage count leaks, and
the core stays powered.

When the versions differ, the core has also been attached to the first
core's domain already, and nothing detaches it.

Check the version before attaching the domain, and drop the runtime PM
reference on every error path.

Fixes: 88ac1cdf8235 ("media: rockchip: rga: bind all cores to the master")
Fixes: 953b6c1e14d8 ("media: rockchip: rga: put all cores into first core iommu domain")
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/platform/rockchip/rga/rga.c | 27 ++++++++++++++---------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/drivers/media/platform/rockchip/rga/rga.c b/drivers/media/platform/rockchip/rga/rga.c
index 91642fd7d79d..b798e1e692c2 100644
--- a/drivers/media/platform/rockchip/rga/rga.c
+++ b/drivers/media/platform/rockchip/rga/rga.c
@@ -887,25 +887,28 @@ static int rga_core_bind(struct device *dev, struct device *master, void *data)
 		  rga->version.major, rga->version.minor);
 
 	if (rga->num_cores) {
-		/* Attach to the first cores iommu */
-		struct iommu_domain *domain = iommu_get_domain_for_dev(rga->cores[0]->dev);
+		struct iommu_domain *domain;
+
+		/* we are not the first core, expect that we have the same version */
+		if (rga->version.major != version.major || rga->version.minor != version.minor) {
+			v4l2_err(&rga->v4l2_dev, "Detected multi-core setup with different core versions!\n");
+			ret = -ENODEV;
+			goto err_put;
+		}
 
+		/* Attach to the first cores iommu */
+		domain = iommu_get_domain_for_dev(rga->cores[0]->dev);
 		if (!domain) {
 			dev_err(core->dev, "Couldn't get domain of the first core\n");
-			return -ENODEV;
+			ret = -ENODEV;
+			goto err_put;
 		}
 		ret = iommu_attach_device(domain, core->dev);
 		if (ret) {
 			dev_err(core->dev, "Couldn't attach to the domain of the first core\n");
-			return ret;
+			goto err_put;
 		}
 		core->attached_domain = domain;
-
-		/* we are not the first core, expect that we have the same version */
-		if (rga->version.major != version.major || rga->version.minor != version.minor) {
-			v4l2_err(&rga->v4l2_dev, "Detected multi-core setup with different core versions!\n");
-			return -ENODEV;
-		}
 	} else
 		rga->version = version;
 
@@ -916,6 +919,10 @@ static int rga_core_bind(struct device *dev, struct device *master, void *data)
 	spin_unlock_irqrestore(&rga->cores_lock, flags);
 
 	return 0;
+
+err_put:
+	pm_runtime_put(core->dev);
+	return ret;
 }
 
 static void rga_core_unbind(struct device *dev, struct device *master,
-- 
