From 1ec8be7a682ce230cb30845b1e5a57e14c272c78 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 7 Nov 2026 23:23:44 +0000
Subject: [PATCH 2342/2409] video/hdmi: Add the HDMI Forum vendor specific
 InfoFrame

HDMI 2.1 sources signal features of the HDMI Forum, such as Auto Low
Latency Mode (ALLM), in the HDMI Forum vendor specific InfoFrame
(HF-VSIF): a vendor specific InfoFrame with the HDMI Forum OUI, version 1
in PB4 and the feature flags in PB5 (3D_Valid in bit 0, ALLM_Mode in bit
1, CCBPC in bits 7:4).

Add struct hdmi_forum_vendor_infoframe with the ALLM_Mode flag, and its
init, check and pack functions, and let the generic vendor InfoFrame
functions handle it next to the HDMI 1.4 one by its OUI, so that it can
be sent through the existing HDMI vendor InfoFrame path of drivers. The
3D and CCBPC fields are left at zero (no 3D, colour depth not
indicated), and unpacking it is not supported.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/video/hdmi.c | 154 ++++++++++++++++++++++++++++++++++++++++---
 include/linux/hdmi.h |  28 ++++++++
 2 files changed, 174 insertions(+), 8 deletions(-)

diff --git a/drivers/video/hdmi.c b/drivers/video/hdmi.c
index 5388f6e4e824..b7dacd1810a0 100644
--- a/drivers/video/hdmi.c
+++ b/drivers/video/hdmi.c
@@ -28,6 +28,7 @@
 #include <linux/export.h>
 #include <linux/hdmi.h>
 #include <linux/string.h>
+#include <linux/string_choices.h>
 #include <linux/device.h>
 
 #define hdmi_log(fmt, ...) dev_printk(level, dev, fmt, ##__VA_ARGS__)
@@ -829,6 +830,131 @@ ssize_t hdmi_vendor_infoframe_pack(struct hdmi_vendor_infoframe *frame,
 }
 EXPORT_SYMBOL(hdmi_vendor_infoframe_pack);
 
+/**
+ * hdmi_forum_vendor_infoframe_init() - initialize an HDMI Forum vendor
+ * specific infoframe
+ * @frame: HDMI Forum vendor specific infoframe
+ *
+ * Returns 0 on success or a negative error code on failure.
+ */
+int hdmi_forum_vendor_infoframe_init(struct hdmi_forum_vendor_infoframe *frame)
+{
+	memset(frame, 0, sizeof(*frame));
+
+	frame->type = HDMI_INFOFRAME_TYPE_VENDOR;
+	frame->version = 1;
+	frame->oui = HDMI_FORUM_IEEE_OUI;
+	frame->length = HDMI_FORUM_VENDOR_INFOFRAME_SIZE;
+
+	return 0;
+}
+EXPORT_SYMBOL(hdmi_forum_vendor_infoframe_init);
+
+static int
+hdmi_forum_vendor_infoframe_check_only(const struct hdmi_forum_vendor_infoframe *frame)
+{
+	if (frame->type != HDMI_INFOFRAME_TYPE_VENDOR ||
+	    frame->version != 1 ||
+	    frame->oui != HDMI_FORUM_IEEE_OUI ||
+	    frame->length != HDMI_FORUM_VENDOR_INFOFRAME_SIZE)
+		return -EINVAL;
+
+	return 0;
+}
+
+/**
+ * hdmi_forum_vendor_infoframe_check() - check an HDMI Forum vendor specific
+ * infoframe
+ * @frame: HDMI Forum vendor specific infoframe
+ *
+ * Validates that the infoframe is consistent and updates derived fields
+ * (eg. length) based on other fields.
+ *
+ * Returns 0 on success or a negative error code on failure.
+ */
+int hdmi_forum_vendor_infoframe_check(struct hdmi_forum_vendor_infoframe *frame)
+{
+	frame->length = HDMI_FORUM_VENDOR_INFOFRAME_SIZE;
+
+	return hdmi_forum_vendor_infoframe_check_only(frame);
+}
+EXPORT_SYMBOL(hdmi_forum_vendor_infoframe_check);
+
+/**
+ * hdmi_forum_vendor_infoframe_pack_only() - write an HDMI Forum vendor
+ * specific infoframe to binary buffer
+ * @frame: HDMI Forum vendor specific infoframe
+ * @buffer: destination buffer
+ * @size: size of buffer
+ *
+ * Packs the information contained in the @frame structure into a binary
+ * representation that can be written into the corresponding controller
+ * registers. Also computes the checksum.
+ *
+ * Returns the number of bytes packed into the binary buffer or a negative
+ * error code on failure.
+ */
+ssize_t hdmi_forum_vendor_infoframe_pack_only(const struct hdmi_forum_vendor_infoframe *frame,
+					      void *buffer, size_t size)
+{
+	u8 *ptr = buffer;
+	size_t length;
+	int ret;
+
+	ret = hdmi_forum_vendor_infoframe_check_only(frame);
+	if (ret)
+		return ret;
+
+	length = HDMI_INFOFRAME_HEADER_SIZE + frame->length;
+
+	if (size < length)
+		return -ENOSPC;
+
+	memset(buffer, 0, size);
+
+	ptr[0] = frame->type;
+	ptr[1] = frame->version;
+	ptr[2] = frame->length;
+	ptr[3] = 0; /* checksum */
+
+	/* HDMI Forum OUI */
+	ptr[4] = 0xd8;
+	ptr[5] = 0x5d;
+	ptr[6] = 0xc4;
+
+	ptr[7] = 1;	/* HF-VSIF version */
+	if (frame->allm)
+		ptr[8] |= BIT(1);
+
+	hdmi_infoframe_set_checksum(buffer, length);
+
+	return length;
+}
+EXPORT_SYMBOL(hdmi_forum_vendor_infoframe_pack_only);
+
+/**
+ * hdmi_forum_vendor_infoframe_pack() - check an HDMI Forum vendor specific
+ * infoframe, and write it to binary buffer
+ * @frame: HDMI Forum vendor specific infoframe
+ * @buffer: destination buffer
+ * @size: size of buffer
+ *
+ * Returns the number of bytes packed into the binary buffer or a negative
+ * error code on failure.
+ */
+ssize_t hdmi_forum_vendor_infoframe_pack(struct hdmi_forum_vendor_infoframe *frame,
+					 void *buffer, size_t size)
+{
+	int ret;
+
+	ret = hdmi_forum_vendor_infoframe_check(frame);
+	if (ret)
+		return ret;
+
+	return hdmi_forum_vendor_infoframe_pack_only(frame, buffer, size);
+}
+EXPORT_SYMBOL(hdmi_forum_vendor_infoframe_pack);
+
 static int
 hdmi_vendor_any_infoframe_check_only(const union hdmi_vendor_any_infoframe *frame)
 {
@@ -995,11 +1121,14 @@ hdmi_vendor_any_infoframe_check(union hdmi_vendor_any_infoframe *frame)
 	if (ret)
 		return ret;
 
-	/* we only know about HDMI vendor infoframes */
-	if (frame->any.oui != HDMI_IEEE_OUI)
+	switch (frame->any.oui) {
+	case HDMI_IEEE_OUI:
+		return hdmi_vendor_infoframe_check(&frame->hdmi);
+	case HDMI_FORUM_IEEE_OUI:
+		return hdmi_forum_vendor_infoframe_check(&frame->hdmi_forum);
+	default:
 		return -EINVAL;
-
-	return hdmi_vendor_infoframe_check(&frame->hdmi);
+	}
 }
 
 /*
@@ -1015,11 +1144,15 @@ hdmi_vendor_any_infoframe_pack_only(const union hdmi_vendor_any_infoframe *frame
 	if (ret)
 		return ret;
 
-	/* we only know about HDMI vendor infoframes */
-	if (frame->any.oui != HDMI_IEEE_OUI)
+	switch (frame->any.oui) {
+	case HDMI_IEEE_OUI:
+		return hdmi_vendor_infoframe_pack_only(&frame->hdmi, buffer, size);
+	case HDMI_FORUM_IEEE_OUI:
+		return hdmi_forum_vendor_infoframe_pack_only(&frame->hdmi_forum,
+							     buffer, size);
+	default:
 		return -EINVAL;
-
-	return hdmi_vendor_infoframe_pack_only(&frame->hdmi, buffer, size);
+	}
 }
 
 /*
@@ -1647,6 +1780,11 @@ hdmi_vendor_any_infoframe_log(const char *level,
 	hdmi_infoframe_log_header(level, dev,
 				  (const struct hdmi_any_infoframe *)frame);
 
+	if (frame->any.oui == HDMI_FORUM_IEEE_OUI) {
+		hdmi_log("    HDMI Forum vendor specific infoframe\n");
+		hdmi_log("    ALLM mode: %s\n", str_on_off(frame->hdmi_forum.allm));
+		return;
+	}
 	if (frame->any.oui != HDMI_IEEE_OUI) {
 		hdmi_log("    not a HDMI vendor infoframe\n");
 		return;
diff --git a/include/linux/hdmi.h b/include/linux/hdmi.h
index 1a87d10dc349..f9063c71c4b7 100644
--- a/include/linux/hdmi.h
+++ b/include/linux/hdmi.h
@@ -137,6 +137,7 @@ int hdmi_frl_bandwidth_range_from_clock(unsigned long long clock,
 #define HDMI_AUDIO_INFOFRAME_SIZE  10
 #define HDMI_DRM_INFOFRAME_SIZE    26
 #define HDMI_VENDOR_INFOFRAME_SIZE  4
+#define HDMI_FORUM_VENDOR_INFOFRAME_SIZE  5
 #define HDMI_VTEM_INFOFRAME_SIZE   10
 
 /*
@@ -508,6 +509,32 @@ ssize_t hdmi_vendor_infoframe_pack_only(const struct hdmi_vendor_infoframe *fram
 					void *buffer, size_t size);
 int hdmi_vendor_infoframe_check(struct hdmi_vendor_infoframe *frame);
 
+/**
+ * struct hdmi_forum_vendor_infoframe - HDMI Forum vendor specific InfoFrame
+ * @type: HDMI_INFOFRAME_TYPE_VENDOR
+ * @version: InfoFrame version, 1
+ * @length: payload length, HDMI_FORUM_VENDOR_INFOFRAME_SIZE
+ * @oui: HDMI_FORUM_IEEE_OUI
+ * @allm: ALLM_Mode, ask the sink for its Auto Low Latency Mode
+ *
+ * The HF-VSIF of HDMI 2.1. Only the fields that are used are described:
+ * the 3D and CCBPC fields are always sent as zero.
+ */
+struct hdmi_forum_vendor_infoframe {
+	enum hdmi_infoframe_type type;
+	unsigned char version;
+	unsigned char length;
+	unsigned int oui;
+	bool allm;
+};
+
+int hdmi_forum_vendor_infoframe_init(struct hdmi_forum_vendor_infoframe *frame);
+int hdmi_forum_vendor_infoframe_check(struct hdmi_forum_vendor_infoframe *frame);
+ssize_t hdmi_forum_vendor_infoframe_pack_only(const struct hdmi_forum_vendor_infoframe *frame,
+					      void *buffer, size_t size);
+ssize_t hdmi_forum_vendor_infoframe_pack(struct hdmi_forum_vendor_infoframe *frame,
+					 void *buffer, size_t size);
+
 union hdmi_vendor_any_infoframe {
 	struct {
 		enum hdmi_infoframe_type type;
@@ -516,6 +543,7 @@ union hdmi_vendor_any_infoframe {
 		unsigned int oui;
 	} any;
 	struct hdmi_vendor_infoframe hdmi;
+	struct hdmi_forum_vendor_infoframe hdmi_forum;
 };
 
 /**
-- 
2.55.0

