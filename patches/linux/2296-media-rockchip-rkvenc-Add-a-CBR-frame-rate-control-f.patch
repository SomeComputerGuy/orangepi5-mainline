 .../platform/rockchip/rkvenc/rkvenc-h264.c    |  98 +++++++-
 .../platform/rockchip/rkvenc/rkvenc-hevc.c    |  12 -
 .../platform/rockchip/rkvenc/rkvenc-rc.c      | 228 ++++++++++++++++++
 .../media/platform/rockchip/rkvenc/rkvenc.h   |  52 ++++
 5 files changed, 376 insertions(+), 15 deletions(-)
 create mode 100644 drivers/media/platform/rockchip/rkvenc/rkvenc-rc.c

diff --git a/drivers/media/platform/rockchip/rkvenc/Makefile b/drivers/media/platform/rockchip/rkvenc/Makefile
index d092543e339b..d40fb3f58d87 100644
--- a/drivers/media/platform/rockchip/rkvenc/Makefile
+++ b/drivers/media/platform/rockchip/rkvenc/Makefile
@@ -5,4 +5,5 @@ rockchip-venc-y += \
