From ecade429d6b9bede8d2f3600bebee24b28457286 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 18:34:38 +0000
Subject: [PATCH 2305/2312] media: verisilicon: rockchip: vpu2: advertise
 MPEG-1 as V4L2_PIX_FMT_MPEG1_SLICE

The VPU2 decoders decode MPEG-1, but applications cannot find that out
from the MPEG-2 coded format. Enumerate V4L2_PIX_FMT_MPEG1_SLICE on the
VPU2 decoders (RK3328, RK3399, RK3568, RK3588 VPU121 and PX30) with the
limits of the MPEG-2 format, and select the MPEG-1 decoding mode from
the coded format instead of from a variant flag, which goes away.

The MPEG-2 controls are shared by both formats. V4L2_MPEG2_SEQ_FLAG_MPEG1
and the full pel picture flags are only accepted with the MPEG-1 format,
so the G1 based decoders and the VPU2 MPEG-2 format reject them as
before. A decoding job whose sequence control disagrees with the coded
format, which can happen after the format changed, fails.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/platform/verisilicon/hantro.h   |  3 --
 .../media/platform/verisilicon/hantro_drv.c   |  5 ++--
 .../media/platform/verisilicon/hantro_v4l2.c  |  2 ++
 .../verisilicon/rockchip_vpu2_hw_mpeg2_dec.c  |  7 +++--
 .../platform/verisilicon/rockchip_vpu_hw.c    | 30 ++++++++++++++++---
 5 files changed, 36 insertions(+), 11 deletions(-)

diff --git a/drivers/media/platform/verisilicon/hantro.h b/drivers/media/platform/verisilicon/hantro.h
index 1ef5118b551c..614b02a22618 100644
--- a/drivers/media/platform/verisilicon/hantro.h
+++ b/drivers/media/platform/verisilicon/hantro.h
@@ -82,8 +82,6 @@ struct hantro_irq {
  * @double_buffer:		core needs double buffering
  * @legacy_regs:		core uses legacy register set
  * @late_postproc:		postproc must be set up at the end of the job
- * @mpeg1_dec:			the MPEG-2 decoder also decodes MPEG-1
- *				(V4L2_MPEG2_SEQ_FLAG_MPEG1)
  * @multi_core:			identical instances of this variant can be driven as
  *				a single device, running jobs in parallel
  * @shared_devices:		an array of device ids that cannot run concurrently
@@ -111,7 +109,6 @@ struct hantro_variant {
 	unsigned int double_buffer : 1;
 	unsigned int legacy_regs : 1;
 	unsigned int late_postproc : 1;
-	unsigned int mpeg1_dec : 1;
 	unsigned int multi_core : 1;
 	const struct of_device_id *shared_devices;
 };
diff --git a/drivers/media/platform/verisilicon/hantro_drv.c b/drivers/media/platform/verisilicon/hantro_drv.c
index 5bedb3e3971d..30feb34e8a4f 100644
--- a/drivers/media/platform/verisilicon/hantro_drv.c
+++ b/drivers/media/platform/verisilicon/hantro_drv.c
@@ -398,8 +398,9 @@ static int hantro_try_ctrl(struct v4l2_ctrl *ctrl)
 	} else if (ctrl->id == V4L2_CID_STATELESS_MPEG2_SEQUENCE) {
 		const struct v4l2_ctrl_mpeg2_sequence *seq = ctrl->p_new.p_mpeg2_sequence;
 
+		/* MPEG-1 sequences come with the MPEG-1 coded format only */
 		if (seq->flags & V4L2_MPEG2_SEQ_FLAG_MPEG1 &&
-		    !ctx->dev->variant->mpeg1_dec)
+		    ctx->vpu_src_fmt->fourcc != V4L2_PIX_FMT_MPEG1_SLICE)
 			return -EINVAL;
 	} else if (ctrl->id == V4L2_CID_STATELESS_MPEG2_PICTURE) {
 		const struct v4l2_ctrl_mpeg2_picture *pic = ctrl->p_new.p_mpeg2_picture;
@@ -410,7 +411,7 @@ static int hantro_try_ctrl(struct v4l2_ctrl *ctrl)
 		/* Full pel vectors only exist in MPEG-1 */
 		if (pic->flags & (V4L2_MPEG2_PIC_FLAG_FULL_PEL_FORWARD |
 				  V4L2_MPEG2_PIC_FLAG_FULL_PEL_BACKWARD) &&
-		    !ctx->dev->variant->mpeg1_dec)
+		    ctx->vpu_src_fmt->fourcc != V4L2_PIX_FMT_MPEG1_SLICE)
 			return -EINVAL;
 	} else if (ctrl->id == V4L2_CID_STATELESS_AVS_SEQUENCE) {
 		const struct v4l2_ctrl_avs_sequence *seq = ctrl->p_new.p_avs_sequence;
diff --git a/drivers/media/platform/verisilicon/hantro_v4l2.c b/drivers/media/platform/verisilicon/hantro_v4l2.c
index d86807bba484..942c93bee066 100644
--- a/drivers/media/platform/verisilicon/hantro_v4l2.c
+++ b/drivers/media/platform/verisilicon/hantro_v4l2.c
@@ -597,6 +597,7 @@ hantro_update_requires_request(struct hantro_ctx *ctx, u32 fourcc)
 	case V4L2_PIX_FMT_JPEG:
 		ctx->fh.m2m_ctx->out_q_ctx.q.requires_requests = false;
 		break;
+	case V4L2_PIX_FMT_MPEG1_SLICE:
 	case V4L2_PIX_FMT_MPEG2_SLICE:
 	case V4L2_PIX_FMT_VP8_FRAME:
 	case V4L2_PIX_FMT_H264_SLICE:
@@ -626,6 +627,7 @@ hantro_update_requires_hold_capture_buf(struct hantro_ctx *ctx, u32 fourcc)
 		vq->subsystem_flags &= ~(VB2_V4L2_FL_SUPPORTS_M2M_HOLD_CAPTURE_BUF);
 		break;
 	case V4L2_PIX_FMT_H264_SLICE:
+	case V4L2_PIX_FMT_MPEG1_SLICE:
 	case V4L2_PIX_FMT_MPEG2_SLICE:
 		vq->subsystem_flags |= VB2_V4L2_FL_SUPPORTS_M2M_HOLD_CAPTURE_BUF;
 		break;
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c
index dc0154fd1538..714ebd7d638a 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c
@@ -172,9 +172,12 @@ int rockchip_vpu2_mpeg2_dec_run(struct hantro_ctx *ctx)
 	 * from MPEG-2 in the inverse quantisation mismatch control and has
 	 * full pel motion vectors. Userspace fills the MPEG-2 extension
 	 * fields with the MPEG-1 values. MPEG-1 has frame pictures only, and
-	 * full pel vectors do not exist in MPEG-2.
+	 * full pel vectors do not exist in MPEG-2. The coded format says
+	 * which one is decoded, the sequence flag has to agree with it.
 	 */
-	mpeg1 = seq->flags & V4L2_MPEG2_SEQ_FLAG_MPEG1;
+	mpeg1 = ctx->vpu_src_fmt->fourcc == V4L2_PIX_FMT_MPEG1_SLICE;
+	if (mpeg1 != !!(seq->flags & V4L2_MPEG2_SEQ_FLAG_MPEG1))
+		return -EINVAL;
 	if (mpeg1 ? pic->picture_structure != V4L2_MPEG2_PIC_FRAME :
 		    pic->flags & (V4L2_MPEG2_PIC_FLAG_FULL_PEL_FORWARD |
 				  V4L2_MPEG2_PIC_FLAG_FULL_PEL_BACKWARD))
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
index 5c6018ac4696..57b5ef76b204 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
@@ -309,6 +309,19 @@ static const struct hantro_fmt rockchip_vdpu2_dec_fmts[] = {
 			.step_height = MB_DIM,
 		},
 	},
+	{
+		.fourcc = V4L2_PIX_FMT_MPEG1_SLICE,
+		.codec_mode = HANTRO_MODE_MPEG2_DEC,
+		.max_depth = 2,
+		.frmsize = {
+			.min_width = FMT_MIN_WIDTH,
+			.max_width = FMT_FHD_WIDTH,
+			.step_width = MB_DIM,
+			.min_height = FMT_MIN_HEIGHT,
+			.max_height = FMT_FHD_HEIGHT,
+			.step_height = MB_DIM,
+		},
+	},
 	{
 		.fourcc = V4L2_PIX_FMT_VP8_FRAME,
 		.codec_mode = HANTRO_MODE_VP8_DEC,
@@ -421,6 +434,19 @@ static const struct hantro_fmt rk3399_vpu_dec_fmts[] = {
 			.step_height = MB_DIM,
 		},
 	},
+	{
+		.fourcc = V4L2_PIX_FMT_MPEG1_SLICE,
+		.codec_mode = HANTRO_MODE_MPEG2_DEC,
+		.max_depth = 2,
+		.frmsize = {
+			.min_width = FMT_MIN_WIDTH,
+			.max_width = FMT_FHD_WIDTH,
+			.step_width = MB_DIM,
+			.min_height = FMT_MIN_HEIGHT,
+			.max_height = FMT_FHD_HEIGHT,
+			.step_height = MB_DIM,
+		},
+	},
 	{
 		.fourcc = V4L2_PIX_FMT_VP8_FRAME,
 		.codec_mode = HANTRO_MODE_VP8_DEC,
@@ -965,7 +991,6 @@ const struct hantro_variant rk3399_vpu_variant = {
 	.num_dec_fmts = ARRAY_SIZE(rk3399_vpu_dec_fmts),
 	.codec = HANTRO_JPEG_ENCODER | HANTRO_MPEG2_DECODER |
 		 HANTRO_VP8_DECODER,
-	.mpeg1_dec = 1,
 	.codec_ops = rk3399_vpu_codec_ops,
 	.irqs = rockchip_vpu2_irqs,
 	.num_irqs = ARRAY_SIZE(rockchip_vpu2_irqs),
@@ -1011,7 +1036,6 @@ const struct hantro_variant rk3568_vpu_variant = {
 	.num_dec_fmts = ARRAY_SIZE(rockchip_vdpu2_dec_fmts),
 	.codec = HANTRO_MPEG2_DECODER |
 		 HANTRO_VP8_DECODER | HANTRO_H264_DECODER,
-	.mpeg1_dec = 1,
 	.codec_ops = rk3399_vpu_codec_ops,
 	.irqs = rockchip_vdpu2_irqs,
 	.num_irqs = ARRAY_SIZE(rockchip_vdpu2_irqs),
@@ -1034,7 +1058,6 @@ const struct hantro_variant rk3588_vpu121_variant = {
 	.num_dec_fmts = ARRAY_SIZE(rockchip_vdpu2_dec_fmts),
 	.codec = HANTRO_H264_ENCODER | HANTRO_MPEG2_DECODER |
 		 HANTRO_VP8_DECODER | HANTRO_H264_DECODER,
-	.mpeg1_dec = 1,
 	.codec_ops = rk3588_vpu121_codec_ops,
 	.irqs = rk3588_vpu121_irqs,
 	.num_irqs = ARRAY_SIZE(rk3588_vpu121_irqs),
@@ -1070,7 +1093,6 @@ const struct hantro_variant px30_vpu_variant = {
 	.num_dec_fmts = ARRAY_SIZE(rockchip_vdpu2_dec_fmts),
 	.codec = HANTRO_JPEG_ENCODER | HANTRO_MPEG2_DECODER |
 		 HANTRO_VP8_DECODER | HANTRO_H264_DECODER,
-	.mpeg1_dec = 1,
 	.codec_ops = rk3399_vpu_codec_ops,
 	.irqs = rockchip_vpu2_irqs,
 	.num_irqs = ARRAY_SIZE(rockchip_vpu2_irqs),
-- 
