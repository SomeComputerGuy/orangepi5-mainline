From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 02 Nov 2026 06:21:53 +0000
Subject: [PATCH] drm/display: hdmi: Set the link status bad when FRL link training fails

When FRL link training fails, the FLT work falls back to TMDS in place
through frl_fallback_tmds(), but the modeset has configured the whole
link for FRL: the PHY runs its PLL at the FRL rate, and the source
driver's glue (e.g. the Rockchip HDMI21 GRF bit, and the frl-enable
GPIO that controls the external bias of the HDMI data lines) is set
for FRL. Only the controller's operation mode is switched to TMDS, so
the sink gets no usable TMDS signal and the screen stays black, with
nothing telling userspace about it.

Do what DisplayPort does on a link training failure instead: stop the
link, set the connector's link status to bad and send a hotplug event,
so that userspace sets the mode again. The failure is recorded against
the connector's epoch counter, and FRL is not offered for the sink until
the counter changes (the sink is unplugged or its EDID changes): the
next atomic check falls back to a TMDS configuration for the mode, or
rejects the mode if TMDS cannot carry it, and modes that need FRL are
pruned on the next probe. The modeset then configures the PHY, the
controller and the glue for TMDS as for any other TMDS mode.

frl_fallback_tmds() remains the TMDS link setup of a modeset that does
not use FRL.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/display/drm_hdmi_helper.c       | 51 +++++++++++++++++++++++--
 drivers/gpu/drm/display/drm_hdmi_state_helper.c |  6 ++-
 drivers/gpu/drm/drm_connector.c                 |  4 +-
 include/drm/drm_connector.h                     | 22 +++++++++--
 4 files changed, 75 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/display/drm_hdmi_helper.c b/drivers/gpu/drm/display/drm_hdmi_helper.c
index a5ff6ab09889..694e5ebf83a3 100644
--- a/drivers/gpu/drm/display/drm_hdmi_helper.c
+++ b/drivers/gpu/drm/display/drm_hdmi_helper.c
@@ -15,6 +15,7 @@
 #include <drm/drm_modes.h>
 #include <drm/drm_modeset_lock.h>
 #include <drm/drm_print.h>
+#include <drm/drm_probe_helper.h>
 #include <drm/drm_property.h>
 
 #define DRM_HDMI_SCDC_SOURCE_VERSION	1
@@ -573,6 +574,7 @@ static int drm_connector_hdmi_try_scrambling_setup(struct drm_connector *connect
 }
 
 static void drm_connector_hdmi_frl_flt_work(struct drm_connector *connector);
+static void drm_connector_hdmi_frl_link_work(struct work_struct *work);
 
 static void drm_connector_hdmi_scdc_work(struct work_struct *work)
 {
@@ -660,6 +662,8 @@ int drm_connector_hdmi_enable_scrambling(struct drm_connector *connector,
 	if (!hdmi->scdc_work_initialized) {
 		INIT_DELAYED_WORK(&hdmi->scdc_work,
 				  drm_connector_hdmi_scdc_work);
+		INIT_WORK(&hdmi->frl_link_work,
+			  drm_connector_hdmi_frl_link_work);
 		hdmi->scdc_work_initialized = true;
 	}
 
@@ -1258,9 +1262,9 @@ static int drm_connector_hdmi_frl_ltsp(struct drm_connector *connector)
 }
 
 /*
- * FLT failed or FRL not selected, fallback to legacy TMDS mode.
+ * FRL not selected: operate the link in TMDS mode.
  */
-static void drm_connector_hdmi_frl_ltsl(struct drm_connector *connector)
+static void drm_connector_hdmi_frl_tmds(struct drm_connector *connector)
 {
 	drm_scdc_set_frl(connector, 0, 0, 0);
 	drm_scdc_writeb(connector->ddc, SCDC_UPDATE_0, SCDC_FLT_UPDATE);
@@ -1268,6 +1272,45 @@ static void drm_connector_hdmi_frl_ltsl(struct drm_connector *connector)
 	connector->hdmi.funcs->frl_fallback_tmds(connector);
 }
 
+static void drm_connector_hdmi_frl_link_work(struct work_struct *work)
+{
+	struct drm_connector *connector =
+		container_of(work, struct drm_connector, hdmi.frl_link_work);
+	struct drm_device *dev = connector->dev;
+
+	mutex_lock(&dev->mode_config.mutex);
+	drm_connector_set_link_status_property(connector,
+					       DRM_MODE_LINK_STATUS_BAD);
+	mutex_unlock(&dev->mode_config.mutex);
+
+	drm_kms_helper_connector_hotplug_event(connector);
+}
+
+/*
+ * FLT failed. The PHY, the controller and any board level link setup are
+ * configured for FRL by the modeset, and only a new modeset can switch them
+ * all to TMDS: stop the link, keep FRL out of the next atomic check for this
+ * sink and ask userspace for that modeset.
+ */
+static void drm_connector_hdmi_frl_ltsl(struct drm_connector *connector)
+{
+	struct drm_connector_hdmi *hdmi = &connector->hdmi;
+
+	/* Disabled meanwhile, not a training failure */
+	if (!drm_connector_hdmi_frl_active(connector))
+		return;
+
+	hdmi->funcs->frl_tx_stop(connector);
+	drm_scdc_set_frl(connector, 0, 0, 0);
+	drm_scdc_writeb(connector->ddc, SCDC_UPDATE_0, SCDC_FLT_UPDATE);
+
+	drm_info(connector->dev, "[CONNECTOR:%d:%s] FRL link training failed, link status bad\n",
+		 connector->base.id, connector->name);
+
+	WRITE_ONCE(hdmi->frl_failed_epoch, connector->epoch_counter + 1);
+	schedule_work(&hdmi->frl_link_work);
+}
+
 static void drm_connector_hdmi_frl_flt_work(struct drm_connector *connector)
 {
 	enum drm_hdmi_frl_lts state = DRM_HDMI_FRL_LTS1;
@@ -1324,7 +1367,7 @@ int drm_connector_hdmi_enable_frl(struct drm_connector *connector,
 	}
 
 	if (!conn_state->hdmi.frl_rate_per_lane || !conn_state->hdmi.frl_lanes) {
-		drm_connector_hdmi_frl_ltsl(connector);
+		drm_connector_hdmi_frl_tmds(connector);
 		return 0;
 	}
 
@@ -1338,6 +1381,8 @@ int drm_connector_hdmi_enable_frl(struct drm_connector *connector,
 	if (!hdmi->scdc_work_initialized) {
 		INIT_DELAYED_WORK(&hdmi->scdc_work,
 				  drm_connector_hdmi_scdc_work);
+		INIT_WORK(&hdmi->frl_link_work,
+			  drm_connector_hdmi_frl_link_work);
 		hdmi->scdc_work_initialized = true;
 	}
 
diff --git a/drivers/gpu/drm/display/drm_hdmi_state_helper.c b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
index ef06be1ef139..41dcd8b1511f 100644
--- a/drivers/gpu/drm/display/drm_hdmi_state_helper.c
+++ b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
@@ -569,8 +569,12 @@ hdmi_clock_valid(const struct drm_connector *connector,
 	    (info->max_tmds_clock && clock > info->max_tmds_clock * 1000)) {
 		unsigned int min_frl_gbps, max_frl_gbps, pref_frl_gbps = 0;
 
-		/* FRL supported by the Source & Sink? */
+		/*
+		 * FRL supported by the Source & Sink, and link training did not
+		 * fail with this sink?
+		 */
 		if (!drm_connector_hdmi_frl_supported(connector) ||
+		    READ_ONCE(hdmi->frl_failed_epoch) == connector->epoch_counter + 1 ||
 		    !hdmi_is_valid_frl_config(info->hdmi.max_frl_rate_per_lane,
 					      info->hdmi.max_lanes))
 			return MODE_CLOCK_HIGH;
diff --git a/drivers/gpu/drm/drm_connector.c b/drivers/gpu/drm/drm_connector.c
index 5c043a3e9c4e..de168c77be64 100644
--- a/drivers/gpu/drm/drm_connector.c
+++ b/drivers/gpu/drm/drm_connector.c
@@ -888,8 +888,10 @@ void drm_connector_cleanup(struct drm_connector *connector)
 		    DRM_CONNECTOR_REGISTERED))
 		drm_connector_unregister(connector);
 
-	if (connector->hdmi.scdc_work_initialized)
+	if (connector->hdmi.scdc_work_initialized) {
 		cancel_delayed_work_sync(&connector->hdmi.scdc_work);
+		cancel_work_sync(&connector->hdmi.frl_link_work);
+	}
 
 	platform_device_unregister(connector->hdmi_audio.codec_pdev);
 
diff --git a/include/drm/drm_connector.h b/include/drm/drm_connector.h
index 9b43559e94e2..27980bdd7300 100644
--- a/include/drm/drm_connector.h
+++ b/include/drm/drm_connector.h
@@ -1633,9 +1633,10 @@ struct drm_connector_hdmi_funcs {
 	 * @frl_fallback_tmds:
 	 *
 	 * This callback is invoked by the FRL helpers when FRL is not supported
-	 * by the sink, not required for the current mode, or when FRL link
-	 * training has failed so that the link operation mode falls back to
-	 * TMDS.
+	 * by the sink or not required for the current mode, so that the link
+	 * operates in TMDS mode. A failed FRL link training does not fall back
+	 * to TMDS in place: the link status is set to bad instead, and the
+	 * next modeset uses TMDS.
 	 *
 	 * The @frl_fallback_tmds callback is mandatory if HDMI 2.1 FRL is to
 	 * be supported.
@@ -2386,6 +2387,21 @@ struct drm_connector_hdmi {
 		bool flt_no_timeout;
 	} scdc_work_data;
 
+	/**
+	 * @frl_link_work: Marks the link status bad and sends a hotplug
+	 * event once FRL link training failed on an enabled link, so that
+	 * userspace sets the mode again. Initialized with @scdc_work.
+	 */
+	struct work_struct frl_link_work;
+
+	/**
+	 * @frl_failed_epoch: &drm_connector.epoch_counter plus one when FRL
+	 * link training last failed, 0 if it did not. FRL is not used again
+	 * for the sink until the epoch counter changes, that is until the
+	 * sink is unplugged or its EDID changes.
+	 */
+	u64 frl_failed_epoch;
+
 	/**
 	 * @funcs: HDMI connector Control Functions and controller capabilities
 	 */
-- 
2.55.0

