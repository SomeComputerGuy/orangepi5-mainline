From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 23:24:45 +0000
Subject: [PATCH] media: rkvdec: hevc: Don't read past the end of the SPS RPS
 controls

The RPS table code reads num_short_term_ref_pic_sets elements of
EXT_SPS_ST_RPS and num_long_term_ref_pics_sps elements of
EXT_SPS_LT_RPS, both taken from the SPS control. Nothing checks that
the dynamic array controls hold that many elements: a control set with
fewer (it starts out with one) makes the driver read past the end of
the control's buffer and write whatever it finds into the hardware
table.

The uAPI says these arrays have exactly as many elements as the SPS
counts. Use a control only when it holds at least that many, and let the
VDPU381/VDPU383 backends test the resulting pointers instead of
has_sps_st_rps/has_sps_lt_rps, so that a short control is handled like
a missing one: a warning on VDPU381, a rejected job on VDPU383.

Assisted-by: Claude:claude-opus-5-5
---
 .../rockchip/rkvdec/rkvdec-hevc-common.c       | 18 ++++++++++++------
 .../rockchip/rkvdec/rkvdec-vdpu381-hevc.c      |  4 ++--
 .../rockchip/rkvdec/rkvdec-vdpu383-hevc.c      |  4 ++--
 3 files changed, 16 insertions(+), 10 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
index f581212fc..39d2a61d6 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
@@ -453,18 +453,24 @@ void rkvdec_hevc_run_preamble(struct rkvdec_ctx *ctx,
 			      V4L2_CID_STATELESS_HEVC_SCALING_MATRIX);
 	run->scaling_matrix = ctrl ? ctrl->p_cur.p : NULL;
 
+	/*
+	 * The RPS controls are used only when userspace has set them, and
+	 * only when they hold a set for every index the SPS allows. The
+	 * table code reads that many elements.
+	 */
+	run->ext_sps_st_rps = NULL;
 	if (ctx->has_sps_st_rps) {
 		ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
 				      V4L2_CID_STATELESS_HEVC_EXT_SPS_ST_RPS);
-		run->ext_sps_st_rps = ctrl ? ctrl->p_cur.p : NULL;
-	} else {
-		run->ext_sps_st_rps = NULL;
+		if (ctrl && ctrl->elems >= run->sps->num_short_term_ref_pic_sets)
+			run->ext_sps_st_rps = ctrl->p_cur.p;
 	}
+
+	run->ext_sps_lt_rps = NULL;
 	if (ctx->has_sps_lt_rps) {
 		ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
 				      V4L2_CID_STATELESS_HEVC_EXT_SPS_LT_RPS);
-		run->ext_sps_lt_rps = ctrl ? ctrl->p_cur.p : NULL;
-	} else {
-		run->ext_sps_lt_rps = NULL;
+		if (ctrl && ctrl->elems >= run->sps->num_long_term_ref_pics_sps)
+			run->ext_sps_lt_rps = ctrl->p_cur.p;
 	}
 }
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index ca5224365..b57be2a20 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
@@ -604,8 +604,8 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	 * On vdpu381, not setting the long and short term ref sets will just output wrong frames.
 	 * Let's just warn about it and let the decoder run anyway.
 	 */
-	if ((!ctx->has_sps_lt_rps && run.sps->num_long_term_ref_pics_sps) ||
-	    (!ctx->has_sps_st_rps && run.sps->num_short_term_ref_pic_sets)) {
+	if ((run.sps->num_long_term_ref_pics_sps && !run.ext_sps_lt_rps) ||
+	    (run.sps->num_short_term_ref_pic_sets && !run.ext_sps_st_rps)) {
 		dev_warn_ratelimited(core->dev, "Long and short term RPS not set\n");
 	} else {
 		rkvdec_hevc_assemble_hw_rps(&run, &tbl->rps, &hevc_ctx->st_cache);
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
index d29de4e6c..a672fa894 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
@@ -550,8 +550,8 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	 * To be on the safe side for this new v4l2 control, write an error in the log and mark
 	 * the buffer as failed by returning an error here.
 	 */
-	if ((!ctx->has_sps_lt_rps && run.sps->num_long_term_ref_pics_sps) ||
-	    (!ctx->has_sps_st_rps && run.sps->num_short_term_ref_pic_sets)) {
+	if ((run.sps->num_long_term_ref_pics_sps && !run.ext_sps_lt_rps) ||
+	    (run.sps->num_short_term_ref_pic_sets && !run.ext_sps_st_rps)) {
 		dev_err_ratelimited(core->dev, "Long and short term RPS not set\n");
 		return -EINVAL;
 	}
