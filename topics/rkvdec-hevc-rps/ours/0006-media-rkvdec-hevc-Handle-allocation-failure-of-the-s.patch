From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 23:26:27 +0000
Subject: [PATCH] media: rkvdec: hevc: Handle allocation failure of the
 short-term RPS sets

rkvdec_hevc_prepare_hw_st_rps() uses the array it gets from kzalloc()
without checking it, so an allocation failure is a NULL pointer
dereference in the decode path.

Check it and return -ENOMEM through rkvdec_hevc_assemble_hw_rps(). The
VDPU381 and VDPU383 backends then complete the request's controls and
fail the job, as they do for their other errors. The cache isn't
updated on failure, so the next job builds the table again.

Use kcalloc() for the array while at it, and also fail the job, with
-EINVAL, in the case the SPS has more sets than the table holds, which
the SPS control's validation rules out.

Assisted-by: Claude:claude-opus-5-5
---
 .../rockchip/rkvdec/rkvdec-hevc-common.c      | 39 +++++++++++++------
 .../rockchip/rkvdec/rkvdec-hevc-common.h      |  4 +-
 .../rockchip/rkvdec/rkvdec-vdpu381-hevc.c     |  7 +++-
 .../rockchip/rkvdec/rkvdec-vdpu383-hevc.c     |  7 +++-
 4 files changed, 41 insertions(+), 16 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
index 776fe14b8d07..117559b57d51 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
@@ -327,19 +327,20 @@ static void st_ref_pic_set_calculate(struct rkvdec_hevc_run *run, int idx,
 	st_rps->num_delta_pocs = st_rps->num_positive_pics + st_rps->num_negative_pics;
 }
 
-static void rkvdec_hevc_prepare_hw_st_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
-					  struct rkvdec_hevc_st_rps_cache *cache)
+static int rkvdec_hevc_prepare_hw_st_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
+					 struct rkvdec_hevc_st_rps_cache *cache)
 {
 	unsigned int num_sets = run->sps->num_short_term_ref_pic_sets;
 	size_t size = num_sets * sizeof(*run->ext_sps_st_rps);
+	struct calculated_rps_st_set *calculated_rps_st_sets;
 	int idx;
 
 	if (!run->ext_sps_st_rps)
-		return;
+		return 0;
 
 	/* The SPS control's validation limits the count to the table size. */
 	if (WARN_ON_ONCE(num_sets > ARRAY_SIZE(cache->sets)))
-		return;
+		return -EINVAL;
 
 	/*
 	 * Every set can differ, and so can their number. The zeroed initial
@@ -348,13 +349,18 @@ static void rkvdec_hevc_prepare_hw_st_rps(struct rkvdec_hevc_run *run, struct rk
 	 */
 	if (cache->num_sets == num_sets &&
 	    !memcmp(cache->sets, run->ext_sps_st_rps, size))
-		return;
+		return 0;
 
-	struct calculated_rps_st_set *calculated_rps_st_sets =
-		kzalloc(sizeof(struct calculated_rps_st_set) *
-			run->sps->num_short_term_ref_pic_sets, GFP_KERNEL);
+	/*
+	 * On failure the cache is left as it is, so the next job tries
+	 * again.
+	 */
+	calculated_rps_st_sets = kcalloc(num_sets, sizeof(*calculated_rps_st_sets),
+					 GFP_KERNEL);
+	if (!calculated_rps_st_sets)
+		return -ENOMEM;
 
-	for (idx = 0; idx < run->sps->num_short_term_ref_pic_sets; idx++) {
+	for (idx = 0; idx < num_sets; idx++) {
 		const struct v4l2_ctrl_hevc_ext_sps_st_rps *rps_data = &run->ext_sps_st_rps[idx];
 
 		if (rps_data->flags & V4L2_HEVC_EXT_SPS_ST_RPS_FLAG_INTER_REF_PIC_SET_PRED)
@@ -369,13 +375,22 @@ static void rkvdec_hevc_prepare_hw_st_rps(struct rkvdec_hevc_run *run, struct rk
 
 	cache->num_sets = num_sets;
 	memcpy(cache->sets, run->ext_sps_st_rps, size);
+
+	return 0;
 }
 
-void rkvdec_hevc_assemble_hw_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
-				 struct rkvdec_hevc_st_rps_cache *st_cache)
+int rkvdec_hevc_assemble_hw_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
+				struct rkvdec_hevc_st_rps_cache *st_cache)
 {
-	rkvdec_hevc_prepare_hw_st_rps(run, rps, st_cache);
+	int ret;
+
+	ret = rkvdec_hevc_prepare_hw_st_rps(run, rps, st_cache);
+	if (ret)
+		return ret;
+
 	rkvdec_hevc_assemble_hw_lt_rps(run, rps);
+
+	return 0;
 }
 
 struct vb2_buffer *
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h
index aba341a5d26a..48fafa79e95e 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h
@@ -75,8 +75,8 @@ void compute_tiles_uniform(struct rkvdec_hevc_run *run, u16 log2_min_cb_size,
 void compute_tiles_non_uniform(struct rkvdec_hevc_run *run, u16 log2_min_cb_size,
 			       u16 width, u16 height, s32 pic_in_cts_width,
 			       s32 pic_in_cts_height, u16 *column_width, u16 *row_height);
-void rkvdec_hevc_assemble_hw_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
-				 struct rkvdec_hevc_st_rps_cache *st_cache);
+int rkvdec_hevc_assemble_hw_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
+				struct rkvdec_hevc_st_rps_cache *st_cache);
 void rkvdec_hevc_assemble_hw_scaling_list(struct rkvdec_ctx *ctx,
 					  struct rkvdec_hevc_run *run,
 					  struct scaling_factor *scaling_factor,
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index e9bf1915cd86..5152ff9484fa 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
@@ -593,6 +593,7 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	struct rkvdec_hevc_run run;
 	struct rkvdec_hevc_ctx *hevc_ctx = ctx->priv;
 	struct rkvdec_hevc_priv_tbl *tbl = hevc_ctx->priv_tbl.cpu;
+	int ret;
 
 	rkvdec_hevc_run_preamble(ctx, &run);
 
@@ -608,7 +609,11 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	    (run.sps->num_short_term_ref_pic_sets && !run.ext_sps_st_rps)) {
 		dev_warn_ratelimited(core->dev, "Long and short term RPS not set\n");
 	} else {
-		rkvdec_hevc_assemble_hw_rps(&run, &tbl->rps, &hevc_ctx->st_cache);
+		ret = rkvdec_hevc_assemble_hw_rps(&run, &tbl->rps, &hevc_ctx->st_cache);
+		if (ret) {
+			rkvdec_run_postamble(ctx, &run.base);
+			return ret;
+		}
 	}
 
 	config_registers(ctx, &run);
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
index 75a152128aff..9f0e41d67df2 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
@@ -542,6 +542,7 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	struct rkvdec_hevc_ctx *hevc_ctx = ctx->priv;
 	struct rkvdec_hevc_priv_tbl *tbl = hevc_ctx->priv_tbl.cpu;
 	u32 timeout_threshold;
+	int ret;
 
 	rkvdec_hevc_run_preamble(ctx, &run);
 
@@ -561,7 +562,11 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	rkvdec_hevc_assemble_hw_scaling_list(ctx, &run, &tbl->scaling_list,
 					     &hevc_ctx->scaling_matrix_cache);
 	assemble_hw_pps(ctx, &run);
-	rkvdec_hevc_assemble_hw_rps(&run, &tbl->rps, &hevc_ctx->st_cache);
+	ret = rkvdec_hevc_assemble_hw_rps(&run, &tbl->rps, &hevc_ctx->st_cache);
+	if (ret) {
+		rkvdec_run_postamble(ctx, &run.base);
+		return ret;
+	}
 
 	config_registers(ctx, &run);
 
