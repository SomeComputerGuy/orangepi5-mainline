From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 23:25:43 +0000
Subject: [PATCH] media: rkvdec: hevc: Rebuild the short-term RPS table when
 any set changes

rkvdec_hevc_prepare_hw_st_rps() skips rebuilding the hardware RPS table
when the cache equals the EXT_SPS_ST_RPS control, but the cache is a
single struct v4l2_ctrl_hevc_ext_sps_st_rps: only the first of the
num_short_term_ref_pic_sets sets is compared and stored. As a result:

- An SPS change that keeps set 0 but changes a later set, or the number
  of sets, leaves the table of the old SPS in place. This happens with
  spliced streams, with several SPS ids, and with encoders that resend a
  new SPS at the same resolution. Inter pictures that pick one of the
  changed sets then decode with wrong references.
- The cache starts out zeroed. An SPS whose first set is coded
  explicitly and is empty (no negative and no positive pictures) gives
  an all-zero first element, which compares equal to the cache, so the
  table for that SPS is never built at all.

The table depends only on the number of sets and on their contents.
Cache both, and rebuild when either differs. The zeroed cache holds no
sets, so the first SPS that has any always builds the table.

The cache grows from 80 bytes to about 5 KiB per HEVC context.

Assisted-by: Claude:claude-opus-5-5
---
 .../rockchip/rkvdec/rkvdec-hevc-common.c      | 21 +++++++++++++++----
 .../rockchip/rkvdec/rkvdec-hevc-common.h      | 13 +++++++++++-
 .../rockchip/rkvdec/rkvdec-vdpu381-hevc.c     |  2 +-
 .../rockchip/rkvdec/rkvdec-vdpu383-hevc.c     |  2 +-
 4 files changed, 31 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
index 39d2a61d623f..776fe14b8d07 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.c
@@ -328,14 +328,26 @@ static void st_ref_pic_set_calculate(struct rkvdec_hevc_run *run, int idx,
 }
 
 static void rkvdec_hevc_prepare_hw_st_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
-					  struct v4l2_ctrl_hevc_ext_sps_st_rps *cache)
+					  struct rkvdec_hevc_st_rps_cache *cache)
 {
+	unsigned int num_sets = run->sps->num_short_term_ref_pic_sets;
+	size_t size = num_sets * sizeof(*run->ext_sps_st_rps);
 	int idx;
 
 	if (!run->ext_sps_st_rps)
 		return;
 
-	if (!memcmp(cache, run->ext_sps_st_rps, sizeof(struct v4l2_ctrl_hevc_ext_sps_st_rps)))
+	/* The SPS control's validation limits the count to the table size. */
+	if (WARN_ON_ONCE(num_sets > ARRAY_SIZE(cache->sets)))
+		return;
+
+	/*
+	 * Every set can differ, and so can their number. The zeroed initial
+	 * cache has no sets, so the first SPS that has any always builds the
+	 * table, whatever its sets contain.
+	 */
+	if (cache->num_sets == num_sets &&
+	    !memcmp(cache->sets, run->ext_sps_st_rps, size))
 		return;
 
 	struct calculated_rps_st_set *calculated_rps_st_sets =
@@ -355,11 +367,12 @@ static void rkvdec_hevc_prepare_hw_st_rps(struct rkvdec_hevc_run *run, struct rk
 
 	kfree(calculated_rps_st_sets);
 
-	memcpy(cache, run->ext_sps_st_rps, sizeof(struct v4l2_ctrl_hevc_ext_sps_st_rps));
+	cache->num_sets = num_sets;
+	memcpy(cache->sets, run->ext_sps_st_rps, size);
 }
 
 void rkvdec_hevc_assemble_hw_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
-				 struct v4l2_ctrl_hevc_ext_sps_st_rps *st_cache)
+				 struct rkvdec_hevc_st_rps_cache *st_cache)
 {
 	rkvdec_hevc_prepare_hw_st_rps(run, rps, st_cache);
 	rkvdec_hevc_assemble_hw_lt_rps(run, rps);
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h
index 2a9b7719ab2d..aba341a5d26a 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-hevc-common.h
@@ -39,6 +39,17 @@ struct rkvdec_rps {
 	u32 info[RKVDEC_RPS_HEVC_SIZE / 8 / 4];
 } __packed;
 
+#define RKVDEC_HEVC_MAX_ST_RPS_SETS	64
+
+/*
+ * The SPS short-term RPS sets the hardware table was last built from: the
+ * table depends on nothing else.
+ */
+struct rkvdec_hevc_st_rps_cache {
+	unsigned int num_sets;
+	struct v4l2_ctrl_hevc_ext_sps_st_rps sets[RKVDEC_HEVC_MAX_ST_RPS_SETS];
+};
+
 struct rkvdec_hevc_run {
 	struct rkvdec_run base;
 	const struct v4l2_ctrl_hevc_slice_params *slices_params;
@@ -65,7 +76,7 @@ void compute_tiles_non_uniform(struct rkvdec_hevc_run *run, u16 log2_min_cb_size
 			       u16 width, u16 height, s32 pic_in_cts_width,
 			       s32 pic_in_cts_height, u16 *column_width, u16 *row_height);
 void rkvdec_hevc_assemble_hw_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps,
-				 struct v4l2_ctrl_hevc_ext_sps_st_rps *st_cache);
+				 struct rkvdec_hevc_st_rps_cache *st_cache);
 void rkvdec_hevc_assemble_hw_scaling_list(struct rkvdec_ctx *ctx,
 					  struct rkvdec_hevc_run *run,
 					  struct scaling_factor *scaling_factor,
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index b57be2a20ff4..e9bf1915cd86 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
@@ -117,7 +117,7 @@ struct rkvdec_hevc_priv_tbl {
 struct rkvdec_hevc_ctx {
 	struct rkvdec_aux_buf			priv_tbl;
 	struct v4l2_ctrl_hevc_scaling_matrix	scaling_matrix_cache;
-	struct v4l2_ctrl_hevc_ext_sps_st_rps	st_cache;
+	struct rkvdec_hevc_st_rps_cache		st_cache;
 	struct rkvdec_vdpu381_regs_hevc		regs;
 };
 
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
index ef4ce05f1c3c..75a152128aff 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-hevc.c
@@ -124,7 +124,7 @@ struct rkvdec_hevc_priv_tbl {
 struct rkvdec_hevc_ctx {
 	struct rkvdec_aux_buf			priv_tbl;
 	struct v4l2_ctrl_hevc_scaling_matrix	scaling_matrix_cache;
-	struct v4l2_ctrl_hevc_ext_sps_st_rps	st_cache;
+	struct rkvdec_hevc_st_rps_cache		st_cache;
 	struct vdpu383_regs_h26x		regs;
 };
 
