From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 23:16:06 +0000
Subject: [PATCH] media: rkvdec: vdpu381: enable and flush the read caches for
 every job

Every VDPU381 core has three read caches in the cache block of its
register space, which the driver never sets up. The Rockchip BSP driver
enables them (cacheable access, read allocate, 64-byte lines) and
flushes them before every frame, in both single and multi-core modes
(rkvdec2_run(), rkvdec2_soft_ccu_enqueue()).

Do the same. Flushing matters once a stream is decoded on both cores:
a reference frame may have been rewritten by the other core, or as the
destination of an earlier frame, since this core last cached it.

Assisted-by: Claude:claude-opus-5-5
---
 .../rockchip/rkvdec/rkvdec-vdpu381-regs.h     |  9 ++++++
 .../media/platform/rockchip/rkvdec/rkvdec.c   | 28 +++++++++++++++++++
 .../media/platform/rockchip/rkvdec/rkvdec.h   |  2 ++
 3 files changed, 39 insertions(+)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
index de59dcba3..6c0ccced2 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
@@ -37,6 +37,15 @@
 #define VDPU381_REG_IMPORTANT_EN	0x02c
 #define VDPU381_DEC_IRQ_DISABLE	BIT(4)
 
+/* Registers in the cache block, one set for each of the three caches */
+#define VDPU381_CACHE_CLR(n)		(0x10 + (n) * 0x40)
+#define VDPU381_CACHE_CLR_ALL		BIT(0)
+#define VDPU381_CACHE_CFG(n)		(0x1c + (n) * 0x40)
+#define VDPU381_CACHE_CFG_CACHEABLE	BIT(0)
+#define VDPU381_CACHE_CFG_RD_ALLOCATE	BIT(1)
+#define VDPU381_CACHE_CFG_LINE_64B	BIT(4)
+#define VDPU381_NUM_CACHES		3
+
 #define VDPU381_REG_STA_INT		0x380
 #define VDPU381_STA_INT_DEC_RDY_STA	BIT(2)
 #define VDPU381_STA_INT_ERROR		BIT(4)
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.c b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
index f0ca0d5c6..d501f3576 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
@@ -1542,6 +1542,25 @@ void rkvdec_schedule_watchdog(struct rkvdec_core *core, u32 timeout_threshold)
 	schedule_delayed_work(&core->watchdog_work, msecs_to_jiffies(watchdog_time));
 }
 
+/*
+ * Enables the read caches of the core, and drops what they hold: the
+ * reference frames of this job may have been rewritten since they were
+ * cached, by another core or as the destination of an earlier job.
+ */
+static void rkvdec_core_reset_cache(struct rkvdec_core *core)
+{
+	unsigned int i;
+
+	if (!core->cache)
+		return;
+
+	for (i = 0; i < VDPU381_NUM_CACHES; i++) {
+		writel(VDPU381_CACHE_CFG_CACHEABLE | VDPU381_CACHE_CFG_RD_ALLOCATE |
+		       VDPU381_CACHE_CFG_LINE_64B, core->cache + VDPU381_CACHE_CFG(i));
+		writel(VDPU381_CACHE_CLR_ALL, core->cache + VDPU381_CACHE_CLR(i));
+	}
+}
+
 static void rkvdec_device_run(void *priv)
 {
 	struct rkvdec_ctx *ctx = priv;
@@ -1586,6 +1605,8 @@ static void rkvdec_device_run(void *priv)
 	if (ctx->dev->ccu)
 		rkvdec_ccu_prepare(ctx);
 
+	rkvdec_core_reset_cache(core);
+
 	if (!rkvdec_rcb_buf_validate_size(ctx)) {
 		rkvdec_free_rcb(ctx->dev, core);
 
@@ -2125,6 +2146,7 @@ static const struct rkvdec_variant vdpu381_variant = {
 	.num_rcb_sizes = ARRAY_SIZE(vdpu381_rcb_sizes),
 	.ops = &vdpu381_variant_ops,
 	.has_ccu = true,
+	.has_cache_ctrl = true,
 };
 
 static const struct rcb_size_info vdpu383_rcb_sizes[] = {
@@ -2273,6 +2295,12 @@ static int rkvdec_core_probe(struct platform_device *pdev)
 		core->link = devm_platform_ioremap_resource_byname(pdev, "link");
 		if (IS_ERR(core->link))
 			return PTR_ERR(core->link);
+
+		if (variant->has_cache_ctrl) {
+			core->cache = devm_platform_ioremap_resource_byname(pdev, "cache");
+			if (IS_ERR(core->cache))
+				return PTR_ERR(core->cache);
+		}
 	}
 
 	if (iommu_get_domain_for_dev(&pdev->dev)) {
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.h b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
index fea8e2ba8..1c27fcffe 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
@@ -93,6 +93,7 @@ struct rkvdec_variant {
 	bool has_single_reg_region;
 	unsigned int quirks;
 	bool has_ccu;
+	bool has_cache_ctrl;
 };
 
 struct rkvdec_coded_fmt_ops {
@@ -191,6 +192,7 @@ struct rkvdec_core {
 	struct rkvdec_rcb_config *rcb_config;
 	struct rkvdec_ctx *curr_ctx;
 	struct rkvdec_job *job;
+	void __iomem *cache;
 	int id;
 	int ccu_port;
 };
