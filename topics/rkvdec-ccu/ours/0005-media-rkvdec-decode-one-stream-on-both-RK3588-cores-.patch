--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Rockchip RK3588 video decoder core coordination unit
+ */
+#ifndef RKVDEC_CCU_H_
+#define RKVDEC_CCU_H_
+
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+struct rkvdec_core;
+struct rkvdec_ctx;
+struct rkvdec_vdpu381_regs_common;
+
+extern struct platform_driver rkvdec_ccu_pdrv;
+
+struct rkvdec_ccu *rkvdec_ccu_find(struct device_node *np);
+void rkvdec_ccu_release(struct rkvdec_ccu *ccu);
+
+int rkvdec_ccu_get(struct rkvdec_ccu *ccu);
+void rkvdec_ccu_put(struct rkvdec_ccu *ccu);
+void rkvdec_ccu_prepare(struct rkvdec_ctx *ctx);
+void rkvdec_ccu_start(struct rkvdec_ctx *ctx);
+void rkvdec_vdpu381_set_ccu_regs(struct rkvdec_ctx *ctx,
+				 struct rkvdec_vdpu381_regs_common *common);
+
+#endif /* RKVDEC_CCU_H_ */
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
index e5d325999f15..dca2a6ba4d05 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
@@ -11,6 +11,7 @@
 
 #include "rkvdec.h"
 #include "rkvdec-cabac.h"
+#include "rkvdec-ccu.h"
 #include "rkvdec-rcb.h"
 #include "rkvdec-h264-common.h"
 #include "rkvdec-vdpu381-regs.h"
@@ -307,6 +308,8 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	else
 		regs->common.reg032_timeout_threshold = RKVDEC_TIMEOUT_MAX;
 
+	rkvdec_vdpu381_set_ccu_regs(ctx, &regs->common);
+
 	/* Set TOP and BOTTOM POCs */
 	regs->h264_param.reg065_cur_top_poc = dec_params->top_field_order_cnt;
 	regs->h264_param.reg066_cur_bot_poc = dec_params->bottom_field_order_cnt;
@@ -320,7 +323,9 @@ static void config_registers(struct rkvdec_ctx *ctx,
 		 * If a DPB entry is unused or invalid, address of current destination
 		 * buffer is returned.
 		 */
-		if (!vb_buf)
+		if (vb_buf)
+			rkvdec_job_add_ref(ctx, vb_buf);
+		else
 			vb_buf = &dst_buf->vb2_buf;
 
 		buf_dma = vb2_dma_contig_plane_dma_addr(vb_buf, 0);
@@ -477,6 +482,7 @@ static int rkvdec_h264_run(struct rkvdec_ctx *ctx)
 	rkvdec_schedule_watchdog(core, h264_ctx->regs.common.reg032_timeout_threshold);
 
 	/* Start decoding! */
+	rkvdec_ccu_start(ctx);
 	writel(VDPU381_DEC_E_BIT, core->regs + VDPU381_REG_DEC_E);
 
 	return 0;
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index 333dcb0264e3..80646885a222 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
@@ -10,6 +10,7 @@
 
 #include "rkvdec.h"
 #include "rkvdec-cabac.h"
+#include "rkvdec-ccu.h"
 #include "rkvdec-rcb.h"
 #include "rkvdec-hevc-common.h"
 #include "rkvdec-vdpu381-regs.h"
@@ -470,6 +471,8 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	else
 		regs->common.reg032_timeout_threshold = RKVDEC_TIMEOUT_MAX;
 
+	rkvdec_vdpu381_set_ccu_regs(ctx, &regs->common);
+
 	/* Set POC val */
 	regs->hevc_param.reg065_cur_top_poc = dec_params->pic_order_cnt_val;
 
@@ -479,6 +482,9 @@ static void config_registers(struct rkvdec_ctx *ctx,
 		dma_addr_t buf_dma = vb2_dma_contig_plane_dma_addr(vb_buf, 0);
 		u32 valid = !!(dec_params->num_active_dpb_entries > i);
 
+		if (valid)
+			rkvdec_job_add_ref(ctx, vb_buf);
+
 		/* Set reference addresses */
 		regs->hevc_addr.reg164_180_ref_base[i] = buf_dma;
 
@@ -650,6 +656,7 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	rkvdec_schedule_watchdog(core, hevc_ctx->regs.common.reg032_timeout_threshold);
 
 	/* Start decoding! */
+	rkvdec_ccu_start(ctx);
 	writel(VDPU381_DEC_E_BIT, ctx->core->regs + VDPU381_REG_DEC_E);
 
 	return 0;
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-vp9.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-vp9.c
index c22b48d7b0bc..e06a915f3731 100644
