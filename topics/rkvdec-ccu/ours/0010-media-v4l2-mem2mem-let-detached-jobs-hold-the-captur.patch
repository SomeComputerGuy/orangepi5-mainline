From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 03:56:49 +0000
Subject: [PATCH] media: v4l2-mem2mem: let detached jobs hold the capture
 buffer

v4l2_m2m_buf_detach_and_job_finish() refuses jobs whose OUTPUT buffer
holds the CAPTURE buffer (V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF): their
destination buffer must stay on the ready list for the next job, so they
have to keep the m2m job until the hardware is done. With the two fields
of an interlaced H.264 frame, which share a CAPTURE buffer, the second
field can then never start before the first one is done, although the
RK3588 decoder could decode them on its two cores at the same time.

Let such a job be detached too. Its source buffer is taken off the ready
list as for any detached job, while the destination buffer stays on the
ready list, held for the next job exactly as if the job had been
finished with v4l2_m2m_buf_done_and_job_finish(). The context records
that detached jobs still write the held buffer. Until the driver says it
is done with it, with the new v4l2_m2m_detached_buf_done(), releasing
the hold (a source buffer with another timestamp, V4L2_DEC_CMD_FLUSH, or
a job without the HOLD flag that ends with
v4l2_m2m_buf_done_and_job_finish()) only takes the buffer off the ready
list, and v4l2_m2m_detached_buf_done() returns it. If the hold is still
in place by then, the buffer stays held and is returned by the framework
as usual. A job without the HOLD flag that is detached takes the held
buffer over from the framework.

The CAPTURE buffer is so returned when the last job writing it is done
and the hold is released, whichever comes last, which is what userspace
sees today: the uAPI doesn't change. Nothing changes for drivers that
don't detach jobs: the new context flag is never set for them, and no
structure changes.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/v4l2-core/v4l2-mem2mem.c | 80 +++++++++++++++++++++-----
 include/media/v4l2-mem2mem.h           | 60 +++++++++++++++----
 2 files changed, 116 insertions(+), 24 deletions(-)

diff --git a/drivers/media/v4l2-core/v4l2-mem2mem.c b/drivers/media/v4l2-core/v4l2-mem2mem.c
index 01f3bba409f1..a2a8748a63e8 100644
--- a/drivers/media/v4l2-core/v4l2-mem2mem.c
+++ b/drivers/media/v4l2-core/v4l2-mem2mem.c
@@ -41,6 +41,8 @@ module_param(debug, bool, 0644);
 #define TRANS_RUNNING		(1 << 1)
 /* Instance is currently aborting */
 #define TRANS_ABORT		(1 << 2)
+/* The held capture buffer is used by detached jobs */
+#define TRANS_HELD_DETACHED	BIT(3)
 
 
 /* The job queue is not running new jobs */
@@ -308,6 +310,32 @@ static void v4l2_m2m_try_run(struct v4l2_m2m_dev *m2m_dev)
 	m2m_dev->m2m_ops->device_run(chosen_ctx->priv);
 }
 
+/*
+ * v4l2_m2m_release_held_buf() - release the held capture buffer
+ * @m2m_ctx: m2m context
+ * @vbuf: the held capture buffer, first on the capture ready list
+ *
+ * Takes the held capture buffer off the ready list and returns it, unless
+ * detached jobs still write it: the driver then returns it with
+ * v4l2_m2m_detached_buf_done() once they are done.
+ *
+ * Must be called with job_spinlock held.
+ */
+static void v4l2_m2m_release_held_buf(struct v4l2_m2m_ctx *m2m_ctx,
+				      struct vb2_v4l2_buffer *vbuf)
+{
+	vbuf->is_held = false;
+	v4l2_m2m_dst_buf_remove(m2m_ctx);
+
+	if (m2m_ctx->job_flags & TRANS_HELD_DETACHED) {
+		dprintk("Held capture buffer still in use, the driver returns it\n");
+		m2m_ctx->job_flags &= ~TRANS_HELD_DETACHED;
+		return;
+	}
+
+	v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_DONE);
+}
+
 /*
  * __v4l2_m2m_try_queue() - queue a job
  * @m2m_dev: m2m device
@@ -364,9 +392,7 @@ static void __v4l2_m2m_try_queue(struct v4l2_m2m_dev *m2m_dev,
 	    dst->vb2_buf.copied_timestamp &&
 	    dst->vb2_buf.timestamp != src->vb2_buf.timestamp) {
 		dprintk("Timestamp mismatch, returning held capture buffer\n");
-		dst->is_held = false;
-		v4l2_m2m_dst_buf_remove(m2m_ctx);
-		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_DONE);
+		v4l2_m2m_release_held_buf(m2m_ctx, dst);
 		dst = v4l2_m2m_next_dst_buf(m2m_ctx);
 
 		if (!dst && !m2m_ctx->cap_q_ctx.buffered) {
@@ -548,7 +574,11 @@ void v4l2_m2m_buf_done_and_job_finish(struct v4l2_m2m_dev *m2m_dev,
 	dst_buf->is_held = src_buf->flags & V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF;
 	if (!dst_buf->is_held) {
 		v4l2_m2m_dst_buf_remove(m2m_ctx);
-		v4l2_m2m_buf_done(dst_buf, state);
+		/* Detached jobs may still write a held buffer. */
+		if (m2m_ctx->job_flags & TRANS_HELD_DETACHED)
+			m2m_ctx->job_flags &= ~TRANS_HELD_DETACHED;
+		else
+			v4l2_m2m_buf_done(dst_buf, state);
 	}
 	/*
 	 * If the request API is being used, returning the OUTPUT
@@ -587,13 +617,17 @@ bool v4l2_m2m_buf_detach_and_job_finish(struct v4l2_m2m_dev *m2m_dev,
 	if (WARN_ON(!src || !dst))
 		goto unlock;
 
-	/* A held capture buffer must stay on the queue for the next job. */
-	if (src->flags & V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF)
-		goto unlock;
-
 	v4l2_m2m_src_buf_remove(m2m_ctx);
-	v4l2_m2m_dst_buf_remove(m2m_ctx);
-	dst->is_held = false;
+	if (src->flags & V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF) {
+		/* The held capture buffer stays on the queue for the next job. */
+		dst->is_held = true;
+		m2m_ctx->job_flags |= TRANS_HELD_DETACHED;
+	} else {
+		/* The driver owns it now, even if it was held. */
+		v4l2_m2m_dst_buf_remove(m2m_ctx);
+		dst->is_held = false;
+		m2m_ctx->job_flags &= ~TRANS_HELD_DETACHED;
+	}
 	*src_buf = src;
 	*dst_buf = dst;
 	schedule_next = _v4l2_m2m_job_finish(m2m_dev, m2m_ctx);
@@ -607,6 +641,28 @@ bool v4l2_m2m_buf_detach_and_job_finish(struct v4l2_m2m_dev *m2m_dev,
 }
 EXPORT_SYMBOL_GPL(v4l2_m2m_buf_detach_and_job_finish);
 
+bool v4l2_m2m_detached_buf_done(struct v4l2_m2m_ctx *m2m_ctx,
+				struct vb2_v4l2_buffer *vbuf,
+				enum vb2_buffer_state state)
+{
+	struct v4l2_m2m_dev *m2m_dev = m2m_ctx->m2m_dev;
+	unsigned long flags;
+	bool done = false;
+
+	spin_lock_irqsave(&m2m_dev->job_spinlock, flags);
+	if (vbuf->is_held) {
+		/* Still held for the next job, which returns it as usual. */
+		m2m_ctx->job_flags &= ~TRANS_HELD_DETACHED;
+	} else {
+		v4l2_m2m_buf_done(vbuf, state);
+		done = true;
+	}
+	spin_unlock_irqrestore(&m2m_dev->job_spinlock, flags);
+
+	return done;
+}
+EXPORT_SYMBOL_GPL(v4l2_m2m_detached_buf_done);
+
 void v4l2_m2m_suspend(struct v4l2_m2m_dev *m2m_dev)
 {
 	unsigned long flags;
@@ -1672,9 +1728,7 @@ int v4l2_m2m_ioctl_stateless_decoder_cmd(struct file *file, void *priv,
 		 * capture buffer that is held, then release that
 		 * buffer.
 		 */
-		cap_vb->is_held = false;
-		v4l2_m2m_dst_buf_remove(fh->m2m_ctx);
-		v4l2_m2m_buf_done(cap_vb, VB2_BUF_STATE_DONE);
+		v4l2_m2m_release_held_buf(fh->m2m_ctx, cap_vb);
 	}
 	spin_unlock_irqrestore(&m2m_dev->job_spinlock, flags);
 
diff --git a/include/media/v4l2-mem2mem.h b/include/media/v4l2-mem2mem.h
index 2e1dd110834a..71f4be716275 100644
--- a/include/media/v4l2-mem2mem.h
+++ b/include/media/v4l2-mem2mem.h
@@ -95,7 +95,8 @@ struct v4l2_m2m_queue_ctx {
  * @out_q_ctx: Output (input from memory) queue context
  * @queue: List of memory to memory contexts
  * @job_flags: Job queue flags, used internally by v4l2-mem2mem.c:
- *		%TRANS_QUEUED, %TRANS_RUNNING and %TRANS_ABORT.
+ *		%TRANS_QUEUED, %TRANS_RUNNING, %TRANS_ABORT and
+ *		%TRANS_HELD_DETACHED.
  * @finished: Wait queue used to signalize when a job queue finished.
  * @priv: Instance private data
  *
@@ -226,6 +227,10 @@ void v4l2_m2m_job_finish(struct v4l2_m2m_dev *m2m_dev,
  * This allows for multiple output buffers to be used to fill in a single
  * capture buffer. This is typically used by stateless decoders where
  * multiple e.g. H.264 slices contribute to a single decoded frame.
+ *
+ * If jobs detached with v4l2_m2m_buf_detach_and_job_finish() still write the
+ * held destination buffer, it isn't returned but handed over to the driver,
+ * which returns it with v4l2_m2m_detached_buf_done().
  */
 void v4l2_m2m_buf_done_and_job_finish(struct v4l2_m2m_dev *m2m_dev,
 				      struct v4l2_m2m_ctx *m2m_ctx,
@@ -242,16 +247,28 @@ void v4l2_m2m_buf_done_and_job_finish(struct v4l2_m2m_dev *m2m_dev,
  *
  * For drivers that keep processing a job after the next one may start, e.g.
  * on hardware with several cores that can work on consecutive jobs of the
- * same context. The source and destination buffers of the job are removed
- * from the ready lists without being returned, and the job is finished, so
- * that the next job can be scheduled while the hardware still processes
- * this one. The driver then owns both buffers and must return them with
- * v4l2_m2m_buf_done(), the destination buffer first.
- *
- * A job whose source buffer has %V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF set keeps
- * its destination buffer for the next job, so it can't be detached: nothing
- * is done and the job has to be finished with
- * v4l2_m2m_buf_done_and_job_finish() as usual.
+ * same context. The source buffer of the job is removed from the ready list
+ * without being returned, and the job is finished, so that the next job can
+ * be scheduled while the hardware still processes this one. The driver then
+ * owns the source buffer and returns it with v4l2_m2m_buf_done().
+ *
+ * The destination buffer is removed from the ready list as well and owned by
+ * the driver, unless the source buffer has %V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF
+ * set: then it stays on the ready list, held for the next job exactly as if
+ * the job had been finished with v4l2_m2m_buf_done_and_job_finish(), and is
+ * shared by the detached jobs and the framework. While detached jobs use it,
+ * the framework doesn't return it when the hold is released (a source buffer
+ * with another timestamp, %V4L2_DEC_CMD_FLUSH, or a job without
+ * %V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF that ends with
+ * v4l2_m2m_buf_done_and_job_finish()), but only takes it off the ready list.
+ *
+ * In both cases, once the driver is done with all the detached jobs that use
+ * the destination buffer, it must call v4l2_m2m_detached_buf_done() for it
+ * before returning the source buffer of the last one, so that the capture
+ * buffer completes before the request of the source buffer.
+ *
+ * The behaviour seen by userspace is the same as if the jobs had been
+ * finished with v4l2_m2m_buf_done_and_job_finish() when the hardware is done.
  *
  * Return: true if the buffers were detached and the job finished.
  */
@@ -260,6 +277,27 @@ bool v4l2_m2m_buf_detach_and_job_finish(struct v4l2_m2m_dev *m2m_dev,
 					struct vb2_v4l2_buffer **src_buf,
 					struct vb2_v4l2_buffer **dst_buf);
 
+/**
+ * v4l2_m2m_detached_buf_done() - the driver is done with the destination
+ * buffer of detached jobs
+ *
+ * @m2m_ctx: m2m context assigned to the instance given by struct &v4l2_m2m_ctx
+ * @vbuf: the destination buffer of jobs detached with
+ *	  v4l2_m2m_buf_detach_and_job_finish()
+ * @state: vb2 buffer state passed to v4l2_m2m_buf_done()
+ *
+ * Called by the driver when all the detached jobs that write @vbuf are done.
+ * If @vbuf is still held for the next job, it stays on the ready list and is
+ * returned by the framework when the hold is released, with
+ * %VB2_BUF_STATE_DONE, as for a held buffer of a job finished with
+ * v4l2_m2m_buf_done_and_job_finish(). Otherwise it is returned with @state.
+ *
+ * Return: true if @vbuf was returned.
+ */
+bool v4l2_m2m_detached_buf_done(struct v4l2_m2m_ctx *m2m_ctx,
+				struct vb2_v4l2_buffer *vbuf,
+				enum vb2_buffer_state state);
+
 static inline void
 v4l2_m2m_buf_done(struct vb2_v4l2_buffer *buf, enum vb2_buffer_state state)
 {
