From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 23:08:05 +0000
Subject: [PATCH] dt-bindings: media: rockchip: add the RK3588 video decoder
 CCU

The RK3588 video decoder has two cores and a core coordination unit
(CCU) between them. With the CCU, both cores can work on the same
stream: one core decodes a frame while the other one decodes the next
frame, and the CCU holds back the reads of reference pixels and
co-located motion vectors from a frame that is still being decoded
until they have been written.

Describe the CCU, and let the cores refer to it, with their index in
the CCU, through a new rockchip,ccu property.

The register layout comes from the Rockchip BSP kernel (mpp_rkvdec2_link.c,
develop-6.1), whose rk3588s.dtsi describes the same block as
rkvdec-ccu@fdc30000.

Assisted-by: Claude:claude-opus-5-5
---
 .../media/rockchip,rk3588-vdec-ccu.yaml       | 62 +++++++++++++++++++
 .../bindings/media/rockchip,vdec.yaml         | 19 ++++++
 MAINTAINERS                                   |  1 +
 3 files changed, 82 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/rockchip,rk3588-vdec-ccu.yaml

diff --git a/Documentation/devicetree/bindings/media/rockchip,rk3588-vdec-ccu.yaml b/Documentation/devicetree/bindings/media/rockchip,rk3588-vdec-ccu.yaml
new file mode 100644
index 000000000000..59cdff16e7fe
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rk3588-vdec-ccu.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rk3588-vdec-ccu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3588 Video Decoder Core Coordination Unit
+
+maintainers:
+  - Heiko Stuebner <heiko@sntech.de>
+
+description:
+  The RK3588 video decoder has two cores (rockchip,rk3588-vdec). The core
+  coordination unit (CCU) lets both cores work on the same stream. While one
+  core decodes a frame, the other one can decode the next frame, and the CCU
+  holds back its reads of reference pixels and co-located motion vectors
+  until the first core has written them.
+
+properties:
+  compatible:
+    const: rockchip,rk3588-vdec-ccu
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rockchip,rk3588-cru.h>
+    #include <dt-bindings/power/rk3588-power.h>
+    #include <dt-bindings/reset/rockchip,rk3588-cru.h>
+
+    bus {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        video-codec@fdc30000 {
+            compatible = "rockchip,rk3588-vdec-ccu";
+            reg = <0x0 0xfdc30000 0x0 0x100>;
+            clocks = <&cru ACLK_RKVDEC_CCU>;
+            power-domains = <&power RK3588_PD_RKVDEC0>;
+            resets = <&cru SRST_A_RKVDEC_CCU>;
+        };
+    };
+
+...
diff --git a/Documentation/devicetree/bindings/media/rockchip,vdec.yaml b/Documentation/devicetree/bindings/media/rockchip,vdec.yaml
index 4f38a0ef29d8..893ecbc0ea52 100644
--- a/Documentation/devicetree/bindings/media/rockchip,vdec.yaml
+++ b/Documentation/devicetree/bindings/media/rockchip,vdec.yaml
@@ -96,6 +96,16 @@ properties:
       Some SoCs, like rk3588 provide on-chip SRAM to store temporary
       buffers during decoding.
 
+  rockchip,ccu:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: The core coordination unit the core is connected to
+          - description: The index of the core in the core coordination unit
+    description:
+      The core coordination unit (rockchip,rk3588-vdec-ccu) that lets the
+      cores of the decoder work on the same stream.
+
 required:
   - compatible
   - reg
@@ -140,6 +150,15 @@ allOf:
         resets: false
         reset-names: false
         sram: false
+  - if:
+      properties:
+        compatible:
+          not:
+            contains:
+              const: rockchip,rk3588-vdec
+    then:
+      properties:
+        rockchip,ccu: false
 
 additionalProperties: false
 
diff --git a/MAINTAINERS b/MAINTAINERS
index e2db9d567140..36c7e64e3a64 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
