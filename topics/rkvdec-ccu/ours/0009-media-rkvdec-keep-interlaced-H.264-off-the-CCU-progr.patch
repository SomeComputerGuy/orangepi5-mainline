From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 02:35:37 +0000
Subject: [PATCH] media: rkvdec: keep interlaced H.264 off the CCU, program the
 POC high bits

On the board, fluster JVT-AVC_V1 broke as soon as the first field-coded
stream had run in CCU mode: the following streams decoded wrong, and in
JVT-FR-EXT the cores eventually stopped finishing frames (timeouts, then
IOMMU stall timeouts). Interlaced streams decode correctly on their own.

- Program the POC high bits of the multi-core registers 200-204 as the
  Rockchip MPP does on RK3588: the field parity of field pictures and of
  their references, 3 for the unused DPB entries of frame pictures. The
  cores tell references apart with them.
- Don't use the CCU for H.264 streams that may have field pictures or
  MBAFF (SPS frame_mbs_only_flag clear): they're decoded serially, with
  the core disconnected from the CCU, like VP9.
- Don't give a new stream the film index of a stream that just ended.

To be squashed into "decode one stream on both RK3588 cores with the
CCU" (and the high bits into its own patch) once confirmed on the board.

Assisted-by: Claude:claude-opus-5-5
---
 .../platform/rockchip/rkvdec/rkvdec-ccu.c      |  6 ++++--
 .../platform/rockchip/rkvdec/rkvdec-ccu.h      |  1 +
 .../rockchip/rkvdec/rkvdec-vdpu381-h264.c      | 18 ++++++++++++++++++
 .../media/platform/rockchip/rkvdec/rkvdec.c    | 15 +++++++++++++--
 .../media/platform/rockchip/rkvdec/rkvdec.h    |  2 ++
 5 files changed, 38 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c
index 5eaddb0bb..3363e4bca 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c
@@ -64,10 +64,12 @@ void rkvdec_ccu_put(struct rkvdec_ccu *ccu)
  * Only formats whose frames are pipelined (H.264, HEVC) run in CCU mode. The
  * VP9 back-end doesn't program the POC, probability and segmentation-map
  * references the cores synchronize VP9 on, and decodes garbage in CCU mode.
+ * Interlaced H.264 streams (ctx->ccu_off) don't use it either: they broke the
+ * following streams, until the decoder hung, on the board.
  */
-static bool rkvdec_ctx_uses_ccu(struct rkvdec_ctx *ctx)
+bool rkvdec_ctx_uses_ccu(struct rkvdec_ctx *ctx)
 {
-	return ctx->dev->ccu && READ_ONCE(ccu_hw) &&
+	return ctx->dev->ccu && !ctx->ccu_off && READ_ONCE(ccu_hw) &&
 	       (ctx->coded_fmt_desc->flags & RKVDEC_FMT_FLAG_PIPELINE);
 }
 
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h
index 39806bbc1..2e6ae1cab 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h
@@ -19,6 +19,7 @@ void rkvdec_ccu_release(struct rkvdec_ccu *ccu);
 
 int rkvdec_ccu_get(struct rkvdec_ccu *ccu);
 void rkvdec_ccu_put(struct rkvdec_ccu *ccu);
+bool rkvdec_ctx_uses_ccu(struct rkvdec_ctx *ctx);
 void rkvdec_ccu_prepare(struct rkvdec_ctx *ctx);
 void rkvdec_ccu_start(struct rkvdec_ctx *ctx);
 void rkvdec_vdpu381_set_ccu_regs(struct rkvdec_ctx *ctx,
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
index dca2a6ba4..9607f561d 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
@@ -233,6 +233,8 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	u32 y_virstride;
 	u32 offset;
 	u32 pixels;
+	bool field_pic;
+	u32 *highpoc;
 	u32 i;
 
 	memset(regs, 0, sizeof(*regs));
@@ -314,11 +316,25 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	regs->h264_param.reg065_cur_top_poc = dec_params->top_field_order_cnt;
 	regs->h264_param.reg066_cur_bot_poc = dec_params->bottom_field_order_cnt;
 
+	/*
+	 * POC high bits, which tell the cores what a reference is: the field
+	 * parity of field pictures, 3 for unused entries of frame pictures.
+	 */
+	field_pic = !!(dec_params->flags & V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC);
+	highpoc = (u32 *)&regs->h264_highpoc;
+	if (field_pic && (dec_params->flags & V4L2_H264_DECODE_PARAM_FLAG_BOTTOM_FIELD))
+		highpoc[4] = 1;
+
 	/* Set ref pic address & poc */
 	for (i = 0; i < ARRAY_SIZE(dec_params->dpb); i++) {
 		struct vb2_buffer *vb_buf = run->ref_buf[i];
 		dma_addr_t buf_dma;
 
+		if (field_pic)
+			highpoc[i / 4] |= 0x10 << ((i % 4) * 8);
+		else if (!vb_buf)
+			highpoc[i / 4] |= 0x33 << ((i % 4) * 8);
+
 		/*
 		 * If a DPB entry is unused or invalid, address of current destination
 		 * buffer is returned.
@@ -403,6 +419,8 @@ static int rkvdec_h264_start(struct rkvdec_ctx *ctx)
 		return -EINVAL;
 
 	ret = rkvdec_h264_validate_sps(ctx, ctrl->p_new.p_h264_sps);
+	if (!ret && !(ctrl->p_new.p_h264_sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY))
+		ctx->ccu_off = true;
 	if (ret)
 		return ret;
 
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.c b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
index 6d326a14d..09091cf48 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
@@ -1106,6 +1106,7 @@ static int rkvdec_start_streaming(struct vb2_queue *q, unsigned int count)
 		return -EINVAL;
 
 	ctx->num_job_slots = 1;
+	ctx->ccu_off = false;
 	if (ctx->dev->ccu && (desc->flags & RKVDEC_FMT_FLAG_PIPELINE) &&
 	    READ_ONCE(pipeline))
 		ctx->num_job_slots = min_t(unsigned int, ctx->dev->core_count,
@@ -1481,7 +1482,7 @@ static int rkvdec_job_ready(void *priv)
 		return 1;
 
 	/* Only formats with more than one job slot can be pipelined. */
-	if (ctx->num_jobs >= ctx->num_job_slots)
+	if (ctx->num_jobs >= ctx->num_job_slots || !rkvdec_ctx_uses_ccu(ctx))
 		return 0;
 
 	/* A CAPTURE buffer shared by two jobs (two fields): one at a time. */
@@ -1769,10 +1770,19 @@ static int rkvdec_open(struct file *filp)
 	mutex_init(&ctx->done_lock);
 	ctx->num_job_slots = 1;
 
-	ret = ida_alloc_range(&rkvdec->film_ida, 1, RKVDEC_MAX_FILM_IDX, GFP_KERNEL);
+	/*
+	 * Don't hand the film index of a stream that just ended to the next
+	 * one: start after the last one given out.
+	 */
+	ret = ida_alloc_range(&rkvdec->film_ida, READ_ONCE(rkvdec->next_film_idx),
+			      RKVDEC_MAX_FILM_IDX, GFP_KERNEL);
+	if (ret < 0)
+		ret = ida_alloc_range(&rkvdec->film_ida, 1, RKVDEC_MAX_FILM_IDX,
+				      GFP_KERNEL);
 	if (ret < 0)
 		goto err_free_ctx;
 	ctx->film_idx = ret;
+	WRITE_ONCE(rkvdec->next_film_idx, ret < RKVDEC_MAX_FILM_IDX ? ret + 1 : 1);
 
 	rkvdec_reset_coded_fmt(ctx);
 	rkvdec_reset_decoded_fmt(ctx);
@@ -2586,6 +2596,7 @@ static int rkvdec_probe(struct platform_device *pdev)
 	mutex_init(&rkvdec->vdev_lock);
 	spin_lock_init(&rkvdec->cores_lock);
 	ida_init(&rkvdec->film_ida);
+	rkvdec->next_film_idx = 1;
 
 	dev_set_drvdata(dev, rkvdec);
 
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.h b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
index 1c27fcffe..e92589cad 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
@@ -214,6 +214,7 @@ struct rkvdec_dev {
 	struct rkvdec_job *held_job;
 	struct rkvdec_ccu *ccu;
 	struct ida film_ida;
+	int next_film_idx;
 };
 
 struct rkvdec_ctx {
@@ -236,6 +237,7 @@ struct rkvdec_ctx {
 	wait_queue_head_t jobs_wq;
 	struct mutex done_lock; /* completes the jobs in decoding order */
 	int film_idx;
+	bool ccu_off; /* the stream can't use the CCU */
 	void *priv;
 	u8 has_sps_st_rps: 1;
 	u8 has_sps_lt_rps: 1;
