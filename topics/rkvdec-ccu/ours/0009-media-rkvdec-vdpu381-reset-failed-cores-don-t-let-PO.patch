From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 04:05:28 +0000
Subject: [PATCH] media: rkvdec: vdpu381: reset failed cores, don't let POC
 aliases deadlock the CCU

On the board, fluster JVT-AVC_V1 with two streams at once (HCBP2_HHI_A
and HCMP1_HHI_A) left core 1 stuck: every later job on it timed out, and
the IOMMU of the core could no longer stall. Two fixes:

- A VDPU381 core that reports an error or times out is now returned to
  its idle state: forced idle in the CCU so the other core doesn't wait
  for it, soft reset, a pulse of its reset lines if the soft reset
  doesn't complete, IOMMU reinitialization, then reconnected to the CCU
  with its error state cleared, as the BSP's soft-CCU reset does. The
  job fails back to userspace; the core takes the next job.

- The cores identify references by POC, and POCs repeat within a stream
  (IDR pictures, memory_management_control_operation 5, CRA). If a frame
  still being decoded has a reference whose POC is that of the next
  frame, the earlier frame waits for the next one, which itself waits
  for the earlier one. Record the POCs of every job and its references,
  and start a frame in CCU mode only once no earlier frame in flight has
  a reference with its POC.

Assisted-by: Claude:claude-opus-5-5
---
 .../platform/rockchip/rkvdec/rkvdec-ccu.c     |  18 +++
 .../platform/rockchip/rkvdec/rkvdec-ccu.h     |   2 +
 .../rockchip/rkvdec/rkvdec-vdpu381-h264.c     |  12 +-
 .../rockchip/rkvdec/rkvdec-vdpu381-hevc.c     |   8 +-
 .../rockchip/rkvdec/rkvdec-vdpu381-regs.h     |   1 +
 .../media/platform/rockchip/rkvdec/rkvdec.c   | 117 ++++++++++++++++--
 .../media/platform/rockchip/rkvdec/rkvdec.h   |  12 ++
 7 files changed, 160 insertions(+), 10 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c
index 604c05188a5b..ce28c12a3d3d 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.c
@@ -28,6 +28,8 @@
 #define RKVDEC_CCU_WORK_MODE_TASK	BIT(0)
 #define RKVDEC_CCU_CORE_WORK		0x044
 #define RKVDEC_CCU_CORE_STA		0x048
+#define RKVDEC_CCU_CORE_IDLE		0x04c
+#define RKVDEC_CCU_CORE_ERR		0x054
 /* Sets the bit of a core in the CORE_* registers */
 #define RKVDEC_CCU_CORE_SET(port)	(0x10001U << (port))
 
@@ -88,6 +90,22 @@ void rkvdec_ccu_prepare(struct rkvdec_ctx *ctx)
 	writel(RKVDEC_CCU_CORE_SET(core->ccu_port), ccu->regs + RKVDEC_CCU_CORE_WORK);
 }
 
+/*
+ * Forces a core that is being reset idle in the CCU, so that the other core
+ * doesn't wait for it, and connects it again with its error state cleared,
+ * as the BSP's soft-CCU reset does.
+ */
+void rkvdec_ccu_disconnect(struct rkvdec_ccu *ccu, struct rkvdec_core *core)
+{
+	writel(RKVDEC_CCU_CORE_SET(core->ccu_port), ccu->regs + RKVDEC_CCU_CORE_IDLE);
+}
+
+void rkvdec_ccu_reconnect(struct rkvdec_ccu *ccu, struct rkvdec_core *core)
+{
+	writel(BIT(core->ccu_port + 16), ccu->regs + RKVDEC_CCU_CORE_ERR);
+	writel(BIT(core->ccu_port + 16), ccu->regs + RKVDEC_CCU_CORE_IDLE);
+}
+
 /* Tells the CCU that the core of the job being set up starts decoding. */
 void rkvdec_ccu_start(struct rkvdec_ctx *ctx)
 {
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h
index 2e6ae1cab1b9..e5bb813f2fba 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-ccu.h
@@ -22,6 +22,8 @@ void rkvdec_ccu_put(struct rkvdec_ccu *ccu);
 bool rkvdec_ctx_uses_ccu(struct rkvdec_ctx *ctx);
 void rkvdec_ccu_prepare(struct rkvdec_ctx *ctx);
 void rkvdec_ccu_start(struct rkvdec_ctx *ctx);
+void rkvdec_ccu_disconnect(struct rkvdec_ccu *ccu, struct rkvdec_core *core);
+void rkvdec_ccu_reconnect(struct rkvdec_ccu *ccu, struct rkvdec_core *core);
 void rkvdec_vdpu381_set_ccu_regs(struct rkvdec_ctx *ctx,
 				 struct rkvdec_vdpu381_regs_common *common);
 
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
index b5a412489a11..69967c34fffa 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
@@ -315,6 +315,8 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	/* Set TOP and BOTTOM POCs */
 	regs->h264_param.reg065_cur_top_poc = dec_params->top_field_order_cnt;
 	regs->h264_param.reg066_cur_bot_poc = dec_params->bottom_field_order_cnt;
+	rkvdec_job_add_poc(ctx, dec_params->top_field_order_cnt, false);
+	rkvdec_job_add_poc(ctx, dec_params->bottom_field_order_cnt, false);
 
 	/*
 	 * POC high bits, which tell the cores what a reference is: the field
@@ -339,10 +341,13 @@ static void config_registers(struct rkvdec_ctx *ctx,
 		 * If a DPB entry is unused or invalid, address of current destination
 		 * buffer is returned.
 		 */
-		if (vb_buf)
+		if (vb_buf) {
 			rkvdec_job_add_ref(ctx, vb_buf);
-		else
+			rkvdec_job_add_poc(ctx, dpb[i].top_field_order_cnt, true);
+			rkvdec_job_add_poc(ctx, dpb[i].bottom_field_order_cnt, true);
+		} else {
 			vb_buf = &dst_buf->vb2_buf;
+		}
 
 		buf_dma = vb2_dma_contig_plane_dma_addr(vb_buf, 0);
 
@@ -495,6 +500,9 @@ static int rkvdec_h264_run(struct rkvdec_ctx *ctx)
 
 	rkvdec_run_postamble(ctx, &run.base);
 
+	/* Before the watchdog: this may wait for the earlier frames. */
+	rkvdec_job_wait_poc_alias(ctx);
+
 	rkvdec_schedule_watchdog(core, h264_ctx->regs.common.reg032_timeout_threshold);
 
 	/* Start decoding! */
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index 80646885a222..beb876a909a3 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
@@ -475,6 +475,7 @@ static void config_registers(struct rkvdec_ctx *ctx,
 
 	/* Set POC val */
 	regs->hevc_param.reg065_cur_top_poc = dec_params->pic_order_cnt_val;
+	rkvdec_job_add_poc(ctx, dec_params->pic_order_cnt_val, false);
 
 	/* Set ref pic address & poc */
 	for (i = 0; i < ARRAY_SIZE(dec_params->dpb); i++) {
@@ -482,8 +483,10 @@ static void config_registers(struct rkvdec_ctx *ctx,
 		dma_addr_t buf_dma = vb2_dma_contig_plane_dma_addr(vb_buf, 0);
 		u32 valid = !!(dec_params->num_active_dpb_entries > i);
 
-		if (valid)
+		if (valid) {
 			rkvdec_job_add_ref(ctx, vb_buf);
+			rkvdec_job_add_poc(ctx, dpb[i].pic_order_cnt_val, true);
+		}
 
 		/* Set reference addresses */
 		regs->hevc_addr.reg164_180_ref_base[i] = buf_dma;
@@ -653,6 +656,9 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 
 	rkvdec_run_postamble(ctx, &run.base);
 
+	/* Before the watchdog: this may wait for the earlier frames. */
+	rkvdec_job_wait_poc_alias(ctx);
+
 	rkvdec_schedule_watchdog(core, hevc_ctx->regs.common.reg032_timeout_threshold);
 
 	/* Start decoding! */
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
index 6c0ccced2454..72324e175297 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
@@ -36,6 +36,7 @@
 
 #define VDPU381_REG_IMPORTANT_EN	0x02c
 #define VDPU381_DEC_IRQ_DISABLE	BIT(4)
+#define VDPU381_SOFT_RESET_EN		BIT(20)
 
 /* Registers in the cache block, one set for each of the three caches */
 #define VDPU381_CACHE_CLR(n)		(0x10 + (n) * 0x40)
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.c b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
index 095e361649f6..05e53e913a05 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
@@ -15,10 +15,12 @@
 #include <linux/genalloc.h>
 #include <linux/interrupt.h>
 #include <linux/iommu.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/of_platform.h>
+#include <linux/reset.h>
 #include <linux/platform_device.h>
 #include <linux/pm.h>
 #include <linux/pm_runtime.h>
@@ -1364,6 +1366,7 @@ static void rkvdec_job_hw_done(struct rkvdec_core *core,
 		job->core = NULL;
 		job->state = state;
 		job->hw_done = true;
+		wake_up(&ctx->jobs_wq);
 
 		/* A core is free now: the held m2m job can be finished. */
 		held = rkvdec->held_job;
@@ -1433,6 +1436,58 @@ void rkvdec_job_add_ref(struct rkvdec_ctx *ctx, const struct vb2_buffer *ref)
 		job->refs[job->num_refs++] = ref;
 }
 
+void rkvdec_job_add_poc(struct rkvdec_ctx *ctx, s32 poc, bool ref)
+{
+	struct rkvdec_job *job = ctx->job;
+
+	if (ref) {
+		if (!WARN_ON(job->num_ref_pocs >= ARRAY_SIZE(job->ref_pocs)))
+			job->ref_pocs[job->num_ref_pocs++] = poc;
+	} else if (!WARN_ON(job->num_pocs >= ARRAY_SIZE(job->pocs))) {
+		job->pocs[job->num_pocs++] = poc;
+	}
+}
+
+/*
+ * Does an earlier frame of the stream that is still being decoded have a
+ * reference with a POC of the frame being set up? The cores identify
+ * references by POC: that earlier frame would wait for this one, which in
+ * turn waits for it.
+ */
+static bool rkvdec_job_poc_alias(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_job *job = ctx->job, *prev;
+	unsigned int i, j;
+
+	guard(spinlock_irqsave)(&ctx->dev->cores_lock);
+
+	list_for_each_entry(prev, &ctx->jobs, node) {
+		if (prev == job)
+			break;
+		if (prev->hw_done)
+			continue;
+		for (i = 0; i < prev->num_ref_pocs; i++)
+			for (j = 0; j < job->num_pocs; j++)
+				if (prev->ref_pocs[i] == job->pocs[j])
+					return true;
+	}
+
+	return false;
+}
+
+/*
+ * POCs repeat in a stream (IDR pictures, memory_management_control_operation
+ * 5, CRA): before starting a frame in CCU mode, wait for the earlier frames
+ * that would take it for one of their references.
+ */
+void rkvdec_job_wait_poc_alias(struct rkvdec_ctx *ctx)
+{
+	if (!rkvdec_ctx_uses_ccu(ctx) || !rkvdec_job_poc_alias(ctx))
+		return;
+
+	wait_event(ctx->jobs_wq, !rkvdec_job_poc_alias(ctx));
+}
+
 /* Is @buf a reference of a frame of @ctx that is still being decoded? */
 static bool rkvdec_ctx_buf_is_ref(struct rkvdec_ctx *ctx,
 				  const struct vb2_buffer *buf)
@@ -1946,6 +2001,43 @@ static irqreturn_t rk3399_irq_handler(struct rkvdec_core *core)
 	return IRQ_HANDLED;
 }
 
+/*
+ * Returns a VDPU381 core that failed or timed out to its idle state. A core
+ * that is stuck, for instance waiting in CCU mode for a reference that will
+ * never be written, doesn't take new jobs and keeps the IOMMU from stalling:
+ * force it idle in the CCU, soft reset it, pulse its reset lines if that
+ * doesn't work, and reinitialize its IOMMU.
+ */
+static void vdpu381_core_reset(struct rkvdec_core *core)
+{
+	struct rkvdec_ccu *ccu = core->curr_ctx->dev->ccu;
+	u32 status;
+	int ret;
+
+	if (ccu)
+		rkvdec_ccu_disconnect(ccu, core);
+
+	writel(VDPU381_SOFT_RESET_EN, core->regs + VDPU381_REG_IMPORTANT_EN);
+	ret = readl_poll_timeout_atomic(core->regs + VDPU381_REG_STA_INT, status,
+					status & VDPU381_STA_INT_SOFTRESET_RDY,
+					1, 100);
+	writel(0, core->regs + VDPU381_REG_STA_INT);
+
+	if (ret && core->resets) {
+		dev_warn(core->dev, "soft reset failed, resetting the core\n");
+		if (!reset_control_assert(core->resets)) {
+			udelay(5);
+			if (reset_control_deassert(core->resets))
+				dev_err(core->dev, "failed to deassert the resets\n");
+		}
+	}
+
+	rkvdec_iommu_restore(core);
+
+	if (ccu)
+		rkvdec_ccu_reconnect(ccu, core);
+}
+
 static irqreturn_t vdpu381_irq_handler(struct rkvdec_core *core)
 {
 	enum vb2_buffer_state state;
@@ -1958,14 +2050,13 @@ static irqreturn_t vdpu381_irq_handler(struct rkvdec_core *core)
 		state = VB2_BUF_STATE_DONE;
 	} else {
 		state = VB2_BUF_STATE_ERROR;
-		if (status & (VDPU381_STA_INT_SOFTRESET_RDY |
-			      VDPU381_STA_INT_TIMEOUT |
-			      VDPU381_STA_INT_ERROR))
-			rkvdec_iommu_restore(core);
 	}
 
-	if (cancel_delayed_work(&core->watchdog_work))
+	if (cancel_delayed_work(&core->watchdog_work)) {
+		if (state == VB2_BUF_STATE_ERROR)
+			vdpu381_core_reset(core);
 		rkvdec_job_hw_done(core, state, true);
+	}
 
 	return IRQ_HANDLED;
 }
@@ -2091,8 +2182,14 @@ static void rkvdec_watchdog_func(struct work_struct *work)
 			      watchdog_work);
 	ctx = core->curr_ctx;
 	if (ctx) {
-		dev_err(core->dev, "Frame processing timed out!\n");
-		writel(RKVDEC_IRQ_DIS, core->regs + RKVDEC_REG_INTERRUPT);
+		dev_err_ratelimited(core->dev, "Frame processing timed out!\n");
+		if (ctx->dev->variant->ops->irq_handler == vdpu381_irq_handler) {
+			disable_irq(core->irq);
+			vdpu381_core_reset(core);
+			enable_irq(core->irq);
+		} else {
+			writel(RKVDEC_IRQ_DIS, core->regs + RKVDEC_REG_INTERRUPT);
+		}
 		rkvdec_job_hw_done(core, VB2_BUF_STATE_ERROR, true);
 	}
 }
@@ -2331,6 +2428,12 @@ static int rkvdec_core_probe(struct platform_device *pdev)
 	irq = platform_get_irq(pdev, 0);
 	if (irq < 0)
 		return irq;
+	core->irq = irq;
+
+	core->resets = devm_reset_control_array_get_optional_exclusive(&pdev->dev);
+	if (IS_ERR(core->resets))
+		return dev_err_probe(&pdev->dev, PTR_ERR(core->resets),
+				     "failed to get the resets\n");
 
 	ret = devm_request_threaded_irq(&pdev->dev, irq, NULL,
 					rkvdec_irq_handler, IRQF_ONESHOT,
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.h b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
index fb17bf644e5c..e71390c0a98a 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
@@ -163,6 +163,10 @@ struct rkvdec_coded_fmt_desc {
  * @busy: the m2m state of the job is being changed, don't complete it
  * @num_refs: number of entries in @refs
  * @refs: the CAPTURE buffers the frame predicts from
+ * @num_pocs: number of entries in @pocs
+ * @pocs: the POCs of the frame (H.264: top and bottom field)
+ * @num_ref_pocs: number of entries in @ref_pocs
+ * @ref_pocs: the POCs of the references of the frame
  */
 struct rkvdec_job {
 	struct list_head node;
@@ -177,6 +181,10 @@ struct rkvdec_job {
 	bool busy;
 	unsigned int num_refs;
 	const struct vb2_buffer *refs[RKVDEC_MAX_REFS];
+	unsigned int num_pocs;
+	s32 pocs[2];
+	unsigned int num_ref_pocs;
+	s32 ref_pocs[2 * RKVDEC_MAX_REFS];
 };
 
 struct rkvdec_core {
@@ -189,6 +197,8 @@ struct rkvdec_core {
 	struct delayed_work watchdog_work;
 	struct gen_pool *sram_pool;
 	struct iommu_domain *empty_domain;
+	struct reset_control *resets;
+	int irq;
 	struct rkvdec_rcb_config *rcb_config;
 	struct rkvdec_ctx *curr_ctx;
 	struct rkvdec_job *job;
@@ -264,6 +274,8 @@ void rkvdec_run_postamble(struct rkvdec_ctx *ctx, struct rkvdec_run *run);
 void rkvdec_memcpy_toio(void __iomem *dst, void *src, size_t len);
 void rkvdec_schedule_watchdog(struct rkvdec_core *core, u32 timeout_threshold);
 void rkvdec_job_add_ref(struct rkvdec_ctx *ctx, const struct vb2_buffer *ref);
+void rkvdec_job_add_poc(struct rkvdec_ctx *ctx, s32 poc, bool ref);
+void rkvdec_job_wait_poc_alias(struct rkvdec_ctx *ctx);
 
 void rkvdec_quirks_disable_qos(struct rkvdec_ctx *ctx);
 
