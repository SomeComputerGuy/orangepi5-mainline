From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 23:15:27 +0000
Subject: [PATCH] arm64: dts: rockchip: add the RK3588 video decoder CCU

Describe the core coordination unit between the two video decoder
cores, which lets both cores decode the same stream, and connect the
cores to it.

The address, clock, reset and power domain, and the 600 MHz clock rate,
are those of the rkvdec-ccu node in the Rockchip BSP rk3588s.dtsi.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/rockchip/rk3588-base.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
index 3d944f9b0..5dfb82aa0 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
@@ -1511,6 +1511,16 @@ vepu580_1_mmu: iommu@fdbef000 {
 		#iommu-cells = <0>;
 	};
 
+	vdec_ccu: video-codec@fdc30000 {
+		compatible = "rockchip,rk3588-vdec-ccu";
+		reg = <0x0 0xfdc30000 0x0 0x100>;
+		clocks = <&cru ACLK_RKVDEC_CCU>;
+		assigned-clocks = <&cru ACLK_RKVDEC_CCU>;
+		assigned-clock-rates = <600000000>;
+		power-domains = <&power RK3588_PD_RKVDEC0>;
+		resets = <&cru SRST_A_RKVDEC_CCU>;
+	};
+
 	vdec0: video-codec@fdc38000 {
 		compatible = "rockchip,rk3588-vdec";
 		reg = <0x0 0xfdc38000 0x0 0x100>,
@@ -1530,6 +1540,7 @@ vdec0: video-codec@fdc38000 {
 		resets = <&cru SRST_A_RKVDEC0>, <&cru SRST_H_RKVDEC0>, <&cru SRST_RKVDEC0_CA>,
 			 <&cru SRST_RKVDEC0_CORE>, <&cru SRST_RKVDEC0_HEVC_CA>;
 		reset-names = "axi", "ahb", "cabac", "core", "hevc_cabac";
+		rockchip,ccu = <&vdec_ccu 0>;
 		sram = <&vdec0_sram>;
 	};
 
@@ -1562,6 +1573,7 @@ vdec1: video-codec@fdc40000 {
 		resets = <&cru SRST_A_RKVDEC1>, <&cru SRST_H_RKVDEC1>, <&cru SRST_RKVDEC1_CA>,
 			 <&cru SRST_RKVDEC1_CORE>, <&cru SRST_RKVDEC1_HEVC_CA>;
 		reset-names = "axi", "ahb", "cabac", "core", "hevc_cabac";
+		rockchip,ccu = <&vdec_ccu 1>;
 		sram = <&vdec1_sram>;
 	};
 
