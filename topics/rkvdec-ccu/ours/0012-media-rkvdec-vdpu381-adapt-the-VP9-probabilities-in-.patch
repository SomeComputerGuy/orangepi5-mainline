+	u8 partition[16][3];
+	u8 seg_pred[3];
+	u8 seg_tree[7];
+	u8 skip[3];
+	u8 tx32[2][3];
+	u8 tx16[2][2];
+	u8 tx8[2][1];
+	u8 is_inter[4];
+	u8 reserved[3];
