From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 23:04:42 +0000
Subject: [PATCH] media: rkvdec: vdpu381: give every job its own H.264/HEVC
 tables

The VDPU381 H.264 and HEVC back-ends write the parameter sets, the
reference picture sets and the scaling lists of a frame to a DMA table
that the hardware reads while it decodes. With one table per context,
the next frame of a stream can't be set up before the previous one is
done.

Allocate one table per job slot of the context, rkvdec_ctx.num_job_slots
of them, and use the one of the job being set up. The tables cache what
they hold to skip unchanged scaling lists and RPS, so the caches move
with them. There's still one slot per context, so nothing changes yet.

Assisted-by: Claude:claude-opus-5-5
---
 .../rockchip/rkvdec/rkvdec-vdpu381-h264.c     | 61 +++++++++++-----
 .../rockchip/rkvdec/rkvdec-vdpu381-hevc.c     | 69 +++++++++++++------
 2 files changed, 91 insertions(+), 39 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
index 7bc67c32a..e5d325999 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
@@ -78,20 +78,28 @@ struct rkvdec_h264_priv_tbl {
 };
 
 struct rkvdec_h264_ctx {
-	struct rkvdec_aux_buf priv_tbl;
+	/* One table per job, see &rkvdec_job.slot */
+	struct rkvdec_aux_buf priv_tbl[RKVDEC_MAX_JOBS];
 	struct rkvdec_h264_reflists reflists;
 	struct rkvdec_vdpu381_regs_h264 regs;
 };
 
+static struct rkvdec_aux_buf *rkvdec_h264_priv_tbl(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_h264_ctx *h264_ctx = ctx->priv;
+
+	return &h264_ctx->priv_tbl[ctx->job->slot];
+}
+
 static void assemble_hw_pps(struct rkvdec_ctx *ctx,
 			    struct rkvdec_h264_run *run)
 {
-	struct rkvdec_h264_ctx *h264_ctx = ctx->priv;
+	struct rkvdec_aux_buf *tbl_buf = rkvdec_h264_priv_tbl(ctx);
 	const struct v4l2_ctrl_h264_sps *sps = run->sps;
 	const struct v4l2_ctrl_h264_pps *pps = run->pps;
 	const struct v4l2_ctrl_h264_decode_params *dec_params = run->decode_params;
 	const struct v4l2_h264_dpb_entry *dpb = dec_params->dpb;
-	struct rkvdec_h264_priv_tbl *priv_tbl = h264_ctx->priv_tbl.cpu;
+	struct rkvdec_h264_priv_tbl *priv_tbl = tbl_buf->cpu;
 	struct rkvdec_sps_pps *hw_ps;
 	dma_addr_t scaling_list_address;
 	u32 scaling_distance;
@@ -174,7 +182,7 @@ static void assemble_hw_pps(struct rkvdec_ctx *ctx,
 	 * To be on the safe side, program the scaling matrix address
 	 */
 	scaling_distance = offsetof(struct rkvdec_h264_priv_tbl, scaling_list);
-	scaling_list_address = h264_ctx->priv_tbl.dma + scaling_distance;
+	scaling_list_address = tbl_buf->dma + scaling_distance;
 	hw_ps->pps.scaling_list_address = scaling_list_address;
 
 	for (i = 0; i < ARRAY_SIZE(dec_params->dpb); i++) {
@@ -211,7 +219,7 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	const struct v4l2_ctrl_h264_decode_params *dec_params = run->decode_params;
 	const struct v4l2_h264_dpb_entry *dpb = dec_params->dpb;
 	struct rkvdec_h264_ctx *h264_ctx = ctx->priv;
-	dma_addr_t priv_start_addr = h264_ctx->priv_tbl.dma;
+	dma_addr_t priv_start_addr = rkvdec_h264_priv_tbl(ctx)->dma;
 	const struct v4l2_pix_format_mplane *dst_fmt;
 	struct vb2_v4l2_buffer *src_buf = run->base.bufs.src;
 	struct vb2_v4l2_buffer *dst_buf = run->base.bufs.dst;
@@ -381,6 +389,7 @@ static int rkvdec_h264_start(struct rkvdec_ctx *ctx)
 	struct rkvdec_h264_priv_tbl *priv_tbl;
 	struct rkvdec_h264_ctx *h264_ctx;
 	struct v4l2_ctrl *ctrl;
+	unsigned int i;
 	int ret;
 
 	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
@@ -396,22 +405,32 @@ static int rkvdec_h264_start(struct rkvdec_ctx *ctx)
 	if (!h264_ctx)
 		return -ENOMEM;
 
-	priv_tbl = dma_alloc_coherent(ctx->dev->main_core->dev, sizeof(*priv_tbl),
-				      &h264_ctx->priv_tbl.dma, GFP_KERNEL);
-	if (!priv_tbl) {
-		ret = -ENOMEM;
-		goto err_free_ctx;
+	for (i = 0; i < ctx->num_job_slots; i++) {
+		struct rkvdec_aux_buf *buf = &h264_ctx->priv_tbl[i];
+
+		priv_tbl = dma_alloc_coherent(ctx->dev->main_core->dev,
+					      sizeof(*priv_tbl), &buf->dma,
+					      GFP_KERNEL);
+		if (!priv_tbl) {
+			ret = -ENOMEM;
+			goto err_free_tbl;
+		}
+
+		buf->size = sizeof(*priv_tbl);
+		buf->cpu = priv_tbl;
+		memcpy(priv_tbl->cabac_table, rkvdec_h264_cabac_table,
+		       sizeof(rkvdec_h264_cabac_table));
 	}
 
-	h264_ctx->priv_tbl.size = sizeof(*priv_tbl);
-	h264_ctx->priv_tbl.cpu = priv_tbl;
-	memcpy(priv_tbl->cabac_table, rkvdec_h264_cabac_table,
-	       sizeof(rkvdec_h264_cabac_table));
-
 	ctx->priv = h264_ctx;
 	return 0;
 
-err_free_ctx:
+err_free_tbl:
+	while (i--)
+		dma_free_coherent(ctx->dev->main_core->dev,
+				  h264_ctx->priv_tbl[i].size,
+				  h264_ctx->priv_tbl[i].cpu,
+				  h264_ctx->priv_tbl[i].dma);
 	kfree(h264_ctx);
 	return ret;
 }
@@ -419,9 +438,13 @@ static int rkvdec_h264_start(struct rkvdec_ctx *ctx)
 static void rkvdec_h264_stop(struct rkvdec_ctx *ctx)
 {
 	struct rkvdec_h264_ctx *h264_ctx = ctx->priv;
+	unsigned int i;
 
-	dma_free_coherent(ctx->dev->main_core->dev, h264_ctx->priv_tbl.size,
-			  h264_ctx->priv_tbl.cpu, h264_ctx->priv_tbl.dma);
+	for (i = 0; i < ctx->num_job_slots; i++)
+		dma_free_coherent(ctx->dev->main_core->dev,
+				  h264_ctx->priv_tbl[i].size,
+				  h264_ctx->priv_tbl[i].cpu,
+				  h264_ctx->priv_tbl[i].dma);
 	kfree(h264_ctx);
 }
 
@@ -430,7 +453,7 @@ static int rkvdec_h264_run(struct rkvdec_ctx *ctx)
 	struct v4l2_h264_reflist_builder reflist_builder;
 	struct rkvdec_core *core = ctx->core;
 	struct rkvdec_h264_ctx *h264_ctx = ctx->priv;
-	struct rkvdec_h264_priv_tbl *tbl = h264_ctx->priv_tbl.cpu;
+	struct rkvdec_h264_priv_tbl *tbl = rkvdec_h264_priv_tbl(ctx)->cpu;
 	struct rkvdec_h264_run run;
 
 	rkvdec_h264_run_preamble(ctx, &run);
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index 8281bd3c5..333dcb026 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
@@ -114,20 +114,31 @@ struct rkvdec_hevc_priv_tbl {
 	u8 cabac_table[27456];
 };
 
-struct rkvdec_hevc_ctx {
+/* The tables of one job, see &rkvdec_job.slot */
+struct rkvdec_hevc_job_tbl {
 	struct rkvdec_aux_buf			priv_tbl;
 	struct v4l2_ctrl_hevc_scaling_matrix	scaling_matrix_cache;
 	struct v4l2_ctrl_hevc_ext_sps_st_rps	st_cache;
+};
+
+struct rkvdec_hevc_ctx {
+	struct rkvdec_hevc_job_tbl		job_tbl[RKVDEC_MAX_JOBS];
 	struct rkvdec_vdpu381_regs_hevc		regs;
 };
 
+static struct rkvdec_hevc_job_tbl *rkvdec_hevc_job_tbl(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_hevc_ctx *hevc_ctx = ctx->priv;
+
+	return &hevc_ctx->job_tbl[ctx->job->slot];
+}
+
 static void assemble_hw_pps(struct rkvdec_ctx *ctx,
 			    struct rkvdec_hevc_run *run)
 {
-	struct rkvdec_hevc_ctx *hevc_ctx = ctx->priv;
 	const struct v4l2_ctrl_hevc_sps *sps = run->sps;
 	const struct v4l2_ctrl_hevc_pps *pps = run->pps;
-	struct rkvdec_hevc_priv_tbl *priv_tbl = hevc_ctx->priv_tbl.cpu;
+	struct rkvdec_hevc_priv_tbl *priv_tbl = rkvdec_hevc_job_tbl(ctx)->priv_tbl.cpu;
 	struct rkvdec_sps_pps_packet *hw_ps;
 	bool tiles_enabled;
 	s32 max_cu_width;
@@ -385,7 +396,7 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	const struct v4l2_hevc_dpb_entry *dpb = dec_params->dpb;
 	struct rkvdec_hevc_ctx *hevc_ctx = ctx->priv;
 	struct rkvdec_vdpu381_regs_hevc *regs = &hevc_ctx->regs;
-	dma_addr_t priv_start_addr = hevc_ctx->priv_tbl.dma;
+	dma_addr_t priv_start_addr = rkvdec_hevc_job_tbl(ctx)->priv_tbl.dma;
 	const struct v4l2_pix_format_mplane *dst_fmt;
 	struct vb2_v4l2_buffer *src_buf = run->base.bufs.src;
 	struct vb2_v4l2_buffer *dst_buf = run->base.bufs.dst;
@@ -545,6 +556,7 @@ static int rkvdec_hevc_start(struct rkvdec_ctx *ctx)
 	struct rkvdec_hevc_priv_tbl *priv_tbl;
 	struct rkvdec_hevc_ctx *hevc_ctx;
 	struct v4l2_ctrl *ctrl;
+	unsigned int i;
 	int ret;
 
 	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
@@ -560,22 +572,33 @@ static int rkvdec_hevc_start(struct rkvdec_ctx *ctx)
 	if (!hevc_ctx)
 		return -ENOMEM;
 
-	priv_tbl = dma_alloc_coherent(rkvdec->main_core->dev, sizeof(*priv_tbl),
-				      &hevc_ctx->priv_tbl.dma, GFP_KERNEL);
-	if (!priv_tbl) {
-		ret = -ENOMEM;
-		goto err_free_ctx;
-	}
+	for (i = 0; i < ctx->num_job_slots; i++) {
+		struct rkvdec_aux_buf *buf = &hevc_ctx->job_tbl[i].priv_tbl;
 
-	hevc_ctx->priv_tbl.size = sizeof(*priv_tbl);
-	hevc_ctx->priv_tbl.cpu = priv_tbl;
-	memcpy(priv_tbl->cabac_table, rkvdec_hevc_cabac_table,
-	       sizeof(rkvdec_hevc_cabac_table));
+		priv_tbl = dma_alloc_coherent(rkvdec->main_core->dev,
+					      sizeof(*priv_tbl), &buf->dma,
+					      GFP_KERNEL);
+		if (!priv_tbl) {
+			ret = -ENOMEM;
+			goto err_free_tbl;
+		}
+
+		buf->size = sizeof(*priv_tbl);
+		buf->cpu = priv_tbl;
+		memcpy(priv_tbl->cabac_table, rkvdec_hevc_cabac_table,
+		       sizeof(rkvdec_hevc_cabac_table));
+	}
 
 	ctx->priv = hevc_ctx;
 	return 0;
 
-err_free_ctx:
+err_free_tbl:
+	while (i--) {
+		struct rkvdec_aux_buf *buf = &hevc_ctx->job_tbl[i].priv_tbl;
+
+		dma_free_coherent(rkvdec->main_core->dev, buf->size, buf->cpu,
+				  buf->dma);
+	}
 	kfree(hevc_ctx);
 	return ret;
 }
@@ -584,9 +607,14 @@ static void rkvdec_hevc_stop(struct rkvdec_ctx *ctx)
 {
 	struct rkvdec_hevc_ctx *hevc_ctx = ctx->priv;
 	struct rkvdec_dev *rkvdec = ctx->dev;
+	unsigned int i;
 
-	dma_free_coherent(rkvdec->main_core->dev, hevc_ctx->priv_tbl.size,
-			  hevc_ctx->priv_tbl.cpu, hevc_ctx->priv_tbl.dma);
+	for (i = 0; i < ctx->num_job_slots; i++) {
+		struct rkvdec_aux_buf *buf = &hevc_ctx->job_tbl[i].priv_tbl;
+
+		dma_free_coherent(rkvdec->main_core->dev, buf->size, buf->cpu,
+				  buf->dma);
+	}
 	kfree(hevc_ctx);
 }
 
@@ -595,12 +623,13 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	struct rkvdec_core *core = ctx->core;
 	struct rkvdec_hevc_run run;
 	struct rkvdec_hevc_ctx *hevc_ctx = ctx->priv;
-	struct rkvdec_hevc_priv_tbl *tbl = hevc_ctx->priv_tbl.cpu;
+	struct rkvdec_hevc_job_tbl *job_tbl = rkvdec_hevc_job_tbl(ctx);
+	struct rkvdec_hevc_priv_tbl *tbl = job_tbl->priv_tbl.cpu;
 
 	rkvdec_hevc_run_preamble(ctx, &run);
 
 	rkvdec_hevc_assemble_hw_scaling_list(ctx, &run, &tbl->scaling_list,
-					     &hevc_ctx->scaling_matrix_cache);
+					     &job_tbl->scaling_matrix_cache);
 	assemble_hw_pps(ctx, &run);
 
 	/*
@@ -611,7 +640,7 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 	    (!ctx->has_sps_st_rps && run.sps->num_short_term_ref_pic_sets)) {
 		dev_warn_ratelimited(core->dev, "Long and short term RPS not set\n");
 	} else {
-		rkvdec_hevc_assemble_hw_rps(&run, &tbl->rps, &hevc_ctx->st_cache);
+		rkvdec_hevc_assemble_hw_rps(&run, &tbl->rps, &job_tbl->st_cache);
 	}
 
 	config_registers(ctx, &run);
