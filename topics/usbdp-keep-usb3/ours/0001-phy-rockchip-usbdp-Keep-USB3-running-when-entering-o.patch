From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 30 Oct 2026 03:45:50 +0000
Subject: [PATCH] phy: rockchip: usbdp: Keep USB3 running when entering or
 leaving DP AltMode

Since commit "phy: rockchip: usbdp: Add USB-C state without DP enabled"
the PHY is in USB-only mode while nothing is using DP AltMode, and every
change of hw_mode sets phy_needs_reinit. Entering DP AltMode with pin
assignment D (USB3 on two lanes, DP on the other two) therefore goes
through rk_udphy_init(): all PHY resets are asserted for 10 ms, the
DWC3 PIPE interface is put into reset and the USB3 port is disabled.
The SuperSpeed link of a device that is already enumerated on the USB3
lanes goes down. With a USB-C dock (USB3 hub + AX88179 NIC + DP) the
hub disconnects and re-enumerates ~1.5 s later, about 1 s after its
devices came up; if the re-init hits during enumeration, a control
transfer times out instead:

  usb 8-1: new SuperSpeed USB device number 2 using xhci-hcd
  usb 8-1: can't set config #1, error -110
  usb 8-1: USB disconnect, device number 2

The same happens on every DP Configure, as the DisplayPort AltMode
driver puts the mux into TYPEC_STATE_SAFE (USB-only here) before each
Configure command, e.g. on a pin assignment change.

The re-init is not needed: USB-only mode and pin assignment D use the
same lane mux (rk_udphy_set_lane_mux() routes lanes 0/1, or 2/3 when
flipped, to USB3 in both), and the DP half of the PHY has no reset line
of its own. It is held in reset by CMN_DP_INIT_RSTN, and its PLL by
CMN_DP_CMN_RSTN, which rk_udphy_dp_phy_configure() releases when the
DP controller sets the link rate.

One more thing the re-init on DP entry used to cover: the DP AUX channel
only works if the PHY is initialized after the SBU lines are biased and
the AUX polarity is set for the cable orientation. At boot, the USB3 PHY
is initialized before the Type-C orientation is known, and the first
orientation event only re-inits the PHY if the orientation differs from
the default, so with DP entry no longer re-initializing the PHY, AUX
transfers time out (-110) and DP-1 stays disconnected. Re-init the PHY
when a partner attaches too, which happens before its USB devices
enumerate.

Only request a full re-init when the USB3 part is switched on or off or
the lane routing changes (4 lane DP, orientation), and otherwise start
or stop just the DP half through CMN_DP_INIT_RSTN. The DP lanes are
restored after both paths when the DP PHY is in use, as before.

Reproducer (Orange Pi 5, USB-C dock with a USB3 hub, AX88179 and DP,
pin assignment D): run iperf3 over the dock's NIC and switch the pin
assignment, which re-enters DP AltMode without re-plugging:

  echo C > /sys/bus/typec/devices/port0-partner.0/displayport/pin_assignment
  echo D > /sys/bus/typec/devices/port0-partner.0/displayport/pin_assignment

Before, the hub disconnects at each SAFE <-> D step (and at boot when
DP AltMode is entered); after, USB3 only goes down while pin assignment
C (4 lane DP, no USB3 lanes) is active, and stays up across DP entry
and exit with pin assignment D, while DP-1 detects (no AUX errors) from
boot and after every transition.

Link: https://gitlab.collabora.com/hardware-enablement/rockchip-3588/linux/-/commit/b6c756709db3ae6f85ef8133de754a8e7b7ec894 # the change this fixes (not in mainline yet)
Assisted-by: Claude:claude-opus-5-5
---
 drivers/phy/rockchip/phy-rockchip-usbdp.c | 100 ++++++++++++++++++----
 1 file changed, 85 insertions(+), 15 deletions(-)

diff --git a/drivers/phy/rockchip/phy-rockchip-usbdp.c b/drivers/phy/rockchip/phy-rockchip-usbdp.c
index 4c90ddccdc63..adcf9056bb7d 100644
--- a/drivers/phy/rockchip/phy-rockchip-usbdp.c
+++ b/drivers/phy/rockchip/phy-rockchip-usbdp.c
@@ -173,6 +173,7 @@ struct rk_udphy {
 
 	/* PHY status management */
 	bool flip;
+	bool attached; /* the Type-C orientation is known */
 	bool phy_needs_reinit; /* lane mux changed */
 	u8 hw_mode; /* modes currently supported by hardware */
 	u8 sw_mode; /* modes currently requested */
@@ -583,6 +584,40 @@ static void rk_udphy_dp_lane_enable(struct rk_udphy *udphy, int dp_lanes)
 				   CMN_DP_CMN_RSTN, FIELD_PREP(CMN_DP_CMN_RSTN, 0x0));
 }
 
+/*
+ * Start or stop the DP half of an initialized PHY. The DP side has no reset
+ * line of its own: it is held in reset by CMN_DP_INIT_RSTN and its PLL by
+ * CMN_DP_CMN_RSTN, which rk_udphy_dp_phy_configure() releases when the link
+ * rate is set. The USB3 lanes, LCPLL and their resets are not affected.
+ */
+static void rk_udphy_dp_enable(struct rk_udphy *udphy, bool enable)
+{
+	if (!enable)
+		rk_udphy_dp_lane_enable(udphy, 0);
+
+	regmap_update_bits(udphy->pma_regmap, CMN_DP_RSTN_OFFSET, CMN_DP_INIT_RSTN,
+			   FIELD_PREP(CMN_DP_INIT_RSTN, enable));
+
+	if (enable)
+		udelay(1);
+}
+
+/*
+ * The DP PHY may already be powered on when the DP side is (re-)initialized
+ * underneath it, e.g. when the Type-C mux changes the pin assignment while DP
+ * is in use. Enable the lanes of the new configuration again, as
+ * rk_udphy_dp_phy_power_on() does, so that the DP controller can retrain.
+ */
+static void rk_udphy_dp_restore_lanes(struct rk_udphy *udphy, u8 target_mode)
+{
+	if (!(udphy->sw_mode & UDPHY_MODE_DP) || !(target_mode & UDPHY_MODE_DP))
+		return;
+
+	phy_set_bus_width(udphy->phy_dp, udphy->dp_lanes);
+	rk_udphy_dp_lane_enable(udphy, udphy->dp_lanes);
+	rk_udphy_dp_lane_select(udphy);
+}
+
 static void rk_udphy_set_lane_mux(struct rk_udphy *udphy)
 {
 	if (udphy->dp_lanes == 4) {
@@ -610,7 +645,19 @@ static void rk_udphy_mode_set(struct rk_udphy *udphy, u8 hw_mode, u8 dp_lanes)
 	if (udphy->hw_mode == hw_mode && udphy->dp_lanes == dp_lanes)
 		return;
 
-	udphy->phy_needs_reinit = true;
+	/*
+	 * USB-only mode and USB3 + 2 lane DP (pin assignment D) use the same
+	 * lane mux (see rk_udphy_set_lane_mux()): the USB3 lanes stay where
+	 * they are and only the DP half of the PHY has to be started or
+	 * stopped, which rk_udphy_update_power_state() does without touching
+	 * the USB3 side. Only request a full re-init, which resets the USB3
+	 * lanes and disconnects any SuperSpeed device, if the USB3 part is
+	 * switched on or off or the lane routing changes (4 lane DP).
+	 */
+	if (((udphy->hw_mode ^ hw_mode) & UDPHY_MODE_USB) ||
+	    udphy->dp_lanes == 4 || dp_lanes == 4)
+		udphy->phy_needs_reinit = true;
+
 	udphy->hw_mode = hw_mode;
 	udphy->dp_lanes = dp_lanes;
 }
@@ -676,15 +723,26 @@ static int rk_udphy_orien_sw_set(struct typec_switch_dev *sw,
 		gpiod_set_value_cansleep(udphy->sbu2_dc_gpio, 0);
 		/* unattached */
 		rk_udphy_usb_bvalid_enable(udphy, false);
+		udphy->attached = false;
 
 		return 0;
 	}
 
-	if (udphy->flip != flipped) {
-		dev_dbg(udphy->dev, "cable orientation changed, PHY re-init required.\n");
+	/*
+	 * The DP AUX channel only works if the PHY is initialized after the
+	 * SBU lines are biased and the AUX polarity is set for the cable
+	 * orientation (rk_udphy_set_typec_default_mapping()), so re-init on
+	 * attach too, not only when the orientation changes. This happens
+	 * before the partner's USB devices enumerate.
+	 */
+	if (udphy->flip != flipped || !udphy->attached) {
+		dev_dbg(udphy->dev, "cable %s, PHY re-init required.\n",
+			udphy->attached ? "orientation changed" : "attached");
 		udphy->phy_needs_reinit = true;
 	}
 
+	udphy->attached = true;
+
 	udphy->flip = flipped;
 	rk_udphy_set_typec_default_mapping(udphy);
 	rk_udphy_usb_bvalid_enable(udphy, true);
@@ -1070,6 +1128,28 @@ static int rk_udphy_update_power_state(struct rk_udphy *udphy)
 	if (udphy->status == target_mode && target_mode == UDPHY_MODE_NONE)
 		return 0;
 
+	/*
+	 * Only the DP half changes (USB-only <-> USB3 + DP, same lane mux):
+	 * start or stop it without resetting the PHY, so that the USB3 link
+	 * of a device using the other two lanes (e.g. a USB-C dock with a hub)
+	 * survives DP AltMode entry and exit.
+	 */
+	if (!udphy->phy_needs_reinit && udphy->status != UDPHY_MODE_NONE &&
+	    target_mode != UDPHY_MODE_NONE) {
+		dev_dbg(udphy->dev, "%s DP (%u lanes), keeping USB3=%s\n",
+			str_enable_disable(target_mode & UDPHY_MODE_DP),
+			udphy->dp_lanes, str_on_off(target_mode & UDPHY_MODE_USB));
+
+		rk_udphy_dp_enable(udphy, target_mode & UDPHY_MODE_DP);
+		rk_udphy_dp_restore_lanes(udphy, target_mode);
+
+		if (udphy->sw_mode & UDPHY_MODE_USB)
+			rk_udphy_u3_port_disable(udphy, !usb3_port_enable);
+
+		udphy->status = target_mode;
+		return 0;
+	}
+
 	/*
 	 * Inform DWC3 driver, that we are about to reset the PHY, so that it can
 	 * assert its PIPE reset lines and avoid DWC3 getting into a buggy state.
@@ -1107,18 +1187,8 @@ static int rk_udphy_update_power_state(struct rk_udphy *udphy)
 			return ret;
 		}
 
-		/*
-		 * rk_udphy_init() leaves all DP lanes disabled. If the DP PHY
-		 * is powered on (the Type-C mux changed the pin assignment
-		 * while DP is in use), enable the lanes of the new
-		 * configuration again, as rk_udphy_dp_phy_power_on() does, so
-		 * that the DP controller can retrain the link.
-		 */
-		if ((udphy->sw_mode & UDPHY_MODE_DP) && (target_mode & UDPHY_MODE_DP)) {
-			phy_set_bus_width(udphy->phy_dp, udphy->dp_lanes);
-			rk_udphy_dp_lane_enable(udphy, udphy->dp_lanes);
-			rk_udphy_dp_lane_select(udphy);
-		}
+		/* rk_udphy_init() leaves all DP lanes disabled */
+		rk_udphy_dp_restore_lanes(udphy, target_mode);
 	}
 
 	/* Ensure USB3 support is enabled when supported */
