From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 12:59:10 +0000
Subject: [PATCH] DO NOT UPSTREAM: media: v4l2-ctrls: Keep the v4l2-core symbol
 versions

Local deployment helper for the Orange Pi 5 test kernel (7.3.0-opi5,
CONFIG_MODVERSIONS with gendwarfksyms). Drop it when the kernel is
rebuilt as a whole.

The H.264 stateless encode uAPI adds a member to union v4l2_ctrl_ptr and
an enumerator to enum v4l2_ctrl_type. Both are part of the DWARF types
that gendwarfksyms hashes, which changes the symbol versions of 86
videodev exports (and 3 of v4l2-flash-led-class), so that every V4L2
module would have to be rebuilt and replaced along with videodev.

Don't add the union member, use the generic pointer instead, and define
V4L2_CTRL_TYPE_H264_ENCODE_PARAMS outside of the enumeration. The
generated code doesn't change, and the symbol versions of all existing
v4l2-core exports stay those of the running kernel, so that only
videodev.ko, the new v4l2-h264-enc modules and hantro-vpu.ko need to be
replaced.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/v4l2-core/v4l2-ctrls-core.c | 2 +-
 drivers/media/v4l2-core/v4l2-h264-enc.c   | 2 +-
 include/media/v4l2-ctrls.h                | 2 --
 include/uapi/linux/videodev2.h            | 4 +++-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/media/v4l2-core/v4l2-ctrls-core.c b/drivers/media/v4l2-core/v4l2-ctrls-core.c
index 9f27cd51b..a1d1ec53b 100644
--- a/drivers/media/v4l2-core/v4l2-ctrls-core.c
+++ b/drivers/media/v4l2-core/v4l2-ctrls-core.c
@@ -339,7 +339,7 @@ void v4l2_ctrl_type_op_log(const struct v4l2_ctrl *ctrl)
 		pr_cont(" ");
 	}
 
-	switch (ctrl->type) {
+	switch ((u32)ctrl->type) {
 	case V4L2_CTRL_TYPE_INTEGER:
 		pr_cont("%d", *ptr.p_s32);
 		break;
diff --git a/drivers/media/v4l2-core/v4l2-h264-enc.c b/drivers/media/v4l2-core/v4l2-h264-enc.c
index 9745c0e85..d43444817 100644
--- a/drivers/media/v4l2-core/v4l2-h264-enc.c
+++ b/drivers/media/v4l2-core/v4l2-h264-enc.c
@@ -470,7 +470,7 @@ static int state_prepare_params(struct v4l2_h264_enc *enc)
 	if (!ctrl)
 		return -EINVAL;
 
-	memcpy(encode, ctrl->p_cur.p_h264_encode_params, sizeof(*encode));
+	memcpy(encode, ctrl->p_cur.p, sizeof(*encode));
 
 	if (encode->slice_type == V4L2_H264_SLICE_TYPE_SI)
 		encode->slice_type = V4L2_H264_SLICE_TYPE_I;
diff --git a/include/media/v4l2-ctrls.h b/include/media/v4l2-ctrls.h
index 9aa79b798..327976b14 100644
--- a/include/media/v4l2-ctrls.h
+++ b/include/media/v4l2-ctrls.h
@@ -42,7 +42,6 @@ struct video_device;
  * @p_h264_scaling_matrix:	Pointer to a struct v4l2_ctrl_h264_scaling_matrix.
  * @p_h264_slice_params:	Pointer to a struct v4l2_ctrl_h264_slice_params.
  * @p_h264_decode_params:	Pointer to a struct v4l2_ctrl_h264_decode_params.
- * @p_h264_encode_params:	Pointer to a struct v4l2_ctrl_h264_encode_params.
  * @p_h264_pred_weights:	Pointer to a struct v4l2_ctrl_h264_pred_weights.
  * @p_vp8_frame:		Pointer to a VP8 frame params structure.
  * @p_vp9_compressed_hdr_probs:	Pointer to a VP9 frame compressed header probs structure.
@@ -77,7 +76,6 @@ union v4l2_ctrl_ptr {
 	struct v4l2_ctrl_h264_scaling_matrix *p_h264_scaling_matrix;
 	struct v4l2_ctrl_h264_slice_params *p_h264_slice_params;
 	struct v4l2_ctrl_h264_decode_params *p_h264_decode_params;
-	struct v4l2_ctrl_h264_encode_params *p_h264_encode_params;
 	struct v4l2_ctrl_h264_pred_weights *p_h264_pred_weights;
 	struct v4l2_ctrl_vp8_frame *p_vp8_frame;
 	struct v4l2_ctrl_hevc_sps *p_hevc_sps;
diff --git a/include/uapi/linux/videodev2.h b/include/uapi/linux/videodev2.h
index e19628c52..eb0a2b584 100644
--- a/include/uapi/linux/videodev2.h
+++ b/include/uapi/linux/videodev2.h
@@ -1973,7 +1973,6 @@ enum v4l2_ctrl_type {
 	V4L2_CTRL_TYPE_H264_SLICE_PARAMS    = 0x0203,
 	V4L2_CTRL_TYPE_H264_DECODE_PARAMS   = 0x0204,
 	V4L2_CTRL_TYPE_H264_PRED_WEIGHTS    = 0x0205,
-	V4L2_CTRL_TYPE_H264_ENCODE_PARAMS   = 0x0206,
 
 	V4L2_CTRL_TYPE_FWHT_PARAMS	    = 0x0220,
 
@@ -2000,6 +1999,9 @@ enum v4l2_ctrl_type {
 	V4L2_CTRL_TYPE_AV1_FILM_GRAIN	    = 0x283,
 };
 
+/* Not an enumerator, to keep the module symbol versions of v4l2-core. */
+#define V4L2_CTRL_TYPE_H264_ENCODE_PARAMS	0x0206
+
 /*  Used in the VIDIOC_QUERYCTRL ioctl for querying controls */
 struct v4l2_queryctrl {
 	__u32		     id;
