diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c
new file mode 100644
index 000000000..c669a6322
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c
@@ -0,0 +1,520 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip VEPU580 (RKVENC) H.264 encoding backend
+ *
+ * Parameter sets are generated by the V4L2 H.264 stateless encode core and
+ * written by the CPU at the start of the CAPTURE buffer. The hardware
+ * writes the start code, NAL header and slice header of each slice from
+ * the syntax registers, followed by the slice data.
+ *
+ * The hardware reads exactly one reference picture per frame, so the
+ * stream is restricted to I and P frames with a single reference frame.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/moduleparam.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <media/v4l2-h264-enc.h>
+
+#include "rkvenc.h"
+
+#define RKVENC_H264_ROW_QP_RANGE	2
+
+static unsigned int row_rc_qp_range = RKVENC_H264_ROW_QP_RANGE;
+module_param(row_rc_qp_range, uint, 0644);
+MODULE_PARM_DESC(row_rc_qp_range,
+		 "CBR: maximum per-row QP change by the hardware rate control (0 = frame-level rate control only)");
+
+#define RKVENC_H264_PROFILE_BASELINE	66
+#define RKVENC_H264_PROFILE_MAIN	77
+#define RKVENC_H264_PROFILE_HIGH	100
+
+struct rkvenc_h264_rec_buf {
+	struct rkvenc_rec_buf rec;
+};
+
+static int rkvenc_h264_state_constrain(struct v4l2_h264_enc *enc,
+				       struct v4l2_h264_enc_state *state)
+{
+	struct v4l2_ctrl_h264_sps *sps = &state->sps;
+	struct v4l2_ctrl_h264_pps *pps = &state->pps;
+	struct v4l2_ctrl_h264_encode_params *encode = &state->encode;
+
+	/* SPS: 8-bit 4:2:0 progressive, Baseline, Main or High. */
+	switch (sps->profile_idc) {
+	case RKVENC_H264_PROFILE_BASELINE:
+	case RKVENC_H264_PROFILE_MAIN:
+	case RKVENC_H264_PROFILE_HIGH:
+		break;
+	default:
+		sps->profile_idc = RKVENC_H264_PROFILE_HIGH;
+		break;
+	}
+
+	if (!sps->level_idc)
+		sps->level_idc = 51;
+
+	/*
+	 * The hardware writes pic_order_cnt_lsb in its slice headers, so only
+	 * picture order count type 0 can be described.
+	 */
+	if (sps->pic_order_cnt_type)
+		return -EINVAL;
+
+	if (V4L2_H264_SPS_HAS_CHROMA_FORMAT(sps)) {
+		sps->chroma_format_idc = 1;
+		sps->flags &= ~(V4L2_H264_SPS_FLAG_SEPARATE_COLOUR_PLANE |
+				V4L2_H264_SPS_FLAG_QPPRIME_Y_ZERO_TRANSFORM_BYPASS);
+		sps->bit_depth_luma_minus8 = 0;
+		sps->bit_depth_chroma_minus8 = 0;
+	}
+
+	sps->flags |= V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY |
+		      V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE;
+	sps->flags &= ~(V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD |
+			V4L2_H264_SPS_FLAG_GAPS_IN_FRAME_NUM_VALUE_ALLOWED);
+
+	/* One reference read port. */
+	if (sps->max_num_ref_frames > 1)
+		sps->max_num_ref_frames = 1;
+
+	if (sps->log2_max_frame_num_minus4 > 12)
+		sps->log2_max_frame_num_minus4 = 12;
+	if (sps->log2_max_pic_order_cnt_lsb_minus4 > 12)
+		sps->log2_max_pic_order_cnt_lsb_minus4 = 12;
+
+	/* PPS */
+	if (sps->profile_idc == RKVENC_H264_PROFILE_BASELINE)
+		pps->flags &= ~V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE;
+	if (sps->profile_idc != RKVENC_H264_PROFILE_HIGH) {
+		pps->flags &= ~V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE;
+		/* second_chroma_qp_index_offset is a High profile syntax element. */
+		pps->second_chroma_qp_index_offset = pps->chroma_qp_index_offset;
+	}
+
+	pps->num_ref_idx_l0_default_active_minus1 = 0;
+	pps->num_ref_idx_l1_default_active_minus1 = 0;
+
+	/* Encode parameters */
+	encode->flags &= ~(V4L2_H264_ENCODE_FLAG_FIELD_PIC |
+			   V4L2_H264_ENCODE_FLAG_BOTTOM_FIELD |
+			   V4L2_H264_ENCODE_FLAG_NUM_REF_IDX_ACTIVE_OVERRIDE);
+	encode->num_ref_idx_l0_active_minus1 = 0;
+	encode->num_ref_idx_l1_active_minus1 = 0;
+	encode->colour_plane_id = 0;
+
+	if (!(pps->flags & V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT)) {
+		encode->disable_deblocking_filter_idc = 0;
+		encode->slice_alpha_c0_offset_div2 = 0;
+		encode->slice_beta_offset_div2 = 0;
+	}
+
+	if (!(pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE))
+		encode->cabac_init_idc = 0;
+
+	return 0;
+}
+
+static void rkvenc_h264_rec_size(struct rkvenc_ctx *ctx, size_t *hdr,
+				 size_t *body, size_t *thumb)
+{
+	const struct v4l2_pix_format_mplane *pix = &ctx->coded_fmt.fmt.pix_mp;
+	/* FBC data needs 16 extra lines for the hardware I/O. */
+	unsigned int aw = ALIGN(pix->width, 64);
+	unsigned int ah = ALIGN(pix->height, 16) + 16;
+
+	*hdr = ALIGN(aw * ah / 64, SZ_8K);
+	*body = aw * ah * 3 / 2;
+	*thumb = ALIGN(DIV_ROUND_UP(aw, 64) * DIV_ROUND_UP(ah, 64) * 256, SZ_8K);
+}
+
+static int rkvenc_h264_rec_buffer_alloc(struct v4l2_h264_enc *enc,
+					struct v4l2_h264_enc_rec_buffer *buffer)
+{
+	struct rkvenc_ctx *ctx = enc->private_data;
+	struct rkvenc_h264_rec_buf *buf;
+	size_t hdr, body, thumb;
+	int ret;
+
+	buf = kzalloc_obj(*buf);
+	if (!buf)
+		return -ENOMEM;
+
+	rkvenc_h264_rec_size(ctx, &hdr, &body, &thumb);
+	buf->rec.fbc_hdr_size = hdr;
+
+	ret = rkvenc_alloc_aux(ctx->dev, &buf->rec.pixel, hdr + body, false);
+	if (ret)
+		goto err_free;
+
+	ret = rkvenc_alloc_aux(ctx->dev, &buf->rec.thumb, thumb, false);
+	if (ret)
+		goto err_free_pixel;
+
+	buffer->private_data = buf;
+	return 0;
+
+err_free_pixel:
+	rkvenc_free_aux(ctx->dev, &buf->rec.pixel);
+err_free:
+	kfree(buf);
+	return ret;
+}
+
+static int rkvenc_h264_rec_buffer_free(struct v4l2_h264_enc *enc,
+				       struct v4l2_h264_enc_rec_buffer *buffer)
+{
+	struct rkvenc_ctx *ctx = enc->private_data;
+	struct rkvenc_h264_rec_buf *buf = buffer->private_data;
+
+	if (!buf)
+		return -EINVAL;
+
+	rkvenc_free_aux(ctx->dev, &buf->rec.thumb);
+	rkvenc_free_aux(ctx->dev, &buf->rec.pixel);
+	kfree(buf);
+	buffer->private_data = NULL;
+	return 0;
+}
+
+static const struct v4l2_h264_enc_ops rkvenc_h264_enc_ops = {
+	.state_constrain = rkvenc_h264_state_constrain,
+	.rec_buffer_alloc = rkvenc_h264_rec_buffer_alloc,
+	.rec_buffer_free = rkvenc_h264_rec_buffer_free,
+};
+
+static int rkvenc_h264_start(struct rkvenc_ctx *ctx)
+{
+	struct rkvenc_h264_ctx *h264;
+	struct v4l2_h264_enc *enc;
+	int ret;
+
+	h264 = kzalloc_obj(*h264);
+	if (!h264)
+		return -ENOMEM;
+
+	enc = &h264->enc;
+	enc->ops = &rkvenc_h264_enc_ops;
+	enc->private_data = ctx;
+	enc->format_mplane = &ctx->coded_fmt.fmt.pix_mp;
+	enc->timeperframe = &ctx->timeperframe;
+	enc->ctrl_handler = &ctx->ctrl_hdl;
+	enc->ref_slots_count_init = 1;
+	enc->flags = V4L2_H264_ENC_FLAG_INTER_PRED |
+		     V4L2_H264_ENC_FLAG_HW_SLICE_HEADER |
+		     V4L2_H264_ENC_FLAG_CHROMA_QP_CR_OFFSET;
+
+	ret = v4l2_h264_enc_init(enc);
+	if (ret) {
+		kfree(h264);
+		return ret;
+	}
+
+	ctx->priv = h264;
+	return 0;
+}
+
+static void rkvenc_h264_stop(struct rkvenc_ctx *ctx)
+{
+	struct rkvenc_h264_ctx *h264 = ctx->priv;
+
+	if (!h264)
+		return;
+
+	v4l2_h264_enc_exit(&h264->enc);
+	kfree(h264);
+	ctx->priv = NULL;
+}
+
+static struct rkvenc_rec_buf *
+rkvenc_h264_rec(struct v4l2_h264_enc_rec_buffer *buffer)
+{
+	struct rkvenc_h264_rec_buf *buf = buffer->private_data;
+
+	return buf ? &buf->rec : NULL;
+}
+
+static void rkvenc_h264_setup_refs(struct rkvenc_h264_ctx *h264,
+				   struct rkvenc_core *core, bool intra)
+{
+	struct v4l2_h264_enc_ref *ref = &h264->enc.ref;
+	struct rkvenc_rec_buf *rec = rkvenc_h264_rec(&ref->buffer_current);
+	struct rkvenc_rec_buf *refr = NULL;
+
+	rkvenc_set(core, VEPU580_RFPW_H_ADDR, rec->pixel.dma);
+	rkvenc_set(core, VEPU580_RFPW_B_ADDR, rec->pixel.dma + rec->fbc_hdr_size);
+	rkvenc_set(core, VEPU580_DSPW_ADDR, rec->thumb.dma);
+
+	if (!intra && ref->l0_active_count)
+		refr = rkvenc_h264_rec(&ref->buffers[ref->l0[0].index]);
+
+	if (refr) {
+		rkvenc_set(core, VEPU580_RFPR_H_ADDR, refr->pixel.dma);
+		rkvenc_set(core, VEPU580_RFPR_B_ADDR,
+			   refr->pixel.dma + refr->fbc_hdr_size);
+		rkvenc_set(core, VEPU580_DSPR_ADDR, refr->thumb.dma);
+	}
+}
+
+static void rkvenc_h264_setup_syntax(struct rkvenc_core *core,
+				     const struct v4l2_h264_enc_state *state)
+{
+	const struct v4l2_ctrl_h264_sps *sps = &state->sps;
+	const struct v4l2_ctrl_h264_pps *pps = &state->pps;
+	const struct v4l2_ctrl_h264_encode_params *encode = &state->encode;
+	bool intra = encode->slice_type == V4L2_H264_SLICE_TYPE_I;
+	bool idr = encode->flags & V4L2_H264_ENCODE_FLAG_IDR_PIC;
+	bool cabac = pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE;
+	u32 val;
+
+	rkvenc_or(core, VEPU580_ENC_PIC,
+		  FIELD_PREP(VEPU580_ENC_PIC_ENC_STND, VEPU580_ENC_STND_H264) |
+		  (encode->nal_ref_idc ? VEPU580_ENC_PIC_CUR_FRM_REF : 0) |
+		  VEPU580_ENC_PIC_BS_SCP);
+
+	rkvenc_set(core, VEPU580_H264_SYNT_NAL,
+		   FIELD_PREP(VEPU580_H264_NAL_REF_IDC, encode->nal_ref_idc) |
+		   FIELD_PREP(VEPU580_H264_NAL_UNIT_TYPE,
+			      idr ? V4L2_H264_NALU_TYPE_SLICE_IDR :
+				    V4L2_H264_NALU_TYPE_SLICE_NON_IDR));
+
+	rkvenc_set(core, VEPU580_H264_SYNT_SPS,
+		   FIELD_PREP(VEPU580_H264_SPS_MAX_FNUM,
+			      sps->log2_max_frame_num_minus4) |
+		   ((sps->flags & V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE) ?
+		    VEPU580_H264_SPS_DRCT_8X8 : 0) |
+		   FIELD_PREP(VEPU580_H264_SPS_MPOC_LM4,
+			      sps->log2_max_pic_order_cnt_lsb_minus4));
+
+	val = (cabac ? VEPU580_H264_PPS_ETPY_MODE : 0) |
+	      FIELD_PREP(VEPU580_H264_PPS_NUM_REF0_IDX,
+			 pps->num_ref_idx_l0_default_active_minus1) |
+	      FIELD_PREP(VEPU580_H264_PPS_NUM_REF1_IDX,
+			 pps->num_ref_idx_l1_default_active_minus1) |
+	      FIELD_PREP(VEPU580_H264_PPS_PIC_INIT_QP,
+			 pps->pic_init_qp_minus26 + 26) |
+	      FIELD_PREP(VEPU580_H264_PPS_CB_OFST,
+			 pps->chroma_qp_index_offset & 0x1f) |
+	      FIELD_PREP(VEPU580_H264_PPS_CR_OFST,
+			 pps->second_chroma_qp_index_offset & 0x1f);
+	if (pps->flags & V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE)
+		val |= VEPU580_H264_PPS_TRNS_8X8;
+	if (pps->flags & V4L2_H264_PPS_FLAG_CONSTRAINED_INTRA_PRED)
+		val |= VEPU580_H264_PPS_CSIP_FLAG;
+	if (pps->flags & V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT)
+		val |= VEPU580_H264_PPS_DBF_CP_FLG;
+	rkvenc_set(core, VEPU580_H264_SYNT_PPS, val);
+
+	rkvenc_set(core, VEPU580_H264_SYNT_SLI0,
+		   FIELD_PREP(VEPU580_H264_SLI0_SLI_TYPE,
+			      intra ? VEPU580_H264_SLI_TYPE_I :
+				      VEPU580_H264_SLI_TYPE_P) |
+		   FIELD_PREP(VEPU580_H264_SLI0_PPS_ID,
+			      encode->pic_parameter_set_id) |
+		   FIELD_PREP(VEPU580_H264_SLI0_CBC_INIT_IDC,
+			      encode->cabac_init_idc) |
+		   FIELD_PREP(VEPU580_H264_SLI0_FRM_NUM, encode->frame_num));
+
+	rkvenc_set(core, VEPU580_H264_SYNT_SLI1,
+		   FIELD_PREP(VEPU580_H264_SLI1_IDR_PID,
+			      idr ? encode->idr_pic_id : 0xffff) |
+		   FIELD_PREP(VEPU580_H264_SLI1_POC_LSB,
+			      encode->pic_order_cnt_lsb));
+
+	rkvenc_set(core, VEPU580_H264_SYNT_SLI2,
+		   FIELD_PREP(VEPU580_H264_SLI2_SLI_BETA_OFST,
+			      encode->slice_beta_offset_div2 & 0xf) |
+		   FIELD_PREP(VEPU580_H264_SLI2_SLI_ALPH_OFST,
+			      encode->slice_alpha_c0_offset_div2 & 0xf) |
+		   FIELD_PREP(VEPU580_H264_SLI2_DIS_DBLK_IDC,
+			      encode->disable_deblocking_filter_idc));
+
+	/* Sliding window marking only; long-term marking on IDR. */
+	val = 0;
+	if (idr && (encode->flags & V4L2_H264_ENCODE_FLAG_NO_OUTPUT_OF_PRIOR_PICS))
+		val |= VEPU580_H264_REFM0_NOPP_FLG;
+	if (idr && (encode->flags & V4L2_H264_ENCODE_FLAG_LONG_TERM_REFERENCE))
+		val |= VEPU580_H264_REFM0_LTRF_FLG;
+	rkvenc_set(core, VEPU580_H264_SYNT_REFM0, val);
+	rkvenc_set(core, VEPU580_H264_SYNT_REFM1, 0);
+	rkvenc_set(core, VEPU580_H264_SYNT_REFM2, 0);
+
+	val = VEPU580_RDO_CFG_INTER_4X4 | VEPU580_RDO_CFG_CHRM_SPCL |
+	      VEPU580_RDO_CFG_CCWA_E | VEPU580_RDO_CFG_ATR_E |
+	      VEPU580_RDO_CFG_ATF_INTRA_E;
+	if (sps->profile_idc == RKVENC_H264_PROFILE_BASELINE &&
+	    sps->level_idc <= 30)
+		val |= VEPU580_RDO_CFG_RECT_SIZE;
+	if (sps->profile_idc < RKVENC_H264_PROFILE_MAIN && !cabac)
+		val |= VEPU580_RDO_CFG_VLC_LMT;
+	rkvenc_set(core, VEPU580_RDO_CFG, val);
+}
+
+static int rkvenc_h264_run(struct rkvenc_ctx *ctx, struct rkvenc_core *core,
+			   struct rkvenc_run *run)
+{
+	struct rkvenc_h264_ctx *h264 = ctx->priv;
+	struct v4l2_h264_enc *enc = &h264->enc;
+	const struct v4l2_h264_enc_state *state = &enc->state_active;
+	const struct v4l2_h264_enc_rc *rc = &enc->rc;
+	unsigned int mbs;
+	bool intra;
+	int ret;
+
+	/* The parameter sets are written through the kernel mapping. */
+	if (!vb2_plane_vaddr(&run->dst->vb2_buf, 0))
+		return -ENOMEM;
+
+	ret = v4l2_h264_enc_step(enc, run->dst);
+	if (ret)
+		return ret;
+
+	run->hdr_bytes = v4l2_h264_enc_rbsp_bytes_count(&enc->rbsp);
+	if (run->hdr_bytes + SZ_4K > rkvenc_dst_size(run))
+		return -ENOSPC;
+
+	intra = state->encode.slice_type == V4L2_H264_SLICE_TYPE_I;
+	mbs = state->width_mbs * state->height_mbs;
+
+	/* A P frame must have a reconstructed reference to read. */
+	if (!intra && (!enc->ref.l0_active_count ||
+		       !enc->ref.buffers[enc->ref.l0[0].index].private_data))
+		return -EINVAL;
+
+	vepu580_setup_common(ctx, core, run);
+	rkvenc_h264_setup_syntax(core, state);
+	rkvenc_h264_setup_refs(h264, core, intra);
+	vepu580_setup_me(core, state->width_mbs, state->height_mbs,
+			 state->sps.level_idc, intra);
+	vepu580_setup_h264_tuning(ctx->dev, core, intra);
+
+	/*
+	 * In CBR mode the frame size target from the common rate control is
+	 * handed to the hardware row rate control, which adapts the QP of
+	 * each macroblock row by up to RKVENC_H264_ROW_QP_RANGE.
+	 */
+	h264->hw_rc = rc->mode && rc->mode->type == V4L2_H264_ENC_RC_TYPE_CBR &&
+		      READ_ONCE(row_rc_qp_range);
+	if (h264->hw_rc)
+		vepu580_setup_row_rc(core, rc->qp, state->qp_min, state->qp_max,
+				     min(READ_ONCE(row_rc_qp_range), 15U),
+				     (u64)rc->size * 8,
+				     mbs, state->width_mbs);
+	else
+		vepu580_setup_fixed_qp(core, rc->qp);
+
+	return 0;
+}
+
+static void rkvenc_h264_done(struct rkvenc_ctx *ctx, struct rkvenc_run *run,
+			     const struct rkvenc_feedback *fb,
+			     enum vb2_buffer_state *state)
+{
+	struct rkvenc_h264_ctx *h264 = ctx->priv;
+	struct v4l2_h264_enc *enc;
+	unsigned int mbs, avg_qp;
+	u64 bytes;
+
+	if (!h264 || *state != VB2_BUF_STATE_DONE)
+		return;
+
+	enc = &h264->enc;
+	bytes = run->hdr_bytes + fb->bs_len;
+	if (!fb->bs_len || bytes > rkvenc_dst_size(run)) {
+		*state = VB2_BUF_STATE_ERROR;
+		return;
+	}
+
+	vb2_set_plane_payload(&run->dst->vb2_buf, 0, bytes);
+
+	mbs = enc->state_active.width_mbs * enc->state_active.height_mbs;
+	avg_qp = mbs ? DIV_ROUND_CLOSEST(fb->qp_sum, mbs) : 0;
+
+	/*
+	 * Don't feed the measured average back into the rate control
+	 * statistics: with adaptive quantisation it sits a few steps below the
+	 * frame QP, and the frame-level estimate then spirals down.
+	 */
+	if (ctx->avg_qp_ctrl)
+		v4l2_ctrl_s_ctrl(ctx->avg_qp_ctrl, min(avg_qp, 51U));
+
+	if (v4l2_h264_enc_complete(enc, run->dst))
+		*state = VB2_BUF_STATE_ERROR;
+}
+
+static int rkvenc_h264_adjust_fmt(struct rkvenc_ctx *ctx, struct v4l2_format *f)
+{
+	return 0;
+}
+
+static const struct rkvenc_codec_ops rkvenc_h264_ops = {
+	.adjust_fmt = rkvenc_h264_adjust_fmt,
