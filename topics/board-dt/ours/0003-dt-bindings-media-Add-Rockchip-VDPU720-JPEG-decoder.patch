From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 12:38:55 +0000
Subject: [PATCH] dt-bindings: media: Add Rockchip VDPU720 JPEG decoder

The RK3588 has a dedicated baseline JPEG decoder, called VDPU720 in the
TRM and rkjpegd in the vendor kernel, separate from the Hantro based
VPU121. It has its own IOMMU, interrupt, clocks and resets, and sits in
the VDPU power domain.

The resources were taken from the rk3588s.dtsi of the Rockchip vendor
kernel (rockchip-linux/kernel, develop-6.1), whose node uses the
"rockchip,rkv-jpeg-decoder-v1" compatible of the vendor MPP framework.

Assisted-by: Claude:claude-opus-5-5
---
 .../media/rockchip,rk3588-jpeg-decoder.yaml   | 86 +++++++++++++++++++
 MAINTAINERS                                   |  7 ++
 2 files changed, 93 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/rockchip,rk3588-jpeg-decoder.yaml

diff --git a/Documentation/devicetree/bindings/media/rockchip,rk3588-jpeg-decoder.yaml b/Documentation/devicetree/bindings/media/rockchip,rk3588-jpeg-decoder.yaml
new file mode 100644
index 000000000..9c42f85c1
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rk3588-jpeg-decoder.yaml
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rk3588-jpeg-decoder.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip VDPU720 JPEG decoder
+
+maintainers:
+  - Arun Iyengar <aiyengar1990@gmail.com>
+
+description:
+  The VDPU720 (also called rkjpegd) is a dedicated baseline JPEG decoder
+  found in Rockchip SoCs. It decodes Huffman coded 8-bit JPEG images into
+  semi-planar YUV frames and has its own IOMMU.
+
+properties:
+  compatible:
+    const: rockchip,rk3588-jpeg-decoder
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: AXI bus clock
+      - description: AHB interface clock
+
+  clock-names:
+    items:
+      - const: aclk
+      - const: hclk
+
+  resets:
+    items:
+      - description: AXI bus reset
+      - description: AHB interface reset
+
+  reset-names:
+    items:
+      - const: axi
+      - const: ahb
+
+  power-domains:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rockchip,rk3588-cru.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/power/rk3588-power.h>
+    #include <dt-bindings/reset/rockchip,rk3588-cru.h>
+
+    bus {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        video-codec@fdb90000 {
+            compatible = "rockchip,rk3588-jpeg-decoder";
+            reg = <0x0 0xfdb90000 0x0 0x400>;
+            interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
+            clocks = <&cru ACLK_JPEG_DECODER>, <&cru HCLK_JPEG_DECODER>;
+            clock-names = "aclk", "hclk";
+            resets = <&cru SRST_A_JPEG_DECODER>, <&cru SRST_H_JPEG_DECODER>;
+            reset-names = "axi", "ahb";
+            iommus = <&jpegd_mmu>;
+            power-domains = <&power RK3588_PD_VDPU>;
+        };
+    };
