From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 23:03:24 +0000
Subject: [PATCH] media: rockchip: rga: Support NV15 and P010 on the RGA3

The RGA3 reads and writes 10-bit YUV 4:2:0, either packed (NV15, the
format the RK3588 video decoder writes) or with one sample per 16-bit
word (P010). This lets userspace convert decoded 10-bit video to NV12,
P010 or RGB, behind the RGA3's own IOMMU and without the 4 GiB limit of
the RGA2.

Add both formats to the RGA3 on the OUTPUT and CAPTURE queues. The width
of 10-bit YUV must be aligned to 4 pixels.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/media/platform/rockchip/rga/rga3-hw.c | 31 ++++++++++++++++++-
 drivers/media/platform/rockchip/rga/rga3-hw.h | 12 +++++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/rockchip/rga/rga3-hw.c b/drivers/media/platform/rockchip/rga/rga3-hw.c
index 2760e8922026..00e2cd0136b4 100644
--- a/drivers/media/platform/rockchip/rga/rga3-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga3-hw.c
@@ -59,6 +59,12 @@ static bool rga3_can_capture(const struct rga3_fmt *fmt)
 	return fmt->hw_format <= RGA3_COLOR_FMT_LAST_OUTPUT;
 }
 
+static bool rga3_is_yuv10b(const struct rga3_fmt *fmt)
+{
+	return fmt->hw_format == RGA3_COLOR_FMT_YUV420_10B ||
+	       fmt->hw_format == RGA3_COLOR_FMT_YUV422_10B;
+}
+
 /*
  * Map the transformations to the RGA3 command buffer.
  * Currently this is just the scaling settings and a fixed alpha value.
@@ -185,6 +191,8 @@ static void rga3_cmd_set_win0_format(struct rga_ctx *ctx)
 		      |  FIELD_PREP(RGA3_WIN_PIC_FORMAT, in->hw_format)
 		      |  FIELD_PREP(RGA3_WIN_YC_SWAP, in->yc_swap)
 		      |  FIELD_PREP(RGA3_WIN_RBUV_SWAP, in->rbuv_swap)
+		      |  FIELD_PREP(RGA3_WIN_YUV10B_COMPACT, in->yuv10b_compact)
+		      |  FIELD_PREP(RGA3_WIN_YUV10B_ENDIAN, in->yuv10b_endian)
 		      |  FIELD_PREP(RGA3_WIN_RD_FORMAT, rd_format)
 		      |  FIELD_PREP(RGA3_WIN_R2Y, r2y)
 		      |  FIELD_PREP(RGA3_WIN_Y2R, y2r)
@@ -236,6 +244,8 @@ static void rga3_cmd_set_wr_format(struct rga_ctx *ctx)
 	cmd[reg >> 2] = FIELD_PREP(RGA3_WR_PIC_FORMAT, out->hw_format)
 		     |  FIELD_PREP(RGA3_WR_YC_SWAP, out->yc_swap)
 		     |  FIELD_PREP(RGA3_WR_RBUV_SWAP, out->rbuv_swap)
+		     |  FIELD_PREP(RGA3_WR_YUV10B_COMPACT, out->yuv10b_compact)
+		     |  FIELD_PREP(RGA3_WR_YUV10B_ENDIAN, out->yuv10b_endian)
 		     |  FIELD_PREP(RGA3_WR_FORMAT, wr_format)
 	/* Use the max value to avoid limiting the write speed */
 		     |  FIELD_PREP(RGA3_WR_SW_OUTSTANDING_MAX, 63);
@@ -398,6 +408,16 @@ static struct rga3_fmt rga3_formats[] = {
 		.hw_format = RGA3_COLOR_FMT_YUV420,
 		.rbuv_swap = 1,
 	},
+	{
+		.fourcc = V4L2_PIX_FMT_NV15,
+		.hw_format = RGA3_COLOR_FMT_YUV420_10B,
+		.yuv10b_compact = 1,
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_P010,
+		.hw_format = RGA3_COLOR_FMT_YUV420_10B,
+		.yuv10b_endian = 1,
+	},
 	{
 		.fourcc = V4L2_PIX_FMT_NV16M,
 		.hw_format = RGA3_COLOR_FMT_YUV422,
@@ -519,8 +539,17 @@ static void *rga3_adjust_and_map_format(struct rga_ctx *ctx,
 		if (!is_output && !rga3_can_capture(&rga3_formats[i]))
 			continue;
 
-		if (rga3_formats[i].fourcc == format->pixelformat)
+		if (rga3_formats[i].fourcc == format->pixelformat) {
+			/*
+			 * The width of 10-bit YUV 4:2:x must be aligned to
+			 * 4 pixels (TRM part 2, 5.6.3); the hardware limits
+			 * are multiples of 4, the driver's YUV step of 2
+			 * keeps it aligned.
+			 */
+			if (rga3_is_yuv10b(&rga3_formats[i]))
+				format->width = ALIGN(format->width, 4);
 			return &rga3_formats[i];
+		}
 	}
 
 	format->pixelformat = rga3_formats[0].fourcc;
diff --git a/drivers/media/platform/rockchip/rga/rga3-hw.h b/drivers/media/platform/rockchip/rga/rga3-hw.h
index d75a517083b5..6d9929f9c6ea 100644
--- a/drivers/media/platform/rockchip/rga/rga3-hw.h
+++ b/drivers/media/platform/rockchip/rga/rga3-hw.h
@@ -183,6 +183,8 @@
 #define RGA3_WIN_SCALE_HOR_BYPASS BIT(20)
 #define RGA3_WIN_YC_SWAP BIT(13)
 #define RGA3_WIN_RBUV_SWAP BIT(12)
+#define RGA3_WIN_YUV10B_ENDIAN BIT(11)
+#define RGA3_WIN_YUV10B_COMPACT BIT(10)
 #define RGA3_WIN_RD_FORMAT GENMASK(9, 8)
 #define RGA3_WIN_PIC_FORMAT GENMASK(7, 4)
 #define RGA3_WIN_ENABLE BIT(0)
@@ -199,14 +201,24 @@
 #define RGA3_WR_YC_SWAP BIT(20)
 #define RGA3_WR_SW_OUTSTANDING_MAX GENMASK(18, 13)
 #define RGA3_WR_RBUV_SWAP BIT(12)
+#define RGA3_WR_YUV10B_ENDIAN BIT(11)
+#define RGA3_WR_YUV10B_COMPACT BIT(10)
 #define RGA3_WR_FORMAT GENMASK(9, 8)
 #define RGA3_WR_PIC_FORMAT GENMASK(7, 4)
 
+/*
+ * 10-bit YUV in raster mode is either compact (4 samples packed into 5 bytes,
+ * as NV15) or one sample per 16-bit word. The endian bit only applies to the
+ * latter. Userspace using the vendor librga sets it for P010, whose samples
+ * are in the upper 10 bits of little-endian words.
+ */
 struct rga3_fmt {
 	u32 fourcc;
 	u8 hw_format;
 	bool rbuv_swap;
 	bool yc_swap;
+	bool yuv10b_compact;
+	bool yuv10b_endian;
 };
 
 #endif
