new file mode 100644
index 000000000..1c30bb692
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkjpegd/rkjpegd-hw.c
@@ -0,0 +1,439 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Rockchip VDPU720 JPEG decoder driver: header checks and hardware programming
+ *
+ * The register and table layouts were derived from the Rockchip RK3588 BSP
+ * and from the Rockchip MPP library; no code was taken from either.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/string.h>
+
+#include "rkjpegd.h"
+
+bool rkjpegd_cap_fourcc_valid(u32 fourcc,
+			      enum v4l2_jpeg_chroma_subsampling subsampling)
+{
+	switch (subsampling) {
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_GRAY:
+		return fourcc == V4L2_PIX_FMT_GREY;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_420:
+		return fourcc == V4L2_PIX_FMT_NV12;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_422:
+		return fourcc == V4L2_PIX_FMT_NV16 || fourcc == V4L2_PIX_FMT_NV12;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_444:
+		return fourcc == V4L2_PIX_FMT_NV24 || fourcc == V4L2_PIX_FMT_NV12;
+	default:
+		return false;
+	}
+}
+
+u32 rkjpegd_native_fourcc(enum v4l2_jpeg_chroma_subsampling subsampling)
+{
+	switch (subsampling) {
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_GRAY:
+		return V4L2_PIX_FMT_GREY;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_422:
+		return V4L2_PIX_FMT_NV16;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_444:
+		return V4L2_PIX_FMT_NV24;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_420:
+	default:
+		return V4L2_PIX_FMT_NV12;
+	}
+}
+
+/* Annex K.3 tables: 16 code length counts followed by the values */
+static const u8 *const rkjpegd_default_huff[4] = {
+	[RKJPEGD_HUFF_DC(0)] = v4l2_jpeg_ref_table_luma_dc_ht,
+	[RKJPEGD_HUFF_DC(1)] = v4l2_jpeg_ref_table_chroma_dc_ht,
+	[RKJPEGD_HUFF_AC(0)] = v4l2_jpeg_ref_table_luma_ac_ht,
+	[RKJPEGD_HUFF_AC(1)] = v4l2_jpeg_ref_table_chroma_ac_ht,
+};
+
+static int rkjpegd_copy_huff(struct rkjpegd_huff *huff, const u8 *table,
+			     unsigned int max_values)
+{
+	unsigned int count = 0, codes = 0;
+	unsigned int i;
+
+	memset(huff, 0, sizeof(*huff));
+
+	/* every code of length i + 1 must fit in i + 1 bits */
+	for (i = 0; i < 16; i++) {
+		codes = (codes << 1) + table[i];
+		if (codes > (2U << i))
+			return -EINVAL;
+		count += table[i];
+	}
+	if (!count || count > max_values)
+		return -EINVAL;
+
+	memcpy(huff->bits, table, 16);
+	memcpy(huff->vals, table + 16, count);
+
+	return 0;
+}
+
+int rkjpegd_parse_header(void *buf, size_t len, struct rkjpegd_hdr *hdr)
+{
+	struct v4l2_jpeg_reference qtables[V4L2_JPEG_MAX_TABLES] = {};
+	struct v4l2_jpeg_reference htables[V4L2_JPEG_MAX_TABLES] = {};
+	struct v4l2_jpeg_scan_header scan = {};
+	struct v4l2_jpeg_header header = {
+		.scan = &scan,
+		.quantization_tables = qtables,
+		.huffman_tables = htables,
+	};
+	const struct v4l2_jpeg_frame_header *frame = &header.frame;
+	unsigned int i;
+	int ret;
+
+	ret = v4l2_jpeg_parse_header(buf, len, &header);
+	if (ret < 0)
+		return ret;
+
+	/* SOF0 or SOF1, 8-bit, and a scan with all components interleaved */
+	if (!header.sof.start || frame->precision != 8 ||
+	    !frame->width || !frame->height ||
+	    frame->width > RKJPEGD_MAX_SIZE || frame->height > RKJPEGD_MAX_SIZE)
+		return -EINVAL;
+
+	if (header.ecs_offset >= len)
+		return -EINVAL;
+
+	switch (frame->subsampling) {
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_GRAY:
+		if (frame->num_components != 1 ||
+		    frame->component[0].horizontal_sampling_factor !=
+		    frame->component[0].vertical_sampling_factor)
+			return -EINVAL;
+		break;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_420:
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_422:
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_444:
+		if (frame->num_components != 3)
+			return -EINVAL;
+		/* Adobe APP14 transform 0 means RGB components */
+		if (header.app14_tf == V4L2_JPEG_APP14_TF_CMYK_RGB)
+			return -EINVAL;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (scan.num_components != frame->num_components)
+		return -EINVAL;
+
+	memset(hdr, 0, sizeof(*hdr));
+	hdr->width = frame->width;
+	hdr->height = frame->height;
+	hdr->subsampling = frame->subsampling;
+	hdr->num_components = frame->num_components;
+	hdr->restart_interval = header.restart_interval;
+	hdr->ecs_offset = header.ecs_offset;
+
+	for (i = 0; i < frame->num_components; i++) {
+		const struct v4l2_jpeg_scan_component_spec *sc =
+			&scan.component[i];
+		u8 tq = frame->component[i].quantization_table_selector;
+
+		if (sc->component_selector !=
+		    frame->component[i].component_identifier)
+			return -EINVAL;
+		if (tq >= V4L2_JPEG_MAX_TABLES || !qtables[tq].start ||
+		    qtables[tq].length != RKJPEGD_QTBL_ENTRIES)
+			return -EINVAL;
+		if (sc->dc_entropy_coding_table_selector > 1 ||
+		    sc->ac_entropy_coding_table_selector > 1)
+			return -EINVAL;
+
+		hdr->tq[i] = tq;
+		hdr->td[i] = sc->dc_entropy_coding_table_selector;
+		hdr->ta[i] = sc->ac_entropy_coding_table_selector;
+	}
+
+	for (i = 0; i < V4L2_JPEG_MAX_TABLES; i++)
+		if (qtables[i].start)
+			memcpy(hdr->qtbl[i], qtables[i].start,
+			       RKJPEGD_QTBL_ENTRIES);
+
+	/* use the Annex K tables for any table the stream does not define */
+	for (i = 0; i < ARRAY_SIZE(hdr->huff); i++) {
+		const u8 *table = htables[i].start ?: rkjpegd_default_huff[i];
+		unsigned int max = i < RKJPEGD_HUFF_AC(0) ?
+				   RKJPEGD_DC_MAX_VALUES : RKJPEGD_AC_MAX_VALUES;
+
+		ret = rkjpegd_copy_huff(&hdr->huff[i], table, max);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static void rkjpegd_write_qtbl(__le16 *dst, const u8 *zigzag)
+{
+	unsigned int i;
+
+	/* the hardware wants the coefficients in raster order */
+	for (i = 0; i < RKJPEGD_QTBL_ENTRIES; i++)
+		dst[v4l2_jpeg_zigzag_scan_index[i]] = cpu_to_le16(zigzag[i]);
+}
+
+/*
+ * Each Huffman table is described by the first code of each code length
+ * and by the number of codes up to and including each length, packed two
+ * per 16-bit word. The first entry, which would always be zero, holds the
+ * last 16-bit code instead.
+ */
+static void rkjpegd_write_mincode(__le16 *dst, const struct rkjpegd_huff *huff)
+{
+	u16 mincode[16];
+	u8 count[16];
+	unsigned int code = 0, total = 0;
+	unsigned int i;
+
+	for (i = 0; i < 16; i++) {
+		mincode[i] = code;
+		code += huff->bits[i];
+		total += huff->bits[i];
+		count[i] = total;
+		code <<= 1;
+	}
+
+	if (huff->bits[15])
+		mincode[0] = mincode[15] + huff->bits[15] - 1;
+	else
+		mincode[0] = mincode[15];
+
+	for (i = 0; i < 16; i++)
+		dst[i] = cpu_to_le16(mincode[i]);
+	for (i = 0; i < 8; i++)
+		dst[16 + i] = cpu_to_le16(count[2 * i] | count[2 * i + 1] << 8);
+}
+
+static unsigned int rkjpegd_huff_count(const struct rkjpegd_huff *huff)
+{
+	unsigned int i, count = 0;
+
+	for (i = 0; i < 16; i++)
+		count += huff->bits[i];
+
+	return count;
+}
+
+static void rkjpegd_write_tables(struct rkjpegd_dev *jpegd,
+				 const struct rkjpegd_hdr *hdr)
+{
+	__le16 *qtbl = jpegd->tables + RKJPEGD_QTBL_OFFSET;
+	__le16 *mincode = jpegd->tables + RKJPEGD_HTBL_MINCODE_OFFSET;
+	u8 *values = jpegd->tables + RKJPEGD_HTBL_VALUE_OFFSET;
+	unsigned int i;
+
+	memset(jpegd->tables, 0, RKJPEGD_TABLES_SIZE);
+
+	for (i = 0; i < hdr->num_components; i++) {
+		const struct rkjpegd_huff *dc =
+			&hdr->huff[RKJPEGD_HUFF_DC(hdr->td[i])];
+		const struct rkjpegd_huff *ac =
+			&hdr->huff[RKJPEGD_HUFF_AC(hdr->ta[i])];
+		u8 *val = values + i * RKJPEGD_HTBL_VALUE_SIZE;
+
+		rkjpegd_write_qtbl(qtbl + i * RKJPEGD_QTBL_ENTRIES,
+				   hdr->qtbl[hdr->tq[i]]);
+
+		rkjpegd_write_mincode(mincode + i * RKJPEGD_HTBL_MINCODE_ENTRIES,
+				      dc);
+		rkjpegd_write_mincode(mincode + i * RKJPEGD_HTBL_MINCODE_ENTRIES +
+				      RKJPEGD_HTBL_MINCODE_ENTRIES / 2, ac);
+
+		memcpy(val, dc->vals, rkjpegd_huff_count(dc));
+		memcpy(val + RKJPEGD_HTBL_AC_VALUE_OFFSET, ac->vals,
+		       rkjpegd_huff_count(ac));
+	}
+}
+
+void rkjpegd_hw_run(struct rkjpegd_dev *jpegd, struct rkjpegd_ctx *ctx,
+		    const struct rkjpegd_hdr *hdr, dma_addr_t src, size_t len,
+		    dma_addr_t dst)
+{
+	const struct v4l2_pix_format_mplane *fmt = &ctx->cap_fmt;
+	u32 stride = fmt->plane_fmt[0].bytesperline / RKJPEGD_ALIGN;
+	u32 uv_stride, mode, out_fmt, sys, tsel_q, tsel_h;
+	u32 strm_off = ALIGN_DOWN(hdr->ecs_offset, RKJPEGD_ALIGN);
+	u32 mcu_w, mcu_h, val;
+	bool fill_down;
+
+	switch (hdr->subsampling) {
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_GRAY:
+		mode = RKJPEGD_MODE_400;
+		mcu_w = 8;
+		mcu_h = 8;
+		uv_stride = 0;
+		break;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_420:
+		mode = RKJPEGD_MODE_420;
+		mcu_w = 16;
+		mcu_h = 16;
+		uv_stride = stride;
+		break;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_422:
+		mode = RKJPEGD_MODE_422;
+		mcu_w = 16;
+		mcu_h = 8;
+		uv_stride = stride;
+		break;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_444:
+	default:
+		mode = RKJPEGD_MODE_444;
+		mcu_w = 8;
+		mcu_h = 8;
+		uv_stride = stride * 2;
+		break;
+	}
+
+	if (fmt->pixelformat == rkjpegd_native_fourcc(hdr->subsampling)) {
+		out_fmt = RKJPEGD_OUT_FMT_NATIVE;
+		fill_down = mode == RKJPEGD_MODE_420;
+	} else {
+		/* NV12 conversion of 4:2:2 and 4:4:4 */
+		out_fmt = RKJPEGD_OUT_FMT_NV12;
+		uv_stride = stride;
+		fill_down = true;
+	}
+
+	/*
+	 * The output buffer is padded to 16 pixels in both directions; let the
+	 * hardware fill the padding when the last MCU is smaller than that.
+	 */
+	if (ALIGN(hdr->height, mcu_h) < ALIGN(hdr->height, RKJPEGD_ALIGN))
+		fill_down = true;
+
+	sys = FIELD_PREP(RKJPEGD_SYS_OUT_FMT, out_fmt);
+	if (fill_down)
+		sys |= RKJPEGD_SYS_FILL_DOWN_E;
+	if (ALIGN(hdr->width, mcu_w) < ALIGN(hdr->width, RKJPEGD_ALIGN))
+		sys |= RKJPEGD_SYS_FILL_RIGHT_E;
+
+	/* Cb and Cr may share their tables, or each have their own */
+	if (hdr->num_components == 1) {
+		tsel_q = 1;
+		tsel_h = 1;
+	} else {
+		tsel_q = hdr->tq[2] == hdr->tq[1] ? 2 : 3;
+		tsel_h = hdr->td[2] == hdr->td[1] &&
+			 hdr->ta[2] == hdr->ta[1] ? 2 : 3;
+	}
+
+	rkjpegd_write_tables(jpegd, hdr);
+
+	rkjpegd_write(jpegd, RKJPEGD_REG_SYS, sys);
+	rkjpegd_write(jpegd, RKJPEGD_REG_PIC_SIZE,
+		      FIELD_PREP(RKJPEGD_PIC_WIDTH_M1, hdr->width - 1) |
+		      FIELD_PREP(RKJPEGD_PIC_HEIGHT_M1, hdr->height - 1));
+
+	val = FIELD_PREP(RKJPEGD_PIC_JPEG_MODE, mode) |
+	      FIELD_PREP(RKJPEGD_PIC_QTABLES_SEL, tsel_q) |
+	      FIELD_PREP(RKJPEGD_PIC_HTABLES_SEL, tsel_h);
+	if (hdr->restart_interval)
+		val |= RKJPEGD_PIC_DRI_E |
+		       FIELD_PREP(RKJPEGD_PIC_DRI_MCU_M1,
+				  hdr->restart_interval - 1);
+	rkjpegd_write(jpegd, RKJPEGD_REG_PIC_FMT, val);
+
+	rkjpegd_write(jpegd, RKJPEGD_REG_HOR_VIRSTRIDE,
+		      FIELD_PREP(RKJPEGD_Y_HOR_VIRSTRIDE, stride & 0xffff) |
+		      FIELD_PREP(RKJPEGD_UV_HOR_VIRSTRIDE, uv_stride));
+	rkjpegd_write(jpegd, RKJPEGD_REG_Y_VIRSTRIDE,
+		      fmt->plane_fmt[0].bytesperline * fmt->height);
+
+	val = FIELD_PREP(RKJPEGD_QTBL_LEN,
+			 tsel_q * RKJPEGD_QTBL_SIZE / 16 - 1) |
+	      FIELD_PREP(RKJPEGD_HTBL_MINCODE_LEN,
+			 tsel_h * RKJPEGD_HTBL_MINCODE_SIZE / 16 - 1) |
+	      FIELD_PREP(RKJPEGD_HTBL_VALUE_LEN,
+			 tsel_h * RKJPEGD_HTBL_VALUE_SIZE / 16 - 1);
+	if (stride > 0xffff)
+		val |= RKJPEGD_Y_HOR_VIRSTRIDE_H;
+	rkjpegd_write(jpegd, RKJPEGD_REG_TBL_LEN, val);
+
+	rkjpegd_write(jpegd, RKJPEGD_REG_STRM_LEN,
+		      FIELD_PREP(RKJPEGD_STRM_START_BYTE,
+				 hdr->ecs_offset - strm_off) |
+		      FIELD_PREP(RKJPEGD_STRM_LEN,
+				 DIV_ROUND_UP(len - strm_off, 16) - 1));
+
+	rkjpegd_write(jpegd, RKJPEGD_REG_QTBL_BASE,
+		      jpegd->tables_dma + RKJPEGD_QTBL_OFFSET);
+	rkjpegd_write(jpegd, RKJPEGD_REG_HTBL_MINCODE_BASE,
+		      jpegd->tables_dma + RKJPEGD_HTBL_MINCODE_OFFSET);
+	rkjpegd_write(jpegd, RKJPEGD_REG_HTBL_VALUE_BASE,
+		      jpegd->tables_dma + RKJPEGD_HTBL_VALUE_OFFSET);
+	rkjpegd_write(jpegd, RKJPEGD_REG_STRM_BASE, src + strm_off);
+	rkjpegd_write(jpegd, RKJPEGD_REG_OUT_BASE, dst);
+
+	/* skip stray 0xffff sequences and unexpected markers */
+	rkjpegd_write(jpegd, RKJPEGD_REG_STRM_ERROR,
+		      RKJPEGD_ERR_PRC_MODE |
+		      FIELD_PREP(RKJPEGD_ERR_FFFF_MODE, RKJPEGD_ERR_MODE_SKIP) |
+		      FIELD_PREP(RKJPEGD_ERR_OTHER_MARK_MODE,
+				 RKJPEGD_ERR_MODE_SKIP));
+	rkjpegd_write(jpegd, RKJPEGD_REG_STRM_MASK, 0);
+	rkjpegd_write(jpegd, RKJPEGD_REG_CLK_GATE, RKJPEGD_CLK_GATE_ALL);
+
+	/* writel() orders the table and register writes before the start */
+	writel(RKJPEGD_INT_DEC_E | RKJPEGD_INT_TIMEOUT_E |
+	       RKJPEGD_INT_BUF_EMPTY_E, jpegd->regs + RKJPEGD_REG_INT);
+}
+
+static void rkjpegd_iommu_restore(struct rkjpegd_dev *jpegd)
+{
+	int ret;
+
+	if (!jpegd->empty_domain)
+		return;
+
+	/*
+	 * A CRU reset may also reset the IOMMU. Attaching an empty domain and
+	 * detaching it again makes the IOMMU driver reprogram the page table
+	 * of the default domain.
+	 */
+	ret = iommu_attach_device(jpegd->empty_domain, jpegd->dev);
+	if (ret) {
+		dev_warn(jpegd->dev, "cannot attach empty domain: %d\n", ret);
+		return;
+	}
+	iommu_detach_device(jpegd->empty_domain, jpegd->dev);
+}
+
+int rkjpegd_hw_reset(struct rkjpegd_dev *jpegd)
+{
+	u32 status = rkjpegd_read(jpegd, RKJPEGD_REG_INT);
+	int ret;
+
+	/* an idle core only accepts a soft reset with this bit set */
+	if (!(status & RKJPEGD_INT_DEC_E))
+		rkjpegd_write(jpegd, RKJPEGD_REG_SYS, RKJPEGD_SYS_FORCE_SOFTRST);
+
+	writel(status | RKJPEGD_INT_SOFT_RST_EN, jpegd->regs + RKJPEGD_REG_INT);
+	ret = readl_poll_timeout(jpegd->regs + RKJPEGD_REG_INT, status,
+				 status & RKJPEGD_INT_SOFT_RST_RDY, 1, 1000);
+	if (ret) {
+		dev_warn(jpegd->dev, "soft reset timed out, resetting core\n");
+		ret = reset_control_assert(jpegd->rstc);
+		if (!ret) {
+			udelay(5);
+			ret = reset_control_deassert(jpegd->rstc);
+		}
+		rkjpegd_iommu_restore(jpegd);
+	}
+
+	rkjpegd_write(jpegd, RKJPEGD_REG_INT, 0);
+	rkjpegd_write(jpegd, RKJPEGD_REG_SYS, 0);
+
+	return ret;
+}
diff --git a/drivers/media/platform/rockchip/rkjpegd/rkjpegd.c b/drivers/media/platform/rockchip/rkjpegd/rkjpegd.c
new file mode 100644
index 000000000..5206b461c
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkjpegd/rkjpegd.c
@@ -0,0 +1,1064 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Rockchip VDPU720 JPEG decoder driver
+ *
+ * The VDPU720 only decodes the entropy coded segment of a baseline JPEG
+ * image, so the headers are parsed here and the decoder is exposed as a
+ * stateful V4L2 memory-to-memory decoder.
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "rkjpegd.h"
+
+static const u32 rkjpegd_cap_fourccs[] = {
+	V4L2_PIX_FMT_NV12,
+	V4L2_PIX_FMT_NV16,
+	V4L2_PIX_FMT_NV24,
+	V4L2_PIX_FMT_GREY,
+};
+
+static bool rkjpegd_is_cap_fourcc(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(rkjpegd_cap_fourccs); i++)
+		if (rkjpegd_cap_fourccs[i] == fourcc)
+			return true;
+
+	return false;
+}
+
+/*
+ * The decoder does not change the colorimetry: keep what the client sets on
+ * OUTPUT (UVC cameras for instance report limited range), default to JFIF,
+ * which is sRGB with full range BT.601 YCbCr, and copy it to CAPTURE.
+ */
+static void rkjpegd_set_out_colorimetry(struct v4l2_pix_format_mplane *pix)
+{
+	pix->field = V4L2_FIELD_NONE;
+	if (pix->colorspace == V4L2_COLORSPACE_DEFAULT ||
+	    pix->colorspace > V4L2_COLORSPACE_DCI_P3) {
+		pix->colorspace = V4L2_COLORSPACE_SRGB;
+		pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+		pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+		pix->xfer_func = V4L2_XFER_FUNC_SRGB;
+	}
+}
+
+/* The hardware writes whole 16x16 blocks: pad the frame accordingly */
+static void rkjpegd_fill_cap_fmt(struct rkjpegd_ctx *ctx,
+				 struct v4l2_pix_format_mplane *pix,
+				 u32 fourcc, u32 width, u32 height)
+{
+	const struct v4l2_pix_format_mplane *out = &ctx->out_fmt;
+
+	width = clamp(width, RKJPEGD_MIN_SIZE, RKJPEGD_MAX_SIZE);
+	height = clamp(height, RKJPEGD_MIN_SIZE, RKJPEGD_MAX_SIZE);
+
+	v4l2_fill_pixfmt_mp(pix, fourcc, ALIGN(width, RKJPEGD_ALIGN),
+			    ALIGN(height, RKJPEGD_ALIGN));
+	pix->field = V4L2_FIELD_NONE;
+	pix->colorspace = out->colorspace;
+	pix->ycbcr_enc = out->ycbcr_enc;
+	pix->quantization = out->quantization;
+	pix->xfer_func = out->xfer_func;
+}
+
+static void rkjpegd_fill_out_fmt(struct v4l2_pix_format_mplane *pix)
+{
+	u32 sizeimage = pix->plane_fmt[0].sizeimage;
+	u32 min_size;
+
+	pix->pixelformat = V4L2_PIX_FMT_JPEG;
+	pix->width = clamp(pix->width, RKJPEGD_MIN_SIZE, RKJPEGD_MAX_SIZE);
+	pix->height = clamp(pix->height, RKJPEGD_MIN_SIZE, RKJPEGD_MAX_SIZE);
+	pix->num_planes = 1;
+	pix->flags = 0;
+	rkjpegd_set_out_colorimetry(pix);
+
+	/* at least what a 4:2:0 frame of that size takes uncompressed */
+	min_size = clamp_t(u32, ALIGN(pix->width, RKJPEGD_ALIGN) *
+				ALIGN(pix->height, RKJPEGD_ALIGN) * 3 / 2,
+			   RKJPEGD_MIN_OUT_SIZE, RKJPEGD_DEF_OUT_MAX_SIZE);
+	memset(pix->plane_fmt, 0, sizeof(pix->plane_fmt));
+	pix->plane_fmt[0].sizeimage =
+		PAGE_ALIGN(clamp_t(u32, sizeimage, min_size,
+				   RKJPEGD_MAX_OUT_SIZE));
+	memset(pix->reserved, 0, sizeof(pix->reserved));
+}
+
+/*
+ * Set up the CAPTURE format for a newly parsed header. Keep the client's
+ * pixel format if it chose one that works for this stream.
+ */
+static void rkjpegd_apply_header(struct rkjpegd_ctx *ctx,
+				 const struct rkjpegd_hdr *hdr)
+{
+	u32 fourcc = ctx->cap_fmt.pixelformat;
+
+	if (!ctx->cap_fourcc_set ||
+	    !rkjpegd_cap_fourcc_valid(fourcc, hdr->subsampling))
+		fourcc = rkjpegd_native_fourcc(hdr->subsampling);
+
+	rkjpegd_fill_cap_fmt(ctx, &ctx->cap_fmt, fourcc, hdr->width, hdr->height);
+	ctx->visible_width = hdr->width;
+	ctx->visible_height = hdr->height;
+	ctx->subsampling = hdr->subsampling;
+	ctx->header_known = true;
+}
+
+static bool rkjpegd_header_changed(struct rkjpegd_ctx *ctx,
+				   const struct rkjpegd_hdr *hdr)
+{
+	return hdr->width != ctx->visible_width ||
+	       hdr->height != ctx->visible_height ||
+	       hdr->subsampling != ctx->subsampling;
+}
+
+static void rkjpegd_queue_src_change(struct rkjpegd_ctx *ctx)
+{
+	static const struct v4l2_event ev = {
+		.type = V4L2_EVENT_SOURCE_CHANGE,
+		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
+	};
+
+	v4l2_event_queue_fh(&ctx->fh, &ev);
+}
+
+static void rkjpegd_queue_eos(struct rkjpegd_ctx *ctx)
+{
+	static const struct v4l2_event ev = {
+		.type = V4L2_EVENT_EOS,
+	};
+
+	v4l2_event_queue_fh(&ctx->fh, &ev);
+}
+
+/* ioctls */
+
+static int rkjpegd_querycap(struct file *file, void *priv,
+			    struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, RKJPEGD_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Rockchip VDPU720 JPEG decoder", sizeof(cap->card));
+
+	return 0;
+}
+
+static int rkjpegd_enum_fmt_vid_out(struct file *file, void *priv,
+				    struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_JPEG;
+	f->flags = V4L2_FMT_FLAG_COMPRESSED;
+
+	return 0;
+}
+
+static int rkjpegd_enum_fmt_vid_cap(struct file *file, void *priv,
+				    struct v4l2_fmtdesc *f)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+	unsigned int i, n = 0;
+	u32 native;
+
+	if (!ctx->header_known) {
+		if (f->index >= ARRAY_SIZE(rkjpegd_cap_fourccs))
+			return -EINVAL;
+		f->pixelformat = rkjpegd_cap_fourccs[f->index];
+		return 0;
+	}
+
+	/* the native layout first, then the conversions */
+	native = rkjpegd_native_fourcc(ctx->subsampling);
+	if (f->index == 0) {
+		f->pixelformat = native;
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(rkjpegd_cap_fourccs); i++) {
+		u32 fourcc = rkjpegd_cap_fourccs[i];
+
+		if (fourcc == native ||
+		    !rkjpegd_cap_fourcc_valid(fourcc, ctx->subsampling))
+			continue;
+		if (++n == f->index) {
+			f->pixelformat = fourcc;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int rkjpegd_enum_framesizes(struct file *file, void *priv,
+				   struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index)
+		return -EINVAL;
+
+	if (fsize->pixel_format != V4L2_PIX_FMT_JPEG &&
+	    !rkjpegd_is_cap_fourcc(fsize->pixel_format))
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = RKJPEGD_MIN_SIZE;
+	fsize->stepwise.max_width = RKJPEGD_MAX_SIZE;
+	fsize->stepwise.step_width = 1;
+	fsize->stepwise.min_height = RKJPEGD_MIN_SIZE;
+	fsize->stepwise.max_height = RKJPEGD_MAX_SIZE;
+	fsize->stepwise.step_height = 1;
+
+	return 0;
+}
+
+static int rkjpegd_g_fmt_vid_out(struct file *file, void *priv,
+				 struct v4l2_format *f)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+
+	f->fmt.pix_mp = ctx->out_fmt;
+
+	return 0;
+}
+
+static int rkjpegd_g_fmt_vid_cap(struct file *file, void *priv,
+				 struct v4l2_format *f)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+
+	f->fmt.pix_mp = ctx->cap_fmt;
+
+	return 0;
+}
+
+static int rkjpegd_try_fmt_vid_out(struct file *file, void *priv,
+				   struct v4l2_format *f)
+{
+	rkjpegd_fill_out_fmt(&f->fmt.pix_mp);
+
+	return 0;
+}
+
+static int rkjpegd_try_fmt_vid_cap(struct file *file, void *priv,
+				   struct v4l2_format *f)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+	struct v4l2_pix_format_mplane *pix = &f->fmt.pix_mp;
+	u32 fourcc = pix->pixelformat;
+
+	if (ctx->header_known) {
+		/* the size comes from the stream */
+		if (!rkjpegd_cap_fourcc_valid(fourcc, ctx->subsampling))
+			fourcc = rkjpegd_native_fourcc(ctx->subsampling);
+		rkjpegd_fill_cap_fmt(ctx, pix, fourcc, ctx->visible_width,
+				     ctx->visible_height);
+	} else {
+		if (!rkjpegd_is_cap_fourcc(fourcc))
+			fourcc = ctx->cap_fmt.pixelformat;
+		rkjpegd_fill_cap_fmt(ctx, pix, fourcc, pix->width, pix->height);
+	}
+
+	return 0;
+}
+
+static int rkjpegd_s_fmt_vid_out(struct file *file, void *priv,
+				 struct v4l2_format *f)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+	struct v4l2_pix_format_mplane *pix = &f->fmt.pix_mp;
+	struct vb2_queue *vq;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	rkjpegd_fill_out_fmt(pix);
+	ctx->out_fmt = *pix;
+
+	/*
+	 * A new OUTPUT format starts a new stream: forget the old header and
+	 * propagate the size to the CAPTURE queue unless it is in use.
+	 */
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (!vb2_is_busy(vq)) {
+		ctx->header_known = false;
+		ctx->state = RKJPEGD_STATE_INIT;
+		ctx->visible_width = pix->width;
+		ctx->visible_height = pix->height;
+		rkjpegd_fill_cap_fmt(ctx, &ctx->cap_fmt, ctx->cap_fmt.pixelformat,
+				     pix->width, pix->height);
+	}
+
+	return 0;
+}
+
+static int rkjpegd_s_fmt_vid_cap(struct file *file, void *priv,
+				 struct v4l2_format *f)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+	struct vb2_queue *vq;
+	int ret;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	ret = rkjpegd_try_fmt_vid_cap(file, priv, f);
+	if (ret)
+		return ret;
+
+	ctx->cap_fmt = f->fmt.pix_mp;
+	ctx->cap_fourcc_set = true;
+	if (!ctx->header_known) {
+		ctx->visible_width = ctx->cap_fmt.width;
+		ctx->visible_height = ctx->cap_fmt.height;
+	}
+
+	return 0;
+}
+
+static int rkjpegd_g_selection(struct file *file, void *priv,
+			       struct v4l2_selection *s)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+
+	if (s->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
+		return -EINVAL;
+
+	s->r.left = 0;
+	s->r.top = 0;
+
+	switch (s->target) {
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+	case V4L2_SEL_TGT_COMPOSE_PADDED:
+		s->r.width = ctx->cap_fmt.width;
+		s->r.height = ctx->cap_fmt.height;
+		break;
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_COMPOSE:
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+		s->r.width = ctx->visible_width;
+		s->r.height = ctx->visible_height;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int rkjpegd_subscribe_event(struct v4l2_fh *fh,
+				   const struct v4l2_event_subscription *sub)
+{
+	switch (sub->type) {
+	case V4L2_EVENT_EOS:
+		return v4l2_event_subscribe(fh, sub, 2, NULL);
+	case V4L2_EVENT_SOURCE_CHANGE:
+		return v4l2_src_change_event_subscribe(fh, sub);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int rkjpegd_decoder_cmd(struct file *file, void *priv,
+			       struct v4l2_decoder_cmd *dc)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	int ret;
+
+	ret = v4l2_m2m_ioctl_try_decoder_cmd(file, priv, dc);
+	if (ret)
+		return ret;
+
+	ret = v4l2_m2m_decoder_cmd(file, m2m_ctx, dc);
+	if (ret)
+		return ret;
+
+	if (dc->cmd == V4L2_DEC_CMD_START) {
+		/*
+		 * The client keeps its CAPTURE buffers after a resolution
+		 * change; buffers that turn out to be too small are returned
+		 * with an error.
+		 */
+		if (ctx->state == RKJPEGD_STATE_SOURCE_CHANGE)
+			ctx->state = RKJPEGD_STATE_RUNNING;
+		vb2_clear_last_buffer_dequeued(&m2m_ctx->cap_q_ctx.q);
+		v4l2_m2m_try_schedule(m2m_ctx);
+	}
+
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops rkjpegd_ioctl_ops = {
+	.vidioc_querycap = rkjpegd_querycap,
+	.vidioc_enum_framesizes = rkjpegd_enum_framesizes,
+
+	.vidioc_enum_fmt_vid_out = rkjpegd_enum_fmt_vid_out,
+	.vidioc_g_fmt_vid_out_mplane = rkjpegd_g_fmt_vid_out,
+	.vidioc_try_fmt_vid_out_mplane = rkjpegd_try_fmt_vid_out,
+	.vidioc_s_fmt_vid_out_mplane = rkjpegd_s_fmt_vid_out,
+
+	.vidioc_enum_fmt_vid_cap = rkjpegd_enum_fmt_vid_cap,
+	.vidioc_g_fmt_vid_cap_mplane = rkjpegd_g_fmt_vid_cap,
+	.vidioc_try_fmt_vid_cap_mplane = rkjpegd_try_fmt_vid_cap,
+	.vidioc_s_fmt_vid_cap_mplane = rkjpegd_s_fmt_vid_cap,
+
+	.vidioc_g_selection = rkjpegd_g_selection,
+
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_try_decoder_cmd = v4l2_m2m_ioctl_try_decoder_cmd,
+	.vidioc_decoder_cmd = rkjpegd_decoder_cmd,
+
+	.vidioc_subscribe_event = rkjpegd_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+/* vb2 queue operations */
+
+static int rkjpegd_queue_setup(struct vb2_queue *vq, unsigned int *nbuffers,
+			       unsigned int *nplanes, unsigned int sizes[],
+			       struct device *alloc_devs[])
+{
+	struct rkjpegd_ctx *ctx = vb2_get_drv_priv(vq);
+	const struct v4l2_pix_format_mplane *pix;
+
+	pix = V4L2_TYPE_IS_OUTPUT(vq->type) ? &ctx->out_fmt : &ctx->cap_fmt;
+
+	if (*nplanes)
+		return *nplanes != 1 || sizes[0] < pix->plane_fmt[0].sizeimage ?
+		       -EINVAL : 0;
+
+	*nplanes = 1;
+	sizes[0] = pix->plane_fmt[0].sizeimage;
+
+	return 0;
+}
+
+static int rkjpegd_buf_prepare(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct rkjpegd_ctx *ctx = vb2_get_drv_priv(vq);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct rkjpegd_buf *buf;
+	void *vaddr;
+
+	if (V4L2_TYPE_IS_CAPTURE(vq->type)) {
+		if (vb2_plane_size(vb, 0) < ctx->cap_fmt.plane_fmt[0].sizeimage)
+			return -EINVAL;
+		return 0;
+	}
+
+	vbuf->field = V4L2_FIELD_NONE;
+
+	/*
+	 * Streams the hardware cannot decode are not refused here: the
+	 * buffer is returned with an error once it has been queued.
+	 */
+	buf = to_rkjpegd_buf(vbuf);
+	vaddr = vb2_plane_vaddr(vb, 0);
+	buf->valid = vaddr &&
+		     !rkjpegd_parse_header(vaddr, vb2_get_plane_payload(vb, 0),
+					   &buf->hdr);
+	if (!buf->valid)
+		dev_dbg(ctx->jpegd->dev, "unsupported or invalid JPEG header\n");
+
+	return 0;
+}
+
+static bool rkjpegd_cap_compatible(struct rkjpegd_ctx *ctx,
+				   const struct v4l2_pix_format_mplane *old)
+{
+	return old->pixelformat == ctx->cap_fmt.pixelformat &&
+	       old->width == ctx->cap_fmt.width &&
+	       old->height == ctx->cap_fmt.height;
+}
+
+static void rkjpegd_buf_queue(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct rkjpegd_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+
+	if (V4L2_TYPE_IS_CAPTURE(vq->type)) {
+		if (vb2_is_streaming(vq) && v4l2_m2m_dst_buf_is_last(m2m_ctx)) {
+			vb2_set_plane_payload(vb, 0, 0);
+			vbuf->field = V4L2_FIELD_NONE;
+			vbuf->sequence = ctx->cap_sequence++;
+			v4l2_m2m_last_buffer_done(m2m_ctx, vbuf);
+			return;
+		}
+		v4l2_m2m_buf_queue(m2m_ctx, vbuf);
+		return;
+	}
+
+	if (!to_rkjpegd_buf(vbuf)->valid) {
+		vbuf->sequence = ctx->out_sequence++;
+		vb2_buffer_done(vb, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	/* the first header sets up the CAPTURE format */
+	if (ctx->state == RKJPEGD_STATE_INIT) {
+		struct v4l2_pix_format_mplane old = ctx->cap_fmt;
+		struct vb2_queue *cap_q = v4l2_m2m_get_dst_vq(m2m_ctx);
+
+		rkjpegd_apply_header(ctx, &to_rkjpegd_buf(vbuf)->hdr);
+		rkjpegd_queue_src_change(ctx);
+		if (vb2_is_streaming(cap_q) && !rkjpegd_cap_compatible(ctx, &old))
+			ctx->state = RKJPEGD_STATE_SOURCE_CHANGE;
+		else
+			ctx->state = RKJPEGD_STATE_RUNNING;
+	}
+
+	v4l2_m2m_buf_queue(m2m_ctx, vbuf);
+}
+
+static int rkjpegd_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct rkjpegd_ctx *ctx = vb2_get_drv_priv(vq);
+
+	v4l2_m2m_update_start_streaming_state(ctx->fh.m2m_ctx, vq);
+
+	return 0;
+}
+
+static void rkjpegd_stop_streaming(struct vb2_queue *vq)
+{
+	struct rkjpegd_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		if (V4L2_TYPE_IS_OUTPUT(vq->type))
+			vbuf = v4l2_m2m_src_buf_remove(m2m_ctx);
+		else
+			vbuf = v4l2_m2m_dst_buf_remove(m2m_ctx);
+		if (!vbuf)
+			break;
+		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
+	}
+
+	v4l2_m2m_update_stop_streaming_state(m2m_ctx, vq);
+
+	/*
+	 * Reset the sequence counters here rather than in start_streaming():
+	 * buffers queued before STREAMON may already have been numbered.
+	 */
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		ctx->out_sequence = 0;
+	else
+		ctx->cap_sequence = 0;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type)) {
+		if (v4l2_m2m_has_stopped(m2m_ctx))
+			rkjpegd_queue_eos(ctx);
+	} else if (ctx->state == RKJPEGD_STATE_SOURCE_CHANGE) {
+		/* the client is reconfiguring the CAPTURE queue */
+		ctx->state = RKJPEGD_STATE_RUNNING;
+	}
+}
+
+static const struct vb2_ops rkjpegd_qops = {
+	.queue_setup = rkjpegd_queue_setup,
+	.buf_prepare = rkjpegd_buf_prepare,
+	.buf_queue = rkjpegd_buf_queue,
+	.start_streaming = rkjpegd_start_streaming,
+	.stop_streaming = rkjpegd_stop_streaming,
+};
+
+static int rkjpegd_queue_init(void *priv, struct vb2_queue *src_vq,
+			      struct vb2_queue *dst_vq)
+{
+	struct rkjpegd_ctx *ctx = priv;
+	struct rkjpegd_dev *jpegd = ctx->jpegd;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->drv_priv = ctx;
+	src_vq->ops = &rkjpegd_qops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	src_vq->buf_struct_size = sizeof(struct rkjpegd_buf);
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &jpegd->lock;
+	src_vq->dev = jpegd->dev;
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = ctx;
+	dst_vq->ops = &rkjpegd_qops;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &jpegd->lock;
+	dst_vq->dev = jpegd->dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* m2m operations */
+
+static void rkjpegd_job_done(struct rkjpegd_dev *jpegd,
+			     enum vb2_buffer_state state)
+{
+	struct rkjpegd_ctx *ctx = jpegd->curr_ctx;
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	struct vb2_v4l2_buffer *src, *dst;
+
+	jpegd->curr_ctx = NULL;
+
+	src = v4l2_m2m_src_buf_remove(m2m_ctx);
+	dst = v4l2_m2m_dst_buf_remove(m2m_ctx);
+
+	v4l2_m2m_buf_copy_metadata(src, dst);
+	src->sequence = ctx->out_sequence++;
+	dst->sequence = ctx->cap_sequence++;
+	dst->field = V4L2_FIELD_NONE;
+	vb2_set_plane_payload(&dst->vb2_buf, 0,
+			      ctx->cap_fmt.plane_fmt[0].sizeimage);
+
+	if (v4l2_m2m_is_last_draining_src_buf(m2m_ctx, src)) {
+		dst->flags |= V4L2_BUF_FLAG_LAST;
+		rkjpegd_queue_eos(ctx);
+		v4l2_m2m_mark_stopped(m2m_ctx);
+	}
+
+	v4l2_m2m_buf_done(src, state);
+	v4l2_m2m_buf_done(dst, state);
+
+	pm_runtime_put_autosuspend(jpegd->dev);
+	v4l2_m2m_job_finish(jpegd->m2m_dev, m2m_ctx);
+}
+
+static void rkjpegd_device_run(void *priv)
+{
+	struct rkjpegd_ctx *ctx = priv;
+	struct rkjpegd_dev *jpegd = ctx->jpegd;
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	struct vb2_v4l2_buffer *src, *dst;
+	const struct rkjpegd_hdr *hdr;
+	int ret;
+
+	src = v4l2_m2m_next_src_buf(m2m_ctx);
+	dst = v4l2_m2m_next_dst_buf(m2m_ctx);
+	hdr = &to_rkjpegd_buf(src)->hdr;
+
+	/*
+	 * A new size or subsampling: return an empty CAPTURE buffer flagged
+	 * LAST and wait for the client to pick up the new format. This
+	 * buffer stays queued and is decoded after the reconfiguration.
+	 */
+	if (rkjpegd_header_changed(ctx, hdr)) {
+		rkjpegd_apply_header(ctx, hdr);
+		ctx->state = RKJPEGD_STATE_SOURCE_CHANGE;
+
+		dst = v4l2_m2m_dst_buf_remove(m2m_ctx);
+		vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+		dst->field = V4L2_FIELD_NONE;
+		dst->sequence = ctx->cap_sequence++;
+		dst->flags |= V4L2_BUF_FLAG_LAST;
+		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_DONE);
+
+		rkjpegd_queue_src_change(ctx);
+		v4l2_m2m_job_finish(jpegd->m2m_dev, m2m_ctx);
+		return;
+	}
+
+	jpegd->curr_ctx = ctx;
+
+	ret = pm_runtime_resume_and_get(jpegd->dev);
+	if (ret < 0) {
+		dev_err(jpegd->dev, "cannot resume device: %d\n", ret);
+		pm_runtime_get_noresume(jpegd->dev);
+		rkjpegd_job_done(jpegd, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	if (vb2_plane_size(&dst->vb2_buf, 0) <
+	    ctx->cap_fmt.plane_fmt[0].sizeimage) {
+		rkjpegd_job_done(jpegd, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	schedule_delayed_work(&jpegd->watchdog_work,
+			      msecs_to_jiffies(RKJPEGD_WATCHDOG_MS));
+
+	rkjpegd_hw_run(jpegd, ctx, hdr,
+		       vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0),
+		       vb2_get_plane_payload(&src->vb2_buf, 0),
+		       vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0));
+}
+
+static int rkjpegd_job_ready(void *priv)
+{
+	struct rkjpegd_ctx *ctx = priv;
+
+	return ctx->state == RKJPEGD_STATE_RUNNING;
+}
+
+static const struct v4l2_m2m_ops rkjpegd_m2m_ops = {
+	.device_run = rkjpegd_device_run,
+	.job_ready = rkjpegd_job_ready,
+};
+
+/* interrupt and watchdog */
+
+static irqreturn_t rkjpegd_irq(int irq, void *priv)
+{
+	struct rkjpegd_dev *jpegd = priv;
+	u32 status;
+
+	status = rkjpegd_read(jpegd, RKJPEGD_REG_INT);
+	if (!(status & RKJPEGD_INT_IRQ_RAW))
+		return IRQ_NONE;
+
+	/* acknowledge the interrupt and stop the core */
+	rkjpegd_write(jpegd, RKJPEGD_REG_INT, 0);
+	jpegd->irq_status = status;
+
+	return IRQ_WAKE_THREAD;
+}
+
+static irqreturn_t rkjpegd_irq_thread(int irq, void *priv)
+{
+	struct rkjpegd_dev *jpegd = priv;
+	enum vb2_buffer_state state = VB2_BUF_STATE_DONE;
+	u32 status = jpegd->irq_status;
+
+	/* the watchdog already handled this job */
+	if (!cancel_delayed_work(&jpegd->watchdog_work))
+		return IRQ_HANDLED;
+
+	if (!(status & RKJPEGD_INT_IRQ) || !(status & RKJPEGD_INT_RDY_STA) ||
+	    (status & RKJPEGD_INT_ERR_MASK)) {
+		dev_dbg(jpegd->dev,
+			"decode error: status %#x, error %#x, mcu %#x\n",
+			status, rkjpegd_read(jpegd, RKJPEGD_REG_DBG_ERR),
+			rkjpegd_read(jpegd, RKJPEGD_REG_DBG_MCU_POS));
+		state = VB2_BUF_STATE_ERROR;
+		rkjpegd_hw_reset(jpegd);
+	} else if (jpegd->hw_id < RKJPEGD_ID_VPU720 &&
+		   !(status & RKJPEGD_INT_SOFT_RST_RDY)) {
+		/* older cores need a reset when this bit is clear */
+		rkjpegd_hw_reset(jpegd);
+	}
+
+	if (jpegd->curr_ctx)
+		rkjpegd_job_done(jpegd, state);
+
+	return IRQ_HANDLED;
+}
+
+static void rkjpegd_watchdog(struct work_struct *work)
+{
+	struct rkjpegd_dev *jpegd = container_of(to_delayed_work(work),
+						 struct rkjpegd_dev,
+						 watchdog_work);
+
+	dev_err(jpegd->dev, "frame processing timed out (status %#x)\n",
+		rkjpegd_read(jpegd, RKJPEGD_REG_INT));
+
+	disable_irq(jpegd->irq);
+	rkjpegd_hw_reset(jpegd);
+	enable_irq(jpegd->irq);
+
+	if (jpegd->curr_ctx)
+		rkjpegd_job_done(jpegd, VB2_BUF_STATE_ERROR);
+}
+
+/* file operations */
+
+static int rkjpegd_open(struct file *file)
+{
+	struct rkjpegd_dev *jpegd = video_drvdata(file);
+	struct rkjpegd_ctx *ctx;
+	int ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->jpegd = jpegd;
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+
+	ctx->out_fmt.width = RKJPEGD_DEF_WIDTH;
+	ctx->out_fmt.height = RKJPEGD_DEF_HEIGHT;
+	rkjpegd_fill_out_fmt(&ctx->out_fmt);
+	rkjpegd_fill_cap_fmt(ctx, &ctx->cap_fmt, V4L2_PIX_FMT_NV12,
+			     RKJPEGD_DEF_WIDTH, RKJPEGD_DEF_HEIGHT);
+	ctx->visible_width = RKJPEGD_DEF_WIDTH;
+	ctx->visible_height = RKJPEGD_DEF_HEIGHT;
+	ctx->state = RKJPEGD_STATE_INIT;
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(jpegd->m2m_dev, ctx,
+					    rkjpegd_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_free;
+	}
+
+	v4l2_fh_add(&ctx->fh, file);
+
+	return 0;
+
+err_free:
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return ret;
+}
+
+static int rkjpegd_release(struct file *file)
+{
+	struct rkjpegd_ctx *ctx = file_to_rkjpegd_ctx(file);
+	struct rkjpegd_dev *jpegd = ctx->jpegd;
+
+	mutex_lock(&jpegd->lock);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	mutex_unlock(&jpegd->lock);
+
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+
+	return 0;
+}
+
+static const struct v4l2_file_operations rkjpegd_fops = {
+	.owner = THIS_MODULE,
+	.open = rkjpegd_open,
+	.release = rkjpegd_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+/* probe and power management */
+
+static int rkjpegd_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rkjpegd_dev *jpegd;
+	struct video_device *vfd;
+	int ret;
+
+	jpegd = devm_kzalloc(dev, sizeof(*jpegd), GFP_KERNEL);
+	if (!jpegd)
+		return -ENOMEM;
+
+	jpegd->dev = dev;
+	platform_set_drvdata(pdev, jpegd);
+	mutex_init(&jpegd->lock);
+	INIT_DELAYED_WORK(&jpegd->watchdog_work, rkjpegd_watchdog);
+
+	jpegd->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(jpegd->regs))
+		return PTR_ERR(jpegd->regs);
+
+	jpegd->num_clocks = devm_clk_bulk_get_all(dev, &jpegd->clocks);
+	if (jpegd->num_clocks < 0)
+		return dev_err_probe(dev, jpegd->num_clocks,
+				     "cannot get clocks\n");
+
+	jpegd->rstc = devm_reset_control_array_get_optional_exclusive(dev);
+	if (IS_ERR(jpegd->rstc))
+		return dev_err_probe(dev, PTR_ERR(jpegd->rstc),
+				     "cannot get resets\n");
+
+	jpegd->irq = platform_get_irq(pdev, 0);
+	if (jpegd->irq < 0)
+		return jpegd->irq;
+
+	ret = devm_request_threaded_irq(dev, jpegd->irq, rkjpegd_irq,
+					rkjpegd_irq_thread, 0,
+					dev_name(dev), jpegd);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot request irq\n");
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot set DMA mask\n");
+
+	jpegd->tables = dmam_alloc_coherent(dev, RKJPEGD_TABLES_SIZE,
+					    &jpegd->tables_dma, GFP_KERNEL);
+	if (!jpegd->tables)
+		return -ENOMEM;
+
+	if (iommu_get_domain_for_dev(dev)) {
+		jpegd->empty_domain = iommu_paging_domain_alloc(dev);
+		if (IS_ERR(jpegd->empty_domain)) {
+			dev_warn(dev, "cannot allocate empty IOMMU domain\n");
+			jpegd->empty_domain = NULL;
+		}
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, RKJPEGD_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto err_pm;
+	jpegd->hw_id = rkjpegd_read(jpegd, RKJPEGD_REG_ID);
+	rkjpegd_write(jpegd, RKJPEGD_REG_INT, 0);
+	pm_runtime_put_autosuspend(dev);
+
+	ret = v4l2_device_register(dev, &jpegd->v4l2_dev);
+	if (ret)
+		goto err_pm;
+
+	jpegd->m2m_dev = v4l2_m2m_init(&rkjpegd_m2m_ops);
+	if (IS_ERR(jpegd->m2m_dev)) {
+		ret = PTR_ERR(jpegd->m2m_dev);
+		goto err_v4l2;
+	}
+
+	vfd = &jpegd->vdev;
+	strscpy(vfd->name, RKJPEGD_NAME, sizeof(vfd->name));
+	vfd->fops = &rkjpegd_fops;
+	vfd->ioctl_ops = &rkjpegd_ioctl_ops;
+	vfd->release = video_device_release_empty;
+	vfd->lock = &jpegd->lock;
+	vfd->v4l2_dev = &jpegd->v4l2_dev;
+	vfd->vfl_dir = VFL_DIR_M2M;
+	vfd->device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING;
+	video_set_drvdata(vfd, jpegd);
+
+	ret = video_register_device(vfd, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_m2m;
+
+	dev_info(dev, "hardware id %#x, registered as %s\n", jpegd->hw_id,
+		 video_device_node_name(vfd));
+
+	return 0;
+
+err_m2m:
+	v4l2_m2m_release(jpegd->m2m_dev);
+err_v4l2:
+	/* runtime PM callbacks need the driver data, see rkjpegd_remove() */
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+	v4l2_device_unregister(&jpegd->v4l2_dev);
+	goto err_free_domain;
+err_pm:
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_disable(dev);
+err_free_domain:
+	if (jpegd->empty_domain)
+		iommu_domain_free(jpegd->empty_domain);
+	return ret;
+}
+
+static void rkjpegd_remove(struct platform_device *pdev)
+{
+	struct rkjpegd_dev *jpegd = platform_get_drvdata(pdev);
+
+	video_unregister_device(&jpegd->vdev);
+	cancel_delayed_work_sync(&jpegd->watchdog_work);
+	v4l2_m2m_release(jpegd->m2m_dev);
+
+	/*
+	 * Suspend and disable runtime PM while the driver data is valid:
+	 * the runtime PM callbacks use it, and v4l2_device_unregister()
+	 * may clear it.
+	 */
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	v4l2_device_unregister(&jpegd->v4l2_dev);
+	if (jpegd->empty_domain)
+		iommu_domain_free(jpegd->empty_domain);
+}
+
+static int rkjpegd_runtime_suspend(struct device *dev)
+{
+	struct rkjpegd_dev *jpegd = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(jpegd->num_clocks, jpegd->clocks);
+
+	return 0;
+}
+
+static int rkjpegd_runtime_resume(struct device *dev)
+{
+	struct rkjpegd_dev *jpegd = dev_get_drvdata(dev);
+
+	return clk_bulk_prepare_enable(jpegd->num_clocks, jpegd->clocks);
+}
+
+static int rkjpegd_suspend(struct device *dev)
+{
+	struct rkjpegd_dev *jpegd = dev_get_drvdata(dev);
+
+	v4l2_m2m_suspend(jpegd->m2m_dev);
+
+	return pm_runtime_force_suspend(dev);
+}
+
+static int rkjpegd_resume(struct device *dev)
+{
+	struct rkjpegd_dev *jpegd = dev_get_drvdata(dev);
+	int ret;
+
+	ret = pm_runtime_force_resume(dev);
+	if (ret)
+		return ret;
+
+	v4l2_m2m_resume(jpegd->m2m_dev);
+
+	return 0;
+}
+
+static const struct dev_pm_ops rkjpegd_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(rkjpegd_suspend, rkjpegd_resume)
+	RUNTIME_PM_OPS(rkjpegd_runtime_suspend, rkjpegd_runtime_resume, NULL)
+};
+
+static const struct of_device_id rkjpegd_of_match[] = {
+	{ .compatible = "rockchip,rk3588-jpeg-decoder" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, rkjpegd_of_match);
+
+static struct platform_driver rkjpegd_driver = {
+	.probe = rkjpegd_probe,
+	.remove = rkjpegd_remove,
+	.driver = {
+		.name = RKJPEGD_NAME,
+		.of_match_table = rkjpegd_of_match,
+		.pm = pm_ptr(&rkjpegd_pm_ops),
+	},
+};
+module_platform_driver(rkjpegd_driver);
+
+MODULE_DESCRIPTION("Rockchip VDPU720 JPEG decoder driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/rockchip/rkjpegd/rkjpegd.h b/drivers/media/platform/rockchip/rkjpegd/rkjpegd.h
new file mode 100644
index 000000000..1b2716333
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkjpegd/rkjpegd.h
@@ -0,0 +1,276 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Rockchip VDPU720 JPEG decoder driver
+ */
+#ifndef RKJPEGD_H_
+#define RKJPEGD_H_
+
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/mutex.h>
+#include <linux/reset.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-jpeg.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-v4l2.h>
+
+#define RKJPEGD_NAME			"rockchip-jpegd"
+
+/* Registers */
+#define RKJPEGD_REG_ID			0x000
+#define   RKJPEGD_ID_VPU720		0xdb1f0006
+
+#define RKJPEGD_REG_INT			0x004
+#define   RKJPEGD_INT_DEC_E		BIT(0)
+#define   RKJPEGD_INT_IRQ_DIS		BIT(1)
+#define   RKJPEGD_INT_TIMEOUT_E		BIT(2)
+#define   RKJPEGD_INT_BUF_EMPTY_E	BIT(3)
+#define   RKJPEGD_INT_SOFT_RST_EN	BIT(5)
+#define   RKJPEGD_INT_IRQ_RAW		BIT(6)
+#define   RKJPEGD_INT_IRQ		BIT(8)
+#define   RKJPEGD_INT_RDY_STA		BIT(9)
+#define   RKJPEGD_INT_BUS_STA		BIT(10)
+#define   RKJPEGD_INT_ERROR_STA		BIT(11)
+#define   RKJPEGD_INT_TIMEOUT_STA	BIT(12)
+#define   RKJPEGD_INT_BUF_EMPTY_STA	BIT(13)
+#define   RKJPEGD_INT_SOFT_RST_RDY	BIT(14)
+#define   RKJPEGD_INT_ERR_MASK		(RKJPEGD_INT_BUS_STA | \
+					 RKJPEGD_INT_ERROR_STA | \
+					 RKJPEGD_INT_TIMEOUT_STA | \
+					 RKJPEGD_INT_BUF_EMPTY_STA)
+
+#define RKJPEGD_REG_SYS			0x008
+#define   RKJPEGD_SYS_OUT_CBCR_SWAP	BIT(9)
+#define   RKJPEGD_SYS_SCALEDOWN		GENMASK(13, 12)
+#define   RKJPEGD_SYS_FORCE_SOFTRST	BIT(17)
+#define   RKJPEGD_SYS_FILL_DOWN_E	BIT(24)
+#define   RKJPEGD_SYS_FILL_RIGHT_E	BIT(25)
+#define   RKJPEGD_SYS_OUT_TILE		BIT(26)
+#define   RKJPEGD_SYS_OUT_FMT		GENMASK(29, 27)
+#define     RKJPEGD_OUT_FMT_NATIVE	0
+#define     RKJPEGD_OUT_FMT_RGB888	1
+#define     RKJPEGD_OUT_FMT_RGB565	2
+#define     RKJPEGD_OUT_FMT_NV12	3
+#define     RKJPEGD_OUT_FMT_YUYV	4
+
+#define RKJPEGD_REG_PIC_SIZE		0x00c
+#define   RKJPEGD_PIC_WIDTH_M1		GENMASK(15, 0)
+#define   RKJPEGD_PIC_HEIGHT_M1		GENMASK(31, 16)
+
+#define RKJPEGD_REG_PIC_FMT		0x010
+#define   RKJPEGD_PIC_JPEG_MODE		GENMASK(2, 0)
+#define     RKJPEGD_MODE_400		0
+#define     RKJPEGD_MODE_411		1
+#define     RKJPEGD_MODE_420		2
+#define     RKJPEGD_MODE_422		3
+#define     RKJPEGD_MODE_440		4
+#define     RKJPEGD_MODE_444		5
+#define   RKJPEGD_PIC_PIXEL_DEPTH	GENMASK(6, 4)
+#define   RKJPEGD_PIC_QTABLES_SEL	GENMASK(9, 8)
+#define   RKJPEGD_PIC_HTABLES_SEL	GENMASK(13, 12)
+#define   RKJPEGD_PIC_DRI_E		BIT(15)
+#define   RKJPEGD_PIC_DRI_MCU_M1	GENMASK(31, 16)
+
+/* Horizontal strides, in units of 16 bytes */
+#define RKJPEGD_REG_HOR_VIRSTRIDE	0x014
+#define   RKJPEGD_Y_HOR_VIRSTRIDE	GENMASK(15, 0)
+#define   RKJPEGD_UV_HOR_VIRSTRIDE	GENMASK(31, 16)
+
+/* Luma plane size in bytes (offset of the chroma plane), 16 byte aligned */
+#define RKJPEGD_REG_Y_VIRSTRIDE		0x018
+
+/* Table lengths, in units of 16 bytes minus one */
+#define RKJPEGD_REG_TBL_LEN		0x01c
+#define   RKJPEGD_QTBL_LEN		GENMASK(4, 0)
+#define   RKJPEGD_HTBL_MINCODE_LEN	GENMASK(12, 8)
+#define   RKJPEGD_HTBL_VALUE_LEN	GENMASK(21, 16)
+#define   RKJPEGD_Y_HOR_VIRSTRIDE_H	BIT(24)
+
+/* Stream length in units of 16 bytes minus one, start byte offset */
+#define RKJPEGD_REG_STRM_LEN		0x020
+#define   RKJPEGD_STRM_START_BYTE	GENMASK(3, 0)
+#define   RKJPEGD_STRM_LEN		GENMASK(31, 4)
+
+#define RKJPEGD_REG_QTBL_BASE		0x024
+#define RKJPEGD_REG_HTBL_MINCODE_BASE	0x028
+#define RKJPEGD_REG_HTBL_VALUE_BASE	0x02c
+#define RKJPEGD_REG_STRM_BASE		0x030
+#define RKJPEGD_REG_OUT_BASE		0x034
+
+#define RKJPEGD_REG_STRM_ERROR		0x038
+#define   RKJPEGD_ERR_PRC_MODE		BIT(0)
+#define   RKJPEGD_ERR_FFFF_MODE		GENMASK(6, 5)
+#define   RKJPEGD_ERR_OTHER_MARK_MODE	GENMASK(8, 7)
+#define     RKJPEGD_ERR_MODE_SKIP	2
+
+#define RKJPEGD_REG_STRM_MASK		0x03c
+
+#define RKJPEGD_REG_CLK_GATE		0x040
+#define   RKJPEGD_CLK_GATE_ALL		GENMASK(7, 0)
+
+#define RKJPEGD_REG_DBG_MCU_POS		0x080
+#define RKJPEGD_REG_DBG_ERR		0x084
+#define RKJPEGD_REG_PERF_WORKING_CNT	0x09c
+
+/*
+ * Table buffer layout: tables for up to three components, 8-bit sample
+ * precision only. Each base address must be 64 byte aligned.
+ */
+#define RKJPEGD_NUM_TBL			3
+#define RKJPEGD_QTBL_ENTRIES		64
+#define RKJPEGD_QTBL_SIZE		(RKJPEGD_QTBL_ENTRIES * sizeof(u16))
+/* min codes and accumulated code counts, for DC and for AC */
+#define RKJPEGD_HTBL_MINCODE_ENTRIES	48
+#define RKJPEGD_HTBL_MINCODE_SIZE	(RKJPEGD_HTBL_MINCODE_ENTRIES * sizeof(u16))
+#define RKJPEGD_HTBL_VALUE_SIZE		192
+#define RKJPEGD_HTBL_AC_VALUE_OFFSET	16
+#define RKJPEGD_QTBL_OFFSET		0
+#define RKJPEGD_HTBL_MINCODE_OFFSET	(RKJPEGD_QTBL_OFFSET + \
+					 RKJPEGD_NUM_TBL * RKJPEGD_QTBL_SIZE)
+#define RKJPEGD_HTBL_VALUE_OFFSET	(RKJPEGD_HTBL_MINCODE_OFFSET + \
+					 ALIGN(RKJPEGD_NUM_TBL * \
+					       RKJPEGD_HTBL_MINCODE_SIZE, 64))
+#define RKJPEGD_TABLES_SIZE		(RKJPEGD_HTBL_VALUE_OFFSET + \
+					 RKJPEGD_NUM_TBL * \
+					 RKJPEGD_HTBL_VALUE_SIZE)
+
+#define RKJPEGD_MIN_SIZE		1
+#define RKJPEGD_MAX_SIZE		16384
+#define RKJPEGD_DEF_WIDTH		1920
+#define RKJPEGD_DEF_HEIGHT		1080
+#define RKJPEGD_ALIGN			16
+#define RKJPEGD_MIN_OUT_SIZE		SZ_1M
+#define RKJPEGD_DEF_OUT_MAX_SIZE	SZ_32M
+#define RKJPEGD_MAX_OUT_SIZE		SZ_256M
+
+#define RKJPEGD_DC_MAX_VALUES		12
+#define RKJPEGD_AC_MAX_VALUES		162
+
+#define RKJPEGD_WATCHDOG_MS		2000
+#define RKJPEGD_AUTOSUSPEND_MS		100
+
+struct rkjpegd_huff {
+	u8 bits[16];
+	u8 vals[RKJPEGD_AC_MAX_VALUES];
+};
+
+/* Huffman table index: class (DC = 0, AC = 1) * 2 + destination */
+#define RKJPEGD_HUFF_DC(th)		(th)
+#define RKJPEGD_HUFF_AC(th)		(2 + (th))
+
+/*
+ * Information extracted from a JPEG header. Tables are copied so that the
+ * header does not have to be parsed again when programming the hardware.
+ */
+struct rkjpegd_hdr {
+	u16 width;
+	u16 height;
+	enum v4l2_jpeg_chroma_subsampling subsampling;
+	u8 num_components;
+	u16 restart_interval;
+	u32 ecs_offset;
+	/* per frame component: quantisation and Huffman table selectors */
+	u8 tq[RKJPEGD_NUM_TBL];
+	u8 td[RKJPEGD_NUM_TBL];
+	u8 ta[RKJPEGD_NUM_TBL];
+	/* quantisation tables, zigzag order */
+	u8 qtbl[V4L2_JPEG_MAX_TABLES][RKJPEGD_QTBL_ENTRIES];
+	/* DC0, DC1, AC0, AC1 */
+	struct rkjpegd_huff huff[4];
+};
+
+struct rkjpegd_buf {
+	/* must be first */
+	struct v4l2_m2m_buffer m2m_buf;
+	bool valid;
+	struct rkjpegd_hdr hdr;
+};
+
+static inline struct rkjpegd_buf *to_rkjpegd_buf(struct vb2_v4l2_buffer *vbuf)
+{
+	return container_of(vbuf, struct rkjpegd_buf, m2m_buf.vb);
+}
+
+enum rkjpegd_state {
+	/* no header parsed yet */
+	RKJPEGD_STATE_INIT,
+	/* decoding */
+	RKJPEGD_STATE_RUNNING,
+	/* waiting for the client to reconfigure the CAPTURE queue */
+	RKJPEGD_STATE_SOURCE_CHANGE,
+};
+
+struct rkjpegd_ctx;
+
+struct rkjpegd_dev {
+	/*
+	 * Not first: v4l2_device_unregister() clears the device's driver
+	 * data when it points to the v4l2_device.
+	 */
+	struct device *dev;
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct v4l2_m2m_dev *m2m_dev;
+	/* serialises ioctls and queue operations */
+	struct mutex lock;
+	void __iomem *regs;
+	int irq;
+	struct clk_bulk_data *clocks;
+	int num_clocks;
+	struct reset_control *rstc;
+	struct iommu_domain *empty_domain;
+	struct delayed_work watchdog_work;
+	u32 hw_id;
+	/* context of the job running on the hardware */
+	struct rkjpegd_ctx *curr_ctx;
+	u32 irq_status;
+
+	void *tables;
+	dma_addr_t tables_dma;
+};
+
+struct rkjpegd_ctx {
+	struct v4l2_fh fh;
+	struct rkjpegd_dev *jpegd;
+	enum rkjpegd_state state;
+
+	struct v4l2_pix_format_mplane out_fmt;
+	struct v4l2_pix_format_mplane cap_fmt;
+	/* the client chose the CAPTURE pixel format with S_FMT */
+	bool cap_fourcc_set;
+	/* visible size and subsampling the CAPTURE format was set up for */
+	u32 visible_width;
+	u32 visible_height;
+	enum v4l2_jpeg_chroma_subsampling subsampling;
+	bool header_known;
+
+	u32 out_sequence;
+	u32 cap_sequence;
+};
+
+static inline struct rkjpegd_ctx *file_to_rkjpegd_ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct rkjpegd_ctx, fh);
+}
+
+static inline void rkjpegd_write(struct rkjpegd_dev *jpegd, u32 reg, u32 val)
+{
+	writel_relaxed(val, jpegd->regs + reg);
+}
+
+static inline u32 rkjpegd_read(struct rkjpegd_dev *jpegd, u32 reg)
+{
+	return readl_relaxed(jpegd->regs + reg);
+}
+
+int rkjpegd_parse_header(void *buf, size_t len, struct rkjpegd_hdr *hdr);
+void rkjpegd_hw_run(struct rkjpegd_dev *jpegd, struct rkjpegd_ctx *ctx,
+		    const struct rkjpegd_hdr *hdr, dma_addr_t src, size_t len,
+		    dma_addr_t dst);
+int rkjpegd_hw_reset(struct rkjpegd_dev *jpegd);
+bool rkjpegd_cap_fourcc_valid(u32 fourcc,
+			      enum v4l2_jpeg_chroma_subsampling subsampling);
+u32 rkjpegd_native_fourcc(enum v4l2_jpeg_chroma_subsampling subsampling);
+
+#endif /* RKJPEGD_H_ */
