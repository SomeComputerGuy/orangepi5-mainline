From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 29 Oct 2026 22:27:25 +0000
Subject: [PATCH] media: verisilicon: Don't report frame rate ioctls when
 encoding JPEG

The frame interval and streaming parameter ioctls for encoders are
there for the rate control of video encoders. They are also offered
when the CAPTURE format is JPEG, which has no rate control and no use
for a frame rate. Other JPEG encoders don't implement these ioctls, and
v4l2-compliance requires memory-to-memory devices that aren't stateful
video encoders to return -ENOTTY for them. On the RK3588 VEPU121 JPEG
encoder, 5 of its 66 tests failed (VIDIOC_ENUM_FMT/FRAMESIZES/
FRAMEINTERVALS and VIDIOC_G/S_PARM, plus G/TRY/S_FMT, which fail
because the format enumeration test stopped early).

Don't register them at all on encoders that only produce JPEG, like the
VEPU121, so that the core reports -ENOTTY even before it validates the
buffer type. On encoders that also do video, like the RK3588 VPU121,
return -ENOTTY from them while the CAPTURE format is JPEG.

Fixes: ced67ee1fffe ("media: verisilicon: Add common encoder parm and frameintervals ioctls")
Assisted-by: Claude:claude-opus-5-5
---
 .../media/platform/verisilicon/hantro_drv.c   | 21 +++++++++++++++++++
 .../media/platform/verisilicon/hantro_v4l2.c  | 19 +++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/drivers/media/platform/verisilicon/hantro_drv.c b/drivers/media/platform/verisilicon/hantro_drv.c
index bb40fed10..973ac1f05 100644
--- a/drivers/media/platform/verisilicon/hantro_drv.c
+++ b/drivers/media/platform/verisilicon/hantro_drv.c
@@ -1099,6 +1099,22 @@ static void hantro_detach_func(struct hantro_func *func)
 	media_entity_cleanup(&func->vdev.entity);
 }
 
+/* Does the encoder only produce JPEG, which has no use for a frame rate? */
+static bool hantro_jpeg_only_encoder(struct hantro_dev *vpu)
+{
+	unsigned int i;
+
+	for (i = 0; i < vpu->variant->num_enc_fmts; i++) {
+		const struct hantro_fmt *fmt = &vpu->variant->enc_fmts[i];
+
+		if (fmt->codec_mode != HANTRO_MODE_NONE &&
+		    fmt->codec_mode != HANTRO_MODE_JPEG_ENC)
+			return false;
+	}
+
+	return true;
+}
+
 static int hantro_add_func(struct hantro_dev *vpu, unsigned int funcid)
 {
 	const struct of_device_id *match;
@@ -1131,6 +1147,11 @@ static int hantro_add_func(struct hantro_dev *vpu, unsigned int funcid)
 		vpu->encoder = func;
 		v4l2_disable_ioctl(vfd, VIDIOC_TRY_DECODER_CMD);
 		v4l2_disable_ioctl(vfd, VIDIOC_DECODER_CMD);
+		if (hantro_jpeg_only_encoder(vpu)) {
+			v4l2_disable_ioctl(vfd, VIDIOC_ENUM_FRAMEINTERVALS);
+			v4l2_disable_ioctl(vfd, VIDIOC_G_PARM);
+			v4l2_disable_ioctl(vfd, VIDIOC_S_PARM);
+		}
 	} else {
 		vpu->decoder = func;
 		v4l2_disable_ioctl(vfd, VIDIOC_TRY_ENCODER_CMD);
diff --git a/drivers/media/platform/verisilicon/hantro_v4l2.c b/drivers/media/platform/verisilicon/hantro_v4l2.c
index 156170805..6b4a23bea 100644
--- a/drivers/media/platform/verisilicon/hantro_v4l2.c
+++ b/drivers/media/platform/verisilicon/hantro_v4l2.c
@@ -213,6 +213,16 @@ static int vidioc_enum_framesizes(struct file *file, void *priv,
 	return 0;
 }
 
+/*
+ * The frame rate only matters to the rate control of video encoders. JPEG
+ * encoders don't have one, and like other JPEG encoders don't implement
+ * the frame interval ioctls.
+ */
+static bool hantro_has_frame_rate(struct hantro_ctx *ctx)
+{
+	return ctx->vpu_dst_fmt->codec_mode != HANTRO_MODE_JPEG_ENC;
+}
+
 static int vidioc_enum_frameintervals(struct file *file, void *priv,
 				      struct v4l2_frmivalenum *fival)
 {
@@ -221,6 +231,9 @@ static int vidioc_enum_frameintervals(struct file *file, void *priv,
 	unsigned int height = fival->height;
 	int ret;
 
+	if (!hantro_has_frame_rate(file_to_ctx(file)))
+		return -ENOTTY;
+
 	if (fival->index > 0)
 		return -EINVAL;
 
@@ -846,6 +859,9 @@ static int vidioc_g_parm(struct file *file, void *priv,
 	struct hantro_ctx *ctx = file_to_ctx(file);
 	struct v4l2_fract *timeperframe;
 
+	if (!hantro_has_frame_rate(ctx))
+		return -ENOTTY;
+
 	if (V4L2_TYPE_IS_OUTPUT(parm->type)) {
 		timeperframe = &ctx->src_timeperframe;
 		parm->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
@@ -867,6 +883,9 @@ static int vidioc_s_parm(struct file *file, void *priv,
 	struct v4l2_fract *timeperframe_ctx;
 	struct v4l2_fract *timeperframe;
 
+	if (!hantro_has_frame_rate(ctx))
+		return -ENOTTY;
+
 	if (V4L2_TYPE_IS_OUTPUT(parm->type)) {
 		parm->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
 		timeperframe = &parm->parm.output.timeperframe;
