+
+/* RDO (SQI) class, H.264 subset */
+#define VEPU580_RDO_SQI_CFG			0x2000
+#define   VEPU580_RDO_SQI_CFG_ATF_PSKIP_EN	BIT(0)
+#define VEPU580_RDO_INTRA_CIME_THD0		0x20cc
