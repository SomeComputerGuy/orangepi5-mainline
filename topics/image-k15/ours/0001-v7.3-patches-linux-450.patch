+#define VEPU580_RDO_INTRA_VAR_THD(n)		(0x20d4 + 4 * (n))
+#define VEPU580_RDO_INTRA_ATF_WGT(n)		(0x20e4 + 4 * (n))
+#define VEPU580_RDO_SKIP_CIME_THD0		0x211c
+#define VEPU580_RDO_SKIP_CIME_THD1		0x2120
