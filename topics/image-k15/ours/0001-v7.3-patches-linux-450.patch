+#define VEPU580_HEVC_RDO_B8_SKIP		0x2194
+#define   VEPU580_HEVC_RDO_SQI_CFG_SEGMENT_EN	BIT(0)
+#define   VEPU580_HEVC_RDO_SQI_CFG_SMEAR_EN	BIT(1)
+#define VEPU580_HEVC_RDO_SEGMENT_B64_THD0	0x21bc
