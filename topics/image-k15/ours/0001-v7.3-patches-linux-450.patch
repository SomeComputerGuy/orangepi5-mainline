+	__u32	flags;
+	__u32	header_size;
+	__u32	qp_sum;
+	__u32	qp_count;
+	__s8	qp_min;
+	__s8	qp_max;
+	__u8	reserved0[6];
+	__u64	sse_luma;
+	__u32	num_intra_blocks;
+	__u32	num_inter_blocks;
