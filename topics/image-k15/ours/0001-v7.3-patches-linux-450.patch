+
+#define v4l2_h264_enc_rbsp_op(r, o, a...) \
+	({ \
+		int ret; \
+		if ((r)->ops && (r)->ops->o) \
+			ret = (r)->ops->o(r, ##a); \
+		else \
+			ret = -EOPNOTSUPP; \
