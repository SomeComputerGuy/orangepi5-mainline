+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(hdmi_frl_configs); i++) {
+		if (frl_rate == hdmi_frl_configs[i].rate_per_lane * hdmi_frl_configs[i].lanes) {
+			*rate_per_lane = hdmi_frl_configs[i].rate_per_lane;
+			*lanes = hdmi_frl_configs[i].lanes;
