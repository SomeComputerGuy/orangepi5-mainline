+		    unsigned char bits_count);
+	int (*ue)(struct v4l2_h264_enc_rbsp *rbsp, u32 value);
+	int (*se)(struct v4l2_h264_enc_rbsp *rbsp, s32 value);
+	int (*align)(struct v4l2_h264_enc_rbsp *rbsp);
+};
