#!/usr/bin/python3 -I
"""Non-interactive hardware-decode test against a Jellyfin server (Orange Pi 5).

Logs in through the Jellyfin REST API, picks videos by codec, resolution and bit
depth, plays each one for a while through mpv (v4l2request hwdec), GStreamer
(playbin3, v4l2codecs) and/or FFmpeg (decode only), and records the decoder in
use, decoder interrupts (proof the VPU worked), dropped frames and CPU load.

Credentials are never taken from the command line. They come from the
environment (OPI5_JELLYFIN_URL, OPI5_JELLYFIN_USER, OPI5_JELLYFIN_PASS) or, with
--creds-stdin, from KEY=VALUE lines on stdin (scripts/pi-jellyfin-test.sh sends
them that way from the build PC's local.env). The players get token-free
http://127.0.0.1 URLs from a local proxy that adds the token as a header, so
the token appears in no process list, player log or result file. The session
is logged out at the end.

Examples:
  opi5-jellyfin-hwtest --list
  opi5-jellyfin-hwtest --backend mpv,gst --duration 30
  opi5-jellyfin-hwtest --backend ffmpeg --codecs hevc,av1 --per-class 2
"""
import argparse
import http.server
import json
import os
import re
import shutil
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

CLIENT = 'Client="opi5-hwtest", Device="orangepi5", DeviceId="opi5-hwtest-%s", Version="1.0"' % socket.gethostname()
CODECS = ["h264", "hevc", "vp9", "av1", "vp8", "mpeg2video"]
# Which RK3588 block should decode what (mainline drivers)
EXPECTED = {
    "h264": "rkvdec (4K) or Hantro G1 (<=1080p)",
    "hevc": "rkvdec", "vp9": "rkvdec", "av1": "AV1 VPU (VPU981)",
    "vp8": "Hantro G1 (<=1080p)", "mpeg2video": "Hantro G1 (<=1080p)",
}
IRQ_RE = re.compile(r"video-codec|vdec|vpu|hantro|rkvdec|av1|jpeg|rga|iep", re.I)


def log(*a):
    print(*a, file=sys.stderr, flush=True)


# ---------------------------------------------------------------- Jellyfin API
class Jellyfin:
    def __init__(self, url, user, password):
        self.url = url.rstrip("/")
        self.token = None
        r = self.req("POST", "/Users/AuthenticateByName", {"Username": user, "Pw": password})
        self.token = r["AccessToken"]
        self.user_id = r["User"]["Id"]
        self.server = r.get("ServerId", "")

    def auth_header(self):
        h = "MediaBrowser " + CLIENT
        if self.token:
            h += ', Token="%s"' % self.token
        return h

    def req(self, method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        rq = urllib.request.Request(self.url + path, data=data, method=method)
        rq.add_header("Authorization", self.auth_header())
        if data is not None:
            rq.add_header("Content-Type", "application/json")
        with urllib.request.urlopen(rq, timeout=30) as f:
            raw = f.read()
        return json.loads(raw) if raw else None

    def videos(self):
        q = urllib.parse.urlencode({
            "userId": self.user_id, "Recursive": "true", "Limit": "10000",
            "IncludeItemTypes": "Movie,Episode,Video,MusicVideo",
            "Fields": "MediaSources,MediaStreams"})
        return self.req("GET", "/Items?" + q).get("Items", [])

    def upstream(self, item, source):
        q = urllib.parse.urlencode({"static": "true", "MediaSourceId": source})
        return "%s/Videos/%s/stream?%s" % (self.url, item, q)

    def logout(self):
        try:
            self.req("POST", "/Sessions/Logout")
        except Exception as e:  # the token expires anyway
            log("logout failed:", type(e).__name__)


def describe(item):
    """Flatten an item's first media source into the fields the test needs."""
    srcs = item.get("MediaSources") or []
    if not srcs:
        return None
    src = srcs[0]
    vs = [s for s in src.get("MediaStreams") or [] if s.get("Type") == "Video"]
    if not vs:
        return None
    v = vs[0]
    codec = (v.get("Codec") or "").lower()
    codec = {"h265": "hevc", "mpeg2": "mpeg2video", "avc": "h264"}.get(codec, codec)
    h = v.get("Height") or 0
    fps = v.get("RealFrameRate") or v.get("AverageFrameRate") or 0
    return {
        "id": item["Id"], "source": src["Id"],
        "name": item.get("SeriesName", "") + (" - " if item.get("SeriesName") else "") + item.get("Name", ""),
        "container": src.get("Container"), "codec": codec, "profile": v.get("Profile"),
        "width": v.get("Width"), "height": h, "bitdepth": v.get("BitDepth") or 8,
        "fps": round(float(fps), 3), "range": v.get("VideoRange"), "interlaced": v.get("IsInterlaced"),
        "bitrate": v.get("BitRate") or src.get("Bitrate"),
        "seconds": int((item.get("RunTimeTicks") or 0) / 1e7),
    }


def size_class(h):
    return "SD" if h <= 576 else "720p" if h <= 720 else "1080p" if h <= 1088 else "1440p" if h <= 1600 else "2160p" if h <= 2176 else ">4K"


def klass(v):
    return (v["codec"], size_class(v["height"]), "%d-bit" % v["bitdepth"], "hfr" if v["fps"] > 31 else "")


def pick(videos, codecs, per_class, min_seconds):
    chosen, seen = [], {}
    for v in sorted(videos, key=lambda v: (-(v["seconds"] >= min_seconds), -v["height"], -v["fps"])):
        if v["codec"] not in codecs:
            continue
        k = klass(v)
        if seen.get(k, 0) < per_class:
            seen[k] = seen.get(k, 0) + 1
            chosen.append(v)
    return sorted(chosen, key=lambda v: (codecs.index(v["codec"]), v["height"], v["bitdepth"], v["fps"]))


# ------------------------------------------------------------ local proxy
class Proxy(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True

    def __init__(self, jf):
        self.jf = jf
        super().__init__(("127.0.0.1", 0), ProxyHandler)

    def url(self, v):
        return "http://127.0.0.1:%d/v/%s/%s" % (self.server_address[1], v["id"], v["source"])


class ProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):  # keep stderr for the test's own output
        pass

    def do_HEAD(self):
        self.forward(head=True)

    def do_GET(self):
        self.forward(head=False)

    def forward(self, head):
        parts = self.path.split("/")
        if len(parts) != 4 or parts[1] != "v":
            self.send_error(404)
            return
        jf = self.server.jf
        rq = urllib.request.Request(jf.upstream(parts[2], parts[3]), method="HEAD" if head else "GET")
        rq.add_header("Authorization", jf.auth_header())
        if self.headers.get("Range"):
            rq.add_header("Range", self.headers["Range"])
        try:
            up = urllib.request.urlopen(rq, timeout=60)
        except urllib.error.HTTPError as e:
            up = e
        except Exception:
            self.send_error(502)
            return
        with up:
            self.send_response(up.status if hasattr(up, "status") else up.code)
            for k in ("Content-Type", "Content-Length", "Content-Range", "Accept-Ranges", "Last-Modified", "ETag"):
                if up.headers.get(k):
                    self.send_header(k, up.headers[k])
            if not up.headers.get("Content-Length"):
                self.send_header("Connection", "close")
                self.close_connection = True
            self.end_headers()
            if head:
                return
            try:
                while True:
                    chunk = up.read(1 << 18)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError, socket.timeout):
                self.close_connection = True


# ------------------------------------------------------------ measurements
def irq_counts():
    out = {}
    with open("/proc/interrupts") as f:
        f.readline()
        for line in f:
            if IRQ_RE.search(line):
                fields = line.split()
                n = sum(int(x) for x in fields[1:] if x.isdigit())
                out[" ".join(fields[-2:])] = n
    return out


def cpu_total():
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:]]
    return sum(v), v[3] + v[4]  # total, idle+iowait


def proc_cpu(pid):
    try:
        with open("/proc/%d/stat" % pid) as f:
            v = f.read().rsplit(")", 1)[1].split()
        return int(v[11]) + int(v[12])  # utime + stime (ticks)
    except OSError:
        return None


class Meter:
    def __init__(self, pid):
        self.pid, self.t0 = pid, time.monotonic()
        self.irq0, self.cpu0, self.p0 = irq_counts(), cpu_total(), proc_cpu(pid) or 0
        self.p_last = self.p0

    def poll(self):
        p = proc_cpu(self.pid)
        if p is not None:
            self.p_last = p

    def result(self):
        dt = time.monotonic() - self.t0
        tot, idle = cpu_total()
        hz = os.sysconf("SC_CLK_TCK")
        irq1 = irq_counts()
        return {
            "wall_s": round(dt, 1),
            "player_cpu_pct_of_one_core": round(100.0 * (self.p_last - self.p0) / hz / dt, 1) if dt else None,
            "system_cpu_pct": round(100.0 * (1 - (idle - self.cpu0[1]) / max(1, tot - self.cpu0[0])), 1),
            "decoder_irqs": {k: irq1[k] - self.irq0.get(k, 0) for k in irq1 if irq1[k] - self.irq0.get(k, 0) > 0},
        }


def display_env():
    """Use the logged-in desktop session's Wayland display if there is one."""
    env = dict(os.environ)
    rt = env.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    if not env.get("WAYLAND_DISPLAY") and os.path.exists(os.path.join(rt, "wayland-0")):
        env.update(XDG_RUNTIME_DIR=rt, WAYLAND_DISPLAY="wayland-0")
    return env, bool(env.get("WAYLAND_DISPLAY"))


def kms_state(outdir, tag):
    """Snapshot the KMS plane state (shows NV12 planes for direct scanout). Needs root."""
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode:
        return None
    paths = [p for p in ("/sys/kernel/debug/dri/0/state", "/sys/kernel/debug/dri/1/state")]
    r = subprocess.run(["sudo", "-n", "cat"] + paths, capture_output=True, text=True)
    f = os.path.join(outdir, tag + ".kms-state.txt")
    with open(f, "w") as fh:
        fh.write(r.stdout)
    return os.path.basename(f)


# ------------------------------------------------------------ backends
def run_mpv(url, v, a, outdir, tag):
    if not shutil.which("mpv"):
        return {"skipped": "mpv not installed"}
    env, has_display = display_env()
    sock = os.path.join(outdir, tag + ".mpv.sock")
    cmd = ["mpv", "--no-terminal", "--idle=no", "--keep-open=no", "--force-window=no",
           "--hwdec=" + a.mpv_hwdec, "--start=%d" % a.start, "--length=%d" % a.duration,
           "--input-ipc-server=" + sock, "--log-file=" + os.path.join(outdir, tag + ".mpv.log"),
           "--msg-level=all=v"]
    if a.no_audio:
        cmd.append("--no-audio")
    if a.mpv_vo:
        cmd.append("--vo=" + a.mpv_vo)
    elif not has_display:
        return {"skipped": "no Wayland session to display on (log in at the desktop, or pass --mpv-vo drm with no compositor running)"}
    cmd.append("--fullscreen")
    if a.output:
        cmd.append("--fs-screen-name=" + a.output)
    cmd.append(url)
    p = subprocess.Popen(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    m = Meter(p.pid)
    props = ["hwdec-current", "estimated-vf-fps", "container-fps", "display-fps", "frame-drop-count",
             "decoder-frame-drop-count", "vo-delayed-frame-count", "mistimed-frame-count",
             "current-vo", "video-codec", "video-params", "video-out-params", "avsync"]
    last, state, kms = {}, None, None
    t_end = time.monotonic() + a.duration + 60
    while p.poll() is None and time.monotonic() < t_end:
        time.sleep(1)
        m.poll()
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(2)
            s.connect(sock)
            for i, prop in enumerate(props):
                s.sendall((json.dumps({"command": ["get_property", prop], "request_id": i}) + "\n").encode())
            buf = b""
            while buf.count(b"\n") < len(props):
                d = s.recv(65536)
                if not d:
                    break
                buf += d
            s.close()
            for line in buf.splitlines():
                r = json.loads(line)
                if "request_id" in r and r.get("error") == "success":
                    last[props[r["request_id"]]] = r.get("data")
        except (OSError, ValueError):
            continue
        if kms is None and last.get("estimated-vf-fps") and time.monotonic() - m.t0 > a.duration / 2:
            kms = kms_state(outdir, tag) or ""
    if p.poll() is None:
        p.terminate()
    p.wait()
    res = m.result()
    res.update({"exit": p.returncode, "kms_state": kms or None})
    vp = last.pop("video-params", None) or {}
    res["decoded_format"] = vp.get("hw-pixelformat") or vp.get("pixelformat")
    res.update(last)
    hw = last.get("hwdec-current")
    res["hw_decode"] = bool(hw and hw != "no")
    res["zero_copy"] = bool(hw and hw != "no" and not hw.endswith("-copy"))
    return res


GST_DEC_RE = re.compile(r"/([A-Za-z][A-Za-z0-9_+-]*):([A-Za-z0-9_.-]+)\.GstPad:src: caps = (video/x-raw[^\n]*)")
GST_FPS_RE = re.compile(r"last-message = rendered: (\d+), dropped: (\d+), current: ([\d.]+), average: ([\d.]+)")


def run_gst(url, v, a, outdir, tag):
    if not shutil.which("gst-launch-1.0"):
        return {"skipped": "gst-launch-1.0 not installed"}
    env, has_display = display_env()
    sink = a.gst_sink or (("waylandsink fullscreen=true" + (" fullscreen-output=" + a.output if a.output else ""))
                          if has_display else "fakevideosink")
    pipe = ["playbin3", "uri=" + url,
            "video-sink=fpsdisplaysink text-overlay=false video-sink=\"%s\"" % sink]
    if a.no_audio:
        pipe.append("audio-sink=fakesink sync=true")
    logf = os.path.join(outdir, tag + ".gst.log")
    env["GST_DEBUG"] = env.get("GST_DEBUG", "2")
    with open(logf, "w") as lf:
        p = subprocess.Popen(["gst-launch-1.0", "-e", "-v"] + pipe, env=env,
                             stdout=lf, stderr=subprocess.STDOUT)
        m = Meter(p.pid)
        t_end = time.monotonic() + a.duration
        kms = None
        while p.poll() is None and time.monotonic() < t_end:
            time.sleep(1)
            m.poll()
            if kms is None and time.monotonic() - m.t0 > a.duration / 2:
                kms = kms_state(outdir, tag) or ""
        if p.poll() is None:
            p.send_signal(2)  # -e: SIGINT -> EOS -> clean shutdown
            try:
                p.wait(timeout=20)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
        res = m.result()
    text = open(logf, errors="replace").read()
    decs = []
    for cls, name, caps in GST_DEC_RE.findall(text):
        if "dec" in name and not name.startswith("decodebin") and (cls, name) not in [(d["element"], d["name"]) for d in decs]:
            decs.append({"element": cls, "name": name, "dmabuf": "memory:DMABuf" in caps,
                         "format": (re.search(r"(?:drm-format|format)=\(string\)([A-Za-z0-9_:]+)", caps) or [None, None])[1]})
    fps = GST_FPS_RE.findall(text)
    res.update({"exit": p.returncode, "sink": sink, "decoders": decs, "kms_state": kms or None,
                "errors": [l.strip() for l in text.splitlines() if l.startswith("ERROR") or ":ERROR" in l][:5]})
    if fps:
        r, d, cur, avg = fps[-1]
        res.update({"rendered": int(r), "dropped": int(d), "average_fps": float(avg)})
    res["hw_decode"] = any(d["element"].startswith("GstV4l2") or d["name"].startswith("v4l2sl") for d in decs)
    res["zero_copy"] = res["hw_decode"] and any(d["dmabuf"] for d in decs)
    return res


def run_ffmpeg(url, v, a, outdir, tag):
    if not shutil.which("ffmpeg"):
        return {"skipped": "ffmpeg not installed"}
    hw = subprocess.run(["ffmpeg", "-hide_banner", "-hwaccels"], capture_output=True, text=True).stdout
    if "v4l2request" not in hw.split():
        return {"skipped": "this FFmpeg has no v4l2request hwaccel (Ubuntu's build; use the image's +opi5 build)"}
    logf = os.path.join(outdir, tag + ".ffmpeg.log")
    cmd = ["ffmpeg", "-hide_banner", "-nostdin", "-loglevel", "verbose", "-hwaccel", "v4l2request",
           "-hwaccel_output_format", "drm_prime", "-ss", str(a.start), "-t", str(a.duration),
           "-i", url, "-map", "0:v:0", "-f", "null", "-"]
    with open(logf, "w") as lf:
        p = subprocess.Popen(cmd, stdout=lf, stderr=subprocess.STDOUT)
        m = Meter(p.pid)
        while p.poll() is None:
            time.sleep(1)
            m.poll()
        res = m.result()
    text = open(logf, errors="replace").read()
    frames = re.findall(r"frame=\s*(\d+)\s+fps=\s*([\d.]+).*?speed=\s*([\d.]+)x", text)
    fallback = re.search(r"Failed setup for format drm_prime|hwaccel initialisation returned error|No device available for decoder", text)
    res.update({"exit": p.returncode, "hw_decode": p.returncode == 0 and not fallback,
                "errors": [l for l in text.splitlines() if "rror" in l][:5]})
    if frames:
        f, fps, speed = frames[-1]
        res.update({"frames": int(f), "decode_fps": float(fps), "speed": float(speed)})
    return res


BACKENDS = {"mpv": run_mpv, "gst": run_gst, "ffmpeg": run_ffmpeg}


# ------------------------------------------------------------ main
def read_creds(from_stdin):
    c = {k: os.environ.get(k) for k in ("OPI5_JELLYFIN_URL", "OPI5_JELLYFIN_USER", "OPI5_JELLYFIN_PASS")}
    if from_stdin:
        for line in sys.stdin:
            line = line.strip()
            if "=" in line and not line.startswith("#"):
                k, val = line.split("=", 1)
                k = k.strip().removeprefix("export ").strip()
                val = val.strip()
                if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
                    val = val[1:-1]
                if k in c:
                    c[k] = val
    missing = [k for k, val in c.items() if not val]
    if missing:
        sys.exit("missing credentials: %s (environment, or KEY=VALUE lines with --creds-stdin)" % ", ".join(missing))
    return c["OPI5_JELLYFIN_URL"], c["OPI5_JELLYFIN_USER"], c["OPI5_JELLYFIN_PASS"]


def table(rows):
    out = ["| # | video | codec | size | bits | fps | backend | HW | zero-copy | decoder / hwdec | fps (avg) | dropped | player CPU % | sys CPU % | decoder IRQs |",
           "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
    for i, r in enumerate(rows, 1):
        v, b, res = dict(r["video"]), r["backend"], r["result"]
        v["name"] = v["name"].replace("|", "/")
        if "skipped" in res:
            out.append("| %d | %s | %s | %sx%s | %s | %s | %s | skipped: %s |||||||" % (
                i, v["name"][:40], v["codec"], v["width"], v["height"], v["bitdepth"], v["fps"], b, res["skipped"]))
            continue
        dec = res.get("hwdec-current") or ", ".join(d["name"] for d in res.get("decoders", [])) or ("v4l2request" if b == "ffmpeg" and res.get("hw_decode") else "")
        fps = res.get("estimated-vf-fps") or res.get("average_fps") or res.get("decode_fps")
        drop = res.get("frame-drop-count", res.get("dropped", ""))
        if b == "mpv":
            drop = "%s/%s" % (res.get("frame-drop-count", "?"), res.get("decoder-frame-drop-count", "?"))
        irqs = sum(res.get("decoder_irqs", {}).values())
        out.append("| %d | %s | %s | %sx%s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            i, v["name"][:40], v["codec"], v["width"], v["height"], v["bitdepth"], v["fps"], b,
            "yes" if res.get("hw_decode") else "NO", "yes" if res.get("zero_copy") else ("n/a" if b == "ffmpeg" else "no"),
            dec, round(fps, 2) if isinstance(fps, (int, float)) else "", drop,
            res.get("player_cpu_pct_of_one_core"), res.get("system_cpu_pct"), irqs))
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--creds-stdin", action="store_true", help="read OPI5_JELLYFIN_* KEY=VALUE lines from stdin")
    ap.add_argument("--list", action="store_true", help="list the server's videos by class and exit")
    ap.add_argument("--backend", default="mpv,gst", help="comma list of mpv, gst, ffmpeg (default mpv,gst)")
    ap.add_argument("--codecs", default=",".join(CODECS))
    ap.add_argument("--per-class", type=int, default=1, help="videos per codec/size/bit-depth/frame-rate class")
    ap.add_argument("--item", action="append", default=[], help="test this item id (repeatable) instead of picking")
    ap.add_argument("--duration", type=int, default=30, help="seconds per video and backend")
    ap.add_argument("--start", type=int, default=60, help="start offset in seconds (mpv, ffmpeg)")
    ap.add_argument("--no-audio", action="store_true")
    ap.add_argument("--mpv-hwdec", default="v4l2request")
    ap.add_argument("--mpv-vo", default="", help="e.g. gpu-next (default), dmabuf-wayland, drm")
    ap.add_argument("--gst-sink", default="", help="video sink, default waylandsink in a session else fakevideosink")
    ap.add_argument("--output", default="", help="connector to fullscreen on, e.g. HDMI-A-1 or DP-1 (mpv, waylandsink)")
    ap.add_argument("--out", default=os.path.expanduser("~/opi5-jellyfin-hwtest"))
    a = ap.parse_args()

    url, user, pw = read_creds(a.creds_stdin)
    jf = Jellyfin(url, user, pw)
    del pw
    try:
        videos = [d for d in (describe(i) for i in jf.videos()) if d]
        log("%d videos on the server" % len(videos))
        if a.list:
            by = {}
            for v in videos:
                by.setdefault(klass(v), []).append(v)
            for k in sorted(by, key=lambda k: (CODECS.index(k[0]) if k[0] in CODECS else 99, k)):
                ex = by[k][0]
                print("%-11s %-6s %-6s %-3s %4d videos  e.g. %s [%s] (%s, %s fps)" % (
                    k + (len(by[k]), ex["name"][:50], ex["id"], ex["container"], ex["fps"])))
            return
        codecs = [c for c in a.codecs.split(",") if c]
        sel = [v for v in videos if v["id"] in a.item] if a.item else pick(videos, codecs, a.per_class, a.start + a.duration)
        if not sel:
            sys.exit("no matching videos")
        stamp = time.strftime("%Y%m%d-%H%M%S")
        outdir = os.path.join(a.out, stamp)
        os.makedirs(outdir, exist_ok=True)
        proxy = Proxy(jf)
        threading.Thread(target=proxy.serve_forever, daemon=True).start()
        rows = []
        info = {"time": stamp, "host": socket.gethostname(), "kernel": os.uname().release,
                "duration": a.duration, "start": a.start, "backends": a.backend}
        for i, v in enumerate(sel, 1):
            for b in a.backend.split(","):
                tag = "%02d-%s-%s-%sp-%s" % (i, b, v["codec"], v["height"], v["id"][:8])
                log("[%d/%d] %s %s %sx%s %d-bit %s fps: %s (expect %s)" % (
                    i, len(sel), b, v["codec"], v["width"], v["height"], v["bitdepth"], v["fps"],
                    v["name"][:50], EXPECTED.get(v["codec"], "software")))
                res = BACKENDS[b](proxy.url(v), v, a, outdir, tag)
                log("    -> %s" % json.dumps({k: res.get(k) for k in ("skipped", "hw_decode", "zero_copy", "hwdec-current",
                    "estimated-vf-fps", "average_fps", "decode_fps", "frame-drop-count", "dropped", "player_cpu_pct_of_one_core") if k in res}))
                rows.append({"video": v, "backend": b, "expected": EXPECTED.get(v["codec"]), "result": res})
                with open(os.path.join(outdir, "results.json"), "w") as f:
                    json.dump({"info": info, "runs": rows}, f, indent=1)
        proxy.shutdown()
        md = "# Jellyfin hardware-decode test %s\n\n%s\n\nPer-run logs and KMS plane snapshots are next to this file.\n" % (stamp, table(rows))
        with open(os.path.join(outdir, "results.md"), "w") as f:
            f.write(md)
        print(md)
        print("results:", outdir)
    finally:
        jf.logout()


if __name__ == "__main__":
    main()
