# Config fragment merged on top of Ubuntu's generic arm64 kernel config
CONFIG_LOCALVERSION="-opi5"
# No git-derived suffix (our patches would make it "-dirty")
CONFIG_LOCALVERSION_AUTO=n
# U-Boot's booti needs a plain Image, not an EFI zboot (compressed PE) image
CONFIG_EFI_ZBOOT=n
# Modules are signed (lockdown LSM requires it) with a key the build generates in
# build/linux/certs/; Canonical's extra keyrings (debian/*.pem) aren't available
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# Ubuntu ships firmware files zstd-compressed (e.g. arm/mali/arch10.8/mali_csffw.bin.zst)
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
# RK3588 GPU / video / NPU (mainline drivers)
CONFIG_DRM_PANTHOR=m
CONFIG_VIDEO_HANTRO=m
CONFIG_DRM_ACCEL_ROCKET=m
# rkvdec (VDPU381): H.264/HEVC up to 8K; not in arm64 defconfig
CONFIG_VIDEO_ROCKCHIP_VDEC=m
# MIPI DSI panel output and MIPI CSI camera input
CONFIG_ROCKCHIP_DW_MIPI_DSI2=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=m
CONFIG_PHY_ROCKCHIP_INNO_CSIDPHY=m
# DDR bandwidth counters (profiling 4K/8K decode)
CONFIG_DEVFREQ_EVENT_ROCKCHIP_DFI=m
# SCMI reset controller (TRNG reset): as a module nothing loads it, because its
# SCMI device only appears once the driver registers, so rockchip-rng never probes
CONFIG_RESET_SCMI=y
# Board: RTC, fan, SPI NOR
CONFIG_RTC_DRV_HYM8563=m
CONFIG_SENSORS_PWM_FAN=m
CONFIG_MTD_SPI_NOR=m
CONFIG_SPI_ROCKCHIP_SFC=m
# Rockchip DWC3 glue (required by the USBDP/DP-altmode series; core dwc3 refuses RK3588 nodes without it)
CONFIG_USB_DWC3_ROCKCHIP=m
# Video codec / processing drivers added by patches/linux 06xx-09xx
# (VIDEO_HANTRO above also gets the VEPU2 H.264 encoder; rkvdec gets VP9)
# VDPU720 JPEG decoder
CONFIG_VIDEO_ROCKCHIP_JPEGD=m
# IEP2 deinterlacer
CONFIG_VIDEO_ROCKCHIP_IEP=m
# VEPU580 H.264/HEVC stateless encoder
CONFIG_VIDEO_ROCKCHIP_VENC=m
# Stateless H.264/HEVC encode cores (hidden; selected by the encoders above,
# listed so build-kernel.sh reports it if they go missing)
CONFIG_V4L2_H264_ENC=m
CONFIG_V4L2_HEVC_ENC=m
CONFIG_V4L2_HEVC_ENC_RBSP=m
