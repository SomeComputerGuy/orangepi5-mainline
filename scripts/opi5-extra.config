# Config fragment for OPI5_EXTRA=1 builds (patches/linux-extra, not tested on
# hardware), merged after opi5.config
# rkisp2: RK3588 ISP for the MIPI CSI camera overlays
CONFIG_VIDEO_ROCKCHIP_ISP2=m
# Already modules in Ubuntu's config, listed because the overlays need them:
# ILI9881C MIPI DSI panel (Orange Pi 10.1" LCD), GT9271 touch, PWM backlight
CONFIG_DRM_PANEL_ILITEK_ILI9881C=m
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_BACKLIGHT_PWM=m
# MIPI CSI receiver/VICAP and the IMX219 sensor and DW9714 VCM
CONFIG_VIDEO_ROCKCHIP_CIF=m
CONFIG_VIDEO_IMX219=m
CONFIG_VIDEO_DW9714=m
